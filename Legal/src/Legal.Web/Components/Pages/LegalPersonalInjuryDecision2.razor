    private static string DiSubTabIcon(string subTab) => subTab switch
    {
        "Document Review" => "bi-folder2-open",
        "Passage Analysis" => "bi-chat-square-quote",
        "Atomic Propositions" => "bi-diagram-3",
        "Evidence Bindings" => "bi-link-45deg",
        "Impact on Decisions" => "bi-signpost-split",
        "Evidence Provenance" => "bi-fingerprint",
        _ => "bi-file-earmark-text",
    };

    // Flattened proposition ↔ evidence binding edges, joined to the originating evidence source citation.
    private sealed record DiBindingEdge(
        string PropositionText,
        string RelationshipTypeCode,
        string EvidenceSummary,
        string SourceReference,
        string? AnchorQuote,
        string? AnchorVerificationStateCode);
    private IReadOnlyList<DiBindingEdge> DiBindingEdges
    {
        get
        {
            if (_evidenceGraph is null)
            {
                return [];
            }

            var evidenceById = _evidenceGraph.Evidence
                .GroupBy(e => e.LegalEvidenceItemId)
                .ToDictionary(g => g.Key, g => g.First());

            // Immutable source anchors, indexed by the claim they pin (support edge preferred, then evidence item).
            var anchorsBySupport = _evidenceGraph.SourceAssertions
                .Where(a => a.LegalPropositionSupportId is not null)
                .GroupBy(a => a.LegalPropositionSupportId!.Value)
                .ToDictionary(g => g.Key, g => g.First());
            var anchorsByEvidence = _evidenceGraph.SourceAssertions
                .Where(a => a.LegalEvidenceItemId is not null)
                .GroupBy(a => a.LegalEvidenceItemId!.Value)
                .ToDictionary(g => g.Key, g => g.First());

            var edges = new List<DiBindingEdge>();
            foreach (var prop in _evidenceGraph.Propositions)
            {
                foreach (var sup in prop.Support)
                {
                    evidenceById.TryGetValue(sup.LegalEvidenceItemId, out var ev);
                    // "Wired from" must show the ACTUAL extracted statement (the real line of words in the
                    // evidence), not the generic document-manifest summary — otherwise every row reads the
                    // same and never visibly matches its proposition. Prefer the exact passage text; fall
                    // back to the assessment reason, then the summary only as a last resort.
                    var summary = FirstNonBlank(ev?.PassageText, sup.AssessmentReason, ev?.Summary) ?? "";
                    var source = ev is null
                        ? ""
                        : $"{ev.DocumentFileName} · v{ev.DocumentVersionNumber}"
                          + (ev.PageNumber is { } pg ? $" · p.{pg}" : "")
                          + (string.IsNullOrWhiteSpace(ev.SectionPath) ? "" : $" · {ev.SectionPath}");

                    if (!anchorsBySupport.TryGetValue(sup.LegalPropositionSupportId, out var anchor))
                    {
                        anchorsByEvidence.TryGetValue(sup.LegalEvidenceItemId, out anchor);
                    }

                    // The anchored quote is the exact span-verified text when one exists; otherwise show the
                    // extracted passage text (unverified) so the reader always sees the matching source words.
                    var anchorQuote = anchor?.QuotedText;
                    var anchorState = anchor?.VerificationStateCode;
                    if (string.IsNullOrWhiteSpace(anchorQuote) && !string.IsNullOrWhiteSpace(ev?.PassageText))
                    {
                        anchorQuote = ev!.PassageText;
                        anchorState ??= "UNVERIFIED";
                    }

                    edges.Add(new DiBindingEdge(
                        prop.PropositionText, sup.RelationshipTypeCode, summary, source,
                        anchorQuote, anchorState));
                }
            }

            return edges;
        }
    }

    private static string? FirstNonBlank(params string?[] values)
    {
        foreach (var v in values)
        {
            if (!string.IsNullOrWhiteSpace(v))
                return v.Trim();
        }
        return null;
    }

    private static string DiAnchorToneClass(string? verificationStateCode) => (verificationStateCode ?? "").ToUpperInvariant() switch
    {
        "VERIFIED" => "di-pill--supports",
        "DRIFTED" => "di-pill--qualifies",
        "INVALIDATED" => "di-pill--insufficient",
        _ => "di-pill--state",
    };

    private static bool DiIsSupportRelation(string? relationCode) => (relationCode ?? "").ToUpperInvariant() switch
    {
        "SUPPORTS" or "DIRECT_SUPPORT" or "PARTIAL_SUPPORT" or "CORROBORATES" => true,
        _ => false,
    };

    private static bool DiIsContradictRelation(string? relationCode) => (relationCode ?? "").ToUpperInvariant() switch
    {
        "CONTRADICTS" or "CONTRADICTION" => true,
        _ => false,
    };

    private int DiSupportCount
        => _evidenceGraph?.Propositions.Sum(p => p.Support.Count(s => DiIsSupportRelation(s.RelationshipTypeCode))) ?? 0;

    private int DiContradictionCount
        => _evidenceGraph?.Propositions.Sum(p => p.Support.Count(s => DiIsContradictRelation(s.RelationshipTypeCode))) ?? 0;

    // Edges that were wired but not admitted as decision-bearing (INSUFFICIENT). These are shown so the
    // Impact panel never looks empty when bindings actually exist — insufficiency is surfaced, not hidden.
    private int DiInsufficientCount
        => _evidenceGraph?.Propositions.Sum(p => p.Support.Count(s => !DiIsSupportRelation(s.RelationshipTypeCode) && !DiIsContradictRelation(s.RelationshipTypeCode))) ?? 0;


    private static string DiProcessingBadgeClass(string? processingStatusCode) => (processingStatusCode ?? "").ToUpperInvariant() switch
    {
        "COMPLETED" or "PROCESSED" or "EXTRACTED" or "SUCCEEDED" => "di-prov-badge--ok",
        "FAILED" or "ERROR" or "QUARANTINED" => "di-prov-badge--fail",
        "PENDING" or "PROCESSING" or "QUEUED" or "RUNNING" => "di-prov-badge--pending",
        _ => "di-prov-badge--neutral",
    };

    private static string DiShortHash(string? sha256Hash)
        => string.IsNullOrWhiteSpace(sha256Hash) ? "—" : sha256Hash.Length <= 12 ? sha256Hash : sha256Hash[..12].ToLowerInvariant();

    private static string DiRelationToneClass(string relationshipTypeCode) => relationshipTypeCode switch
    {
        "SUPPORTS" => "di-pill--supports",
        "CONTRADICTS" => "di-pill--contradicts",
        "QUALIFIES" => "di-pill--qualifies",
        "INSUFFICIENT" => "di-pill--insufficient",
        _ => "di-pill--context",
    };

    // Evidence admission disposition: span-less evidence is persisted as INVALIDATED (not admitted) so the
    // cockpit visibly distinguishes admitted evidence from excluded, non-traceable assertions.
    private static string DiEvidenceStateToneClass(string evidenceStateCode) => evidenceStateCode switch
    {
        "VERIFIED" => "di-pill--supports",
        "DISPUTED" => "di-pill--qualifies",
        "INVALIDATED" => "di-pill--insufficient",
        _ => "di-pill--state",
    };

    private static bool DiIsExcludedEvidence(string evidenceStateCode)
        => string.Equals(evidenceStateCode, "INVALIDATED", StringComparison.OrdinalIgnoreCase);
