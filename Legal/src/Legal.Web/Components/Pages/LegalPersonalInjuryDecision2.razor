@code {

    [Parameter, SupplyParameterFromQuery(Name = "matterId")]
    public Guid? MatterId { get; set; }

    private DecisionMatterDto? _matter;
    private IReadOnlyCollection<LegalDocumentDto> _documents = [];

    // Opens the Candidate Full Analysis as an in-page popup for the given 1-based candidate rank index.
    // The compact OvOutcome powers the header instantly; the rich, DB-backed CandidateFullAnalysisDto
    // is then loaded on demand from the API so the popup shows authoritative persisted sections.
    private async Task OpenCandidateAnalysis(int candidateIndex)
    {
        _analysisPopupOutcome = OvOutcomes.FirstOrDefault(o => o.Index == candidateIndex);
        _analysisPopupModel = null;
        _analysisPopupError = null;

        var matterId = _matter?.DecisionMatterId ?? MatterId;
        if (matterId is not { } mid || mid == Guid.Empty)
            return;

        _analysisPopupLoading = true;
        try
        {
            _analysisPopupModel = await Api.GetLegalCandidateFullAnalysisAsync(mid, candidateIndex);
        }
        catch (Exception ex)
        {
            _analysisPopupError = $"Unable to load full analysis: {ex.Message}";
        }
        finally
        {
            _analysisPopupLoading = false;
        }
    }

    private void CloseCandidateAnalysis()
    {
        _analysisPopupOutcome = null;
        _analysisPopupModel = null;
        _analysisPopupError = null;
        _analysisPopupLoading = false;
    }

    private bool _uploading;
    private int _uploadTotal;
    private int _uploadIndex;
    private string? _uploadOutcome;
    private bool _uploadEnriched;

    // ── Real-time intake pipeline stepper (directional stage indicator) ──
    // One integrated indicator with two phases: "Prepared on upload" (deterministic intake) and
    // "Activated on answer" (metered reasoning that runs on Disambiguate & Answer). The Queued state
    // marks activation stages that are prepared but deferred until the answer path runs.
    private enum UploadStageState { Pending, Active, Done, Skipped, Failed, Queued }
    private enum UploadResult { None, Pass, Warn, Fail }
    private UploadResult _uploadResult = UploadResult.None;
    private sealed class UploadStage
    {
        public required string Key { get; init; }
        public required string Label { get; init; }
        public required string Icon { get; init; }
        // "prepare" (runs on upload) or "activate" (runs on Disambiguate & Answer).
        public required string Segment { get; init; }
        public UploadStageState State { get; set; } = UploadStageState.Pending;
    }
    private List<UploadStage>? _uploadStages;

    private List<UploadStage> BuildUploadStages() =>
    [
        new() { Key = "upload", Label = "Upload", Icon = "bi-cloud-arrow-up", Segment = "prepare" },
        new() { Key = "scan", Label = "Malware scan", Icon = "bi-shield-check", Segment = "prepare" },
        new() { Key = "blob", Label = "Store to Blob", Icon = "bi-hdd-network", Segment = "prepare" },
        new() { Key = "db", Label = "Save to database", Icon = "bi-database", Segment = "prepare" },
        new() { Key = "extract", Label = "Extract text", Icon = "bi-file-text", Segment = "prepare" },
        new() { Key = "propositions", Label = "Atomic propositions", Icon = "bi-diagram-3", Segment = "activate" },
        new() { Key = "cdc", Label = "Re-check decisions (CDC)", Icon = "bi-arrow-repeat", Segment = "activate" },
    ];

    private void SetUploadStage(string key, UploadStageState state)
    {
        var stage = _uploadStages?.FirstOrDefault(s => s.Key == key);
        if (stage is not null)
        {
            stage.State = state;
            StateHasChanged();
        }
    }

    private static string UploadStageCss(UploadStageState state) => state switch
    {
        UploadStageState.Active => "is-active",
        UploadStageState.Done => "is-done",
        UploadStageState.Skipped => "is-skipped",
        UploadStageState.Failed => "is-failed",
        UploadStageState.Queued => "is-queued",
        _ => "is-pending"
    };

    private static string UploadStageIcon(UploadStage stage) => stage.State switch
    {
        UploadStageState.Done => "bi-check-circle-fill",
        UploadStageState.Active => "bi-arrow-repeat intake-spin",
        UploadStageState.Skipped => "bi-slash-circle",
        UploadStageState.Failed => "bi-x-circle-fill",
        UploadStageState.Queued => "bi-hourglass-split",
        _ => stage.Icon
    };

    private void SetUploadResult(UploadResult result)
    {
        _uploadResult = result;
        StateHasChanged();
    }

    private static string UploadResultCss(UploadResult result) => result switch
    {
        UploadResult.Pass => "is-pass",
        UploadResult.Warn => "is-warn",
        UploadResult.Fail => "is-fail",
        _ => string.Empty
    };

    private static string UploadResultIcon(UploadResult result) => result switch
    {
        UploadResult.Pass => "bi-check2-all",
        UploadResult.Warn => "bi-exclamation-triangle-fill",
        UploadResult.Fail => "bi-x-octagon-fill",
        _ => "bi-dash-circle"
    };

    private static string UploadResultLabel(UploadResult result) => result switch
    {
        UploadResult.Pass => "Prepared — activates on Disambiguate & Answer",
        UploadResult.Warn => "Stored — no propositions were derived yet (semantic enrichment disabled or CHAT route unavailable)",
        UploadResult.Fail => "Failed",
        _ => string.Empty
    };

    // ── Document Intelligence workspace (matter-scoped evidence ↔ proposition graph, DB-backed) ──
    private Legal.Application.Features.Intelligence.Decision.LegalMatterEvidenceGraphDto? _evidenceGraph;
    private bool _evidenceGraphLoading;
    private string? _evidenceGraphError;
    private Guid? _diSelectedDocumentId;

    // Enterprise Document Intelligence workbench sub-tabs (native Blazor, DB-backed projections).
    private static readonly string[] DiSubTabs =
        ["Document Review", "Passage Analysis", "Atomic Propositions", "Evidence Bindings", "Impact on Decisions", "Evidence Provenance", "Document Cleanup"];
    private string _diSubTab = "Document Review";
    private Guid? _diSelectedPropositionId;

    // ── Document Cleanup sub-tab: hard-delete supporting documents + synchronous recompute ──────────
    private readonly HashSet<Guid> _selectedCleanupDocumentIds = [];
    private bool _cleanupBusy;
    private string? _cleanupError;
    private Legal.Application.Features.Intelligence.Decision.LegalMatterDocumentPurgeOutcome? _cleanupResult;
    private sealed record CleanupConfirmContext(string Title, string Message, IReadOnlyCollection<Guid>? DocumentIds);
    private CleanupConfirmContext? _cleanupConfirm;

    private void ToggleCleanupDocument(Guid documentId, ChangeEventArgs e)
    {
        if (e.Value is bool value && value)
            _selectedCleanupDocumentIds.Add(documentId);
        else
            _selectedCleanupDocumentIds.Remove(documentId);
    }

    private void ToggleSelectAllCleanupDocuments(ChangeEventArgs e)
    {
        _selectedCleanupDocumentIds.Clear();
        if (e.Value is bool value && value)
            foreach (var doc in _documents)
                _selectedCleanupDocumentIds.Add(doc.LegalDocumentId);
    }

    private void ConfirmRemoveSingleDocument(LegalDocumentDto doc)
        => _cleanupConfirm = new CleanupConfirmContext(
            "Remove document?",
            $"Permanently delete \"{doc.FileName}\" and all evidence, passages, propositions and provenance derived from it. Scoring and decision statuses will be recomputed. This cannot be undone.",
            [doc.LegalDocumentId]);

    private void ConfirmRemoveSelectedDocuments()
    {
        if (_selectedCleanupDocumentIds.Count == 0) return;
        _cleanupConfirm = new CleanupConfirmContext(
            "Remove selected documents?",
            $"Permanently delete {_selectedCleanupDocumentIds.Count} selected document(s) and everything derived from them. Scoring and decision statuses will be recomputed. This cannot be undone.",
            _selectedCleanupDocumentIds.ToArray());
    }

    private void ConfirmRemoveAllDocuments()
        => _cleanupConfirm = new CleanupConfirmContext(
            "Remove ALL documents?",
            "Permanently delete every supporting document for this matter and all derived evidence, passages, propositions, source anchors, provenance occurrences and upload batches. This is a full clean slate and cannot be undone. Scoring and decision statuses will be recomputed.",
            null);

    private async Task ExecuteCleanupAsync()
    {
        if (_matter is null || _cleanupConfirm is null) return;
        _cleanupBusy = true;
        _cleanupError = null;
        try
        {
