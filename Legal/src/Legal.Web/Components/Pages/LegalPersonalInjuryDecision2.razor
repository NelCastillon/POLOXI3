    // (HRR-AER), change drivers, and readiness blockers render empty: _cdcChangeEvents is only loaded
    // once in OnInitializedAsync (before any answer), and _evidenceGraph is only loaded inside the
    // corpus-activation path which early-returns for matters whose corpus was already activated. Both
    // are reloaded here so every live Overview panel reflects the just-produced decision. Fail-soft.
    private async Task RefreshPostAnswerIntelligenceAsync()
    {
        if (MatterId is not { } matterId || matterId == Guid.Empty)
