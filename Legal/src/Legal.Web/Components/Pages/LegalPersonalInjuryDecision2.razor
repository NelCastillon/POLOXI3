    // Readiness progress: coverage/structure/evidence/analysis/open-question gates, each a 0-100 signal.
    internal sealed record OvReadinessStep(string Label, string Value, string Tone);
    internal IReadOnlyList<OvReadinessStep> OvReadinessSteps
    {
        get
        {
            var structurePct = (_response?.DepthReached ?? 0) >= 2 && SurvivingBranches.Count > 0 ? 100 : 40;
            var evidencePct = (int)Math.Round(DfiEvidenceCoveragePct * 100m);
            var analysisPct = FinalRankedCandidates.Count > 0 ? 100 : OvOutcomes.Count > 0 ? 70 : 30;
            var missing = DfiMissingFactorCount;
            var total = Math.Max(1, DfiFactorCount);
            var openQuestionPct = (int)Math.Round((1m - (decimal)missing / total) * 100m);
            return
            [
                new("Structure", $"{structurePct}%", structurePct >= 80 ? "ok" : "warn"),
                new("Evidence", $"{evidencePct}%", evidencePct >= 70 ? "ok" : "warn"),
                new("Analysis", $"{analysisPct}%", analysisPct >= 80 ? "ok" : "warn"),
                new("Open Questions", $"{openQuestionPct}%", openQuestionPct >= 80 ? "ok" : "warn"),
                new("Readiness", $"{OvReadinessPct}%", DfiReadinessTone),
            ];
        }
    }

    internal int OvReadinessPct
    {
        get
        {
            var structure = (_response?.DepthReached ?? 0) >= 2 && SurvivingBranches.Count > 0 ? 1m : 0.4m;
            var evidence = DfiEvidenceCoveragePct;
            var analysis = FinalRankedCandidates.Count > 0 ? 1m : OvOutcomes.Count > 0 ? 0.7m : 0.3m;
            var missing = DfiMissingFactorCount;
            var total = Math.Max(1, DfiFactorCount);
            var openQ = 1m - (decimal)missing / total;
            var avg = (structure + evidence + analysis + openQ) / 4m;
            return (int)Math.Round(Math.Clamp(avg, 0m, 1m) * 100m);
        }
    }

    // Executive / Analyst summary: a grounded decision brief, not generated prose.
    internal string OvExecutiveSummary
    {
        get
        {
            var leader = OvOutcomes.FirstOrDefault();
            if (leader is null) return "No decision outcome has been established yet. Run an analysis to generate the decision landscape.";
            var conf = OvConfidenceValue > 0m ? $"{OvConfidenceValue:P0} confidence" : "provisional confidence";
            var evidence = TotalEvidenceCount > 0
                ? $"supported by {TotalEvidenceCount} admitted evidence item{(TotalEvidenceCount == 1 ? "" : "s")} at {DfiEvidenceCoveragePct:P0} decision coverage"
                : "with no independently verified evidence admitted yet";
            var nextAction = OvNextBestActions.FirstOrDefault();
            var nextText = nextAction is not null
                ? $" The highest-value next step is to resolve \"{nextAction.Title}\" (ADV {nextAction.Adv:0.00}), which could materially change the ranking."
                : string.Empty;
            return $"Based on current evidence, {leader.Title} remains the most supportable outcome with {leader.SupportPct}% support and {conf}, {evidence}. The decision is currently {DfiReadinessLabel.ToLowerInvariant()}.{nextText}";
        }
    }

    internal sealed record OvSummaryChip(string Icon, string Title, string Text, string Tone);
    internal IReadOnlyList<OvSummaryChip> OvSummaryChips
    {
        get
        {
            var chips = new List<OvSummaryChip>();
            var leader = OvOutcomes.FirstOrDefault();
            if (leader is not null && leader.KeySupportingFactors > 0)
                chips.Add(new("bi-shield-check", "Key Strength", $"{leader.KeySupportingFactors} supporting factor(s) behind the leading outcome", "ok"));
            var topRisk = OvOutcomes.FirstOrDefault(o => o.MainVulnerabilities > 0);
            if (topRisk is not null)
                chips.Add(new("bi-exclamation-triangle", "Key Risk", $"{topRisk.Title} carries {topRisk.MainVulnerabilities} unresolved risk(s)", "warn"));
            var nextAction = OvNextBestActions.FirstOrDefault();
            if (nextAction is not null)
                chips.Add(new("bi-flag", "Next Milestone", nextAction.Title, "info"));
            return chips;
        }
    }

    // ── Decision Intelligence Overview projections (live-data only) ────────────────────────────────
    // Decision Status trust strip: the authoritative at-a-glance state of the decision. Every value is
    // derived from the live Wide2 response / factor inventory; nothing is fabricated.
    internal sealed record OvStatusChip(string Label, string Value, string Tone, string Tooltip);
    internal string OvDecisionStateLabel => DfiReadinessLabel;
    internal string OvDecisionStateTone => DfiReadinessTone;
    // True only when a real POLOXI Candidate x Branch competition executed. The LLM ADVISORY score is
    // NOT a competition score: when competition is blocked we must not crown a "Current Leader" or claim
    // one outcome "leads at X% support". Mirrors the authoritative backend signals used by the
    // Technical Verification strip (CandidateCompetitionStatus = "RAN ..." /
    // DecisionReadinessStatus = "CANDIDATES_REGISTERED_AND_COMPETED").
    internal bool OvCompetitionValid
    {
        get
        {
            var competitionStatus = _response?.MatterContext?.CandidateCompetitionStatus;
            var readinessStatus = _response?.MatterContext?.DecisionReadinessStatus;
            return (competitionStatus?.StartsWith("RAN", StringComparison.OrdinalIgnoreCase) ?? false)
                || (readinessStatus?.StartsWith("CANDIDATES_REGISTERED_AND_COMPETED", StringComparison.OrdinalIgnoreCase) ?? false);
        }
    }
    internal IReadOnlyList<OvStatusChip> OvDecisionStatusChips
    {
        get
        {
            var verifiedAuthorities = _response?.ProposedLegalAuthorities.Count(a => a.VerificationStatus == "VERIFIED") ?? 0;
            var openQuestions = _response?.DecisionInspector?.FactorInventory?.MissingFactorCount ?? DfiMissingFactorCount;
            return
            [
                new("Candidates", OvOutcomes.Count.ToString(), "info",
                    "Candidates — the number of distinct competing outcomes (candidate answers) generated and scored for this matter. Formula: count of scored outcomes in the current analysis. More candidates means a wider decision space was explored."),
                new("Verified Evidence", TotalEvidenceCount.ToString(), TotalEvidenceCount > 0 ? "ok" : "warn",
                    "Verified Evidence — count of independently verified evidence items admitted into the decision. Formula: count of evidence items with verification status = VERIFIED. Unverified allegations are excluded and do not count."),
                new("Verified Authorities", verifiedAuthorities.ToString(), verifiedAuthorities > 0 ? "ok" : "warn",
                    "Verified Authorities — count of cited legal authorities (statutes, cases, rules) confirmed against an authoritative source. Formula: count of proposed legal authorities where verification status = VERIFIED."),
                new("Open Questions", openQuestions.ToString(), openQuestions > 0 ? "warn" : "ok",
                    "Open Questions — unresolved, decision-material atomic factors still missing evidence or a determination. Formula: count of atomic (non-grouping) factors in the inventory with no established fact state. Lower is better."),
                new("Decision Readiness", $"{OvReadinessPct}%", DfiReadinessTone,
                    "Decision Readiness — how close the decision is to being defensible end to end. Formula: average of the readiness gates (Structure, Evidence, Analysis, Open Questions) as a 0–100% score. 100% means all gates are satisfied."),
                new("Confidence", OvConfidenceValue > 0m ? $"{OvConfidencePct}%" : "—", OvConfidenceTone,
                    "Confidence — how decisively the leading candidate separates from the rest. Formula: derived from outcome entropy H and winner separation, normalized to 0–100% (higher = lower entropy / clearer winner). Shows “—” until a confidence value is available."),
            ];
        }
    }

    // Why It Leads: the leading candidate's strongest scored dimensions (branch evidence scores 0-100).
    internal sealed record OvLeaderFactor(string Name, int Pct, string Tone);
    internal IReadOnlyList<OvLeaderFactor> OvWhyItLeads
    {
        get
        {
            var leader = OvOutcomes.FirstOrDefault();
            if (leader is null) return [];
            return leader.BranchScores
                .OrderByDescending(b => b.EvidenceScore)
                .Take(5)
                .Select(b =>
                {
                    var pct = (int)Math.Round((double)Math.Clamp(b.EvidenceScore, 0m, 1m) * 100);
                    var tone = pct >= 70 ? "ok" : pct >= 45 ? "warn" : "danger";
                    return new OvLeaderFactor(b.BranchDisplayName, pct, tone);
                })
                .ToList();
        }
    }

    // What Could Flip It: factors that are contradicted or unresolved — the live risks that could change
    // the ranking. Contradictions first, then unsupported factors. Derived from the factor inventory.
    internal sealed record OvFlipPoint(string Name, string StateLabel, string Tone);
    internal IReadOnlyList<OvFlipPoint> OvWhatCouldFlipIt
    {
        get
        {
            var factors = DfiFactors;
            if (factors.Count == 0) return [];
            var flips = new List<OvFlipPoint>();
            foreach (var f in factors.Where(f => f.Contradictions.Count > 0))
                flips.Add(new OvFlipPoint(f.FactorName, "Contradicted", "danger"));
            foreach (var f in factors.Where(f => f.Contradictions.Count == 0))
            {
                var (state, _) = DfiFactorState(f);
                if (state != "SUPPORTED")
                    flips.Add(new OvFlipPoint(f.FactorName, state == "SUPPLIED" ? "Unverified" : "Unsupported", state == "SUPPLIED" ? "warn" : "danger"));
            }
            return flips.Take(5).ToList();
        }
    }

    // Decision Structure (CHR / APR): hierarchy node count and atomic-proposition resolution, from the
    // surviving branch tree and the evidence-graph proposition support edges.
    internal int OvHierarchyNodeCount => SurvivingBranches.Count;
    internal int OvAprResolvedCount => _evidenceGraph?.Propositions.Count(p => p.Support.Count > 0) ?? 0;
    internal int OvAprTotalCount => _evidenceGraph?.Propositions.Count ?? 0;
    internal int OvAprResolvedPct => OvAprTotalCount <= 0 ? 0 : (int)Math.Round((double)OvAprResolvedCount / OvAprTotalCount * 100);

    // Latest Intelligence (HRR / AER): the most recent decision-affecting change driver, with the
    // affected factor and direction. Null when no change events have been recorded yet.
    internal CdcDriver? OvLatestIntelligence => CdcKeyDrivers.FirstOrDefault();

    // Document Intelligence overview stats, from the matter evidence graph.
    internal sealed record OvDocStat(string Label, string Value);
    internal IReadOnlyList<OvDocStat> OvDocumentIntelligence
    {
        get
        {
            if (_evidenceGraph is null) return [];
            var verified = _evidenceGraph.Evidence.Count(e =>
                string.Equals(e.EvidenceStateCode, "VERIFIED", StringComparison.OrdinalIgnoreCase)
                || string.Equals(e.EvidenceStateCode, "SUPPORTED", StringComparison.OrdinalIgnoreCase));
            var contradictions = _evidenceGraph.Propositions.Sum(p =>
                p.Support.Count(s => string.Equals(s.RelationshipTypeCode, "CONTRADICTS", StringComparison.OrdinalIgnoreCase)));
            return
            [
                new("Documents", _evidenceGraph.DocumentCount.ToString()),
                new("Source Assertions", _evidenceGraph.SourceAssertions.Count.ToString()),
                new("Evidence Bindings", _evidenceGraph.Evidence.Count.ToString()),
                new("Fact Propositions", _evidenceGraph.Propositions.Count.ToString()),
                new("Verified", verified.ToString()),
                new("Contradictions", contradictions.ToString()),
            ];
        }
    }

    // Decision Readiness blockers: the live, material items preventing an established decision.
    internal IReadOnlyList<string> OvReadinessBlockers
    {
        get
        {
            var blockers = new List<string>();
            foreach (var f in DfiFactors.Where(f => f.Contradictions.Count > 0).Take(3))
                blockers.Add($"{f.FactorName} has conflicting sources");
            if (DfiMissingFactorCount > 0)
                blockers.Add($"{DfiMissingFactorCount} decision factor(s) missing a verified value");
            if (TotalEvidenceCount == 0)
                blockers.Add("No independently verified evidence admitted yet");
            var topRisk = OvOutcomes.FirstOrDefault(o => o.MainVulnerabilities > 0);
            if (topRisk is not null)
                blockers.Add($"{topRisk.Title} carries {topRisk.MainVulnerabilities} unresolved risk(s)");
            return blockers.Take(4).ToList();
        }
    }

    internal static string OvRelativeTime(DateTime when)
    {
        var delta = DateTime.UtcNow - when.ToUniversalTime();
        if (delta < TimeSpan.Zero) delta = TimeSpan.Zero;
        if (delta.TotalMinutes < 1) return "just now";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes} min ago";
        if (delta.TotalHours < 24) return $"{(int)delta.TotalHours} hour{((int)delta.TotalHours == 1 ? "" : "s")} ago";
        return $"{(int)delta.TotalDays} day{((int)delta.TotalDays == 1 ? "" : "s")} ago";
    }

    internal void SetOverviewView(string view) => _ovComparisonView = view;


    // ── Milestone B/C: per-candidate REQUIRED-dependency satisfaction ─────────────────────────────
    // Joins the existing Candidate×Factor relationships to the factor inventory (by FactorId) so the
    // Competition tab can show, per ranked candidate, whether every REQUIRED dependency is actually
    // established. This enforces the safeguard from the specification: strong support for two of three
    // required propositions must NOT present the third as established. Pure presentation over data the
    // pipeline already produced — no fabricated values, no extra model call.
    internal sealed record DfiRequiredDependency(string FactorName, string State, string Tone, string? Obligation);
    internal sealed record DfiCandidateDependencySummary(
        string CandidateTitle,
        IReadOnlyList<DfiRequiredDependency> Required,
        int Established,
        int Total,
        bool HasUnresolvedRequired);

    // Map a factor's validated binding/verification state onto a compact required-dependency state.
    private static (string State, string Tone) DfiFactorState(WideFactorDto f)
    {
        if (string.Equals(f.BindingAdmissibility, "REJECTED", StringComparison.OrdinalIgnoreCase))
            return ("UNRESOLVED", "danger");
        if (string.Equals(f.Availability, "MISSING", StringComparison.OrdinalIgnoreCase))
            return ("UNRESOLVED", "danger");
        if (string.Equals(f.VerificationStatus, "VERIFIED", StringComparison.OrdinalIgnoreCase)
            || string.Equals(f.EvidenceAdmissionState, "SUPPORTED", StringComparison.OrdinalIgnoreCase)
            || string.Equals(f.EvidenceAdmissionState, "VERIFIED", StringComparison.OrdinalIgnoreCase))
            return ("SUPPORTED", "ok");
        if (string.Equals(f.VerificationStatus, "SUPPLIED", StringComparison.OrdinalIgnoreCase))
            return ("SUPPLIED", "warn");
        return ("UNRESOLVED", "warn");
    }

    // Compute a required-dependency summary for a single candidate title directly from the factor
    // relationship inventory. Relationships join by candidate TITLE, so this works for both scored
    // competition candidates AND normalized proposed candidates (even when _response.Candidates is
    // empty). Returns null when the candidate has no required dependencies.
    private DfiCandidateDependencySummary? BuildDependencySummaryForTitle(string candidateTitle)
    {
        if (string.IsNullOrWhiteSpace(candidateTitle)) return null;
        var factorsById = DfiFactors
            .GroupBy(f => f.FactorId, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var required = DfiRelations
            .Where(rel => rel.IsRequired
                && string.Equals(rel.CandidateTitle, candidateTitle, StringComparison.OrdinalIgnoreCase))
            .GroupBy(rel => rel.FactorId, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .Select(rel =>
            {
                if (!factorsById.TryGetValue(rel.FactorId, out var f))
                    return new DfiRequiredDependency(rel.FactorName, "UNRESOLVED", "warn", null);
                // Milestone B: a REQUIRED link with no validated legal/logical basis (lexical only)
                // must not be presented as established, even if the factor value is supplied.
                if (!rel.IsValidatedRelation)
                    return new DfiRequiredDependency(
                        rel.FactorName, "UNVALIDATED", "danger",
                        "Dependency relationship is not validated — establish the legal or logical basis before treating it as required.");
                var (state, tone) = DfiFactorState(f);
                var obligation = string.Equals(state, "SUPPORTED", StringComparison.OrdinalIgnoreCase)
                    ? null
                    : (f.VerificationObligation ?? f.MissingInformation);
                return new DfiRequiredDependency(rel.FactorName, state, tone, obligation);
            })
            .OrderBy(d => string.Equals(d.State, "SUPPORTED", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
            .ToArray();

        if (required.Length == 0) return null;
        var established = required.Count(d => string.Equals(d.State, "SUPPORTED", StringComparison.OrdinalIgnoreCase));
        return new DfiCandidateDependencySummary(
            candidateTitle,
            required,
            established,
            required.Length,
            required.Any(d => !string.Equals(d.State, "SUPPORTED", StringComparison.OrdinalIgnoreCase)));
    }

    internal IReadOnlyList<DfiCandidateDependencySummary> DfiCandidateDependencySummaries
    {
        get
        {
            var summaries = new List<DfiCandidateDependencySummary>();
            foreach (var cand in FinalRankedCandidates)
            {
                // Relationships join by candidate title (both derive from the candidate display name).
                var summary = BuildDependencySummaryForTitle(cand.DisplayName);
                if (summary is not null) summaries.Add(summary);
            }
            return summaries;
        }
    }

    // Factor Inventory review grid state + helpers.
    internal string _dfiFactorFilter = "All";
    internal string? _dfiSelectedFactorId;
    internal Guid? _dfiSelectedBranchId;
    internal WideBranchDto? DfiSelectedBranch => SurvivingBranches.FirstOrDefault(b => b.WideBranchId == _dfiSelectedBranchId);
    internal static readonly string[] DfiFactorFilters = ["All", "Needs review", "Missing"];

    // ── Hierarchy workspace (3-column decision explorer) ──────────────────────────
    internal string _hxDetailTab = "Overview";
    internal static readonly string[] HxDetailTabs = ["Overview", "Sub-questions", "Dependencies", "Evidence", "Analysis", "Notes"];
    internal string _hxSearch = "";
    internal readonly HashSet<Guid> _hxCollapsedGroups = new();

    // L1 branches act as expandable groups; every deeper branch is a descendant listed under its L1 root.
    internal IReadOnlyList<WideBranchDto> HxRootBranches =>
        SurvivingBranches.Where(b => b.LevelNumber == 1).OrderBy(b => b.SortOrder).ToArray();

    // All descendants of a given L1 root (any depth), ordered by level then sort, filtered by the search box.
    internal IReadOnlyList<WideBranchDto> HxDescendants(WideBranchDto root)
    {
        var byId = SurvivingBranches.ToDictionary(b => b.WideBranchId);
        bool DescendsFrom(WideBranchDto b)
        {
            var cur = b;
            var guard = 0;
            while (cur.ParentWideBranchId is { } pid && byId.TryGetValue(pid, out var parent) && guard++ < 20)
            {
                if (parent.WideBranchId == root.WideBranchId) return true;
                cur = parent;
            }
            return false;
        }
        return SurvivingBranches
            .Where(b => b.LevelNumber > 1 && DescendsFrom(b) && HxMatchesSearch(b))
            .OrderBy(b => b.LevelNumber).ThenBy(b => b.SortOrder)
            .ToArray();
    }

    private bool HxMatchesSearch(WideBranchDto b) =>
        string.IsNullOrWhiteSpace(_hxSearch)
        || b.DisplayName.Contains(_hxSearch, StringComparison.OrdinalIgnoreCase)
        || (b.Interpretation?.Contains(_hxSearch, StringComparison.OrdinalIgnoreCase) ?? false);

    internal bool HxRootVisible(WideBranchDto root) =>
        HxMatchesSearch(root) || HxDescendants(root).Count > 0;

    // Direct children of a branch — rendered as the "Related sub-questions" list in the detail panel.
    internal IReadOnlyList<WideBranchDto> HxChildren(WideBranchDto b) =>
        SurvivingBranches.Where(x => x.ParentWideBranchId == b.WideBranchId)
            .OrderBy(x => x.SortOrder).ToArray();

    // A branch is "complete" when it is grounded by evidence; otherwise it needs work.
    internal static bool HxComplete(WideBranchDto b) => b.EvidenceCount > 0;
    internal static string HxStatusLabel(WideBranchDto b) => HxComplete(b) ? "Complete" : "Incomplete";
    internal static string HxStatusTone(WideBranchDto b) => HxComplete(b) ? "ok" : "warn";

    internal void HxSelect(WideBranchDto b)
