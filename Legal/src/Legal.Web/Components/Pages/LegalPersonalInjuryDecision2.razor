    // Surface the funnel's reassessment status so the attorney never reads the old ranking as current.
    private void ApplyLegalAuthorityReviewResult(Legal.Application.Features.Intelligence.Decision.Lpi.LpiIntegrationResult? result, string verb)
    {
        if (result is null)
        {
            SetLegalAuthorityBanner($"Proposition {verb}, but no result was returned.", isError: true);
            return;
        }
        var (isError, message) = result.StatusCode switch
        {
            "EvaluationPending" => (false, $"Proposition {verb}. POLOXI Core reassessment is enqueued — the displayed ranking will update once recompetition completes."),
            "EvaluationFailed" => (true, $"Proposition {verb}, but the reassessment failed to enqueue. The displayed ranking does NOT yet reflect this change. {result.Explanation}"),
            "Applied" => (false, $"Proposition {verb}. {result.Explanation}"),
            "Idempotent" => (false, $"Proposition already {verb} (no duplicate applied)."),
            "Rejected" => (true, $"Could not {verb} the proposition: {result.Explanation}"),
            _ => (!result.Applied, result.Explanation)
        };
        SetLegalAuthorityBanner(message, isError);
    }

    private void SetLegalAuthorityBanner(string message, bool isError)
    {
        _legalAuthorityBanner = message;
        _legalAuthorityBannerError = isError;
    }

