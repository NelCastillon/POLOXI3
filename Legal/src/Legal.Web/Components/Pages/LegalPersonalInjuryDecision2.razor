    // Proposition workspace (drag/drop) wired to the real Human Intelligence LPI pipeline.
    // The AttorneyPropositionWorkspace component is data-driven. It surfaces the live L1 candidate nodes,
    // previews a dropped proposition through PreviewLegalAttorneyInputAsync (the authoritative POLOXI
    // scoring path), and commits it through CommitLegalAttorneyInputAsync so the candidate's final
    // decision outcome actually moves. No fabricated scores are presented as real outcomes.
    internal Guid? _apwSelectedCandidateId;
    private Guid? _apwLastCommittedNodeId;

    internal IReadOnlyList<AttorneyPropositionWorkspace.WorkspaceCandidate> ApwCandidates
    {
        get
        {
            // Single source of truth: the workspace "FINAL OUTCOME OF CANDIDATE" cards must show the SAME
            // candidates and support values as the Overview tab (FinalRankedCandidates / WideCandidateDto).
            // Each Overview candidate is mapped to its matching DB-backed L1 decision node (by name) so the
            // drag/drop Human-Intelligence LPI preview/commit still has a real DecisionNodeId to target.
            // Fall back to the persisted L1 nodes only when no Overview candidates exist yet.
            var overview = FinalRankedCandidates;
            if (overview.Count == 0)
            {
                var nodes = AdiCandidates;
                var fallback = new List<AttorneyPropositionWorkspace.WorkspaceCandidate>(nodes.Count);
                for (var i = 0; i < nodes.Count; i++)
                {
                    var node = nodes[i];
                    fallback.Add(new AttorneyPropositionWorkspace.WorkspaceCandidate(
                        node.DecisionNodeId,
                        $"C{i + 1}",
                        string.IsNullOrWhiteSpace(node.NodeText) ? node.CanonicalKey : node.NodeText,
                        AdiNodeScore(node)));
                }
                return fallback;
            }

            // Match percent rendered on the Overview cards: the raw CompositeScore as a percentage
            // (the Overview renders @candidate.CompositeScore.ToString("P0")), so the workspace scores
            // line up exactly with the Overview / Decision-hierarchy values.
            var l1Nodes = AdiCandidates;
            var result = new List<AttorneyPropositionWorkspace.WorkspaceCandidate>(overview.Count);
            for (var i = 0; i < overview.Count; i++)
            {
                var c = overview[i];
                var match = l1Nodes.FirstOrDefault(n =>
                    string.Equals(string.IsNullOrWhiteSpace(n.NodeText) ? n.CanonicalKey : n.NodeText,
                        c.DisplayName, StringComparison.OrdinalIgnoreCase));
                // Keep a stable, candidate-specific id even when no persisted L1 node matches, so selection
                // state stays consistent; drag/drop commit is only wired when a real node id is present.
                var nodeId = match?.DecisionNodeId ?? c.WideCandidateId;
                var matchPct = Math.Round(c.CompositeScore * 100m, 1);
                result.Add(new AttorneyPropositionWorkspace.WorkspaceCandidate(
                    nodeId,
                    $"C{i + 1}",
                    c.DisplayName,
                    matchPct));
            }
            return result;
        }
    }

    // Live Evaluation-tree columns built from the SAME DB-backed branch data as the "Decision hierarchy"
    // tree (SurvivingBranches / WideBranch). L1 = decision dimensions, L2 = supporting factors, L3 =
    // propositions. Returns null when no live hierarchy exists so the component keeps its sample columns.
    internal IReadOnlyList<AttorneyPropositionWorkspace.TreeColumn>? ApwTreeColumns
    {
        get
        {
            var branches = SurvivingBranches;
            if (branches.Count == 0)
            {
                return null;
            }

            static string NodeClass(int level) => level switch
            {
                1 => "apw-node--muted",
                2 => "apw-node--selected",
                _ => "apw-node--prop",
            };

            // Map every branch by id so a child can resolve its parent name and its root L1 family (for the
            // shared lineage-color accent). The root-family index is the sort position of the ancestor L1.
            var byId = branches.ToDictionary(b => b.WideBranchId);
            var l1Order = branches
                .Where(b => b.LevelNumber == 1)
                .OrderBy(b => b.SortOrder)
                .Select((b, i) => (b.WideBranchId, i))
                .ToDictionary(x => x.WideBranchId, x => x.i);

            Guid? RootL1Id(WideBranchDto b)
            {
                var cur = b;
                while (cur.LevelNumber > 1 && cur.ParentWideBranchId is { } pid && byId.TryGetValue(pid, out var parent))
                    cur = parent;
                return cur.LevelNumber == 1 ? cur.WideBranchId : null;
            }

            AttorneyPropositionWorkspace.TreeNode ToNode(WideBranchDto b)
            {
                var lvl = b.LevelNumber == 1 ? "L1"
                    : b.LevelNumber == 2 ? "L2"
                    : $"L{b.LevelNumber}";
                var sub = string.IsNullOrWhiteSpace(b.Interpretation)
                    ? (HxComplete(b) ? "Complete" : "Incomplete")
                    : b.Interpretation;
                var score = Math.Round(b.Confidence * 100m, 0);
                string? parentName = b.ParentWideBranchId is { } pid && byId.TryGetValue(pid, out var parent)
                    ? parent.DisplayName
                    : null;
                var lineageIndex = RootL1Id(b) is { } rootId && l1Order.TryGetValue(rootId, out var li) ? li : -1;
                return new AttorneyPropositionWorkspace.TreeNode(lvl, b.DisplayName, sub, score, NodeClass(b.LevelNumber))
                {
                    NodeId = b.WideBranchId,
                    ParentId = b.ParentWideBranchId,
                    ParentName = parentName,
                    LineageIndex = lineageIndex,
                };
            }

            var columns = new List<AttorneyPropositionWorkspace.TreeColumn>();
            // Render every level actually present in SurvivingBranches (L1, L2, L3, L4, … Ln). The Wide2
            // pipeline allows depth beyond L3 (AbsoluteDepthCeiling), so the tree must not hard-cap at 3 —
            // otherwise any deeper branch the engine produced would be silently dropped from this view.
            var levels = branches
                .Select(b => b.LevelNumber)
                .Distinct()
                .OrderBy(level => level);
            foreach (var level in levels)
            {
                var nodes = branches
                    .Where(b => b.LevelNumber == level)
                    .OrderBy(b => b.SortOrder)
                    .Select(ToNode)
                    .ToList();
                if (nodes.Count == 0)
                {
                    continue;
                }

                var head = level switch
                {
                    1 => "L1 · Decision dimension",
                    2 => "L2 · Supporting factor",
                    3 => "L3 · Propositions",
                    _ => $"L{level} · Sub-propositions",
                };
                columns.Add(new AttorneyPropositionWorkspace.TreeColumn(level, head, nodes));
            }

            return columns.Count > 0 ? columns : null;
        }
    }

    private async Task ApwEnsureSessionAsync(Guid matterId)
    {
        if (_adiSessionId != Guid.Empty) return;
        try
        {
            var sessions = await Api.GetLegalDecisionMatterSessionsAsync(matterId);
            _adiSessionId = sessions
                .OrderByDescending(s => s.CreatedDateUtc)
                .Select(s => s.DecisionSessionId)
                .FirstOrDefault();
        }
        catch
        {
            _adiSessionId = Guid.Empty;
        }
    }

    private async Task<Legal.Application.Features.Intelligence.Decision.PlacementAnalysis?> ApwAnalyzePlacementAsync(
        Guid matterId, Guid candidateNodeId, int level)
    {
        var siblings = HiNodes.Where(n => n.NodeLevel == level && n.ParentNodeId == candidateNodeId)
            .OrderBy(n => n.PlacementKey).ToList();
        Guid? prev = siblings.Count > 0 ? siblings[0].DecisionNodeId : null;
        Guid? next = siblings.Count > 1 ? siblings[1].DecisionNodeId : null;

        return await Api.AnalyzeLegalAttorneyPlacementAsync(matterId, new(
            matterId, candidateNodeId, candidateNodeId, level, prev, next));
    }

    internal async Task<AttorneyPropositionWorkspace.WorkspacePreviewResult?> ApwPreviewAsync(
        AttorneyPropositionWorkspace.WorkspacePreviewRequest request)
    {
        if (MatterId is not { } matterId) return null;
        await ApwEnsureSessionAsync(matterId);

        var level = request.Level; // hierarchy level of the insertion slot the attorney selected
        var placement = await ApwAnalyzePlacementAsync(matterId, request.CandidateId, level);
        var confirmedValue = placement?.SuggestedMidpoint ?? 50m;

        var preview = await Api.PreviewLegalAttorneyInputAsync(matterId, new(
            matterId, _adiSessionId, request.CandidateId, request.CandidateId, level,
            request.Text, confirmedValue, placement?.PreviousSiblingId, placement?.NextSiblingId, AdiBaseSnapshotId));

        if (preview is null) return null;

        return new AttorneyPropositionWorkspace.WorkspacePreviewResult(
            preview.CurrentCandidateScore,
            preview.ProjectedCandidateScore,
            preview.CandidateScoreDelta,
            preview.ExplanationSummary,
            preview.ScoreProjectionAdvisory);
    }

    internal async Task<AttorneyPropositionWorkspace.WorkspaceApplyResult?> ApwApplyAsync(
        AttorneyPropositionWorkspace.WorkspaceApplyRequest request)
    {
        if (MatterId is not { } matterId) return null;
        await ApwEnsureSessionAsync(matterId);

        var level = request.Level; // hierarchy level of the insertion slot the attorney selected
        var placement = await ApwAnalyzePlacementAsync(matterId, request.CandidateId, level);
        var confirmedValue = placement?.SuggestedMidpoint ?? 50m;

        var preview = await Api.PreviewLegalAttorneyInputAsync(matterId, new(
            matterId, _adiSessionId, request.CandidateId, request.CandidateId, level,
            request.Text, confirmedValue, placement?.PreviousSiblingId, placement?.NextSiblingId, AdiBaseSnapshotId));

        var result = await Api.CommitLegalAttorneyInputAsync(matterId, new(
            matterId, request.CandidateId, request.CandidateId, "Proposition", level, request.Text, null,
            confirmedValue, placement?.SuggestedMidpoint,
            placement?.PreviousSiblingId, placement?.PreviousSiblingValue,
            placement?.NextSiblingId, placement?.NextSiblingValue,
            placement?.MethodCode ?? "BoundedEntry",
            preview?.PreviewToken ?? Guid.NewGuid(), AdiBaseSnapshotId,
            ExpectedHierarchyVersion: 0, IdempotencyKey: Guid.NewGuid(),
            GovernancePolicyCode: null, RequestApproval: false));

        // Reload the authoritative Human Intelligence projection so candidate scores reflect the commit.
        await LoadHumanIntelligenceAsync();
        if (result is not null)
            _hiSelectedNodeId = result.DecisionNodeId;
        _apwLastCommittedNodeId = result?.DecisionNodeId;

        var candidate = HiNodes.FirstOrDefault(n => n.DecisionNodeId == request.CandidateId);
        var finalScore = (candidate is not null ? AdiNodeScore(candidate) : null)
            ?? preview?.ProjectedCandidateScore
            ?? confirmedValue;

        return new AttorneyPropositionWorkspace.WorkspaceApplyResult(
            finalScore,
            preview?.CandidateScoreDelta ?? 0m,
            preview?.ScoreProjectionAdvisory ?? true,
            preview?.ExplanationSummary);
    }

