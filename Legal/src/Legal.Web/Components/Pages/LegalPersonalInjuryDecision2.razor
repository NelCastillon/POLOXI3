@page "/legal/personalinjury_decision2"
@using Legal.Application.Features.Intelligence
@using Legal.Application.Features.Intelligence.Decision
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject DecisionOverviewStateCache OverviewState
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment
@inject IJSRuntime JS

<LegalWorkspace ExtraClass="intel-compact">
    <div class="poloxi-page">
        <header class="poloxi-hero">
            <div class="poloxi-hero-icon"><i class="bi bi-diagram-3"></i></div>
            <div class="poloxi-hero-content">
                <span>Powered by the Poloxi.ai algorithm</span>
                <h1>Structurally superior reasoning for ambiguity and complex use cases</h1>
                <p>Poloxi.ai combines proven mathematical formulas with structured reasoning to explore competing interpretations, narrow uncertainty, and produce targeted answers instead of forcing a single premature assumption.</p>
                <div class="poloxi-foundations" aria-label="Poloxi.ai foundations">
                    <span><i class="bi bi-calculator" aria-hidden="true"></i> Mathematical rigor</span>
                    <span><i class="bi bi-diagram-3" aria-hidden="true"></i> Structured reasoning</span>
                    <span><i class="bi bi-signpost-split" aria-hidden="true"></i> Ambiguity resolution</span>
                </div>
            </div>
        </header>

        <section class="dfi-console" aria-label="Decision Intelligence console">
            <div class="dfi-console-topbar">
                <div class="dfi-brand">
                    <span class="dfi-brand-mark"><i class="bi bi-bank2" aria-hidden="true"></i></span>
                    <div class="dfi-crumbs dfi-crumbs--header">
                        MATTERS / @DfiPracticeAreaLabel / DECISION INTELLIGENCE
                        @if (_matter is not null)
                        {
                            <a class="dfi-crumbs-matter-link" href="@($"/legal/matters/{_matter.DecisionMatterId}")">
                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> @_matter.Title
                            </a>
                        }
                    </div>
                </div>
                <div class="dfi-topbar-actions">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                </div>
            </div>

            <div class="dfi-console-body">
                <div class="dfi-matter-head">
                    <div>
                        <h2 class="dfi-matter-title">@DfiMatterTitle</h2>
                        <p class="dfi-matter-sub">@DfiMatterSubtitle</p>
                    </div>
                    <span class="dfi-pill dfi-pill-@(DfiReviewRequired ? "warn" : "ok")">@(DfiReviewRequired ? "Review required" : "Decision ready")</span>
                </div>
                <div class="dfi-tag-row">
                    @if (!string.IsNullOrWhiteSpace(DfiJurisdictionTag))
                    {
                        <span class="dfi-tag dfi-tag-info">@DfiJurisdictionTag</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(DfiPostureTag))
                    {
                        <span class="dfi-tag">@DfiPostureTag</span>
                    }
                    <span class="dfi-tag dfi-tag-@(TotalEvidenceCount > 0 ? "ok" : "warn")">@(TotalEvidenceCount > 0 ? "Evidence admitted" : "Evidence unverified")</span>
                </div>

                @if (DfiShowCommandCenter)
                {
                    <div class="dfi-kpi-grid @(DfiLiveProvisional ? "dfi-kpi-grid--analyzing" : null)">
                        <div class="dfi-kpi dfi-kpi--click @(_ovKpiFilter is null ? "dfi-kpi--active" : "")" @onclick='() => SetOvKpiFilter("__all")' title="Show all scored candidates">
                            <span class="dfi-kpi-val">@DfiScoredCandidateCount</span>
                            <span class="dfi-kpi-lbl">Scored candidates @if (DfiLiveProvisional) {<span class="dfi-kpi-live">analyzing…</span>}</span>
                        </div>
                        <div class="dfi-kpi dfi-kpi--click @(_ovKpiFilter == "dependencies" ? "dfi-kpi--active" : "")" @onclick='() => SetOvKpiFilter("dependencies")' title="Filter outcomes that have critical dependencies">
                            <span class="dfi-kpi-val">@DfiDependencyCount</span>
                            <span class="dfi-kpi-lbl">Dependencies</span>
                        </div>
                        <div class="dfi-kpi dfi-kpi--click @(_ovKpiFilter == "evidence" ? "dfi-kpi--active" : "")" @onclick='() => SetOvKpiFilter("evidence")' title="Filter evidence-backed outcomes">
                            <span class="dfi-kpi-val">@DfiEvidenceCoveragePct.ToString("P0")</span>
                            <span class="dfi-kpi-lbl">Evidence coverage</span>
                        </div>
                        <div class="dfi-kpi dfi-kpi--click @(_ovKpiFilter == "leader" ? "dfi-kpi--active" : "")" @onclick='() => SetOvKpiFilter("leader")' title="Filter to the current leader">
                            <span class="dfi-kpi-val">@DfiTopKStabilityPct.ToString("P0")</span>
                            <span class="dfi-kpi-lbl">Top-3 stability</span>
                        </div>
                    </div>
                }

                @if (DfiShowIntegrityAlert)
                {
                    <div class="dfi-alert">
                        <div class="dfi-alert-head"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Decision integrity alert</div>
                        <p class="dfi-alert-body">@DfiIntegrityMessage</p>
                        <span class="dfi-pill dfi-pill-warn">Attorney review required</span>
                    </div>
                }

                @if (DfiShowWorkspace)
                {
                <div class="dfi-workspace">
                    @if (DfiShowCommandCenter)
                    {
                    <h3 class="dfi-workspace-title">Decision workspace</h3>
                    <div class="dfi-tabs" role="tablist">
                        @foreach (var tab in DfiTabs)
                        {
                            <button type="button" role="tab"
                                    class="dfi-tab @(_dfiTab == tab ? "dfi-tab--active" : "")"
                                    @onclick="() => SelectDfiTab(tab)">@tab</button>
                        }
                        <a class="dfi-tab dfi-tab--link"
                           href="@($"/legal/casecommandcenter{(MatterId is { } ccId ? $"?matterId={ccId}" : string.Empty)}")">
                            <i class="bi bi-grid-1x2" aria-hidden="true"></i> Case Command Center
                        </a>
                        <a class="dfi-tab dfi-tab--link"
                           href="@($"/legal/providercaseview{(MatterId is { } pvId ? $"?matterId={pvId}" : string.Empty)}")">
                            <i class="bi bi-shield-lock" aria-hidden="true"></i> Provider Case Portal
                        </a>
                        <a class="dfi-tab dfi-tab--link" href="/integrations/clio">
                            <i class="bi bi-plug" aria-hidden="true"></i> Clio Integration
                        </a>
                    </div>
                    }

                    <div class="dfi-tabpanel">
                        @if (DfiShowLiveExecution)
                        {
                            <div class="dfi-live-exec dfi-pipeline @(DfiLiveProvisional ? "dfi-live-exec--running" : "dfi-live-exec--done")" role="status" aria-live="polite">
                                <div class="dfi-pipeline-topbar">
                                    <div class="dfi-pipeline-brand">
                                        <span class="dfi-pipeline-brand-mark" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
                                        <div class="dfi-pipeline-brand-txt">
                                            <span class="dfi-pipeline-title">Decision processing pipeline</span>
                                            <span class="dfi-pipeline-sub">Real-time execution status and progress</span>
                                        </div>
                                        <span class="dfi-pipeline-live @(DfiLiveProvisional ? "is-live" : "is-done")">
                                            <span class="dfi-pipeline-live-dot" aria-hidden="true"></span>@(DfiLiveProvisional ? "LIVE" : "DONE")
                                        </span>
                                    </div>
                                    <div class="dfi-pipeline-metrics">
                                        @if (_liveFeedConnected)
                                        {
                                            <span class="dfi-pipeline-flag" title="Live feed connected"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> Live</span>
                                        }
                                        else if (DfiLiveProvisional)
                                        {
                                            <span class="dfi-pipeline-flag dfi-pipeline-flag--offline" title="@(_liveFeedError ?? "Live feed not connected — showing estimated progress.")"><i class="bi bi-wifi-off" aria-hidden="true"></i> Offline</span>
                                        }
                                        <span title="Competing outcomes"><i class="bi bi-list-ul" aria-hidden="true"></i> @DfiLiveCompetingOutcomes</span>
                                        <span title="Identified factors"><i class="bi bi-diagram-2" aria-hidden="true"></i> @DfiLiveFactorCount</span>
                                        <span title="Admitted evidence"><i class="bi bi-chat-square-text" aria-hidden="true"></i> @DfiLiveEvidenceCount</span>
                                        <span title="Elapsed"><i class="bi bi-stopwatch" aria-hidden="true"></i> @DfiPipelineElapsed</span>
                                    </div>
                                </div>

                                <ol class="dfi-pipeline-rail">
                                    @for (var si = 0; si < DfiPipelineStages.Count; si++)
                                    {
                                        var stage = DfiPipelineStages[si];
                                        var oneBased = si + 1;
                                        var state = oneBased < DfiPipelineActiveIndex ? "done"
                                            : oneBased == DfiPipelineActiveIndex ? (DfiLiveProvisional ? "active" : "done")
                                            : "pending";
                                        <li class="dfi-pipeline-node dfi-pipeline-node--@state">
                                            @if (si < DfiPipelineStages.Count - 1)
                                            {
                                                <span class="dfi-pipeline-connector" aria-hidden="true"></span>
                                            }
                                            <span class="dfi-pipeline-marker" aria-hidden="true">
                                                @if (state == "done")
                                                {
                                                    <i class="bi bi-check-lg"></i>
                                                }
                                                else if (state == "active")
                                                {
                                                    <i class="bi bi-arrow-repeat dfi-pipeline-spin"></i>
                                                }
                                                else
                                                {
                                                    @oneBased
                                                }
                                            </span>
                                            <span class="dfi-pipeline-node-title">@oneBased @stage.Title</span>
                                            <span class="dfi-pipeline-node-sub">@stage.Subtitle</span>
                                            @if (state == "active")
                                            {
                                                <span class="dfi-pipeline-node-detail" title="@DfiPipelineActiveDetail">
                                                    <span class="dfi-pipeline-node-detail-dot" aria-hidden="true"></span>@DfiPipelineActiveDetail
                                                </span>
                                            }
                                        </li>
                                    }
                                </ol>

                                <div class="dfi-pipeline-progress">
                                    <span class="dfi-pipeline-progress-label">@DfiPipelineStatusLine</span>
                                    <div class="dfi-pipeline-progress-track"><div class="dfi-pipeline-progress-fill" style="width:@(DfiPipelineProgressPct)%"></div></div>
                                    <span class="dfi-pipeline-progress-pct">@DfiPipelineProgressPct%</span>
                                </div>

                                <ol class="dfi-live-exec-log">
                                    @foreach (var step in _livePhaseLog)
                                    {
                                        <li class="dfi-live-exec-step @(step.IsProvisional ? "" : "dfi-live-exec-step--done")">
                                            <span class="dfi-live-exec-step-ico" aria-hidden="true">
                                                <i class="bi @(step.IsProvisional ? "bi-arrow-repeat" : "bi-check-circle-fill")"></i>
                                            </span>
                                            <span class="dfi-live-exec-step-txt">
                                                <strong>@step.Label</strong>
                                                @if (!string.IsNullOrWhiteSpace(step.Message) && !string.Equals(step.Message, step.Label, StringComparison.Ordinal))
                                                {
                                                    <span class="dfi-live-exec-step-msg">@step.Message</span>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ol>

                                @if (_documentActivationLog.Count > 0)
                                {
                                    <div class="dfi-doclog">
                                        <button type="button" class="dfi-doclog-toggle" @onclick="() => _showDocumentActivationLog = !_showDocumentActivationLog" aria-expanded="@_showDocumentActivationLog">
                                            <i class="bi @(_showDocumentActivationLog ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i>
                                            <span class="dfi-doclog-toggle-txt">Document activation log</span>
                                            <span class="dfi-doclog-count">@_documentActivationLog.Count</span>
                                        </button>
                                        @if (_showDocumentActivationLog)
                                        {
                                            <ul class="dfi-doclog-list">
                                                @foreach (var doc in _documentActivationLog)
                                                {
                                                    <li class="dfi-doclog-item @(doc.Succeeded ? "dfi-doclog-item--ok" : "dfi-doclog-item--warn")">
                                                        <span class="dfi-doclog-ico" aria-hidden="true">
                                                            <i class="bi @(doc.Succeeded ? "bi-file-earmark-check" : "bi-file-earmark-x")"></i>
                                                        </span>
                                                        <span class="dfi-doclog-body">
                                                            <span class="dfi-doclog-name" title="@doc.FileName">@doc.FileName</span>
                                                            <span class="dfi-doclog-action">@doc.ActionLabel</span>
                                                            <span class="dfi-doclog-meta">
                                                                <span title="Passages read"><i class="bi bi-layout-text-window" aria-hidden="true"></i> @doc.PassagesRead</span>
                                                                <span title="Evidence extracted"><i class="bi bi-chat-square-text" aria-hidden="true"></i> @doc.EvidenceExtracted</span>
                                                                @if (doc.ConceptBound)
                                                                {
                                                                    <span class="dfi-doclog-tag dfi-doclog-tag--bound" title="Bound to an applicable domain concept"><i class="bi bi-diagram-3" aria-hidden="true"></i> @FormatDomainPack(doc.DomainPackCode)</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="dfi-doclog-tag dfi-doclog-tag--unbound" title="No domain concept bound">Unbound</span>
                                                                }
                                                            </span>
                                                        </span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @switch (_dfiTab)
                        {
                            case "Overview":
                                @if (OvOutcomes.Count > 0)
                                {
                                    <div class="ov-landscape">
                                        @{ var ovLeader = OvOutcomes[0]; }

                                        @* ── Decision KPI strip ───────────────────────────────────────── *@
                                        @* ── Decision Status trust strip ──────────────────────────────────────────── *@
                                        <div class="ov-status">
                                            <div class="ov-status-lead">
                                                <span class="ov-status-state ov-status-state--@OvDecisionStateTone">@OvDecisionStateLabel.ToUpperInvariant()</span>
                                                <span class="ov-status-headline">C@(ovLeader.Index) @ovLeader.Title leads at @ovLeader.SupportPct% support</span>
                                            </div>
                                            <div class="ov-status-chips">
                                                @foreach (var chip in OvDecisionStatusChips)
                                                {
                                                    <div class="ov-status-chip ov-status-chip--@chip.Tone" title="@chip.Tooltip">
                                                        <span class="ov-status-chip-val">@chip.Value</span>
                                                        <span class="ov-status-chip-lbl">@chip.Label</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="ov-outcomes-head">
                                            <div>
                                                <h4 class="ov-section-title">Decision Outcomes</h4>
                                                <p class="ov-section-sub">The most supportable outcomes for the current matter, generated and compared in a single analysis.</p>
                                            </div>
                                            <div class="ov-viewtoggle" role="tablist" aria-label="Comparison view">
                                                @foreach (var view in OvComparisonViews)
                                                {
                                                    var icon = view switch { "Cards" => "bi-grid-3x3-gap", "Table" => "bi-table", _ => "bi-graph-up" };
                                                    <button type="button" role="tab"
                                                            class="ov-viewtoggle-btn @(_ovComparisonView == view ? "ov-viewtoggle-btn--active" : "")"
                                                            @onclick="() => SetOverviewView(view)">
                                                        <i class="bi @icon" aria-hidden="true"></i> @view
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        @if (_ovComparisonView == "Cards")
                                        {
                                            <div class="ov-cards">
                                                @foreach (var o in OvFilteredOutcomes)
                                                {
                                                    <div class="ov-card ov-card--@(o.IsLeader ? "leader" : "compete") ov-card--c@(o.Index)">
                                                        <div class="ov-card-top">
                                                            <span class="ov-card-code">C@(o.Index)</span>
                                                            <span class="ov-card-flag ov-card-flag--@(o.IsLeader ? "leader" : "compete")">
                                                                @if (o.IsLeader)
                                                                {
                                                                    <i class="bi bi-trophy" aria-hidden="true"></i>
                                                                }
                                                                @(o.IsLeader ? "Current Leader" : "Competing Outcome")
                                                            </span>
                                                            <span class="ov-card-support">@o.SupportPct% support</span>
                                                        </div>
                                                        <div class="ov-card-track"><div class="ov-card-fill" style="width:@(o.SupportPct)%"></div></div>
                                                        <h5 class="ov-card-title">@o.Title</h5>
                                                        <p class="ov-card-detail">@o.CardText</p>
                                                        @if (o.FullNarrative.Count > 0)
                                                        {
                                                            <div class="ov-card-fullnarrative">
                                                                @foreach (var section in o.FullNarrative)
                                                                {
                                                                    <div class="ov-card-fullnarrative-section">
                                                                        <span class="ov-card-fullnarrative-label">@section.Label</span>
                                                                        <p class="ov-card-fullnarrative-text">@section.Text</p>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        <div class="ov-card-tags">
                                                            @foreach (var tag in o.Tags)
                                                            {
                                                                <span class="ov-tag ov-tag--@tag.Tone">@tag.Label</span>
                                                            }
                                                        </div>
                                                        <ul class="ov-card-metrics">
                                                            <li class="ov-metric-click @(_ovKpiFilter == "supporting" ? "ov-metric-click--active" : "")" @onclick='() => SetOvKpiFilter("supporting")' title="Filter outcomes that have key supporting factors"><span class="ov-metric-ic"><i class="bi bi-check2-circle"></i></span><span class="ov-metric-lbl">Key supporting factors</span><span class="ov-metric-val">@o.KeySupportingFactors</span></li>
                                                            <li class="ov-metric-click @(_ovKpiFilter == "dependencies" ? "ov-metric-click--active" : "")" @onclick='() => SetOvKpiFilter("dependencies")' title="Filter outcomes that have critical dependencies"><span class="ov-metric-ic"><i class="bi bi-diagram-2"></i></span><span class="ov-metric-lbl">Critical dependencies</span><span class="ov-metric-val">@o.CriticalDependencies</span></li>
                                                            <li class="ov-metric-click @(_ovKpiFilter == "missing" ? "ov-metric-click--active" : "")" @onclick='() => SetOvKpiFilter("missing")' title="Filter outcomes with missing or unverified evidence"><span class="ov-metric-ic ov-metric-ic--warn"><i class="bi bi-exclamation-circle"></i></span><span class="ov-metric-lbl">Missing or unverified evidence</span><span class="ov-metric-val">@o.MissingEvidence</span></li>
                                                            <li class="ov-metric-click @(_ovKpiFilter == "vulnerabilities" ? "ov-metric-click--active" : "")" @onclick='() => SetOvKpiFilter("vulnerabilities")' title="Filter outcomes with main vulnerabilities"><span class="ov-metric-ic ov-metric-ic--danger"><i class="bi bi-shield-exclamation"></i></span><span class="ov-metric-lbl">Main vulnerabilities</span><span class="ov-metric-val">@o.MainVulnerabilities</span></li>
                                                        </ul>
                                                        <button type="button" class="ov-card-cta ov-card-cta--@(o.IsLeader ? "leader" : "compete")" @onclick="() => OpenCandidateAnalysis(o.Index)">View full analysis →</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (_ovComparisonView == "Table")
                                        {
                                            <div class="ov-table-wrap">
                                                <table class="ov-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Metric</th>
                                                            @foreach (var o in OvOutcomes)
                                                            {
                                                                <th>C@(o.Index) · @o.Title</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>Overall support</td>
                                                            @foreach (var o in OvOutcomes)
                                                            {
                                                                <td>
                                                                    <div class="ov-table-bar"><div class="ov-table-bar-fill ov-card--c@(o.Index)" style="width:@(o.SupportPct)%"></div></div>
                                                                    <span class="ov-table-bar-val">@o.SupportPct%</span>
                                                                </td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td>Legal viability</td>
                                                            @foreach (var o in OvOutcomes)
                                                            {
                                                                <td><span class="dfi-pill dfi-pill-@o.ViabilityTone">@o.ViabilityLabel</span></td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td>Key supporting factors</td>
                                                            @foreach (var o in OvOutcomes)
                                                            {
                                                                <td>@o.KeySupportingFactors</td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td>Critical dependencies</td>
                                                            @foreach (var o in OvOutcomes)
                                                            {
                                                                <td>@o.CriticalDependencies</td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td>Missing or unverified evidence</td>
                                                            @foreach (var o in OvOutcomes)
                                                            {
                                                                <td class="@(o.MissingEvidence > 0 ? "ov-table-warn" : "")">@o.MissingEvidence</td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td>Main vulnerabilities</td>
                                                            @foreach (var o in OvOutcomes)
                                                            {
                                                                <td class="@(o.MainVulnerabilities > 0 ? "ov-table-danger" : "")">@o.MainVulnerabilities</td>
                                                            }
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ov-graph-panel">
                                                @if (OvComparisonDimensions.Count >= 3)
                                                {
                                                    <div class="ov-radar">
                                                        <svg viewBox="0 0 200 200" class="ov-radar-svg" role="img" aria-label="Outcome profile across key dimensions">
                                                            @for (var ring = 1; ring <= 4; ring++)
                                                            {
                                                                <circle cx="100" cy="100" r="@(12 + ring * 19)" class="ov-radar-grid" />
                                                            }
                                                            @{ var dims = OvComparisonDimensions; }
                                                            @for (var di = 0; di < dims.Count; di++)
                                                            {
                                                                var end = OvRadarAxisLabelPoint(di, dims.Count);
                                                                <line x1="100" y1="100" x2="@end.X.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y2="@end.Y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" class="ov-radar-axis" />
                                                            }
                                                            @foreach (var o in OvOutcomes)
                                                            {
                                                                <polygon points="@OvRadarPolygon(o)" class="ov-radar-poly" style="stroke:@OvOutcomeColor(o.Index - 1);fill:@OvOutcomeColor(o.Index - 1)" />
                                                            }
                                                        </svg>
                                                        <div class="ov-radar-axislabels">
                                                            @{ var ds = OvComparisonDimensions; }
                                                            @for (var di = 0; di < ds.Count; di++)
                                                            {
                                                                var p = OvRadarAxisLabelPoint(di, ds.Count);
                                                                var lx = (p.X / 200d) * 100d;
                                                                var ly = (p.Y / 200d) * 100d;
                                                                <span class="ov-radar-axislabel" style="left:@lx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%;top:@ly.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%">@ds[di]</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <ul class="ov-graph-legend">
                                                        @foreach (var o in OvOutcomes)
                                                        {
                                                            <li><span class="ov-legend-dot" style="background:@OvOutcomeColor(o.Index - 1)"></span>C@(o.Index) @o.Title</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p class="dfi-empty">Not enough scored dimensions to render a comparison graph for this execution.</p>
                                                }
                                            </div>
                                        }

                                        <div class="ov-bottom-grid">
                                            <div class="ov-panel ov-panel--comparison">
                                                <h5 class="ov-panel-title">Outcome comparison</h5>
                                                <p class="ov-panel-sub">Relative support, risk, and key metrics across outcomes.</p>
                                                <div class="ov-table-wrap">
                                                    <table class="ov-table ov-table--compact">
                                                        <thead>
                                                            <tr>
                                                                <th>Metric</th>
                                                                @foreach (var o in OvOutcomes)
                                                                {
                                                                    <th>C@(o.Index)</th>
                                                                }
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td>Overall support</td>
                                                                @foreach (var o in OvOutcomes)
                                                                {
                                                                    <td>
                                                                        <div class="ov-table-bar"><div class="ov-table-bar-fill ov-card--c@(o.Index)" style="width:@(o.SupportPct)%"></div></div>
                                                                        <span class="ov-table-bar-val">@o.SupportPct%</span>
                                                                    </td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Legal viability</td>
                                                                @foreach (var o in OvOutcomes)
                                                                {
                                                                    <td><span class="dfi-pill dfi-pill-@o.ViabilityTone">@o.ViabilityLabel</span></td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Estimated time to resolution</td>
                                                                @foreach (var o in OvOutcomes)
                                                                {
                                                                    <td>@(string.IsNullOrWhiteSpace(o.EstimatedResolutionLabel) ? "\u2014" : o.EstimatedResolutionLabel)</td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Estimated cost</td>
                                                                @foreach (var o in OvOutcomes)
                                                                {
                                                                    <td>@(string.IsNullOrWhiteSpace(o.EstimatedCostBand) ? "\u2014" : o.EstimatedCostBand)</td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Critical dependencies</td>
                                                                @foreach (var o in OvOutcomes)
                                                                {
                                                                    <td>@o.CriticalDependencies</td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Missing evidence</td>
                                                                @foreach (var o in OvOutcomes)
                                                                {
                                                                    <td class="@(o.MissingEvidence > 0 ? "ov-table-warn" : "")">@o.MissingEvidence</td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Risk of adverse outcome</td>
                                                                @foreach (var o in OvOutcomes)
                                                                {
                                                                    <td class="@(o.MainVulnerabilities > 0 ? "ov-table-danger" : "")">@(o.MainVulnerabilities == 0 ? "Lower" : o.MainVulnerabilities >= 3 ? "Higher" : "Moderate")</td>
                                                                }
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <div class="ov-panel ov-panel--profile">
                                                <h5 class="ov-panel-title">Outcome profile</h5>
                                                <p class="ov-panel-sub">Comparative view across key dimensions.</p>
                                                @if (OvComparisonDimensions.Count >= 3)
                                                {
                                                    <div class="ov-radar ov-radar--mini">
                                                        <svg viewBox="0 0 200 200" class="ov-radar-svg" role="img" aria-label="Outcome profile radar">
                                                            @for (var ring = 1; ring <= 4; ring++)
                                                            {
                                                                <circle cx="100" cy="100" r="@(12 + ring * 19)" class="ov-radar-grid" />
                                                            }
                                                            @{ var mdims = OvComparisonDimensions; }
                                                            @for (var di = 0; di < mdims.Count; di++)
                                                            {
                                                                var end = OvRadarAxisLabelPoint(di, mdims.Count);
                                                                <line x1="100" y1="100" x2="@end.X.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y2="@end.Y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" class="ov-radar-axis" />
                                                            }
                                                            @foreach (var o in OvOutcomes)
                                                            {
                                                                <polygon points="@OvRadarPolygon(o)" class="ov-radar-poly" style="stroke:@OvOutcomeColor(o.Index - 1);fill:@OvOutcomeColor(o.Index - 1)" />
                                                            }
                                                        </svg>
                                                    </div>
                                                    <ul class="ov-graph-legend">
                                                        @foreach (var o in OvOutcomes)
                                                        {
                                                            <li><span class="ov-legend-dot" style="background:@OvOutcomeColor(o.Index - 1)"></span>C@(o.Index) @o.Title</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p class="dfi-empty">Not enough scored dimensions to render the profile.</p>
                                                }
                                            </div>

                                            <div class="ov-panel ov-panel--insights">
                                                <div class="ov-insights-head">
                                                    <h5 class="ov-panel-title">Key insights</h5>
                                                    <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Readiness"'>View all insights →</button>
                                                </div>
                                                @if (OvKeyInsights.Count > 0)
                                                {
                                                    <ul class="ov-insights-list">
                                                        @foreach (var insight in OvKeyInsights)
                                                        {
                                                            var icon = insight.Tone switch { "ok" => "bi-lightbulb", "warn" => "bi-exclamation-triangle", _ => "bi-info-circle" };
                                                            <li class="ov-insight ov-insight--@insight.Tone">
                                                                <span class="ov-insight-ic"><i class="bi @icon"></i></span>
                                                                <span class="ov-insight-text">@insight.Text</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No insights are available for this execution yet.</p>
                                                        }
                                                    </div>
                                                </div>

                                                @* ── Why It Leads · What Could Flip It · What To Resolve Next ──────── *@
                                                <div class="ov-intel-grid ov-intel-grid--three ov-decision-row">
                                                    <div class="ov-panel ov-panel--why">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-trophy" aria-hidden="true"></i> Why C@(ovLeader.Index) Leads</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Competition"'>Evidence →</button>
                                                        </div>
                                                        @if (OvWhyItLeads.Count > 0)
                                                        {
                                                            <ul class="ov-factor-list">
                                                                @foreach (var f in OvWhyItLeads)
                                                                {
                                                                    <li class="ov-factor">
                                                                        <span class="ov-factor-name">@f.Name</span>
                                                                        <span class="ov-factor-track"><span class="ov-factor-fill ov-factor-fill--@f.Tone" style="width:@f.Pct%"></span></span>
                                                                        <span class="ov-factor-pct">@f.Pct%</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">The leading outcome has no scored supporting dimensions yet.</p>
                                                        }
                                                    </div>

                                                    <div class="ov-panel ov-panel--flip">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-shuffle" aria-hidden="true"></i> What Could Flip It</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Decision Analysis"'>Flip points →</button>
                                                        </div>
                                                        @if (OvWhatCouldFlipIt.Count > 0)
                                                        {
                                                            <ul class="ov-flip-list">
                                                                @foreach (var fp in OvWhatCouldFlipIt)
                                                                {
                                                                    <li class="ov-flip">
                                                                        <span class="ov-flip-ic ov-flip-ic--@fp.Tone"><i class="bi bi-exclamation-triangle"></i></span>
                                                                        <span class="ov-flip-name">@fp.Name</span>
                                                                        <span class="ov-flip-state ov-flip-state--@fp.Tone">@fp.StateLabel</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No contradicted or unresolved factors could currently flip the decision.</p>
                                                        }
                                                    </div>

                                                    <div class="ov-panel ov-panel--resolve">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-flag" aria-hidden="true"></i> What To Resolve Next</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Continuous Decision Calibration (CDC)"'>All actions →</button>
                                                        </div>
                                                        @if (OvResolutionCalculated)
                                                        {
                                                            <div class="dfi-table-wrap">
                                                                <table class="dfi-table nba-grid">
                                                                    <thead>
                                                                        <tr>
                                                                            <th style="width:3rem;">#</th>
                                                                            <th>Resolution Target</th>
                                                                            <th style="width:6rem;">IV</th>
                                                                            <th style="width:6rem;">ADV</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @{ var wtrnRank = (WtrnPage - 1) * WtrnPageSize; }
                                                                        @foreach (var t in WtrnPagedTargets)
                                                                        {
                                                                            wtrnRank++;
                                                                            <tr>
                                                                                <td><span class="ov-action-rank">@wtrnRank</span></td>
                                                                                <td>
                                                                                    <span class="ov-action-title">@t.ResolutionQuestion</span>
                                                                                    @if (t.HierarchyPath.Count > 0)
                                                                                    {
                                                                                        <span class="ov-action-path">@string.Join(" → ", t.HierarchyPath.Select(n => n.Label))</span>
                                                                                    }
                                                                                    @if (!string.IsNullOrWhiteSpace(t.MissingInformation))
                                                                                    {
                                                                                        <span class="ov-action-ctx">@t.MissingInformation</span>
                                                                                    }
                                                                                </td>
                                                                                <td>@(t.InformationValue.HasValue ? t.InformationValue.Value.ToString("0.00") : "—")</td>
                                                                                <td>@(t.LegalAdv.HasValue ? t.LegalAdv.Value.ToString("0.00") : "—")</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                            @if (WtrnPageCount > 1)
                                                            {
                                                                <div class="nba-pager">
                                                                    <button type="button" class="nba-pager-btn" disabled="@(WtrnPage <= 1)" @onclick="() => WtrnGoToPage(WtrnPage - 1)">
                                                                        <i class="bi bi-chevron-left" aria-hidden="true"></i> Prev
                                                                    </button>
                                                                    <span class="nba-pager-info">Page @WtrnPage of @WtrnPageCount · @OvResolutionTargets.Count targets</span>
                                                                    <button type="button" class="nba-pager-btn" disabled="@(WtrnPage >= WtrnPageCount)" @onclick="() => WtrnGoToPage(WtrnPage + 1)">
                                                                        Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                                                    </button>
                                                                </div>
                                                            }
                                                        }
                                                                                else
                                                                                {
                                                                                    <p class="dfi-empty">@OvResolutionStateText</p>
                                                                                }
                                                                            </div>
                                                                        </div>

                                                                        @* ── Decision Structure (CHR/APR) · Latest Intelligence (HRR/AER) ──── *@
                                                <div class="ov-intel-grid ov-intel-grid--two">
                                                    <div class="ov-panel ov-panel--structure">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-diagram-3" aria-hidden="true"></i> Decision Structure (CHR / APR)</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Hierarchy"'>Explore hierarchy →</button>
                                                        </div>
                                                        <div class="ov-struct-stats">
                                                            <div class="ov-struct-stat">
                                                                <span class="ov-struct-val">@OvHierarchyNodeCount</span>
                                                                <span class="ov-struct-lbl">Hierarchy nodes (CHR)</span>
                                                            </div>
                                                            <div class="ov-struct-stat">
                                                                <span class="ov-struct-val">@OvAprResolvedCount / @OvAprTotalCount</span>
                                                                <span class="ov-struct-lbl">Atomic propositions resolved (APR)</span>
                                                            </div>
                                                            <div class="ov-struct-stat">
                                                                <span class="ov-struct-val">@OvAprResolvedPct%</span>
                                                                <span class="ov-struct-lbl">APR resolution</span>
                                                            </div>
                                                        </div>
                                                        <div class="ov-struct-track"><div class="ov-struct-fill" style="width:@OvAprResolvedPct%"></div></div>
                                                    </div>

                                                    <div class="ov-panel ov-panel--intel">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-activity" aria-hidden="true"></i> Latest Intelligence (HRR / AER)</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Decision Change Intelligence (DCI)"'>Full DCI trace →</button>
                                                        </div>
                                                        @if (OvLatestIntelligence is { } li)
                                                        {
                                                            <div class="ov-intel-lineage">
                                                                <span class="ov-intel-node">@li.Factor</span>
                                                                <i class="bi bi-arrow-down ov-intel-arrow"></i>
                                                                <span class="ov-intel-edge">HRR → AER</span>
                                                                <i class="bi bi-arrow-down ov-intel-arrow"></i>
                                                                <span class="ov-intel-outcome ov-intel-outcome--@li.ImpactTone">@li.Impact impact · @li.LinkedCandidates</span>
                                                            </div>
                                                            <p class="ov-intel-reason">@li.Reason</p>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No decision-affecting intelligence has been recorded for this matter yet.</p>
                                                        }
                                                    </div>
                                                </div>

                                                @* ── Document Intelligence ────────────────────────────────────────── *@
                                                <div class="ov-panel ov-panel--docintel">
                                                    <div class="ov-panel-head">
                                                        <h5 class="ov-panel-title"><i class="bi bi-files" aria-hidden="true"></i> Document Intelligence</h5>
                                                        <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Documents"'>Open document intelligence →</button>
                                                    </div>
                                                    @if (OvDocumentIntelligence.Count > 0)
                                                    {
                                                        <div class="ov-docintel-stats">
                                                            @foreach (var s in OvDocumentIntelligence)
                                                            {
                                                                <div class="ov-docintel-stat">
                                                                    <span class="ov-docintel-val">@s.Value</span>
                                                                    <span class="ov-docintel-lbl">@s.Label</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <p class="dfi-empty">Document intelligence has not been projected for this matter yet.</p>
                                                    }
                                                </div>

                                                @* ── Decision Confidence · Key Factors · Next Best Actions ───────── *@
                                                <div class="ov-intel-grid ov-intel-grid--three">
                                                    <div class="ov-panel ov-panel--confidence">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Decision Confidence</h5>
                                                            <span class="dfi-pill dfi-pill-@OvConfidenceTone">H = @OvEntropy.ToString("0.00")</span>
                                                        </div>
                                                        <div class="ov-confidence-body">
                                                            <div class="ov-donut" style="--ov-donut:@OvConfidencePct%">
                                                                <div class="ov-donut-hole">
                                                                    <span class="ov-donut-val">@OvConfidenceLabel</span>
                                                                    <span class="ov-donut-sub">Confidence</span>
                                                                </div>
                                                            </div>
                                                            <ul class="ov-confidence-legend">
                                                                @foreach (var o in OvOutcomes)
                                                                {
                                                                    <li>
                                                                        <span class="ov-legend-dot" style="background:@OvOutcomeColor(o.Index - 1)"></span>
                                                                        <span class="ov-legend-name">C@(o.Index) @o.Title</span>
                                                                        <span class="ov-legend-pct">@o.SupportPct%</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                        <p class="ov-panel-foot">Confidence reflects winner separation, evidence grounding, and ranking stability. Additional evidence could materially change the outcome.</p>
                                                    </div>

                                                    <div class="ov-panel ov-panel--factors">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Key Factors Impacting Outcomes</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Decision Analysis"'>View all →</button>
                                                        </div>
                                                        @if (OvKeyFactors.Count > 0)
                                                        {
                                                            <ul class="ov-factor-list">
                                                                @foreach (var f in OvKeyFactors)
                                                                {
                                                                    <li class="ov-factor">
                                                                        <span class="ov-factor-name">@f.Name</span>
                                                                        <span class="ov-factor-track"><span class="ov-factor-fill ov-factor-fill--@f.Tone" style="width:@f.Pct%"></span></span>
                                                                        <span class="ov-factor-pct">@f.Pct%</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No scored decision factors are available for this execution yet.</p>
                                                        }
                                                    </div>

                                                    <div class="ov-panel ov-panel--actions">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Next Best Actions</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Continuous Decision Calibration (CDC)"'>View all →</button>
                                                        </div>
                                                        @if (OvNextBestActions.Count > 0)
                                                        {
                                                            <div class="dfi-table-wrap">
                                                                <table class="dfi-table nba-grid">
                                                                    <thead>
                                                                        <tr>
                                                                            <th style="width:3rem;">#</th>
                                                                            <th>Action</th>
                                                                            <th style="width:9rem;">Impact</th>
                                                                            <th style="width:6rem;">ADV</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @{ var nbaRank = (NbaPage - 1) * NbaPageSize; }
                                                                        @foreach (var a in NbaPagedActions)
                                                                        {
                                                                            nbaRank++;
                                                                            <tr>
                                                                                <td><span class="ov-action-rank">@nbaRank</span></td>
                                                                                <td>
                                                                                    <span class="ov-action-title">@a.Title</span>
                                                                                    @if (a.HierarchyPath.Count > 0)
                                                                                    {
                                                                                        <span class="ov-action-path">@string.Join(" → ", a.HierarchyPath)</span>
                                                                                    }
                                                                                    @if (!string.IsNullOrWhiteSpace(a.Context))
                                                                                    {
                                                                                        <span class="ov-action-ctx">@a.Context</span>
                                                                                    }
                                                                                </td>
                                                                                <td><span class="ov-impact ov-impact--@a.ImpactTone">@a.ImpactLabel</span></td>
                                                                                <td><span class="ov-adv">ADV @a.Adv.ToString("0.00")</span></td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                            @if (NbaPageCount > 1)
                                                            {
                                                                <div class="nba-pager">
                                                                    <button type="button" class="nba-pager-btn" disabled="@(NbaPage <= 1)" @onclick="() => NbaGoToPage(NbaPage - 1)">
                                                                        <i class="bi bi-chevron-left" aria-hidden="true"></i> Prev
                                                                    </button>
                                                                    <span class="nba-pager-info">Page @NbaPage of @NbaPageCount · @OvNextBestActions.Count actions</span>
                                                                    <button type="button" class="nba-pager-btn" disabled="@(NbaPage >= NbaPageCount)" @onclick="() => NbaGoToPage(NbaPage + 1)">
                                                                        Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                                                    </button>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">@OvNextBestActionsEmptyText</p>
                                                        }
                                                                            </div>
                                                                        </div>

                                                                        @* ── Matter Snapshot · Progress to Decision Readiness ───────────── *@
                                                <div class="ov-intel-grid ov-intel-grid--two">
                                                    <div class="ov-panel ov-panel--matter">
                                                        <h5 class="ov-panel-title">Matter Snapshot</h5>
                                                        <dl class="ov-snapshot">
                                                            @foreach (var s in OvMatterSnapshot)
                                                            {
                                                                <div class="ov-snapshot-item">
                                                                    <dt><i class="bi @s.Icon" aria-hidden="true"></i> @s.Label</dt>
                                                                    <dd>@(string.IsNullOrWhiteSpace(s.Value) ? "—" : s.Value)</dd>
                                                                </div>
                                                            }
                                                        </dl>
                                                    </div>

                                                    <div class="ov-panel ov-panel--readiness">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Progress to Decision Readiness</h5>
                                                            <span class="ov-readiness-pct">@OvReadinessPct%</span>
                                                        </div>
                                                        <div class="ov-readiness-track"><div class="ov-readiness-fill ov-readiness-fill--@DfiReadinessTone" style="width:@OvReadinessPct%"></div></div>
                                                        <ul class="ov-readiness-steps">
                                                            @foreach (var step in OvReadinessSteps)
                                                            {
                                                                <li class="ov-rstep ov-rstep--@step.Tone">
                                                                    <span class="ov-rstep-ic"><i class="bi @(step.Tone == "ok" ? "bi-check-circle-fill" : "bi-clock")"></i></span>
                                                                    <span class="ov-rstep-lbl">@step.Label</span>
                                                                                    <span class="ov-rstep-val">@step.Value</span>
                                                                                </li>
                                                                            }
                                                                        </ul>
                                                                        @if (OvReadinessBlockers.Count > 0)
                                                                        {
                                                                            <div class="ov-blockers">
                                                                                <span class="ov-blockers-title"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Blockers</span>
                                                                                <ul class="ov-blockers-list">
                                                                                    @foreach (var b in OvReadinessBlockers)
                                                                                    {
                                                                                        <li>@b</li>
                                                                                    }
                                                                                </ul>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                </div>

                                                @* ── Recent Activity · Analyst Summary ──────────────────────────── *@
                                                <div class="ov-intel-grid ov-intel-grid--two">
                                                    <div class="ov-panel ov-panel--activity">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Recent Activity</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => _dfiTab = "Decision Change Intelligence (DCI)"'>View all →</button>
                                                        </div>
                                                        @if (CdcRecentActivity.Count > 0)
                                                        {
                                                            <ul class="ov-activity-list">
                                                                @foreach (var act in CdcRecentActivity)
                                                                {
                                                                    <li class="ov-activity">
                                                                        <span class="ov-activity-ic ov-activity-ic--@act.Tone"><i class="bi bi-dot"></i></span>
                                                                        <span class="ov-activity-body">
                                                                            <span class="ov-activity-title">@act.Title</span>
                                                                            @if (!string.IsNullOrWhiteSpace(act.Detail))
                                                                            {
                                                                                <span class="ov-activity-detail">@act.Detail</span>
                                                                            }
                                                                        </span>
                                                                        <span class="ov-activity-when">@OvRelativeTime(act.When)</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No recent matter activity has been recorded yet.</p>
                                                        }
                                                    </div>

                                                    <div class="ov-panel ov-panel--summary">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-stars" aria-hidden="true"></i> Decision Brief</h5>
                                                        </div>
                                                        <p class="ov-summary-text">@OvExecutiveSummary</p>
                                                        <div class="ov-summary-chips">
                                                            @foreach (var chip in OvSummaryChips)
                                                            {
                                                                <div class="ov-summary-chip ov-summary-chip--@chip.Tone">
                                                                    <span class="ov-summary-chip-head"><i class="bi @chip.Icon"></i> @chip.Title</span>
                                                                    <span class="ov-summary-chip-text">@chip.Text</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                                                       </div>
                                                                                   }
                                                                                  break;
                                                                              case "Decision Analysis":
                                                @DecisionAnalysisDashboard
                                                break;
                                            case "Continuous Decision Calibration (CDC)":
                                                @CdcDashboard
                                                break;
                                            case "Decision Change Intelligence (DCI)":
                                                @DciDashboard
                                                break;
                                            case "Decision Contract":
                                @if (_matter is not null)
                                {
                                    <DecisionContractWorkspace MatterId="_matter.DecisionMatterId" />
                                }
                                else
                                {
                                    <div class="dfi-panel-card"><p class="dfi-panel-sub">Select a matter to view its Decision Contract.</p></div>
                                }
                                break;
                            case "Hierarchy":
                                @if (SurvivingBranches.Count > 0)
                                {
                                    var hxSelected = DfiSelectedBranch;
                                    <div class="hx-workspace">
                                        @* ── Left · Decision hierarchy tree ─────────────────────────────── *@
                                        <aside class="hx-tree">
                                            <div class="hx-tree-head">
                                                <div class="hx-tree-title">
                                                    <i class="bi bi-diagram-3"></i>
                                                    <span>Decision hierarchy</span>
                                                </div>
                                                <p class="hx-tree-sub">Structured questions to resolve the matter.</p>
                                                <div class="hx-search">
                                                    <i class="bi bi-search"></i>
                                                    <input type="text" placeholder="Search questions or factors…" @bind="_hxSearch" @bind:event="oninput" />
                                                </div>
                                            </div>
                                            <div class="hx-tree-body">
                                                @foreach (var root in HxRootBranches.Where(HxRootVisible))
                                                {
                                                    var descendants = HxDescendants(root);
                                                    var collapsed = _hxCollapsedGroups.Contains(root.WideBranchId);
                                                    <div class="hx-group">
                                                        <button type="button"
                                                                class="hx-group-head @(_dfiSelectedBranchId == root.WideBranchId ? "hx-group-head--active" : "")"
                                                                @onclick="() => HxSelect(root)">
                                                            <i class="bi bi-chevron-@(collapsed ? "right" : "down") hx-group-caret"
                                                               @onclick:stopPropagation="true"
                                                               @onclick="() => HxToggleGroup(root.WideBranchId)"></i>
                                                            <span class="hx-node-lvl">L@(root.LevelNumber)</span>
                                                            <span class="hx-node-name">@root.DisplayName</span>
                                                            <span class="hx-node-status hx-node-status--@HxStatusTone(root)">
                                                                <i class="bi bi-@(HxComplete(root) ? "check-circle" : "exclamation-circle")"></i>
                                                                @HxStatusLabel(root)
                                                            </span>
                                                        </button>
                                                        @if (!collapsed)
                                                        {
                                                            <div class="hx-group-children">
                                                                @foreach (var d in descendants)
                                                                {
                                                                    <button type="button"
                                                                            class="hx-node hx-node--l@(Math.Min(d.LevelNumber, 6)) @(_dfiSelectedBranchId == d.WideBranchId ? "hx-node--active" : "")"
                                                                            style="padding-left:@(0.75 + (d.LevelNumber - 2) * 0.9)rem"
                                                                            @onclick="() => HxSelect(d)">
                                                                        <span class="hx-node-lvl">L@(d.LevelNumber)</span>
                                                                        <span class="hx-node-name">@d.DisplayName</span>
                                                                        <i class="bi bi-chevron-right hx-node-go"></i>
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </aside>

                                        @* ── Center · Selected node detail ──────────────────────────────── *@
                                        <section class="hx-detail">
                                            @if (hxSelected is not null)
                                            {
                                                var children = HxChildren(hxSelected);
                                                <header class="hx-detail-head">
                                                    <div class="hx-detail-title">
                                                        <span class="hx-node-lvl hx-node-lvl--lg">L@(hxSelected.LevelNumber)</span>
                                                        <div>
                                                            <h3>@hxSelected.DisplayName</h3>
                                                            <p>@hxSelected.Interpretation</p>
                                                        </div>
                                                    </div>
                                                    <span class="hx-node-status hx-node-status--@HxStatusTone(hxSelected) hx-node-status--pill">
                                                        <i class="bi bi-@(HxComplete(hxSelected) ? "check-circle" : "exclamation-circle")"></i>
                                                        @HxStatusLabel(hxSelected)
                                                    </span>
                                                </header>

                                                <nav class="hx-detail-tabs">
                                                    @foreach (var t in HxDetailTabs)
                                                    {
                                                        var label = t switch
                                                        {
                                                            "Sub-questions" => $"Sub-questions ({children.Count})",
                                                            "Dependencies" => $"Dependencies ({DfiDependencyCount})",
                                                            "Evidence" => $"Evidence ({hxSelected.EvidenceCount})",
                                                            _ => t
                                                        };
                                                        <button type="button"
                                                                class="hx-detail-tab @(_hxDetailTab == t ? "hx-detail-tab--active" : "")"
                                                                @onclick="() => _hxDetailTab = t">@label</button>
                                                    }
                                                </nav>

                                                <div class="hx-detail-body">
                                                    @switch (_hxDetailTab)
                                                    {
                                                        case "Sub-questions":
                                                            @if (children.Count > 0)
                                                            {
                                                                <div class="hx-subq-list">
                                                                    @foreach (var c in children)
                                                                    {
                                                                        <button type="button" class="hx-subq" @onclick="() => HxSelect(c)">
                                                                            <span class="hx-node-lvl">L@(c.LevelNumber)</span>
                                                                            <span class="hx-subq-name">@c.DisplayName</span>
                                                                            <span class="hx-node-status hx-node-status--@HxStatusTone(c)">@HxStatusLabel(c)</span>
                                                                            <i class="bi bi-chevron-right"></i>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <p class="dfi-empty">No sub-questions branch from this node.</p>
                                                            }
                                                            break;
                                                        case "Dependencies":
                                                            @if (_response?.DecisionInspector?.SharedDependencies.Count > 0)
                                                            {
                                                                <ul class="hx-dep-list">
                                                                    @foreach (var d in _response.DecisionInspector.SharedDependencies.Take(8))
                                                                    {
                                                                        <li>
                                                                            <span class="hx-dep-type">@d.DependencyType</span>
                                                                            <span class="hx-dep-prop">@d.Proposition</span>
                                                                            <span class="dfi-pill dfi-pill-@(d.VerificationState == "VERIFIED" ? "ok" : "warn")">@d.VerificationState</span>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else
                                                            {
                                                                <p class="dfi-empty">No cross-node dependencies mapped for this run.</p>
                                                            }
                                                            break;
                                                        case "Evidence":
                                                            @if (hxSelected.EvidenceCount > 0)
                                                            {
                                                                <div class="hx-callout hx-callout--ok">
                                                                    <i class="bi bi-shield-check"></i>
                                                                    <span>@hxSelected.EvidenceCount source(s) linked to this node · grounding @hxSelected.GroundingStatusCode.</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="hx-callout hx-callout--warn">
                                                                    <i class="bi bi-exclamation-triangle"></i>
                                                                    <span>Source review required — no independently verified evidence admitted for this node.</span>
                                                                </div>
                                                            }
                                                            @if (_response?.ProposedLegalAuthorities.Count > 0)
                                                            {
                                                                <ul class="hx-auth-list">
                                                                    @foreach (var a in _response.ProposedLegalAuthorities.Take(5))
                                                                    {
                                                                        <li><span class="hx-node-lvl">@a.Kind</span> @a.Name <span class="dfi-pill dfi-pill-@(a.VerificationStatus == "VERIFIED" ? "ok" : "muted")">@a.VerificationStatus</span></li>
                                                                    }
                                                                </ul>
                                                            }
                                                            break;
                                                        case "Analysis":
                                                            <div class="hx-analysis">
                                                                <div class="hx-analysis-icon"><i class="bi bi-stars"></i></div>
                                                                <div>
                                                                    <h5>Latest analysis summary</h5>
                                                                    <p>@(string.IsNullOrWhiteSpace(hxSelected.Interpretation) ? "This branch requires validation before its disposition can be compared." : hxSelected.Interpretation)</p>
                                                                    <p class="hx-analysis-meta">Confidence @hxSelected.Confidence.ToString("P0")@(hxSelected.ContinueNarrowing ? " · narrowing" : $" · terminal ({hxSelected.StopReason})").</p>
                                                                </div>
                                                            </div>
                                                            break;
                                                        case "Notes":
                                                            <p class="dfi-empty">Notes for this node will appear here.</p>
                                                            break;
                                                        default:
                                                            <div class="hx-overview">
                                                                <div class="hx-card">
                                                                    <div class="hx-card-head"><i class="bi bi-bullseye"></i> Purpose</div>
                                                                    <p>@hxSelected.Interpretation</p>
                                                                </div>
                                                                <div class="hx-card">
                                                                    <div class="hx-card-head"><i class="bi bi-list-check"></i> Key considerations</div>
                                                                    <ul class="hx-check">
                                                                        <li>Grounding status · @hxSelected.GroundingStatusCode</li>
                                                                        <li>Evidence items · @hxSelected.EvidenceCount</li>
                                                                        <li>Confidence · @hxSelected.Confidence.ToString("P0")</li>
                                                                        <li>@(hxSelected.ContinueNarrowing ? "Still narrowing" : $"Terminal · {hxSelected.StopReason}")</li>
                                                                    </ul>
                                                                </div>
                                                                @if (FinalRankedCandidates.Count > 0)
                                                                {
                                                                    <div class="hx-card hx-card--wide">
                                                                        <div class="hx-card-head"><i class="bi bi-grid-3x3-gap"></i> Linked candidate outcomes</div>
                                                                        <div class="hx-cand-grid">
                                                                            @for (var ci = 0; ci < Math.Min(3, FinalRankedCandidates.Count); ci++)
                                                                            {
                                                                                var cand = FinalRankedCandidates[ci];
                                                                                <div class="hx-cand">
                                                                                    <div class="hx-cand-head"><span class="hx-cand-tag">C@(ci + 1)</span> <span class="dfi-pill dfi-pill-ok">Relevant</span></div>
                                                                                    <div class="hx-cand-name">@cand.DisplayName</div>
                                                                                    <div class="hx-cand-score">@cand.CompositeScore.ToString("P0")</div>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                                @if (children.Count > 0)
                                                                {
                                                                    <div class="hx-card hx-card--wide">
                                                                        <div class="hx-card-head"><i class="bi bi-diagram-2"></i> Related sub-questions (@children.Count)</div>
                                                                        <div class="hx-subq-list">
                                                                            @foreach (var c in children.Take(4))
                                                                            {
                                                                                <button type="button" class="hx-subq" @onclick="() => HxSelect(c)">
                                                                                    <span class="hx-node-lvl">L@(c.LevelNumber)</span>
                                                                                    <span class="hx-subq-name">@c.DisplayName</span>
                                                                                    <span class="hx-node-status hx-node-status--@HxStatusTone(c)">@HxStatusLabel(c)</span>
                                                                                    <i class="bi bi-chevron-right"></i>
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            break;
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="dfi-empty">Select a hierarchy node to inspect its proposition, grounding and linked outcomes.</p>
                                            }
                                        </section>

                                        @* ── Right · Execution status & context rail ────────────────────── *@
                                        <aside class="hx-rail">
                                            <div class="hx-rail-card">
                                                <div class="hx-rail-title">Execution status <span class="hx-live"><i class="bi bi-broadcast"></i> Live</span></div>
                                                <ul class="hx-status-list">
                                                    <li><i class="bi bi-cpu"></i> Technical execution <span class="dfi-pill dfi-pill-ok">Completed</span></li>
                                                    <li><i class="bi bi-trophy"></i> Candidate competition <span class="dfi-pill dfi-pill-@(FinalRankedCandidates.Count > 0 ? "ok" : "warn")">@(FinalRankedCandidates.Count > 0 ? "Executed" : "Pending")</span></li>
                                                    <li><i class="bi bi-shield-check"></i> Evidence grounding <span class="dfi-pill dfi-pill-@(TotalEvidenceCount > 0 ? "ok" : "warn")">@DfiEvidenceCoveragePct.ToString("P0") coverage</span></li>
                                                    <li><i class="bi bi-clipboard-check"></i> Decision readiness <span class="dfi-pill dfi-pill-@DfiReadinessTone">@DfiReadinessLabel</span></li>
                                                </ul>
                                            </div>
                                            <div class="hx-rail-card">
                                                <div class="hx-rail-title">Context</div>
                                                <dl class="hx-context">
                                                    <div><dt><i class="bi bi-diagram-3"></i> Legal domain</dt><dd>Personal Injury</dd></div>
                                                    <div><dt><i class="bi bi-geo-alt"></i> Jurisdiction</dt><dd>@DfiJurisdictionTag</dd></div>
                                                    <div><dt><i class="bi bi-signpost"></i> Matter stage</dt><dd>@DfiPostureTag</dd></div>
                                                    <div><dt><i class="bi bi-cpu"></i> Model</dt><dd>@(_response?.ModelCodeUsed ?? _selectedModelCode)</dd></div>
                                                    <div><dt><i class="bi bi-lightning-charge"></i> POLOXI Engine</dt><dd>@(_usePoloxiEngine ? "Enabled" : "Disabled")</dd></div>
                                                </dl>
                                            </div>
                                        </aside>
                                    </div>
                                }
                                else
                                {
                                    <div class="dfi-panel-card">
                                        <p class="dfi-empty">No hierarchy branches are available for this run.</p>
                                    </div>
                                }
                                break;
                            case "Hierarchy Details":
                                @if (_matter is not null)
                                {
                                    <HierarchyDetailsWorkspace MatterId="_matter.DecisionMatterId" />
                                }
                                else
                                {
                                    <div class="dfi-panel-card"><p class="dfi-panel-sub">Select a matter to view its persisted hierarchy executions.</p></div>
                                }
                                break;
                            case "Factor Matrix":
                                <div class="dfi-panel-card">
                                    <h4>Factor Inventory</h4>
                                    <p class="dfi-panel-sub">Interactive dependency review · @DfiFilteredFactors.Count of @DfiFactorCount factor(s) · @DfiMissingFactorCount missing value(s).</p>
                                    <div class="dfi-review-bar">
                                        <span class="dfi-review-label">Review mode</span>
                                        @foreach (var mode in DfiFactorFilters)
                                        {
                                            <button type="button"
                                                    class="dfi-chip-btn @(_dfiFactorFilter == mode ? "dfi-chip-btn--active" : "")"
                                                    @onclick="() => _dfiFactorFilter = mode">@mode</button>
                                        }
                                    </div>
                                    @if (DfiFilteredFactors.Count > 0)
                                    {
                                        <div class="dfi-grid-scroll">
                                            <table class="dfi-grid">
                                                <thead>
                                                    <tr>
                                                        <th>Factor ID · L-level</th>
                                                        <th>Factor / proposition</th>
                                                        <th>Candidate</th>
                                                        <th>Relationship</th>
                                                        <th>Source</th>
                                                        <th>Actual value</th>
                                                        <th>Availability</th>
                                                        <th>Verification</th>
                                                        <th>Decision impact</th>
                                                        <th>Review status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var f in DfiFilteredFactors)
                                                    {
                                                        <tr class="@(_dfiSelectedFactorId == f.FactorId ? "dfi-row--selected" : "")"
                                                            @onclick="() => SelectDfiFactor(f.FactorId)">
                                                            <td class="dfi-cell-id">@f.FactorId · @f.NodeKind</td>
                                                            <td>@f.FactorName</td>
                                                            <td>@DfiFactorCandidate(f)</td>
                                                            <td><span class="dfi-badge dfi-badge-@DfiRelationTone(f)">@DfiFactorRelation(f)</span></td>
                                                            <td>@f.Source</td>
                                                            <td>@(f.ActualValue ?? "—")</td>
                                                            <td><span class="dfi-badge dfi-badge-@(f.Availability == "AVAILABLE" ? "ok" : "warn")">@f.Availability</span></td>
                                                            <td><span class="dfi-badge dfi-badge-@(f.VerificationStatus == "VERIFIED" ? "ok" : "muted")">@f.VerificationStatus</span></td>
                                                            <td>@DfiFactorImpact(f)</td>
                                                            <td><span class="dfi-badge dfi-badge-muted">Pending</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <p class="dfi-prototype-note">Review controls surface provenance and validation state; they do not modify the original model output or matter data. An accepted correction creates a new authoritative decision-state version and audit entry.</p>
                                    }
                                    else
                                    {
                                        <p class="dfi-empty">No factors match this review filter for the current run.</p>
                                    }
                                </div>
                                break;
                            case "Evidence":
                                <div class="dfi-panel-card">
                                    <h4>Admitted evidence</h4>
                                    <p class="dfi-panel-sub">@_response?.EnterpriseEvidenceCount enterprise · @_response?.ExternalEvidenceCount external · decision coverage @((_response?.DecisionEvidenceCoverage ?? 0m).ToString("P0")).</p>
                                    @if (!string.IsNullOrEmpty(_activationNotice))
                                    {
                                        <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                            <div>
                                                <strong>Corpus activation did not complete</strong>
                                                <div>@_activationNotice</div>
                                            </div>
                                        </div>
                                    }
                                    @if (TotalEvidenceCount == 0)
                                    {
                                        <p class="dfi-empty">No corpus evidence from your uploaded documents was admitted in the referenced execution.</p>
                                        @if ((_response?.DecisionEvidenceCoverage ?? 0m) > 0m)
                                        {
                                            <p class="dfi-panel-sub">
                                                Note: the answer above reports @(( _response?.DecisionEvidenceCoverage ?? 0m).ToString("P0")) decision coverage,
                                                but that is drawn from the model's external/legal sources (@_response?.ExternalEvidenceCount external ·
                                                @_response?.EnterpriseEvidenceCount enterprise) — not from your uploaded Matter Corpus. Corpus evidence
                                                appears here only after uploaded documents are activated into propositions during Disambiguate &amp; Answer.
                                            </p>
                                        }
                                    }
                                    @{
                                        var retrievedRaw = _response?.ExternalKnowledge ?? Array.Empty<WideExternalKnowledgeSnippet>();
                                        // Collapse duplicate rows for the same underlying source (same statute/case retrieved
                                        // once per branch/proposition). Keep the strongest-support representative so the same
                                        // authority is not listed multiple times as separate "Admitted" evidence.
                                        var retrieved = retrievedRaw
                                            .GroupBy(DfiSourceKey)
                                            .Select(g => g
                                                .OrderByDescending(DfiIsAdmitted)
                                                .ThenByDescending(s => s.PropositionSupportScore)
                                                .ThenByDescending(s => s.Score)
                                                .First())
                                            .ToArray();
                                    }
                                    @if (retrieved.Length > 0)
                                    {
                                        <div class="dfi-admission">
                                            <div class="dfi-admission-head">
                                                <h5>Why evidence was admitted or rejected</h5>
                                                <p class="dfi-panel-sub">@retrieved.Length source(s) retrieved · @retrieved.Count(DfiIsAdmitted) admitted · @(retrieved.Length - retrieved.Count(DfiIsAdmitted)) rejected. Only identity-verified, in-scope sources count toward admitted evidence.</p>
                                            </div>
                                            <ul class="dfi-admission-list">
                                                @foreach (var snip in retrieved.OrderByDescending(DfiIsAdmitted).ThenByDescending(s => s.Score))
                                                {
                                                    <li class="dfi-admission-item">
                                                        <div class="dfi-admission-main">
                                                            <span class="dfi-pill dfi-pill-@(DfiIsAdmitted(snip) ? "ok" : "warn")">@(DfiIsAdmitted(snip) ? "Admitted" : "Rejected")</span>
                                                            @if (!string.IsNullOrWhiteSpace(snip.Url))
                                                            {
                                                                <a href="@snip.Url" target="_blank" rel="noopener" class="dfi-admission-title">@(string.IsNullOrWhiteSpace(snip.Title) ? snip.Url : snip.Title)</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="dfi-admission-title">@(string.IsNullOrWhiteSpace(snip.Title) ? "(untitled source)" : snip.Title)</span>
                                                            }
                                                        </div>
                                                        <div class="dfi-admission-meta">
                                                            <span class="dfi-admission-reason">@DfiAdmissionReason(snip)</span>
                                                            @if (!string.IsNullOrWhiteSpace(snip.AuthorityKind)) { <span class="dfi-admission-tag">@snip.AuthorityKind</span> }
                                                            @if (!string.IsNullOrWhiteSpace(snip.Jurisdiction)) { <span class="dfi-admission-tag">@snip.Jurisdiction</span> }
                                                            <span class="dfi-admission-tag">support @snip.PropositionSupportScore.ToString("P0")</span>
                                                        </div>
                                                                 </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                         }
                                                         @{
                                                             var corpusProps = _evidenceGraph?.Propositions
                                                                 ?.Where(p => p.Support.Count > 0)
                                                                 .ToArray() ?? Array.Empty<Legal.Application.Features.Intelligence.Decision.LegalEvidenceGraphPropositionDto>();
                                                             var evidenceById = _evidenceGraph?.Evidence
                                                                 ?.ToDictionary(e => e.LegalEvidenceItemId)
                                                                 ?? new Dictionary<Guid, Legal.Application.Features.Intelligence.Decision.LegalEvidenceGraphItemDto>();
                                                         }
                                                         @if (corpusProps.Length > 0)
                                                         {
                                                             <div class="dfi-admission">
                                                                 <div class="dfi-admission-head">
                                                                     <h5>Atomic propositions matched to document evidence</h5>
                                                                     <p class="dfi-panel-sub">
                                                                         @corpusProps.Length proposition(s) derived from your uploaded corpus ·
                                                                         @corpusProps.Count(p => p.IsDecisionAuthoritative) decision-authoritative.
                                                                         Each row links an atomic proposition to the extracted document evidence that supports, contradicts, or contextualizes it.
                                                                     </p>
                                                                 </div>
                                                                 <ul class="dfi-admission-list">
                                                                     @foreach (var prop in corpusProps.OrderByDescending(p => p.IsDecisionAuthoritative).ThenByDescending(p => p.Confidence ?? 0m))
                                                                     {
                                                                         <li class="dfi-admission-item">
                                                                             <div class="dfi-admission-main">
                                                                                 <span class="dfi-pill dfi-pill-@(prop.IsDecisionAuthoritative ? "ok" : "warn")">@prop.FactStateCode</span>
                                                                                 <span class="dfi-admission-title">@prop.PropositionText</span>
                                                                             </div>
                                                                             <div class="dfi-admission-meta">
                                                                                 @if (prop.Confidence is { } pc)
                                                                                 {
                                                                                     <span class="dfi-admission-tag">confidence @pc.ToString("P0")</span>
                                                                                 }
                                                                                 @if (prop.IsDecisionAuthoritative)
                                                                                 {
                                                                                     <span class="dfi-admission-tag"><i class="bi bi-shield-check"></i> authoritative</span>
                                                                                 }
                                                                                 <span class="dfi-admission-tag">@prop.Support.Count supporting evidence link(s)</span>
                                                                             </div>
                                                                             <ul class="dfi-support-list">
                                                                                 @foreach (var sup in prop.Support)
                                                                                 {
                                                                                     evidenceById.TryGetValue(sup.LegalEvidenceItemId, out var ev);
                                                                                     <li class="dfi-support-row">
                                                                                         <span class="dfi-pill @DiRelationToneClass(sup.RelationshipTypeCode)" title="@sup.AssessmentReason">@sup.RelationshipTypeCode</span>
                                                                                         <span class="dfi-support-text">
                                                                                             @(ev is null ? "(evidence detail unavailable)" : ev.Summary)
                                                                                         </span>
                                                                                         @if (ev is not null)
                                                                                         {
                                                                                             <div class="dfi-support-meta">
                                                                                                 @if (!string.IsNullOrWhiteSpace(ev.DocumentFileName))
                                                                                                 {
                                                                                                     <span class="dfi-support-source">
                                                                                                         <i class="bi bi-file-earmark-text"></i> @ev.DocumentFileName
                                                                                                         @(ev.DocumentVersionNumber > 0 ? $" v{ev.DocumentVersionNumber}" : "")
                                                                                                     </span>
                                                                                                 }
                                                                                                 @if (ev.PageNumber is { } pg)
                                                                                                 {
                                                                                                     <span class="dfi-admission-tag"><i class="bi bi-file-text"></i> p.@pg</span>
                                                                                                 }
                                                                                                 @if (!string.IsNullOrWhiteSpace(ev.SectionPath))
                                                                                                 {
                                                                                                     <span class="dfi-admission-tag" title="Section">@ev.SectionPath</span>
                                                                                                 }
                                                                                                 @if (!string.IsNullOrWhiteSpace(ev.DocumentTypeCode))
                                                                                                 {
                                                                                                     <span class="dfi-admission-tag">@ev.DocumentTypeCode.Replace('_', ' ')</span>
                                                                                                 }
                                                                                                 @if (!string.IsNullOrWhiteSpace(ev.EvidenceTypeCode))
                                                                                                 {
                                                                                                     <span class="dfi-admission-tag">@ev.EvidenceTypeCode.Replace('_', ' ')</span>
                                                                                                 }
                                                                                                 @if (!string.IsNullOrWhiteSpace(ev.DimensionCode))
                                                                                                 {
                                                                                                     <span class="dfi-admission-tag">@ev.DimensionCode.Replace('_', ' ')</span>
                                                                                                 }
                                                                                                 @if (!string.IsNullOrWhiteSpace(ev.EvidenceStateCode))
                                                                                                 {
                                                                                                     <span class="dfi-admission-tag">@ev.EvidenceStateCode.Replace('_', ' ')</span>
                                                                                                 }
                                                                                                 @if (ev.Confidence is { } evc)
                                                                                                 {
                                                                                                     <span class="dfi-admission-tag">confidence @evc.ToString("P0")</span>
                                                                                                 }
                                                                                             </div>
                                                                                             @if (!string.IsNullOrWhiteSpace(ev.PassageText))
                                                                                             {
                                                                                                 <blockquote class="dfi-support-passage">&ldquo;@ev.PassageText&rdquo;</blockquote>
                                                                                             }
                                                                                         }
                                                                                         @if (!string.IsNullOrWhiteSpace(sup.AssessmentReason))
                                                                                         {
                                                                                             <span class="dfi-support-reason">@sup.AssessmentReason</span>
                                                                                         }
                                                                                     </li>
                                                                                 }
                                                                             </ul>
                                                                         </li>
                                                                     }
                                                                 </ul>
                                                             </div>
                                                         }
                                                     </div>
                                                     break;
                                    case "Competition":
                                        <div class="dfi-panel-card">
                                            <h4>Candidate competition</h4>
                                            <p class="dfi-panel-sub">@DfiScoredCandidateCount scored candidate(s) · @DfiCompetingOutcomes competing outcome(s) · @DfiDependencyCount dependency relationship(s).</p>
                                            @if (FinalRankedCandidates.Count > 0)
                                            {
                                                <div class="dcc-compare">
                                                    @{ var compMax = Math.Max(0.01m, FinalRankedCandidates.Max(c => c.CompositeScore)); }
                                                    @for (var ci = 0; ci < FinalRankedCandidates.Count; ci++)
                                                    {
                                                                    var cand = FinalRankedCandidates[ci];
                                                                    var pct = (int)Math.Round((double)(cand.CompositeScore / compMax) * 100);
                                                                    <div class="dcc-compare-row">
                                                                        <div class="dcc-compare-head">
                                                                            <span class="dcc-compare-name">@cand.DisplayName</span>
                                                                            <span class="dcc-compare-val">@cand.CompositeScore.ToString("P0")</span>
                                                                        </div>
                                                                        <div class="dcc-compare-sub">C@(ci + 1) · @cand.SupportTierCode support · @cand.EvidenceCoverage.ToString("P0") coverage · Not an attorney-ready determination</div>
                                                                        <div class="dcc-compare-track"><div class="dcc-compare-fill" style="width:@(pct)%"></div></div>
                                                                        @if (cand.BranchScores.Count > 0)
                                                                        {
                                                                            <div class="dfi-branchscore-strip">
                                                                                @foreach (var branch in cand.BranchScores.OrderByDescending(b => b.EvidenceScore))
                                                                                {
                                                                                    <span class="dfi-branchscore" title="@BranchScoreTooltip(branch)">
                                                                                        <span class="dfi-branchscore-name">@branch.BranchDisplayName</span>
                                                                                        <span class="dfi-branchscore-val">@branch.EvidenceScore.ToString("P0")</span>
                                                                                    </span>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                            else
                                            {
                                                <p class="dfi-empty">The candidate competition did not produce a scored ranking for this execution.</p>
                                            }
                                            @if (DfiCandidateDependencySummaries.Count > 0)
                                            {
                                                <p class="dfi-panel-sub">Required-dependency satisfaction (a candidate is not established until every required proposition is)</p>
                                                <div class="dfi-reqdep">
                                                    @foreach (var summary in DfiCandidateDependencySummaries)
                                                    {
                                                        <div class="dfi-reqdep-card">
                                                            <div class="dfi-reqdep-head">
                                                                <span class="dfi-reqdep-name">@summary.CandidateTitle</span>
                                                                <span class="dfi-pill dfi-pill-@(summary.HasUnresolvedRequired ? "warn" : "ok")">@summary.Established / @summary.Total established</span>
                                                            </div>
                                                            @foreach (var dep in summary.Required)
                                                            {
                                                                <div class="dfi-reqdep-row">
                                                                    <span class="dfi-reqdep-factor">@dep.FactorName</span>
                                                                    <span class="dfi-pill dfi-pill-@dep.Tone">@dep.State</span>
                                                                </div>
                                                                @if (!string.IsNullOrWhiteSpace(dep.Obligation))
                                                                {
                                                                    <div class="dfi-reqdep-obligation"><i class="bi bi-shield-exclamation"></i> @dep.Obligation</div>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            @if (DfiCompetitionBlockers.Count > 0)
                                            {
                                                <p class="dfi-panel-sub">Why the ranking is provisional</p>
                                                <ul class="dfi-list">
                                                    @foreach (var blocker in DfiCompetitionBlockers)
                                                    {
                                                        <li>@blocker</li>
                                                    }
                                                </ul>
                                            }
                                            @if (_response?.PoloxiComputationDetails is { } comp)
                                            {
                                                <p class="dfi-panel-sub">POLOXI computation details (@comp.AlgorithmVersion)</p>
                                                <div class="dfi-compdetails">
                                                    <div class="dfi-compweights">
                                                        <span class="dfi-compweight" title="Composite-score weight for the Legal support dimension.">Legal <strong>@comp.WeightLegal.ToString("0.##")</strong></span>
                                                        <span class="dfi-compweight" title="Composite-score weight for the Fact support dimension.">Fact <strong>@comp.WeightFact.ToString("0.##")</strong></span>
                                                        <span class="dfi-compweight" title="Composite-score weight for the Evidence support dimension.">Evidence <strong>@comp.WeightEvidence.ToString("0.##")</strong></span>
                                                        <span class="dfi-compweight" title="Composite-score weight for the Authority support dimension.">Authority <strong>@comp.WeightAuthority.ToString("0.##")</strong></span>
                                                        <span class="dfi-compweight" title="Composite-score weight for the Verification dimension.">Verification <strong>@comp.WeightVerification.ToString("0.##")</strong></span>
                                                    </div>
                                                    <dl class="dfi-compformulas">
                                                        <div><dt>Certainty ceiling</dt><dd>@comp.CertaintyCeilingFormula</dd></div>
                                                        <div><dt>Uncertainty</dt><dd>@comp.UncertaintyFormula</dd></div>
                                                        <div><dt>Margin</dt><dd>@comp.MarginFormula</dd></div>
                                                        <div><dt>Information value</dt><dd>@comp.InformationValueFormula</dd></div>
                                                    </dl>
                                                    <p class="dfi-compnote">@comp.RecompetitionNote</p>
                                                </div>
                                            }
                                        </div>
                                        break;
                                    case "Investigation":
                                        <div class="dfi-panel-card">
                                            <h4>Investigation plan</h4>
                                            <p class="dfi-panel-sub">Unresolved factors are turned into targeted investigation obligations. Resolving them is what changes support, uncertainty, and readiness.</p>
                                            @if (DfiNextRequiredWork.Count > 0)
                                            {
                                                <ol class="dcc-worklist">
                                                    @foreach (var work in DfiNextRequiredWork)
                                                    {
                                                        <li>@work</li>
                                                    }
                                                </ol>
                                            }
                                            else
                                            {
                                                <p class="dfi-empty">No open investigation obligations for the current execution.</p>
                                            }
                                            @if (DfiMissingFactorCount > 0)
                                            {
                                                <div class="dfi-dep-row">
                                                    <span>Missing factor value(s)</span>
                                                    <span class="dfi-pill dfi-pill-warn">@DfiMissingFactorCount</span>
                                                </div>
                                            }
                                        </div>
                                        break;
                                    case "Readiness":
                                <div class="dfi-panel-card">
                                    <h4>Decision Integrity</h4>
                                    <p class="dfi-panel-sub">Legal correctness is not a single confidence percentage. A technical execution can finish successfully without producing a sufficiently supported legal conclusion.</p>
                                    <div class="dfi-integrity-grid">
                                        @foreach (var ind in DfiIntegrityIndicators)
                                        {
                                            <div class="dfi-integrity-card">
                                                <div class="dfi-integrity-lbl">
                                                    <strong>@ind.Label</strong>
                                                    <small>@ind.Meaning</small>
                                                </div>
                                                <span class="dfi-pill dfi-pill-@ind.Tone">@ind.Value</span>
                                            </div>
                                        }
                                    </div>
                                    <p class="dfi-prototype-note">A COMPLETED technical execution is not by itself a successful legal decision. The distinction between execution, grounding, competition, and readiness is essential for enterprise trust.</p>
                                     </div>
                                     break;
                                case "Human Intelligence":
                                    <div class="hi-workspace">
                                        <div class="di-head">
                                            <div class="di-head-icon"><i class="bi bi-people"></i></div>
                                            <div class="di-head-body">
                                                <span>Attorney Decision Input</span>
                                                <h4>Human Intelligence</h4>
                                                <p class="dfi-panel-sub">Authorized attorneys contribute structured professional judgment — inclusion, placement, relative value and rationale — directly into the decision model. POLOXI remains the single authoritative evaluator.</p>
                                            </div>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm di-refresh" @onclick="LoadHumanIntelligenceAsync" disabled="@_humanIntelLoading" title="Reload human intelligence">
                                                <i class="bi @(_humanIntelLoading ? "bi-arrow-repeat di-spin" : "bi-arrow-clockwise")"></i>
                                            </button>
                                            @if (_humanIntel is { AttorneyDecisionInputEnabled: true })
                                            {
                                                <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenAddPropositionAsync" title="Add a candidate, factor or proposition to the decision model">
                                                    <i class="bi bi-plus-lg"></i><span>Add Proposition</span>
                                                </button>
                                            }
                                        </div>

                                        @if (_humanIntelError is not null)
                                        {
                                            <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_humanIntelError</div>
                                        }
                                        else if (_humanIntelLoading && _humanIntel is null)
                                        {
                                            <div class="di-empty"><i class="bi bi-hourglass-split"></i><p>Loading human intelligence…</p></div>
                                        }
                                        else if (_humanIntel is { AttorneyDecisionInputEnabled: false })
                                        {
                                            <div class="di-empty">
                                                <i class="bi bi-lock"></i>
                                                <p>Attorney Decision Input is not enabled for this workspace. Enable <code>AttorneyDecisionInput.Enabled</code> in decision settings to contribute and view attorney decision nodes.</p>
                                            </div>
                                        }
                                        else if (_humanIntel is null || _humanIntel.NodeCount == 0)
                                        {
                                            <div class="di-empty">
                                                <i class="bi bi-person-plus"></i>
                                                <p>No attorney decision input yet for this matter. When authorized attorneys add candidates, factors or propositions to the decision model, their assessments and approvals will appear here.</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="di-kpis">
                                                <div class="di-kpi"><span class="di-kpi-val">@_humanIntel.NodeCount</span><span class="di-kpi-lbl">Decision nodes</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@_humanIntel.AttorneyCount</span><span class="di-kpi-lbl">Attorneys</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@_humanIntel.AssessmentCount</span><span class="di-kpi-lbl">Assessments</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@_humanIntel.ApprovedAssessmentCount</span><span class="di-kpi-lbl">Approved</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@_humanIntel.OpenChallengeCount</span><span class="di-kpi-lbl">Open challenges</span></div>
                                            </div>

                                            <div class="di-grid">
                                                <div class="di-col">
                                                    <h5 class="di-col-title"><i class="bi bi-diagram-3"></i> Decision model hierarchy</h5>
                                                    @foreach (var node in HiNodes)
                                                    {
                                                        <button type="button" class="di-doc @(_hiSelectedNodeId == node.DecisionNodeId ? "di-doc--active" : "")"
                                                                style="padding-left:@(8 + Math.Max(0, node.NodeLevel - 1) * 14)px"
                                                                @onclick="() => _hiSelectedNodeId = node.DecisionNodeId">
                                                            <div class="di-doc-main">
                                                                <span class="di-pill di-pill-@HiKindTone(node.NodeKindCode)">L@node.NodeLevel</span>
                                                                <span class="di-doc-name" title="@node.NodeText">@node.NodeText</span>
                                                            </div>
                                                            <div class="di-doc-meta">
                                                                <span class="di-tag">@node.OriginCode</span>
                                                                @if (node.ApprovedAssessment is { } approved)
                                                                {
                                                                    <span class="di-doc-count" title="Approved matter assessment">@approved.ConfirmedValue.ToString("0.##")</span>
                                                                }
                                                                else if (node.Assessments.Count > 0)
                                                                {
                                                                    <span class="di-doc-count" title="Attorney assessments">@node.Assessments.Count</span>
                                                                }
                                                            </div>
                                                        </button>
                                                    }
                                                </div>

                                                <div class="di-col">
                                                    @if (HiSelectedNode is { } sel)
                                                    {
                                                        <h5 class="di-col-title"><i class="bi bi-card-list"></i> Selected node</h5>
                                                        <div class="dfi-panel-card">
                                                            <p class="di-prop-text">@sel.NodeText</p>
                                                            <ul class="dfi-list">
                                                                <li>Kind <span class="dfi-pill">@sel.NodeKindCode (L@sel.NodeLevel)</span></li>
                                                                <li>Origin <span class="dfi-pill">@sel.OriginCode</span></li>
                                                                <li>Structural <span class="dfi-pill">@sel.StructuralStateCode</span></li>
                                                                <li>Evidence <span class="dfi-pill">@sel.EvidenceStateCode</span></li>
                                                                <li>Authority <span class="dfi-pill">@sel.AuthorityStateCode</span></li>
                                                                <li>Final evaluated POLOXI value <span class="dfi-pill">@(sel.EvaluatedValue?.ToString("0.##") ?? "Pending")</span></li>
                                                                @if (sel.ApprovedAssessment is { } ap)
                                                                {
                                                                    <li>Approved matter assessment <span class="dfi-pill">@ap.ConfirmedValue.ToString("0.##") · @ap.ApprovedByDisplayName</span></li>
                                                                }
                                                            </ul>
                                                        </div>

                                                        <h5 class="di-col-title"><i class="bi bi-people"></i> Attorney assessments</h5>
                                                        @if (_humanIntel is { AttorneyDecisionInputEnabled: true })
                                                        {
                                                            <div class="adi-node-actions">
                                                                <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenAssessForm" disabled="@_hiNodeBusy"><i class="bi bi-pencil-square"></i> Add assessment</button>
                                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenRepositionForm" disabled="@_hiNodeBusy"><i class="bi bi-arrows-move"></i> Reposition</button>
                                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenChallengeForm" disabled="@_hiNodeBusy"><i class="bi bi-flag"></i> Raise challenge</button>
                                                            </div>
                                                            @if (_hiNodeError is not null)
                                                            {
                                                                <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_hiNodeError</div>
                                                            }
                                                            else if (_hiNodeNotice is not null)
                                                            {
                                                                <div class="alert alert-success">@_hiNodeNotice</div>
                                                            }
                                                            @if (_showAssessForm)
                                                            {
                                                                <div class="dfi-panel-card">
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Relative assessment (@_assessValue.ToString("0.#"))</label>
                                                                        <input type="range" min="0" max="100" step="1" @bind="_assessValue" @bind:event="oninput" />
                                                                    </div>
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Rationale (optional)</label>
                                                                        <textarea class="form-control" rows="2" @bind="_assessRationale" placeholder="Basis for your professional judgment."></textarea>
                                                                    </div>
                                                                    <div class="um-modal-footer">
                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showAssessForm = false" disabled="@_hiNodeBusy">Cancel</button>
                                                                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="SubmitAssessmentAsync" disabled="@_hiNodeBusy">@(_hiNodeBusy ? "Saving…" : "Submit assessment")</button>
                                                                    </div>
                                                                </div>
                                                            }
                                                            @if (_showChallengeForm)
                                                            {
                                                                <div class="dfi-panel-card">
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Challenge type</label>
                                                                        <select class="form-select" @bind="_challengeType">
                                                                            @foreach (var ct in HiChallengeTypes)
                                                                            {
                                                                                <option value="@ct">@ct</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Challenge detail</label>
                                                                        <textarea class="form-control" rows="2" @bind="_challengeText" placeholder="Describe the structural, placement, duplicate or premise concern."></textarea>
                                                                    </div>
                                                                    <div class="um-modal-footer">
                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showChallengeForm = false" disabled="@_hiNodeBusy">Cancel</button>
                                                                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="SubmitChallengeAsync" disabled="@_hiNodeBusy">@(_hiNodeBusy ? "Saving…" : "Raise challenge")</button>
                                                                    </div>
                                                                </div>
                                                            }
                                                            @if (_showRepositionForm)
                                                            {
                                                                <div class="dfi-panel-card">
                                                                    <p class="adi-disclosure"><i class="bi bi-info-circle"></i> Repositioning records a new node version and a DecisionDelta. It updates relative placement — not an evidence score.</p>
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Relative value (@_repositionValue.ToString("0.#"))</label>
                                                                        <input type="range" min="0" max="100" step="1" @bind="_repositionValue" @bind:event="oninput" />
                                                                    </div>
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Rationale (optional)</label>
                                                                        <textarea class="form-control" rows="2" @bind="_repositionRationale" placeholder="Why the placement is changing."></textarea>
                                                                    </div>
                                                                    <div class="um-modal-footer">
                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showRepositionForm = false" disabled="@_hiNodeBusy">Cancel</button>
                                                                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="RepositionNodeAsync" disabled="@_hiNodeBusy">@(_hiNodeBusy ? "Saving…" : "Reposition node")</button>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                        @if (sel.Assessments.Count == 0)
                                                        {
                                                            <p class="dfi-empty">No attorney assessments recorded for this node yet.</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="dfi-table-wrap">
                                                                <table class="dfi-table">
                                                                    <thead>
                                                                        <tr><th>Attorney</th><th>Role</th><th>Assessment</th><th>Rationale</th><th>Status</th><th>Date</th><th></th></tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var a in sel.Assessments)
                                                                        {
                                                                            <tr>
                                                                                <td>@(string.IsNullOrWhiteSpace(a.AttorneyDisplayName) ? "—" : a.AttorneyDisplayName)</td>
                                                                                <td>@(a.AttorneyRole ?? "—")</td>
                                                                                <td>@a.ConfirmedValue.ToString("0.##")</td>
                                                                                <td>@(string.IsNullOrWhiteSpace(a.Rationale) ? "—" : a.Rationale)</td>
                                                                                <td><span class="dfi-pill">@a.StatusCode</span></td>
                                                                                <td>@a.CreatedDateUtc.ToString("yyyy-MM-dd")</td>
                                                                                <td>
                                                                                    @if (_humanIntel is { AttorneyDecisionInputEnabled: true } && (sel.ApprovedAssessment is null || sel.ApprovedAssessment.AssessmentId != a.AssessmentId))
                                                                                    {
                                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ApproveAssessmentAsync(a.AssessmentId)" disabled="@_hiNodeBusy" title="Approve as the active matter assessment"><i class="bi bi-check2-circle"></i> Approve</button>
                                                                                    }
                                                                                    else if (sel.ApprovedAssessment is { } sa && sa.AssessmentId == a.AssessmentId)
                                                                                    {
                                                                                        <span class="dfi-pill">Approved</span>
                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                            <p class="dfi-prototype-note">Multiple attorneys may independently assess one canonical node. Assessments are never automatically averaged; only a single governance-approved matter assessment is eligible for authoritative POLOXI scoring.</p>
                                                        }
                                                    }
                                                                     else
                                                                     {
                                                                         <div class="di-empty"><i class="bi bi-hand-index"></i><p>Select a decision node to review its attorney assessments and approval status.</p></div>
                                                                     }
                                                                 </div>
                                                             </div>
                                                        }
                                                    </div>

                                                    @if (_adiShowWizard)
                                                    {
                                                        <div class="um-modal-backdrop" @onclick="CloseAddProposition">
                                                            <div class="um-modal um-modal--xl" @onclick:stopPropagation="true">
                                                                <div class="um-modal-header">
                                                                    <i class="bi bi-plus-square"></i>
                                                                    <span>Add Proposition — Attorney Decision Input</span>
                                                                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseAddProposition"><i class="bi bi-x-lg"></i></button>
                                                                </div>
                                                                <div class="um-modal-body adi-editor">
                                                                    <div class="adi-editor-col adi-editor-left">
                                                                        <div class="adi-panel-num">1</div>
                                                                        <div class="adi-panel-head">
                                                                            <h5>Decision Model Hierarchy</h5>
                                                                            <div class="adi-tree-tabs" role="tablist">
                                                                                @foreach (var v in new[] { "Hierarchy", "List View", "Search" })
                                                                                {
                                                                                    <button type="button" class="adi-tree-tab @(_adiTreeView == v ? "adi-tree-tab--active" : "")" @onclick="() => _adiTreeView = v">@v</button>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                        @if (_adiTreeView == "Search")
                                                                        {
                                                                            <div class="adi-tree-search">
                                                                                <i class="bi bi-search"></i>
                                                                                <input type="text" placeholder="Search nodes…" @bind="_adiTreeSearch" @bind:event="oninput" />
                                                                            </div>
                                                                        }
                                                                        <div class="adi-tree">
                                                                            @if (_adiTreeView == "Hierarchy")
                                                                            {
                                                                                @if (!AdiHasLiveHierarchy)
                                                                                {
                                                                                    <p class="adi-tree-empty">No decision hierarchy yet. Run a decision analysis so the hierarchy (L1/L2/L3…) is available for placement.</p>
                                                                                }
                                                                                @foreach (var root in AdiBranchRoots)
                                                                                {
                                                                                    var rootCollapsed = AdiBranchCollapsed(root.WideBranchId);
                                                                                    <div class="adi-tree-group">
                                                                                        <button type="button" class="adi-tree-row adi-tree-row--candidate @(_adiBranchId == root.WideBranchId ? "adi-tree-row--active" : "")"
                                                                                                @onclick="() => AdiSelectBranch(root.WideBranchId)">
                                                                                            <span class="adi-tree-caret" @onclick:stopPropagation="true" @onclick="() => AdiToggleBranch(root.WideBranchId)">
                                                                                                <i class="bi @(rootCollapsed ? "bi-chevron-right" : "bi-chevron-down")"></i>
                                                                                            </span>
                                                                                            <span class="adi-tree-code">@AdiBranchCode(root)</span>
                                                                                            <span class="adi-tree-text" title="@root.Interpretation">@root.DisplayName</span>
                                                                                            <span class="adi-tree-lvl">L1</span>
                                                                                        </button>
                                                                                        @if (!rootCollapsed)
                                                                                        {
                                                                                            @AdiBranchTree(root.WideBranchId, 1)
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                @foreach (var node in AdiFlatNodes)
                                                                                {
                                                                                    var nScore = AdiNodeScore(node);
                                                                                    <button type="button" class="adi-tree-row adi-tree-flat @(_hiSelectedNodeId == node.DecisionNodeId ? "adi-tree-row--active" : "")"
                                                                                            @onclick="() => _hiSelectedNodeId = node.DecisionNodeId">
                                                                                        <span class="adi-tree-lvl">L@node.NodeLevel</span>
                                                                                        <span class="adi-tree-text" title="@node.NodeText">@node.NodeText</span>
                                                                                        <span class="adi-score adi-score--@AdiScoreTone(nScore)">@(nScore?.ToString("0") ?? "—")</span>
                                                                                    </button>
                                                                                }
                                                                                @if (AdiFlatNodes.Count == 0)
                                                                                {
                                                                                    <p class="adi-tree-empty">No matching nodes.</p>
                                                                                }
                                                                            }
                                                                        </div>
                                                                    </div>

                                                                    <div class="adi-editor-col adi-editor-mid">
                                                                    <div class="adi-steps">
                                                                        @foreach (var (idx, label) in AdiSteps.Select((l, i) => (i + 1, l)))
                                                                        {
                                                                            <div class="adi-step @(_adiStep == idx ? "adi-step--active" : _adiStep > idx ? "adi-step--done" : "")">
                                                                                <span class="adi-step-num">@idx</span><span class="adi-step-lbl">@label</span>
                                                                            </div>
                                                                        }
                                                                    </div>

                                                                    @if (_adiError is not null)
                                                                    {
                                                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_adiError</div>
                                                                    }

                                                                    @switch (_adiStep)
                                                                    {
                                                                        case 1:
                                                                            <div class="um-form-grid">
                                                                                <div class="adi-field">
                                                                                    <label>Proposition type</label>
                                                                                    <div class="adi-type-row">
                                                                                        @foreach (var (kind, lvl, lbl) in AdiTypeOptions)
                                                                                        {
                                                                                            <button type="button" class="adi-type @(_adiKind == kind && _adiLevel == lvl ? "adi-type--active" : "")" @onclick="() => SelectAdiType(kind, lvl)">@lbl</button>
                                                                                        }
                                                                                    </div>
                                                                                </div>
                                                                                <div class="adi-field">
                                                                                    <label>Owning candidate (L1 scope)</label>
                                                                                    <select class="form-select" @bind="_adiCandidateNodeId">
                                                                                        <option value="">— Select candidate —</option>
                                                                                        @foreach (var c in HiNodes.Where(n => n.NodeLevel == 1))
                                                                                        {
                                                                                            <option value="@c.DecisionNodeId">@c.NodeText</option>
                                                                                        }
                                                                                    </select>
                                                                                </div>
                                                                                <div class="adi-field">
                                                                                    <label>Parent node (placement)</label>
                                                                                    <select class="form-select" @bind="_adiParentNodeId">
                                                                                        <option value="">— Top of candidate —</option>
                                                                                        @foreach (var p in HiNodes.Where(n => n.NodeLevel == _adiLevel - 1))
                                                                                        {
                                                                                            <option value="@p.DecisionNodeId">L@p.NodeLevel · @p.NodeText</option>
                                                                                        }
                                                                                    </select>
                                                                                </div>
                                                                                <div class="adi-field adi-field--full">
                                                                                    <label>Proposition text</label>
                                                                                    <textarea class="form-control" rows="3" maxlength="500" @bind="_adiText" placeholder="State the proposition as a single, independently evaluable assertion."></textarea>
                                                                                </div>
                                                                                <div class="adi-field adi-field--full">
                                                                                    <label>Rationale (optional)</label>
                                                                                    <textarea class="form-control" rows="2" @bind="_adiRationale" placeholder="Why it matters, or why an existing node/relationship is disputed."></textarea>
                                                                                </div>
                                                                            </div>
                                                                            @if (_adiDraft is { } draft)
                                                                            {
                                                                                <div class="adi-checks">
                                                                                    <span class="adi-check adi-check--@(draft.AtomicityDisposition == "Atomic" ? "ok" : draft.AtomicityDisposition == "NotApplicable" ? "muted" : "warn")"><i class="bi bi-diagram-3"></i> Atomicity: @draft.AtomicityDisposition</span>
                                                                                    <span class="adi-check adi-check--@(draft.ParentFidelity == "Good" ? "ok" : "warn")"><i class="bi bi-signpost"></i> Parent fit: @draft.ParentFidelity</span>
                                                                                    <span class="adi-check adi-check--@(draft.PossibleDuplicates.Count == 0 ? "ok" : "warn")"><i class="bi bi-files"></i> Duplicates: @(draft.PossibleDuplicates.Count == 0 ? "None found" : $"{draft.PossibleDuplicates.Count} possible")</span>
                                                                                    <span class="adi-check adi-check--muted"><i class="bi bi-bank"></i> @draft.LegalContextSummary</span>
                                                                                </div>
                                                                            }
                                                                            break;

                                                                        case 2:
                                                                            <p class="adi-disclosure"><i class="bi bi-info-circle"></i> @(_adiPlacement?.Disclosure ?? "Set a relative value based on your professional judgment. This is not an evidence score.")</p>
                                                                            <div class="adi-placement">
                                                                                <div class="adi-neighbor">
                                                                                    <span class="adi-neighbor-lbl">Previous</span>
                                                                                    <span class="adi-neighbor-txt">@(_adiPlacement?.PreviousSiblingText ?? "—")</span>
                                                                                    <span class="adi-neighbor-val">@(_adiPlacement?.PreviousSiblingValue?.ToString("0.#") ?? "—")</span>
                                                                                </div>
                                                                                <div class="adi-slider">
                                                                                    <div class="adi-slider-val">@_adiConfirmedValue.ToString("0.#")</div>
                                                                                    <input type="range" min="@((double)(_adiPlacement?.LowerBound ?? 0))" max="@((double)(_adiPlacement?.UpperBound ?? 100))" step="1" @bind="_adiConfirmedValue" @bind:event="oninput" />
                                                                                    @if (_adiPlacement is { SuggestedMidpoint: { } mid })
                                                                                    {
                                                                                        <label class="adi-midpoint"><input type="checkbox" checked="@_adiUseMidpoint" @onchange="e => ApplyMidpoint((bool)e.Value!)" /> Use midpoint (@mid.ToString("0.#"))</label>
                                                                                    }
                                                                                </div>
                                                                                <div class="adi-neighbor">
                                                                                    <span class="adi-neighbor-lbl">Next</span>
                                                                                    <span class="adi-neighbor-txt">@(_adiPlacement?.NextSiblingText ?? "—")</span>
                                                                                    <span class="adi-neighbor-val">@(_adiPlacement?.NextSiblingValue?.ToString("0.#") ?? "—")</span>
                                                                                </div>
                                                                            </div>
                                                                            break;

                                                                        case 3:
                                                                            @if (_adiPreview is { } pv)
                                                                            {
                                                                                <div class="adi-preview">
                                                                                    <div class="adi-preview-scores">
                                                                                        <div class="adi-score"><span class="adi-score-lbl">Current</span><span class="adi-score-val">@pv.CurrentCandidateScore.ToString("0.#")</span></div>
                                                                                        <i class="bi bi-arrow-right"></i>
                                                                                        <div class="adi-score"><span class="adi-score-lbl">Projected</span><span class="adi-score-val">@pv.ProjectedCandidateScore.ToString("0.#")</span><span class="adi-score-delta @(pv.CandidateScoreDelta >= 0 ? "adi-up" : "adi-down")">@pv.CandidateScoreDelta.ToString("+0.#;-0.#;0")</span></div>
                                                                                    </div>
                                                                                    <ul class="dfi-list">
                                                                                        <li>Uncertainty Δ <span class="dfi-pill">+@pv.UncertaintyDelta.ToString("0.####")</span></li>
                                                                                        <li>Information Value <span class="dfi-pill">@pv.InformationValueBand</span></li>
                                                                                        <li>Decision Frontier <span class="dfi-pill">@(pv.FrontierChanged ? "May change" : "Unchanged")</span></li>
                                                                                        <li>Readiness <span class="dfi-pill">@(pv.ReadinessBefore ?? "—") → @(pv.ReadinessAfter ?? "—")</span></li>
                                                                                        <li>Affected path <span class="dfi-pill">@string.Join(" → ", pv.AffectedPath)</span></li>
                                                                                    </ul>
                                                                                    @if (pv.ScoreProjectionAdvisory)
                                                                                    {
                                                                                        <p class="adi-disclosure"><i class="bi bi-info-circle"></i> @pv.ExplanationSummary</p>
                                                                                    }
                                                                                    @if (pv.IntegrityFindings.Count > 0)
                                                                                    {
                                                                                        <div class="adi-findings">@foreach (var f in pv.IntegrityFindings){<span class="adi-finding">@f</span>}</div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="di-empty"><i class="bi bi-hourglass-split"></i><p>Preparing preview…</p></div>
                                                                            }
                                                                            break;

                                                                        case 4:
                                                                            <div class="um-form-grid">
                                                                                <div class="adi-field adi-field--full">
                                                                                    <label>Proposition</label>
                                                                                    <p class="di-prop-text">@_adiText</p>
                                                                                </div>
                                                                                <div class="adi-field"><label>Relative assessment</label><p class="di-prop-text">@_adiConfirmedValue.ToString("0.#")</p></div>
                                                                                <div class="adi-field"><label>Method</label><p class="di-prop-text">@(_adiPlacement?.MethodCode ?? "BoundedEntry")</p></div>
                                                                                                <div class="adi-field adi-field--full">
                                                                                                    <label class="adi-checkbox"><input type="checkbox" @bind="_adiRequestApproval" /> Request approval as the Approved Matter Assessment (governance permitting)</label>
                                                                                                </div>
                                                                                            </div>
                                                                                            break;
                                                                                    }
                                                                                    </div>

                                                                                    <div class="adi-editor-col adi-editor-right">
                                                                                        <div class="adi-side-card">
                                                                                            <div class="adi-side-head"><span>Candidate Overview</span></div>
                                                                                            @if (HiNodes.FirstOrDefault(n => n.DecisionNodeId == _adiCandidateNodeId) is { } ov)
                                                                                            {
                                                                                                var ovScore = AdiNodeScore(ov);
                                                                                                <div class="adi-gauge">
                                                                                                    <div class="adi-gauge-ring adi-gauge-ring--@AdiScoreTone(ovScore)">
                                                                                                        <span class="adi-gauge-val">@(ovScore?.ToString("0") ?? "—")</span>
                                                                                                    </div>
                                                                                                    <span class="adi-gauge-lbl">POLOXI Decision Score</span>
                                                                                                </div>
                                                                                                <ul class="adi-side-list">
                                                                                                    <li><span>Candidate</span><strong>@AdiCandidateCode(ov.DecisionNodeId)</strong></li>
                                                                                                    <li><span>Evidence state</span><strong>@ov.EvidenceStateCode</strong></li>
                                                                                                    <li><span>Authority state</span><strong>@ov.AuthorityStateCode</strong></li>
                                                                                                    <li><span>Structural</span><strong>@ov.StructuralStateCode</strong></li>
                                                                                                </ul>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <p class="adi-side-empty">Select a candidate in the hierarchy to view its overview.</p>
                                                                                            }
                                                                                        </div>

                                                                                        <div class="adi-side-card">
                                                                                            <div class="adi-side-head"><span>Preview Impact (Real-time Simulation)</span></div>
                                                                                            @if (_adiPreview is { } pvr)
                                                                                            {
                                                                                                <div class="adi-side-scores">
                                                                                                    <div class="adi-side-score"><span>Current</span><strong>@pvr.CurrentCandidateScore.ToString("0.#")</strong></div>
                                                                                                    <i class="bi bi-arrow-right"></i>
                                                                                                    <div class="adi-side-score">
                                                                                                        <span>Projected</span>
                                                                                                        <strong>@pvr.ProjectedCandidateScore.ToString("0.#")
                                                                                                            <span class="adi-side-delta @(pvr.CandidateScoreDelta >= 0 ? "adi-up" : "adi-down")">@pvr.CandidateScoreDelta.ToString("+0.#;-0.#;0")</span>
                                                                                                        </strong>
                                                                                                    </div>
                                                                                                </div>
                                                                                                <p class="adi-side-why">@pvr.ExplanationSummary</p>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <p class="adi-side-empty">Advance to Preview Impact to simulate how this proposition changes the decision.</p>
                                                                                            }
                                                                                        </div>

                                                                                        <div class="adi-side-card">
                                                                                            <div class="adi-side-head"><span>Selected Node Details (Preview)</span></div>
                                                                                            @if (HiSelectedNode is { } selr)
                                                                                            {
                                                                                                <p class="adi-side-nodetext">@selr.NodeText</p>
                                                                                                <ul class="adi-side-list">
                                                                                                    <li><span>Kind</span><strong>@selr.NodeKindCode (L@selr.NodeLevel)</strong></li>
                                                                                                    <li><span>Status</span><strong>@selr.StructuralStateCode</strong></li>
                                                                                                    <li><span>Evidence</span><strong>@selr.EvidenceStateCode</strong></li>
                                                                                                    <li><span>Final evaluated</span><strong>@(selr.EvaluatedValue?.ToString("0.##") ?? "Pending")</strong></li>
                                                                                                </ul>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <p class="adi-side-empty">Select a node to preview its authoritative details.</p>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                <div class="um-modal-footer">
                                                                    @if (_adiStep > 1)
                                                                    {
                                                                        <button type="button" class="um-btn um-btn-ghost" @onclick="AdiBack" disabled="@_adiBusy"><i class="bi bi-arrow-left"></i> Back</button>
                                                                    }
                                                                    @if (_adiStep < 4)
                                                                    {
                                                                        <button type="button" class="um-btn um-btn-primary" @onclick="AdiNext" disabled="@(_adiBusy || !AdiCanAdvance)">
                                                                            @(_adiBusy ? "Working…" : AdiStep == 3 ? "Confirm" : "Next") <i class="bi bi-arrow-right"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="um-btn um-btn-primary" @onclick="AdiCommitAsync" disabled="@_adiBusy">
                                                                            <i class="bi bi-check-lg"></i> @(_adiBusy ? "Committing…" : "Add to Decision Model")
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                    break;
                                case "Document Intelligence":
                                    <div class="di-workspace">
                                    <div class="di-head">
                                        <div class="di-head-icon"><i class="bi bi-file-earmark-text"></i></div>
                                        <div class="di-head-body">
                                            <span>Decision-aware document intelligence</span>
                                            <h4>Source-traceable evidence &amp; supported facts</h4>
                                            <p class="dfi-panel-sub">Every extracted assertion is linked to the originating document, page, and passage — and to the fact propositions it supports or contradicts.</p>
                                        </div>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm di-refresh" @onclick="LoadEvidenceGraphAsync" disabled="@_evidenceGraphLoading" title="Reload document intelligence">
                                            <i class="bi @(_evidenceGraphLoading ? "bi-arrow-repeat di-spin" : "bi-arrow-clockwise")"></i>
                                        </button>
                                        <label class="um-btn um-btn-primary um-btn-sm di-upload @(_uploading ? "disabled" : "")" title="Upload one or more documents for real extraction (Blob storage + SHA-256 + Azure Document Intelligence)">
                                            <i class="bi @(_uploading ? "bi-hourglass-split di-spin" : "bi-cloud-arrow-up")"></i>
                                            <span>@(_uploading ? (_uploadTotal > 1 ? $"Analyzing {_uploadIndex}/{_uploadTotal}…" : "Analyzing…") : "Upload documents")</span>
                                            <InputFile OnChange="UploadDocumentAsync" disabled="@_uploading" multiple accept=".pdf,.docx,.txt,.png,.jpg,.jpeg,.tif,.tiff" style="display:none;" />
                                        </label>
                                    </div>

                                    <details class="di-evidence-context" style="margin:.5rem 0 .75rem;border:1px solid var(--um-border,#e2e8f0);border-radius:8px;padding:.5rem .75rem;">
                                        <summary style="cursor:pointer;font-weight:600;font-size:.85rem;"><i class="bi bi-fingerprint"></i> Evidence context (optional) — applied to the next upload as legal provenance</summary>
                                        <div class="um-form-grid" style="margin-top:.5rem;">
                                            <div class="um-field">
                                                <label>Source type</label>
                                                <select class="form-select form-select-sm" @bind="_evSourceType">
                                                    @foreach (var st in EvidenceSourceTypes)
                                                    {
                                                        <option value="@st">@st</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="um-field"><label>Custodian</label><input class="form-control form-control-sm" @bind="_evCustodian" placeholder="e.g. Jane Smith" /></div>
                                            <div class="um-field"><label>Produced by</label><input class="form-control form-control-sm" @bind="_evProducedBy" placeholder="e.g. Plaintiff" /></div>
                                            <div class="um-field"><label>Production ID</label><input class="form-control form-control-sm" @bind="_evProductionId" placeholder="e.g. PROD-001" /></div>
                                            <div class="um-field"><label>Bates start</label><input class="form-control form-control-sm" @bind="_evBatesStart" placeholder="e.g. P000123" /></div>
                                            <div class="um-field"><label>Bates end</label><input class="form-control form-control-sm" @bind="_evBatesEnd" placeholder="e.g. P000140" /></div>
                                        </div>
                                        <p style="font-size:.75rem;color:var(--um-text-muted,#64748b);margin:.4rem 0 0;">Physical bytes are deduplicated; this provenance is preserved as a distinct evidence occurrence. Leave blank to upload as a standalone occurrence.</p>
                                    </details>

                                    @if (_error is not null)
                                    {
                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_error</div>
                                    }

                                    @if (_evidenceGraphError is not null)
                                    {
                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_evidenceGraphError</div>
                                    }
                                    else if (_evidenceGraphLoading && _evidenceGraph is null)
                                    {
                                        <div class="di-empty"><i class="bi bi-hourglass-split"></i><p>Loading document intelligence…</p></div>
                                    }
                                    else if (_evidenceGraph is null || (_evidenceGraph.Evidence.Count == 0 && _evidenceGraph.Propositions.Count == 0))
                                    {
                                        <div class="di-empty">
                                            <i class="bi bi-inbox"></i>
                                            <p>No analyzed documents yet for this matter. Upload documents in the matter corpus and the extracted evidence graph will appear here.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="di-kpis">
                                            <div class="di-kpi"><span class="di-kpi-val">@_evidenceGraph.DocumentCount</span><span class="di-kpi-lbl">Documents</span></div>
                                            <div class="di-kpi"><span class="di-kpi-val">@_evidenceGraph.Evidence.Count</span><span class="di-kpi-lbl">Evidence items</span></div>
                                            <div class="di-kpi"><span class="di-kpi-val">@_evidenceGraph.Propositions.Count</span><span class="di-kpi-lbl">Fact propositions</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@_evidenceGraph.Propositions.Count(p => p.IsDecisionAuthoritative)</span><span class="di-kpi-lbl">Decision-authoritative</span></div>
                                            </div>

                                            <div class="di-subtabs" role="tablist" aria-label="Document Intelligence views">
                                                @foreach (var st in DiSubTabs)
                                                {
                                                    <button type="button" role="tab"
                                                            class="di-subtab @(_diSubTab == st ? "di-subtab--active" : "")"
                                                            aria-selected="@(_diSubTab == st ? "true" : "false")"
                                                            @onclick="() => _diSubTab = st">
                                                        <i class="bi @DiSubTabIcon(st)"></i>
                                                        <span>@st</span>
                                                    </button>
                                                }
                                            </div>

                                            @switch (_diSubTab)
                                            {
                                                case "Document Review":
                                            <div class="di-grid">
                                            <div class="di-col">
                                                <h5 class="di-col-title"><i class="bi bi-folder2-open"></i> Documents</h5>
                                                <button type="button" class="di-doc @(_diSelectedDocumentId is null ? "di-doc--active" : "")" @onclick="() => _diSelectedDocumentId = null">
                                                    <div class="di-doc-main"><i class="bi bi-collection"></i><span>All documents</span></div>
                                                    <span class="di-doc-count">@_evidenceGraph.Evidence.Count</span>
                                                </button>
                                                @foreach (var doc in _documents)
                                                {
                                                    <button type="button" class="di-doc @(_diSelectedDocumentId == doc.LegalDocumentId ? "di-doc--active" : "")" @onclick="() => _diSelectedDocumentId = doc.LegalDocumentId">
                                                        <div class="di-doc-main">
                                                            <i class="bi bi-file-earmark-text"></i>
                                                            <span class="di-doc-name" title="@doc.FileName">@doc.FileName</span>
                                                        </div>
                                                        <div class="di-doc-meta">
                                                            @if (!string.IsNullOrWhiteSpace(doc.DocumentTypeCode))
                                                            {
                                                                <span class="di-tag">@doc.DocumentTypeCode.Replace('_', ' ')</span>
                                                            }
                                                            <span class="di-doc-count">@DiEvidenceCountFor(doc.LegalDocumentId)</span>
                                                        </div>
                                                        @{
                                                            var latestVersion = doc.Versions.OrderByDescending(v => v.VersionNumber).FirstOrDefault();
                                                        }
                                                        @if (latestVersion is not null)
                                                        {
                                                            <div class="di-doc-provenance" title="@($"SHA-256 {latestVersion.Sha256Hash}\nStored at {latestVersion.StorageReference}")">
                                                                <span class="di-prov-badge @DiProcessingBadgeClass(latestVersion.ProcessingStatusCode)">
                                                                    <i class="bi bi-cpu"></i> @latestVersion.ProcessingStatusCode.Replace('_', ' ')
                                                                </span>
                                                                @if (!string.IsNullOrWhiteSpace(latestVersion.ExtractionModelCode))
                                                                {
                                                                    <span class="di-prov-model">
                                                                        @latestVersion.ExtractionModelCode@(string.IsNullOrWhiteSpace(latestVersion.ExtractionModelVersion) ? "" : $" · {latestVersion.ExtractionModelVersion}")
                                                                    </span>
                                                                }
                                                                <span class="di-prov-hash"><i class="bi bi-fingerprint"></i> @DiShortHash(latestVersion.Sha256Hash)</span>
                                                            </div>
                                                        }
                                                    </button>
                                                }
                                            </div>

                                            <div class="di-col">
                                                <h5 class="di-col-title"><i class="bi bi-chat-square-quote"></i> Extracted evidence <small>@(_diSelectedDocumentId is null ? "(all)" : "(filtered)")</small></h5>
                                                @if (!DiVisibleEvidence.Any())
                                                {
                                                    <div class="di-empty di-empty--sm"><i class="bi bi-search"></i><p>No evidence for the selected document.</p></div>
                                                }
                                                else
                                                {
                                                    @foreach (var ev in DiVisibleEvidence)
                                                    {
                                                        <div class="di-evidence @(DiIsExcludedEvidence(ev.EvidenceStateCode) ? "di-evidence--excluded" : "")">
                                                           <div class="di-evidence-top">
                                                               <span class="di-dim">@ev.DimensionCode.Replace('_', ' ')</span>
                                                               <span class="di-pill @DiEvidenceStateToneClass(ev.EvidenceStateCode)" title="@(DiIsExcludedEvidence(ev.EvidenceStateCode) ? "Excluded: source passage lacks a traceable source span, so this assertion is not admissible as decision evidence." : "Evidence admission state")">@ev.EvidenceStateCode</span>
                                                               @if (ev.Confidence is { } c)
                                                               {
                                                                   <span class="di-conf" title="Extraction confidence">@c.ToString("P0")</span>
                                                               }
                                                           </div>
                                                           <p class="di-evidence-summary">@ev.Summary</p>
                                                           @if (DiIsExcludedEvidence(ev.EvidenceStateCode))
                                                           {
                                                                   <p class="di-evidence-exclusion"><i class="bi bi-exclamation-triangle"></i> Not admitted — no traceable source span to ground this assertion.</p>
                                                               }
                                                                @if (!string.IsNullOrWhiteSpace(ev.PassageText))
                                                                {
                                                                    <blockquote class="di-passage">“@ev.PassageText”</blockquote>
                                                                }
                                                                <div class="di-cite">
                                                                    <i class="bi bi-file-earmark-text"></i>
                                                                    <span class="di-cite-doc" title="@ev.DocumentFileName">@ev.DocumentFileName</span>
                                                                    <span class="di-cite-loc">v@(ev.DocumentVersionNumber)@(ev.PageNumber is { } pg ? $" · p.{pg}" : "")@(string.IsNullOrWhiteSpace(ev.SectionPath) ? "" : $" · {ev.SectionPath}")</span>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>

                                            <div class="di-col">
                                                <h5 class="di-col-title"><i class="bi bi-diagram-3"></i> Supported facts</h5>
                                                @if (_evidenceGraph.Propositions.Count == 0)
                                                {
                                                    <div class="di-empty di-empty--sm"><i class="bi bi-diagram-3"></i><p>No fact propositions derived yet.</p></div>
                                                }
                                                else
                                                {
                                                    @foreach (var prop in _evidenceGraph.Propositions)
                                                    {
                                                        <div class="di-prop @(prop.IsDecisionAuthoritative ? "di-prop--authoritative" : "")">
                                                            <div class="di-prop-top">
                                                                <span class="di-pill di-pill--state">@prop.FactStateCode</span>
                                                                @if (prop.IsDecisionAuthoritative)
                                                                {
                                                                    <span class="di-pill di-pill--auth"><i class="bi bi-shield-check"></i> Authoritative</span>
                                                                }
                                                                @if (prop.Confidence is { } pc)
                                                                {
                                                                    <span class="di-conf">@pc.ToString("P0")</span>
                                                                }
                                                            </div>
                                                            <p class="di-prop-text">@prop.PropositionText</p>
                                                            @if (prop.Support.Count > 0)
                                                            {
                                                                <div class="di-support">
                                                                    @foreach (var sup in prop.Support)
                                                                    {
                                                                        <span class="di-pill @DiRelationToneClass(sup.RelationshipTypeCode)" title="@sup.AssessmentReason">@sup.RelationshipTypeCode</span>
                                                                    }
                                                                </div>
                                                            }
                                                                                </div>
                                                                            }
                                                                        }
                                                                    </div>
                                                                </div>
                                                                        break;

                                                                    case "Atomic Propositions":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-diagram-3"></i> Atomic propositions</h5>
                                                                            <p class="di-analysis-sub">Fact propositions derived from this matter's corpus, with structural state, decision authority and proof support. POLOXI remains the single authoritative evaluator; retrieval rank is never shown as evidence support.</p>
                                                                        </div>
                                                                        <span class="di-analysis-count">@_evidenceGraph.Propositions.Count proposition(s) · @_evidenceGraph.Propositions.Count(p => p.IsDecisionAuthoritative) authoritative</span>
                                                                    </div>
                                                                    @if (_evidenceGraph.Propositions.Count == 0)
                                                                    {
                                                                        <div class="di-empty di-empty--sm"><i class="bi bi-diagram-3"></i><p>No atomic propositions derived yet for this matter. Upload and analyze documents in the matter corpus to populate the proposition graph.</p></div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead>
                                                                                    <tr><th>Proposition</th><th>State</th><th>Origin</th><th>Authority</th><th>Confidence</th><th>Support</th></tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var prop in _evidenceGraph.Propositions)
                                                                                    {
                                                                                        <tr class="@(_diSelectedPropositionId == prop.LegalFactPropositionId ? "di-row--active" : "")"
                                                                                            @onclick="() => _diSelectedPropositionId = prop.LegalFactPropositionId" style="cursor:pointer;">
                                                                                            <td>@prop.PropositionText</td>
                                                                                            <td><span class="di-pill di-pill--state">@prop.FactStateCode</span></td>
                                                                                            <td><span class="di-tag">@prop.GenerationOriginCode.Replace('_', ' ')</span></td>
                                                                                            <td>
                                                                                                @if (prop.IsDecisionAuthoritative)
                                                                                                {
                                                                                                    <span class="di-pill di-pill--auth"><i class="bi bi-shield-check"></i> Authoritative</span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <span class="di-pill">Advisory</span>
                                                                                                }
                                                                                            </td>
                                                                                            <td>@(prop.Confidence is { } pc ? pc.ToString("P0") : "—")</td>
                                                                                            <td>@prop.Support.Count edge(s)</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                        break;

                                                                    case "Evidence Bindings":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-link-45deg"></i> Evidence bindings</h5>
                                                                            <p class="di-analysis-sub">Each binding links an extracted evidence item to the proposition it supports, contradicts, qualifies or contextualizes. Supporting, contradicting and insufficient evidence are shown simultaneously — contradiction is never hidden behind a count.</p>
                                                                        </div>
                                                                        <span class="di-analysis-count">@DiBindingEdges.Count binding(s)</span>
                                                                    </div>
                                                                    @if (DiBindingEdges.Count == 0)
                                                                    {
                                                                        <div class="di-empty di-empty--sm"><i class="bi bi-link-45deg"></i><p>No proposition–evidence bindings yet. Bindings appear here once extracted assertions are aligned to fact propositions.</p></div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead>
                                                                                   <tr><th>Evidence (wired from)</th><th>Relation</th><th>Proposition (wired to)</th><th>Anchored quote</th><th>Source</th></tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var edge in DiBindingEdges)
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@(string.IsNullOrWhiteSpace(edge.EvidenceSummary) ? "—" : edge.EvidenceSummary)</td>
                                                                                            <td><span class="di-pill @DiRelationToneClass(edge.RelationshipTypeCode)">@edge.RelationshipTypeCode.Replace('_', ' ')</span></td>
                                                                                            <td>@edge.PropositionText</td>
                                                                                            <td>
                                                                                                @if (string.IsNullOrWhiteSpace(edge.AnchorQuote))
                                                                                                {
                                                                                                    <span class="di-cite-loc">—</span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <span class="di-anchor-quote">“@edge.AnchorQuote”</span>
                                                                                                    <span class="di-pill @DiAnchorToneClass(edge.AnchorVerificationStateCode)">@((edge.AnchorVerificationStateCode ?? "UNVERIFIED").Replace('_', ' '))</span>
                                                                                                }
                                                                                            </td>
                                                                                            <td class="di-cite-loc">@(string.IsNullOrWhiteSpace(edge.SourceReference) ? "—" : edge.SourceReference)</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                        <p class="dfi-prototype-note">Retrieval rank ≠ evidence relation ≠ POLOXI decision effect. Embedding finds, alignment verifies, POLOXI decides.</p>
                                                                    }
                                                                </div>
                                                                        break;

                                                                    case "Passage Analysis":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-chat-square-quote"></i> Passage analysis @(_diSelectedDocumentId is null ? "(all documents)" : "(selected document)")</h5>
                                                                            <p class="di-analysis-sub">Exact quotes with immutable source coordinates (document version, page, section). Select a document in the Document Review tab to scope this view.</p>
                                                                        </div>
                                                                        <span class="di-analysis-count">@DiVisibleEvidence.Count() passage(s)</span>
                                                                    </div>
                                                                    @if (!DiVisibleEvidence.Any())
                                                                    {
                                                                        <div class="di-empty di-empty--sm"><i class="bi bi-search"></i><p>No analyzed passages for the current selection.</p></div>
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var ev in DiVisibleEvidence)
                                                                        {
                                                                            <div class="di-evidence @(DiIsExcludedEvidence(ev.EvidenceStateCode) ? "di-evidence--excluded" : "")">
                                                                                <div class="di-evidence-top">
                                                                                    <span class="di-dim">@ev.DimensionCode.Replace('_', ' ')</span>
                                                                                    <span class="di-pill @DiEvidenceStateToneClass(ev.EvidenceStateCode)">@ev.EvidenceStateCode</span>
                                                                                    @if (ev.Confidence is { } c)
                                                                                    {
                                                                                        <span class="di-conf" title="Extraction confidence">@c.ToString("P0")</span>
                                                                                    }
                                                                                </div>
                                                                                <p class="di-evidence-summary">@ev.Summary</p>
                                                                                @if (!string.IsNullOrWhiteSpace(ev.PassageText))
                                                                                {
                                                                                    <blockquote class="di-passage">“@ev.PassageText”</blockquote>
                                                                                }
                                                                                <div class="di-cite">
                                                                                    <i class="bi bi-file-earmark-text"></i>
                                                                                    <span class="di-cite-doc" title="@ev.DocumentFileName">@ev.DocumentFileName</span>
                                                                                    <span class="di-cite-loc">v@(ev.DocumentVersionNumber)@(ev.PageNumber is { } pg ? $" · p.{pg}" : "")@(string.IsNullOrWhiteSpace(ev.SectionPath) ? "" : $" · {ev.SectionPath}")</span>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                                        break;

                                                                    case "Impact on Decisions":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-signpost-split"></i> Impact on decisions</h5>
                                                                            <p class="di-analysis-sub">How admitted evidence bears on the authoritative decision. This is the current authoritative snapshot — not a preview. Detailed before/after deltas are available on the Decision Change Intelligence (DCI) tab.</p>
                                                                        </div>
                                                                        <span class="di-analysis-badge"><i class="bi bi-shield-lock"></i> Authoritative snapshot</span>
                                                                    </div>
                                                                     <div class="di-kpis">
                                                                        <div class="di-kpi"><span class="di-kpi-val">@_evidenceGraph.Propositions.Count(p => p.IsDecisionAuthoritative)</span><span class="di-kpi-lbl">Decision-authoritative facts</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@DiContradictionCount</span><span class="di-kpi-lbl">Contradiction edges</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@DiSupportCount</span><span class="di-kpi-lbl">Supporting edges</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@DiInsufficientCount</span><span class="di-kpi-lbl">Insufficient edges</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@_evidenceGraph.Propositions.Count(p => p.Support.Count == 0)</span><span class="di-kpi-lbl">Facts without support</span></div>
                                                                    </div>
                                                                    @if (_evidenceGraph.Propositions.Count(p => p.IsDecisionAuthoritative) == 0)
                                                                    {
                                                                        @if (DiInsufficientCount > 0)
                                                                        {
                                                                            <div class="di-empty di-empty--sm"><i class="bi bi-signpost"></i><p>@DiInsufficientCount binding(s) are wired but currently <strong>insufficient</strong> — the evidence is not yet span-anchored/admitted, so no fact is decision-authoritative. Re-run activation after upload so admitted evidence can support or contradict a proposition.</p></div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="di-empty di-empty--sm"><i class="bi bi-signpost"></i><p>No decision-authoritative facts yet. Once evidence is admitted and POLOXI re-evaluates, decision impact appears here.</p></div>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead>
                                                                                    <tr><th>Authoritative fact</th><th>State</th><th>Supporting</th><th>Contradicting</th></tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var prop in _evidenceGraph.Propositions.Where(p => p.IsDecisionAuthoritative))
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@prop.PropositionText</td>
                                                                                            <td><span class="di-pill di-pill--state">@prop.FactStateCode</span></td>
                                                                                            <td>@prop.Support.Count(s => DiIsSupportRelation(s.RelationshipTypeCode))</td>
                                                                                            <td>@prop.Support.Count(s => DiIsContradictRelation(s.RelationshipTypeCode))</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                        break;
                                                                    case "Evidence Provenance":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-fingerprint"></i> Evidence provenance &amp; upload dashboard</h5>
                                                                            <p class="di-analysis-sub">Physical content is deduplicated by SHA-256, but every legal provenance occurrence (custodian, production, Bates range) is preserved. The same bytes arriving from two productions remain two admissible occurrences. Batch reports are immutable.</p>
                                                                        </div>
                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadProvenanceAsync" disabled="@_provenanceLoading" title="Reload evidence provenance">
                                                                            <i class="bi @(_provenanceLoading ? "bi-arrow-repeat di-spin" : "bi-arrow-clockwise")"></i>
                                                                        </button>
                                                                    </div>
                                                                    @if (_provenanceError is not null)
                                                                    {
                                                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_provenanceError</div>
                                                                    }
                                                                    <div class="di-kpis">
                                                                        <div class="di-kpi"><span class="di-kpi-val">@_uploadBatches.Count</span><span class="di-kpi-lbl">Upload batches</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@_evidenceOccurrences.Count</span><span class="di-kpi-lbl">Evidence occurrences</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@_evidenceOccurrences.Count(o => o.ContentReused)</span><span class="di-kpi-lbl">Content reused (deduped)</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@_evidenceOccurrences.Select(o => o.Sha256Hash).Distinct().Count()</span><span class="di-kpi-lbl">Distinct physical objects</span></div>
                                                                    </div>
                                                                    @if (_uploadBatches.Count > 0)
                                                                    {
                                                                        <h6 class="di-col-title" style="margin-top:.75rem;"><i class="bi bi-stack"></i> Upload batches</h6>
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead><tr><th>Batch</th><th>Source</th><th>Discovered</th><th>Accepted</th><th>Duplicates</th><th>Occurrences</th><th>Reused</th></tr></thead>
                                                                                <tbody>
                                                                                    @foreach (var batch in _uploadBatches)
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@batch.BatchNumber</td>
                                                                                            <td><span class="di-pill di-pill--state">@(batch.SourceTypeCode ?? "USER_UPLOAD")</span></td>
                                                                                            <td>@batch.FilesDiscovered</td>
                                                                                            <td>@batch.FilesAccepted</td>
                                                                                            <td>@batch.ExactContentDuplicates</td>
                                                                                            <td>@batch.NewEvidenceOccurrences</td>
                                                                                            <td>@batch.ProcessingReused</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    }
                                                                    @if (_evidenceOccurrences.Count > 0)
                                                                    {
                                                                        <h6 class="di-col-title" style="margin-top:.75rem;"><i class="bi bi-fingerprint"></i> Evidence occurrences</h6>
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead><tr><th>File</th><th>Source</th><th>Custodian</th><th>Production</th><th>Bates</th><th>Confidentiality</th><th>Privilege</th><th>Family</th><th>SHA-256</th><th>Content</th></tr></thead>
                                                                                <tbody>
                                                                                    @foreach (var occ in _evidenceOccurrences)
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@occ.FileName</td>
                                                                                            <td><span class="di-pill di-pill--state">@occ.SourceTypeCode</span></td>
                                                                                            <td>@(occ.Custodian ?? "—")</td>
                                                                                            <td>@(occ.ProductionId ?? "—")</td>
                                                                                            <td>@(string.IsNullOrWhiteSpace(occ.BatesStart) ? "—" : $"{occ.BatesStart}–{occ.BatesEnd}")</td>
                                                                                            <td>@(occ.ConfidentialityCode ?? "—")</td>
                                                                                            <td>@(occ.PrivilegeCode ?? "—")</td>
                                                                                            <td>@(occ.LegalDocumentFamilyId is null ? "—" : $"D{occ.FamilyDepth}·#{occ.FamilyOrdinal}")</td>
                                                                                            <td><code style="font-size:.72rem;">@(occ.Sha256Hash.Length > 12 ? occ.Sha256Hash[..12] : occ.Sha256Hash)…</code></td>
                                                                                            <td>@(occ.ContentReused ? "Reused" : "New")</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="di-empty di-empty--sm"><i class="bi bi-fingerprint"></i><p>No evidence occurrences yet. Set the evidence context above, then upload documents — each upload records a provenance occurrence even when identical bytes already exist.</p></div>
                                                                    }
                                                                    @if (_evidenceLineage.Count > 0)
                                                                    {
                                                                        <h6 class="di-col-title" style="margin-top:.75rem;"><i class="bi bi-diagram-3"></i> Evidence lineage <span class="di-pill di-pill--muted" title="Independent-source identity: DERIVATIVE members quote/restate the ORIGINAL and add no independent evidentiary weight.">advisory</span></h6>
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead><tr><th>Lineage</th><th>Independence basis</th><th>Origin</th><th>Members (role)</th></tr></thead>
                                                                                <tbody>
                                                                                    @foreach (var grp in _evidenceLineage)
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@(grp.LineageLabel ?? "—")</td>
                                                                                            <td><span class="di-pill di-pill--state">@grp.IndependenceBasisCode</span></td>
                                                                                            <td>@(grp.OriginDescription ?? "—")</td>
                                                                                            <td>@(grp.Members.Count == 0 ? "—" : string.Join(", ", grp.Members.Select(m => $"{m.FileName ?? "occurrence"} ({m.RoleCode})")))</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                                            </table>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                                        break;
                                                                                    case "Document Cleanup":
                                                                                <div class="di-analysis">
                                                                                    <div class="di-analysis-head">
                                                                                        <div>
                                                                                            <h5 class="di-col-title"><i class="bi bi-trash3"></i> Document cleanup &amp; recompute</h5>
                                                                                            <p class="di-analysis-sub">Permanently remove supporting documents and every derived passage, evidence item, proposition support, source anchor and provenance occurrence for this matter. Removing documents automatically recomputes all associated scoring, evidence/proposition states, decision authority and statuses. This cannot be undone.</p>
                                                                                        </div>
                                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadEvidenceGraphAsync" disabled="@_cleanupBusy" title="Reload documents">
                                                                                            <i class="bi bi-arrow-clockwise"></i>
                                                                                        </button>
                                                                                    </div>
                                                                                    @if (_cleanupError is not null)
                                                                                    {
                                                                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_cleanupError</div>
                                                                                    }
                                                                                    @if (_cleanupResult is not null)
                                                                                    {
                                                                                        <div class="alert alert-success d-flex align-items-start gap-2">
                                                                                            <i class="bi bi-check-circle-fill"></i>
                                                                                            <div>
                                                                                                <strong>Cleanup complete — scoring recomputed.</strong>
                                                                                                <div>
                                                                                                    Removed @_cleanupResult.Purge.DocumentsRemoved document(s), @_cleanupResult.Purge.DocumentVersionsRemoved version(s), @_cleanupResult.Purge.PassagesRemoved passage(s),
                                                                                                    @_cleanupResult.Purge.EvidenceItemsRemoved evidence item(s), @_cleanupResult.Purge.PropositionsRemoved proposition(s),
                                                                                                    @_cleanupResult.Purge.PropositionSupportsRemoved support edge(s), @_cleanupResult.Purge.SourceAssertionsRemoved source anchor(s),
                                                                                                    @_cleanupResult.Purge.EvidenceOccurrencesRemoved occurrence(s)@(_cleanupResult.Purge.UploadBatchesRemoved > 0 ? $", {_cleanupResult.Purge.UploadBatchesRemoved} upload batch(es)" : string.Empty).
                                                                                                </div>
                                                                                            </div>
                                                                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _cleanupResult = null" title="Dismiss"><i class="bi bi-x-lg"></i></button>
                                                                                        </div>
                                                                                    }
                                                                                    @if (_documents.Count == 0)
                                                                                    {
                                                                                        <div class="di-empty"><i class="bi bi-inbox"></i> No supporting documents for this matter.</div>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <div class="di-cleanup-actions" style="display:flex;gap:.5rem;align-items:center;margin:.5rem 0;flex-wrap:wrap;">
                                                                                            <button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick="ConfirmRemoveSelectedDocuments"
                                                                                                    disabled="@(_cleanupBusy || _selectedCleanupDocumentIds.Count == 0)">
                                                                                                <i class="bi bi-trash"></i> Remove selected (@_selectedCleanupDocumentIds.Count)
                                                                                            </button>
                                                                                            <button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick="ConfirmRemoveAllDocuments" disabled="@_cleanupBusy">
                                                                                                <i class="bi bi-trash3-fill"></i> Remove all documents
                                                                                            </button>
                                                                                            @if (_cleanupBusy)
                                                                                            {
                                                                                                <span class="di-pill di-pill--muted"><i class="bi bi-arrow-repeat di-spin"></i> Recomputing…</span>
                                                                                            }
                                                                                        </div>
                                                                                        <div class="dfi-table-wrap">
                                                                                            <table class="dfi-table">
                                                                                                <thead><tr>
                                                                                                    <th style="width:2.5rem;">
                                                                                                        <input type="checkbox" title="Select all"
                                                                                                               checked="@(_selectedCleanupDocumentIds.Count == _documents.Count && _documents.Count > 0)"
                                                                                                               @onchange="ToggleSelectAllCleanupDocuments" />
                                                                                                    </th>
                                                                                                    <th>Document</th><th>Type</th><th>Status</th><th>Versions</th><th style="width:6rem;"></th>
                                                                                                </tr></thead>
                                                                                                <tbody>
                                                                                                    @foreach (var doc in _documents)
                                                                                                    {
                                                                                                        <tr>
                                                                                                            <td>
                                                                                                                <input type="checkbox"
                                                                                                                       checked="@_selectedCleanupDocumentIds.Contains(doc.LegalDocumentId)"
                                                                                                                       @onchange="e => ToggleCleanupDocument(doc.LegalDocumentId, e)" />
                                                                                                            </td>
                                                                                                            <td>@doc.FileName</td>
                                                                                                            <td>@(doc.DocumentTypeCode ?? "—")</td>
                                                                                                            <td><span class="di-pill di-pill--state">@doc.StatusCode</span></td>
                                                                                                            <td>@doc.Versions.Count</td>
                                                                                                            <td>
                                                                                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Remove this document"
                                                                                                                        @onclick="() => ConfirmRemoveSingleDocument(doc)" disabled="@_cleanupBusy">
                                                                                                                    <i class="bi bi-trash text-danger"></i>
                                                                                                                </button>
                                                                                                            </td>
                                                                                                        </tr>
                                                                                                    }
                                                                                                </tbody>
                                                                                            </table>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                                        break;
                                                                                }
                                                                            }
                                                                                                    </div>
                                                            break;
                                                        case "Audit":
                                                            <div class="dfi-panel-card">
                                                                <h4>Execution audit</h4>
                                    <p class="dfi-panel-sub">Route @(_response?.DecisionInspector?.ExecutionMode.ExecutionRoute ?? "—") · prompt @(_response?.DecisionInspector?.ExecutionMode.PromptKey ?? "—").</p>
                                    <ul class="dfi-list">
                                        <li>Status <span class="dfi-pill">@(_response?.StatusCode ?? "—")</span></li>
                                        <li>Narrowing trend <span class="dfi-pill">@(_response?.FinalNarrowingTrend ?? "—")</span></li>
                                        <li>Information rounds <span class="dfi-pill">@(_response?.NarrowingIterations.Count ?? 0)</span></li>
                                                                 </ul>
                                                             </div>
                                                             break;
                                                    }
                                                </div>
                                            </div>
                                            }
                                                                         </div>
                                                                     </section>

                                        @if (_cleanupConfirm is not null)
                                        {
                                            <div class="um-modal-backdrop" @onclick="() => _cleanupConfirm = null">
                                                <div class="um-confirm-dialog" @onclick:stopPropagation="true">
                                                    <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-exclamation-octagon"></i></div>
                                                    <h4 class="um-confirm-title">@_cleanupConfirm.Title</h4>
                                                    <p class="um-confirm-text">@_cleanupConfirm.Message</p>
                                                    <div class="um-modal-footer">
                                                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => _cleanupConfirm = null" disabled="@_cleanupBusy">Cancel</button>
                                                        <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteCleanupAsync" disabled="@_cleanupBusy">
                                                            @if (_cleanupBusy)
                                                            {
                                                                <span><i class="bi bi-arrow-repeat di-spin"></i> Removing…</span>
                                                            }
                                                            else
                                                            {
                                                                <span><i class="bi bi-trash"></i> Remove &amp; recompute</span>
                                                            }
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (_matter is not null)
        {
            <div class="decision-matter-banner">
                <i class="bi bi-file-earmark-arrow-up"></i>
                <div class="decision-matter-banner-body">
                    <span>Matter corpus</span>
                    <strong>@_documents.Count document(s)</strong>
                </div>
                <InputFile OnChange="UploadDocumentAsync" disabled="@_uploading" multiple class="form-control form-control-sm ms-auto" style="max-width: 320px" />
                @if (_uploading)
                {
                    <span class="decision-chip">@(_uploadTotal > 1 ? $"Scanning and extracting {_uploadIndex}/{_uploadTotal}…" : "Scanning and extracting…")</span>
                }
            </div>
            @if (_uploadStages is not null)
            {
                <div class="intake-pipeline" role="list" aria-label="Document intake pipeline">
                    <span class="intake-phase-label" aria-hidden="true"><i class="bi bi-cloud-arrow-up"></i> Prepared on upload</span>
                    @for (var i = 0; i < _uploadStages.Count; i++)
                    {
                        var stage = _uploadStages[i];
                        @if (i > 0 && _uploadStages[i - 1].Segment != stage.Segment)
                        {
                            <i class="bi bi-chevron-double-right intake-step-arrow intake-phase-divider" aria-hidden="true"></i>
                            <span class="intake-phase-label intake-phase-activate" aria-hidden="true"><i class="bi bi-lightning-charge"></i> Activated on answer</span>
                        }
                        <div class="intake-step @UploadStageCss(stage.State)" role="listitem" title="@stage.Label">
                            <span class="intake-step-icon">
                                <i class="bi @UploadStageIcon(stage)"></i>
                            </span>
                            <span class="intake-step-label">@stage.Label</span>
                        </div>
                        @if (i < _uploadStages.Count - 1 && _uploadStages[i + 1].Segment == stage.Segment)
                        {
                            <i class="bi bi-chevron-right intake-step-arrow" aria-hidden="true"></i>
                        }
                    }
                    @if (_uploadResult != UploadResult.None)
                    {
                        <i class="bi bi-chevron-right intake-step-arrow" aria-hidden="true"></i>
                        <span class="intake-result @UploadResultCss(_uploadResult)" role="status" aria-live="polite">
                            <i class="bi @UploadResultIcon(_uploadResult)"></i>
                            <span>@UploadResultLabel(_uploadResult)</span>
                        </span>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(_uploadOutcome))
            {
                <div class="alert @(_uploadEnriched ? "alert-success" : "alert-warning") d-flex align-items-start gap-2 mt-2" role="status">
                    <i class="bi @(_uploadEnriched ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                    <div>
                        <strong>@(_uploadEnriched ? "Upload complete — here's what happened" : "Upload stored — but not yet in the reasoning engine")</strong>
                        <div>@_uploadOutcome</div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _uploadOutcome = null" title="Dismiss"><i class="bi bi-x-lg"></i></button>
                </div>
            }
        }

        <section class="poloxi-composer" aria-label="Wide enterprise question">
            <div class="poloxi-composer-input">
                <i class="bi bi-search" aria-hidden="true"></i>
                <textarea id="poloxi-query" class="poloxi-query-area" rows="3"
                          placeholder="Ask a detailed question — include your goals, constraints, and priorities. Example: Which policies are in trouble, considering lapse risk and claim history?"
                          @bind="_query" @bind:event="oninput" @onkeydown="KeyDown"></textarea>
            </div>
            <div class="poloxi-composer-footer">
                <span class="poloxi-composer-hint"><kbd>Enter</kbd> to search &middot; <kbd>Shift</kbd>+<kbd>Enter</kbd> for a new line</span>
                <label class="poloxi-model-select" title="Choose the language model used for this search. Auto lets the platform route to the best available model.">
                    <i class="bi bi-cpu" aria-hidden="true"></i>
                    <select @bind="_selectedModelCode" aria-label="Model">
                        <option value="">Auto</option>
                        @foreach (var model in _models)
                        {
                            <option value="@model.ModelCode">@model.ModelCode</option>
                        }
                    </select>
                </label>
                <label class="poloxi-model-select" title="Choose the search context. General uses the standard web grounding; Legal grounds answers in CourtListener case law and GovInfo/eCFR statutes and regulations.">
                    <i class="bi bi-bank" aria-hidden="true"></i>
                    <select @bind="_selectedContextCode" aria-label="Context">
                        @foreach (var context in _contexts)
                        {
                            <option value="@context.ContextCode">@context.DisplayName</option>
                        }
                    </select>
                </label>
                <label class="poloxi-toggle"><input type="checkbox" @bind="_usePoloxiEngine" /><span></span><strong>POLOXI Engine</strong></label>
                <button class="um-btn um-btn-primary" @onclick="SearchAsync" disabled="@(_loading||string.IsNullOrWhiteSpace(_query))"><i class="bi bi-stars"></i> Disambiguate &amp; Answer</button>
            </div>
        </section>

        @if (_loading)
        {
            <section class="poloxi-loading" role="status" aria-live="polite">
                <i class="bi bi-water poloxi-spinner"></i>
                <div>
                    <strong>Deep-sea-searching&hellip; @(_usePoloxiEngine ? "running progressive disambiguation" : "generating LLM answer")</strong>
                    <p>@(_usePoloxiEngine ? "Proposing a problem-specific hierarchy, progressively refining interpretation paths, eliminating weak candidates, and composing an answer from LLM knowledge." : "POLOXI Engine is off — composing a direct LLM answer without progressive refinement.")</p>
                    <div class="poloxi-loading-track"><span></span></div>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Stop this search — the running pipeline is cancelled server-side too." @onclick="CancelSearch"><i class="bi bi-x-circle"></i> Cancel</button>
            </section>
                @GroupDetailsPanel
        }
        else if (_error is not null)
        {
            <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_error</div>
        }
        else if (_response is not null)
        {
            @if (_response.StatusCode == "USER_CLARIFICATION_REQUIRED" && !string.IsNullOrWhiteSpace(_response.ClarificationQuestion))
            {
                <section class="poloxi-explanation">
                    <div class="poloxi-explanation-icon"><i class="bi bi-question-circle"></i></div>
                    <div class="poloxi-explanation-body">
                        <div class="poloxi-panel-header"><div><span>POLOXI needs one more detail before it can answer responsibly</span><h2>Clarification needed</h2></div><span class="poloxi-status">@(_response.ClarificationTarget ?? "AMBIGUOUS")</span></div>
                        <p>@_response.ClarificationQuestion</p>
                        @if (_response.ClarificationOptionItems.Count > 0)
                        {
                            <div class="poloxi-grounded-branches">
                                <small title="POLOXI already researched the possibilities — recognize the description instead of recalling a name, or type your own answer below.">Which sounds like the one you mean?</small>
                                <div class="poloxi-branch-level">
                                    @foreach (var option in _response.ClarificationOptionItems)
                                    {
                                        <button type="button" class="um-btn um-btn-secondary um-btn-sm" disabled="@_loading" @onclick="() => SubmitClarificationAsync(option.Value ?? option.Label)">@option.Label</button>
                                    }
                                </div>
                            </div>
                        }
                        else if (_response.ClarificationOptions.Count > 0)
                        {
                            <div class="poloxi-grounded-branches">
                                <small title="Top competing candidates — pick the one you mean, or type your own answer below.">Top competing candidates:</small>
                                <div class="poloxi-branch-level">
                                    @foreach (var option in _response.ClarificationOptions)
                                    {
                                        <button type="button" class="um-btn um-btn-secondary um-btn-sm" disabled="@_loading" @onclick="() => SubmitClarificationAsync(option)">@option</button>
                                    }
                                </div>
                            </div>
                        }
                        <div class="um-search-box" style="margin-top:.75rem;">
                            <input class="um-search-input" placeholder="Or describe what you mean in your own words…" @bind="_clarificationAnswer" @bind:event="oninput" @onkeydown="ClarificationKeyDown" />
                            <button class="um-btn um-btn-primary" disabled="@(_loading || string.IsNullOrWhiteSpace(_clarificationAnswer))" @onclick="() => SubmitClarificationAsync(_clarificationAnswer)"><i class="bi bi-arrow-return-right"></i> Continue</button>
                        </div>
                    </div>
                </section>
            }
            @if (ShowAnswerView && _response.AnswerContext is { } answerContext)
            {
                <section class="poloxi-answer-card poloxi-reveal">
                    <div class="poloxi-answer-head">
                        <div>
                            <span class="poloxi-answer-kicker">@AnswerModeKicker(answerContext)</span>
                            @if (answerContext.WinnerDisplayName is not null)
                            {
                                <h2><strong>@answerContext.WinnerDisplayName</strong> ranks #1 in this analysis</h2>
                            }
                            else
                            {
                                <h2>Analysis result</h2>
                            }
                        </div>
                        <span class="poloxi-confidence-pill poloxi-confidence-pill--@answerContext.ConfidenceLabel.ToLowerInvariant()" title="@ConfidenceTooltip">
                            <i class="bi bi-shield-check"></i> @(HasAnyEvidence ? $"{answerContext.ConfidenceLabel} evidence confidence" : "Evidence confidence: NONE") · @GroundingBadge
                        </span>
                    </div>
                    <p class="poloxi-answer-narrative">@answerContext.ConfidenceNarrative</p>
                    @if (_response.LegalAnswer is { } legalAnswer)
                    {
                        <div class="poloxi-answer-section poloxi-reveal poloxi-legal-answer">
                            <h3><i class="bi bi-briefcase"></i> Attorney-ready answer</h3>
                            @if (!DfiDecisionReady)
                            {
                                <div class="poloxi-proposed-caution" style="border-left: 4px solid #dc3545;">
                                    <i class="bi bi-exclamation-triangle"></i> This analysis is <strong>not decision-ready</strong>. The authoritative Decision Inspector reports the matter decision contract or core evaluation is incomplete. Treat the content below as a draft to review, not a verified conclusion.
                                </div>
                            }
                            <div class="poloxi-legal-block">
                                <h4>Conclusion</h4>
                                <p>@legalAnswer.Conclusion</p>
                            </div>
                            <div class="poloxi-legal-block">
                                <h4>Analysis</h4>
                                <p>@legalAnswer.Analysis</p>
                            </div>
                            @if (legalAnswer.KeyAuthorities.Count > 0)
                            {
                                <div class="poloxi-legal-block">
                                    <h4>Key Authorities</h4>
                                    <ul class="poloxi-legal-authorities">
                                        @foreach (var authority in legalAnswer.KeyAuthorities)
                                        {
                                            <li>
                                                @if (!string.IsNullOrWhiteSpace(authority.Reference))
                                                {
                                                    <a href="@authority.Reference" target="_blank" rel="noopener"><strong>@authority.Name</strong></a>
                                                }
                                                else
                                                {
                                                    <strong>@authority.Name</strong>
                                                }
                                                <span> — @authority.Relevance</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            <div class="poloxi-legal-block">
                                <h4>Application</h4>
                                <p>@legalAnswer.Application</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(legalAnswer.Counterargument))
                            {
                                <div class="poloxi-legal-block">
                                    <h4>Counterargument</h4>
                                    <p>@legalAnswer.Counterargument</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(legalAnswer.RemainingUncertainty))
                            {
                                <div class="poloxi-legal-block">
                                    <h4>Remaining Uncertainty</h4>
                                    <p>@legalAnswer.RemainingUncertainty</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(legalAnswer.DecisiveMissingFact))
                            {
                                <div class="poloxi-legal-block poloxi-legal-decisive">
                                    <h4><i class="bi bi-key"></i> Decisive missing fact</h4>
                                    <p>@legalAnswer.DecisiveMissingFact</p>
                                </div>
                            }
                            <div class="poloxi-legal-block poloxi-legal-bottomline">
                                <h4>Bottom Line</h4>
                                <p>@legalAnswer.BottomLine</p>
                            </div>
                        </div>
                    }
                    @AmbiguityGroupsPanel
                    @if (answerContext.ResponseMode == WideResponseModes.LimitedEvidence)
                    {
                        <div class="poloxi-evidence-warning"><i class="bi bi-exclamation-triangle"></i> Fewer deciding factors are evidence-backed than usual — verify before acting on this ranking.</div>
                    }
                    @if (answerContext.OutputContract is { IsSatisfied: false } contractResult)
                    {
                        <div class="poloxi-evidence-warning"><i class="bi bi-list-ol"></i> You asked for @contractResult.RequestedCount results, but only @contractResult.DeliveredCount candidates passed POLOXI's evidence and constraint checks@(contractResult.RecoveryAttempted ? " (a wider candidate recovery pass was attempted)" : "") — the ranking below is complete but shorter than requested.</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_response.FinalAnswer))
                    {
                        <div class="poloxi-answer-section poloxi-reveal poloxi-full-answer-primary">
                            <h3><i class="bi bi-card-text"></i> Full answer</h3>
                            <p>@_response.FinalAnswer</p>
                        </div>
                    }
                    @if (answerContext.CandidateSummaries.Count > 0)
                    {
                        <div class="poloxi-rank-table">
                            @foreach (var (summary, index) in answerContext.CandidateSummaries.Select((item, index) => (item, index)))
                            {
                                <div class="poloxi-rank-row poloxi-reveal" style="animation-delay:@($"{index * 70}ms")">
                                    <span class="poloxi-rank-medal @(index == 0 ? "poloxi-rank-medal--gold" : index == 1 ? "poloxi-rank-medal--silver" : index == 2 ? "poloxi-rank-medal--bronze" : null)">@(index switch { 0 => "🥇", 1 => "🥈", 2 => "🥉", _ => (index + 1).ToString() })</span>
                                    <div class="poloxi-rank-main">
                                        <strong>@summary.DisplayName</strong>
                                        @if (summary.SupportTierCode != "STRONG")
                                        {
                                            <span class="poloxi-tier-badge @(summary.SupportTierCode == "MODERATE" ? "poloxi-tier-badge--moderate" : "poloxi-tier-badge--limited")" title="@(summary.SupportTierCode == "MODERATE" ? "Moderate support — backed by fewer independent evidence signals than the top results" : "Limited support — provisional result backed by a single credible evidence signal")">@(summary.SupportTierCode == "MODERATE" ? "Moderate support" : "Limited support")</span>
                                        }
                                        @{ var hasInsights = summary.BestFor is not null || summary.PraisedFor.Count > 0 || summary.WatchOutFor.Count > 0; }
                                        @if (hasInsights)
                                        {
                                            <div class="poloxi-rank-facts">
                                                @if (summary.BestFor is not null)
                                                {
                                                    <span class="poloxi-fact-chip poloxi-fact-chip--bestfor" title="What this candidate is genuinely best for, based on retrieved evidence@(summary.BestForDimension is not null && summary.BestForScore is { } bfs ? $" — strongest decision dimension: {summary.BestForDimension} ({bfs:P0})" : "")">
                                                        🎯 Best for: @summary.BestFor
                                                    </span>
                                                }
                                                @if (summary.PraisedFor.Count > 0)
                                                {
                                                    <span class="poloxi-fact-chip poloxi-fact-chip--praise" title="Recurring strength themes the retrieved evidence actually supports">
                                                        👍 Praised for: @string.Join(" · ", summary.PraisedFor)
                                                    </span>
                                                }
                                                @if (summary.WatchOutFor.Count > 0)
                                                {
                                                    <span class="poloxi-fact-chip poloxi-fact-chip--watch" title="Recurring complaint or limitation themes the retrieved evidence actually supports">
                                                        ⚠ Watch out: @string.Join(" · ", summary.WatchOutFor)
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else if (summary.BestForDimension is not null || summary.TradeOffDimension is not null)
                                        {
                                            <div class="poloxi-rank-facts">
                                                @if (index == 0 && answerContext.WinnerStrengths.Count > 1)
                                                {
                                                    <span class="poloxi-fact-chip poloxi-fact-chip--strength" title="Top decision dimensions used for the winning candidate; the ranking is computed from the full Candidate × Branch matrix, not this chip alone.">
                                                        <i class="bi bi-diagram-3-fill"></i> Top factors: @string.Join(" · ", answerContext.WinnerStrengths.Take(3).Select(strength => $"{strength.DimensionName} {strength.Score:P0}"))
                                                    </span>
                                                }
                                                else if (summary.BestForDimension is not null)
                                                {
                                                    <span class="poloxi-fact-chip poloxi-fact-chip--strength" title="Strongest evidence-scored dimension for this candidate@(summary.BestForScore is { } bs ? $" — scored {bs:P0} on {summary.BestForDimension}" : "")">
                                                        <i class="bi bi-arrow-up-circle-fill"></i> Strongest: @summary.BestForDimension@(summary.BestForScore is { } bestScore ? $" · {bestScore:P0}" : "")
                                                    </span>
                                                }
                                                @if (summary.TradeOffDimension is not null)
                                                {
                                                    <span class="poloxi-fact-chip poloxi-fact-chip--tradeoff" title="Weakest evidence-scored dimension — the honest trade-off of choosing this candidate@(summary.TradeOffScore is { } ts ? $" — scored {ts:P0} on {summary.TradeOffDimension}" : "")">
                                                        <i class="bi bi-arrow-down-circle-fill"></i> Trade-off: @summary.TradeOffDimension@(summary.TradeOffScore is { } tradeScore ? $" · {tradeScore:P0}" : "")
                                                    </span>
                                                }
                                            </div>
                                        }
                                        <div class="poloxi-score-track"><span class="poloxi-score-fill" style="--score:@summary.CompositeScore.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"></span></div>
                                    </div>
                                    <span class="poloxi-rank-score" title="Match score — how well this candidate fits the decision criteria relative to the alternatives; not a probability that it is objectively the best">@summary.CompositeScore.ToString("P0")<small class="poloxi-rank-score-label">match</small></span>
                                </div>
                            }
                        </div>
                    }
                    @if (answerContext.WinnerStrengths.Count > 0 && answerContext.WinnerDisplayName is not null)
                    {
                        <div class="poloxi-answer-section poloxi-reveal">
                            <h3><i class="bi bi-trophy"></i> Why @answerContext.WinnerDisplayName won</h3>
                            <p>@(answerContext.WinnerStrengths.Count > 0 ? $"Its {string.Join(" and ", answerContext.WinnerStrengths.Take(2).Select(strength => $"{strength.Score:P0} {strength.DimensionName.ToLowerInvariant()}"))} score{(answerContext.WinnerStrengths.Take(2).Count() > 1 ? "s" : "")} created its largest advantages." : "It performed strongly across the criteria that drove this decision.")@(answerContext.WinnerWeaknesses.Count > 0 ? $" {string.Join(" and ", answerContext.WinnerWeaknesses.Select(weakness => $"{weakness.DimensionName} ({weakness.Score:P0})"))} {(answerContext.WinnerWeaknesses.Count > 1 ? "were" : "was")} comparatively weaker." : "")</p>
                            <div class="poloxi-dimension-bars">
                                @foreach (var strength in answerContext.WinnerStrengths)
                                {
                                    <div class="poloxi-dimension-bar">
                                        <span>@strength.DimensionName</span>
                                        <div class="poloxi-score-track"><span class="poloxi-score-fill" style="--score:@strength.Score.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"></span></div>
                                        <em>@strength.Score.ToString("P0")</em>
                                    </div>
                                }
                                @foreach (var weakness in answerContext.WinnerWeaknesses)
                                {
                                    <div class="poloxi-dimension-bar poloxi-dimension-bar--weak">
                                        <span>@weakness.DimensionName</span>
                                        <div class="poloxi-score-track"><span class="poloxi-score-fill" style="--score:@weakness.Score.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"></span></div>
                                        <em>@weakness.Score.ToString("P0")</em>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (answerContext.CandidateContrasts.Count > 0 && answerContext.WinnerDisplayName is not null)
                    {
                        <div class="poloxi-answer-section poloxi-reveal">
                            <h3><i class="bi bi-arrow-left-right"></i> Why not the others?</h3>
                            @foreach (var contrast in answerContext.CandidateContrasts)
                            {
                                <p class="poloxi-contrast">
                                    <strong>vs @contrast.AlternativeDisplayName (@contrast.AlternativeScore.ToString("P0"))</strong> —
                                    @if (contrast.AlternativeLeadsOn.Count > 0)
                                    {
                                        <span>competitive on @string.Join(", ", contrast.AlternativeLeadsOn.Select(dimension => dimension.ToLowerInvariant()))</span>
                                    }
                                    else
                                    {
                                        <span>close overall</span>
                                    }
                                    @if (contrast.WinnerLeadsOn.Count > 0)
                                    {
                                        <span>, but @answerContext.WinnerDisplayName led on @string.Join(", ", contrast.WinnerLeadsOn.Select(dimension => dimension.ToLowerInvariant())).</span>
                                    }
                                    else
                                    {
                                        <span>; the composite balance decided it.</span>
                                    }
                                </p>
                            }
                        </div>
                    }
                    @if (answerContext.ChangeableDimensions.Count > 0)
                    {
                        <div class="poloxi-answer-section poloxi-reveal">
                            <h3><i class="bi bi-sliders"></i> This ranking could change if…</h3>
                            <p>The candidates are separated most by these factors. Tell POLOXI what matters most to make this ranking yours:</p>
                            <div class="poloxi-personalize-chips">
                                @foreach (var dimension in answerContext.ChangeableDimensions)
                                {
                                    <button type="button" class="poloxi-personalize-chip" disabled="@_loading" @onclick="() => PersonalizeAsync(dimension)"><i class="bi bi-magic"></i> @dimension</button>
                                }
                            </div>
                        </div>
                    }
                    @if (answerContext.RankingChangeDriver is { } changeDriver && answerContext.WinnerDisplayName is not null)
                    {
                        <div class="poloxi-answer-section poloxi-reveal poloxi-change-driver">
                            <h3><i class="bi bi-arrow-left-right"></i> Most likely to change this ranking</h3>
                            <p>
                                <strong>@changeDriver.DimensionName</strong> — @answerContext.WinnerDisplayName currently leads by @changeDriver.MarginPoints.ToString("P0"), but <strong>@changeDriver.ChallengerDisplayName</strong> scores higher on this dimension@(changeDriver.ChallengerScore is { } cs && changeDriver.WinnerScore is { } ws ? $" ({cs:P0} vs {ws:P0})" : "").
                                If @changeDriver.DimensionName.ToLowerInvariant() resolves against the current leader, @changeDriver.ChallengerDisplayName is the most likely new #1.
                            </p>
                        </div>
                    }
                    @if (_response.QueryContract is { } answerCardContract && (answerCardContract.HardConstraints.Count > 0 || answerCardContract.AmbiguousConcepts.Count > 0))
                    {
                        <div class="poloxi-answer-section poloxi-reveal">
                            <h3><i class="bi bi-file-earmark-check"></i> Query contract</h3>
                            <div class="poloxi-grounded-branches">
                                <div class="poloxi-branch-level">
                                    @foreach (var constraint in answerCardContract.HardConstraints)
                                    {
                                        <span class="poloxi-branch-chip" title="Hard constraint — fixed by your query, never reinterpreted."><i class="bi bi-lock"></i>@constraint<em>FIXED</em></span>
                                    }
                                    @foreach (var concept in answerCardContract.AmbiguousConcepts)
                                    {
                                        <span class="poloxi-branch-chip" title="Ambiguous concept — the only part POLOXI disambiguated."><i class="bi bi-question-circle"></i>@concept<em>DISAMBIGUATED</em></span>
                                    }
                                             </div>
                                        </div>
                                    </div>
                                }
                                @if (_response.MatterContext is { } matterContext)
                                {
                                    <div class="poloxi-answer-section poloxi-reveal">
                                        <h3><i class="bi bi-folder-symlink"></i> Selected matter context <span class="poloxi-status">diagnostic</span></h3>
                                        <p>
                                            First-class proposal input projected into the discovery/hierarchy prompts@(matterContext.ProjectedIntoPrompt ? "" : " (not projected this run)").
                                            Domain Pack: <strong>@(matterContext.ResolvedDomainPackCode ?? matterContext.DomainPackCode ?? "—")</strong>@(matterContext.ResolvedDomainPackId is { } packId ? $" (id {packId})" : "")@(string.IsNullOrWhiteSpace(matterContext.PracticeAreaCode) ? "" : $" · Practice area: {matterContext.PracticeAreaCode}").
                                            @(string.IsNullOrWhiteSpace(matterContext.CandidateCompetitionStatus) ? "" : $" Candidate competition: {matterContext.CandidateCompetitionStatus}.")
                                            Distinct legal fields with provenance; supplied allegations are never treated as verified evidence.
                                        </p>
                                        @{
                                            var reachedScoring = _response.Candidates.Count(c => !c.IsConstraintViolation);
                                            // The competition genuinely executed once two or more competing outcomes reached
                                            // scoring, even if zero evidence was admitted. That is distinct from "blocked":
                                            // it adjudicated the dispositions but cannot certify a winner without verified
                                            // evidence. Distinguish the two so a legitimately-competing but unverified run is
                                            // not mislabeled as a failure. Trust the authoritative backend status first
                                            // (CandidateCompetitionStatus = "RAN ..." / DecisionReadinessStatus =
                                            // "CANDIDATES_REGISTERED_AND_COMPETED"); only fall back to the UI candidate
                                            // count when no backend status was emitted, so an executed run is never
                                            // mislabeled "Blocked" due to presentation-layer filtering.
                                            var backendCompeted =
                                                (matterContext.CandidateCompetitionStatus?.StartsWith("RAN", StringComparison.OrdinalIgnoreCase) ?? false)
                                                || (matterContext.DecisionReadinessStatus?.StartsWith("CANDIDATES_REGISTERED_AND_COMPETED", StringComparison.OrdinalIgnoreCase) ?? false);
                                            var competitionExecuted = backendCompeted || reachedScoring > 0;
                                            var executedUnverified = competitionExecuted && TotalEvidenceCount == 0;
                                            var blockers = DfiCompetitionBlockers;
                                            var statusClass = competitionExecuted
                                                ? (executedUnverified ? "poloxi-competition-status--unverified" : "poloxi-competition-status--ran")
                                                : "poloxi-competition-status--blocked";
                                            var badgeLabel = competitionExecuted
                                                ? (executedUnverified ? "ran \u2014 no verified winner" : "evaluated decision")
                                                : "interpretation only";
                                        }
                                        <div class="poloxi-competition-status @statusClass">
                                            <div class="poloxi-competition-status-head">
                                                <span class="poloxi-panel-icon"><i class="bi bi-diagram-3"></i></span>
                                                <div>
                                                    <span>Candidate Competition</span>
                                                    <strong>@(competitionExecuted ? "Executed" : "Blocked")</strong>
                                                </div>
                                                <span class="poloxi-competition-badge @(competitionExecuted ? (executedUnverified ? "warn" : "ok") : "warn")">@badgeLabel</span>
                                            </div>
                                            <div class="poloxi-competition-metrics">
                                                <div><span class="poloxi-competition-metric-label">Proposed outcomes</span><span class="poloxi-competition-metric-value">@matterContext.ProposedCandidateCount</span></div>
                                                <div><span class="poloxi-competition-metric-label">Reached scoring</span><span class="poloxi-competition-metric-value">@reachedScoring</span></div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(matterContext.NormalizationGateStatus))
                                            {
                                                <p class="poloxi-competition-detail">Normalization gate: <code>@matterContext.NormalizationGateStatus</code>@(string.IsNullOrWhiteSpace(matterContext.DecisionReadinessStatus) ? "" : $" · Readiness: {matterContext.DecisionReadinessStatus}")</p>
                                            }
                                            @if (executedUnverified)
                                            {
                                                <p class="poloxi-competition-note">The competition executed and adjudicated the competing outcomes, but <strong>no independently verified evidence was admitted</strong>, so no outcome is presented as an established winner. The leading outcome below is a provisional, quality-weighted hypothesis pending evidence verification &mdash; not a machinery failure.</p>
                                            }
                                            @if (!competitionExecuted && blockers.Count > 0)
                                            {
                                                <div class="poloxi-competition-blockers">
                                                    <span class="poloxi-competition-metric-label">Current blockers</span>
                                                    <ul>
                                                        @foreach (var blocker in blockers)
                                                        {
                                                            <li>@blocker</li>
                                                        }
                                                    </ul>
                                                </div>
                                                <p class="poloxi-competition-note">Illustrative presentation of the latest execution diagnostics. The values shown for leading interpretations are interpretation-prior confidence, not the result of a completed, evidence-verified candidate competition.</p>
                                            }
                                        </div>
                                        <pre class="poloxi-matter-context">@matterContext.SerializedContext</pre>
                                    </div>
                                }
                                @if (_response.SuggestedActions.Count > 0)
                    {
                        <div class="poloxi-answer-section poloxi-reveal">
                            <h3><i class="bi bi-arrow-right-circle"></i> Suggested actions</h3>
                            <div class="poloxi-grounded-branches">
                                <div class="poloxi-branch-level">
                                    @foreach (var action in _response.SuggestedActions)
                                    {
                                        <span class="poloxi-branch-chip poloxi-action-chip" title="@action.Rationale" @onclick="() => OpenRoute(action.NavigationRoute)"><i class="bi bi-arrow-right-circle"></i>@action.DisplayName</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
            @if (_response.Branches.Count > 0 || _response.ExternalReferences.Count > 0 || _response.InterpretiveResults.Count > 0)
            {
            <div class="poloxi-layout">
                <section class="poloxi-panel poloxi-hierarchy-panel">
                    <div class="poloxi-panel-header"><div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-diagram-3"></i></span><div><span>EPG Engine Logic Applied</span><h2>Reasoning hierarchy</h2></div></div></div>
                    <div class="poloxi-tree">
                        @foreach (var level in BranchLevels)
                        {

                            @foreach (var branch in level)
                            {
                                <article class="poloxi-branch @(branch.IsEliminated ? "poloxi-branch-unsupported" : "poloxi-branch-valid")">
                                    <span class="poloxi-branch-icon"><i class="bi @(branch.IsEliminated ? "bi-slash-circle" : branch.GroundingStatusCode == "GROUNDED" ? "bi-check2-circle" : "bi-lightbulb")"></i></span>
                                    <div class="poloxi-branch-body">
                                        <strong>@BranchDisplayWithLevel(branch)</strong>
                                        <p>@branch.Interpretation</p>
                                        <div class="poloxi-branch-assessment">
                                            <span class="decision-chip" title="Assessment of this reasoning branch based on information value, decision relevance and flip potential.">@(BranchAssessment(branch))</span>
                                            <small class="poloxi-branch-why" title="Why this branch received the assessment above.">@(BranchAssessmentWhy(branch))</small>
                                        </div>
                                        <small>@(branch.IsEliminated ? branch.EliminationReason : branch.GroundingStatusCode == "GROUNDED" ? $"Grounded · {branch.EvidenceCount} evidence" : "Interpretive reasoning path (not enterprise-grounded)")@(branch.StopReason is not null ? $" · {branch.StopReason}" : null)</small>
                                        @if (_response.QueryContract is { } hierarchyContract)
                                        {
                                            var associatedContractEntries = AssociatedContractEntries(branch, hierarchyContract);
                                            @if (associatedContractEntries.Count > 0)
                                            {
                                                <div class="poloxi-branch-contract" aria-label="Query contract entries associated with this hierarchy branch">
                                                    <span class="poloxi-branch-contract-title"><i class="bi bi-file-earmark-check"></i> Associated query contract</span>
                                                    @foreach (var entry in associatedContractEntries)
                                                    {
                                                        <span title="@entry.Title"><i class="bi @entry.Icon"></i>@entry.Value<em>@entry.Label</em></span>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="poloxi-branch-meta"><span>@BranchStateLabel(branch)</span>@if (branch.SemanticTypeCode == "DIMENSION")
                                        {
                                            <span class="um-badge um-badge-neutral" title="Jointly valid evaluation criterion — scored on importance/coverage, excluded from winner-take-all entropy.">Dimension</span>
                                        }
                                        else
                                        {
                                            <span class="um-badge um-badge-neutral" title="Mutually exclusive competing interpretation — participates in Shannon entropy.">Alternative</span>
                                        }<small title="Interpretation prior (LLM) · Evidence support · POLOXI confidence">@(branch.PoloxiConfidence > 0 ? $"{branch.InterpretationPrior:P0} · {branch.EvidenceSupport:P0} · {branch.PoloxiConfidence:P0}" : branch.Confidence.ToString("P0"))</small></div>
                                </article>
                            }
                        }
                    </div>
                </section>

                <section class="poloxi-panel poloxi-evidence-panel">
                    <div class="poloxi-panel-header"><div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-collection"></i></span><div><span>LLM knowledge · not enterprise data</span><h2>Results &amp; references</h2></div></div></div>
                    @if (_response.Evidence.Count == 0 && _response.ExternalReferences.Count == 0 && _response.InterpretiveResults.Count == 0)
                    {
                        <div class="poloxi-empty"><i class="bi bi-lightbulb"></i><strong>No result sets returned</strong><p>The LLM did not return interpretive result sets or references for this question.</p></div>
                    }
                    @foreach (var evidence in _response.Evidence)
                    {
                        var canOpen = !string.IsNullOrWhiteSpace(evidence.NavigationRoute);
                        <article class="poloxi-evidence @(canOpen ? "poloxi-evidence-clickable" : null)" @ondblclick="() => OpenEvidence(evidence)" title="@(canOpen ? "Double-click to open the source record." : null)">
                            <span class="poloxi-rank">@evidence.RankNumber</span>
                            <div class="poloxi-evidence-main"><strong>@evidence.Title</strong><small>@evidence.ModuleCode · @evidence.EntityTypeCode</small><p>@evidence.Excerpt</p><div>@foreach (var branch in evidence.MatchedBranches) { <span class="um-badge um-badge-neutral">@BranchNameWithLevel(branch)</span> }</div></div>
                            <div class="poloxi-score"><strong>@evidence.RelevanceScore.ToString("P0")</strong><small>Score</small></div>
                        </article>
                    }
                    @if (_response.InterpretiveResults.Count > 0)
                    {
                        <div class="poloxi-section-divider"><i class="bi bi-stars"></i><h2>Interpretation results</h2></div>
                        @if (_response.InterpretiveResults.Any(r => r.DataVolatility == "TIME_SENSITIVE" && !r.IsExternallyGrounded))
                        {
                            <div class="alert alert-warning" role="alert" style="border-left: 4px solid #ffc107;">
                                <i class="bi bi-clock-history"></i> Some results below depend on time-sensitive data (prices, rates, rankings). Figures may be outdated &mdash; verify against the referenced sources for current values.
                            </div>
                        }
                        @foreach (var result in PrioritizedInterpretiveResults)
                        {
                            <article class="poloxi-evidence">
                                <span class="poloxi-rank"><i class="bi bi-lightbulb"></i></span>
                                <div class="poloxi-evidence-main">
                                    <strong>@InterpretiveBranchDisplayWithLevel(result)</strong>
                                    <small>@result.Interpretation</small>
                                    @foreach (var item in result.Items)
                                    {
                                        <p><strong>@item.RankNumber. @item.Name</strong> &mdash; @item.Detail</p>
                                    }
                                    <div>
                                        <span class="um-badge um-badge-neutral">INTERPRETIVE</span>
                                        @if (result.DataVolatility == "TIME_SENSITIVE")
                                        {
                                            <span class="um-badge um-badge-warning" title="This result depends on facts that change over time; figures may be outdated."><i class="bi bi-clock-history"></i> TIME-SENSITIVE</span>
                                        }
                                        @if (result.IsExternallyGrounded)
                                        {
                                            <span class="um-badge um-badge-success" title="Figures were grounded against live external sources."><i class="bi bi-globe2"></i> LIVE-GROUNDED</span>
                                        }
                                    </div>
                                </div>
                                <div class="poloxi-score" title="POLOXI branch-support confidence: interpretation prior blended with evidence support."><strong>@result.Confidence.ToString("P0")</strong><small>POLOXI</small></div>
                            </article>
                        }
                        @if (SecondaryInterpretiveResults.Count > 0)
                        {
                            <div class="poloxi-secondary-panel">
                                <div class="poloxi-secondary-header">
                                    <i class="bi bi-layers-half"></i>
                                    <div>
                                        <span>Not prioritized &middot; secondary analysis</span>
                                        <h3>Interpretation results for not-prioritized paths</h3>
                                        <p>These interpretation paths scored below the prioritization threshold or returned no enterprise evidence. They remain part of the answer surface for completeness and can be reactivated by supporting evidence.</p>
                                    </div>
                                    <span class="poloxi-secondary-count">@SecondaryInterpretiveResults.Count</span>
                                </div>
                                @foreach (var result in SecondaryInterpretiveResults)
                                {
                                    <article class="poloxi-evidence poloxi-evidence-secondary">
                                        <span class="poloxi-rank poloxi-rank-secondary"><i class="bi bi-lightbulb"></i></span>
                                        <div class="poloxi-evidence-main">
                                            <strong>@InterpretiveBranchDisplayWithLevel(result)</strong>
                                            <small>@result.Interpretation</small>
                                            @foreach (var item in result.Items)
                                            {
                                                <p><strong>@item.RankNumber. @item.Name</strong> &mdash; @item.Detail</p>
                                            }
                                            <div>
                                                <span class="um-badge um-badge-neutral" title="This interpretation path was demoted to dormant/secondary — retained for completeness, not driving the primary answer.">NOT PRIORITIZED</span>
                                                <span class="um-badge um-badge-neutral">INTERPRETIVE</span>
                                                @if (result.DataVolatility == "TIME_SENSITIVE")
                                                {
                                                    <span class="um-badge um-badge-warning" title="This result depends on facts that change over time; figures may be outdated."><i class="bi bi-clock-history"></i> TIME-SENSITIVE</span>
                                                }
                                                @if (result.IsExternallyGrounded)
                                                {
                                                    <span class="um-badge um-badge-success" title="Figures were grounded against live external sources."><i class="bi bi-globe2"></i> LIVE-GROUNDED</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="poloxi-score" title="POLOXI branch-support confidence: interpretation prior blended with evidence support."><strong>@result.Confidence.ToString("P0")</strong><small>POLOXI</small></div>
                                    </article>
                                }
                            </div>
                        }
                    }
                </section>
            </div>
            }

                                </section>
                            }
                            @if (!ShowAnswerView && !string.IsNullOrWhiteSpace(_response.FinalAnswer))
            {
                <section class="poloxi-explanation">
                    <div class="poloxi-explanation-icon"><i class="bi bi-chat-square-quote"></i></div>
                    <div class="poloxi-explanation-body">
                        <div class="poloxi-panel-header"><div><span>@VerificationLabel</span><h2>@AnswerHeading</h2></div><span class="poloxi-status">@GroundingBadge</span></div>
                        @if (FinalRankedCandidates.Count > 0)
                        {
                            <div class="poloxi-grounded-branches">
                                <small title="Deterministic final ordering from the Candidate × Branch competition — the authoritative POLOXI conclusion, never the pre-competition LLM composition.">Final POLOXI ranking (Candidate × Branch competition):</small>
                                <ol class="poloxi-final-ranking">
                                    @foreach (var candidate in FinalRankedCandidates)
                                    {
                                        <li><strong>@candidate.DisplayName</strong> <span>@candidate.CompositeScore.ToString("P0")</span></li>
                                    }
                                </ol>
                            </div>
                            <small class="poloxi-interpretive-note" title="The LLM composition below was written before the final candidate competition; it is the interpretive candidate source, not the final ordering.">Interpretive composition (candidate source):</small>
                        }
                        <p>@_response.FinalAnswer</p>
                        @if (_response.QueryContract is { } contract && (contract.HardConstraints.Count > 0 || contract.AmbiguousConcepts.Count > 0))
                        {
                            <div class="poloxi-grounded-branches">
                                <small>Query contract:</small>
                                <div class="poloxi-branch-level">
                                    @foreach (var constraint in contract.HardConstraints)
                                    {
                                        <span class="poloxi-branch-chip" title="Hard constraint — fixed by your query, never reinterpreted."><i class="bi bi-lock"></i>@constraint<em>FIXED</em></span>
                                    }
                                    @foreach (var concept in contract.AmbiguousConcepts)
                                    {
                                        <span class="poloxi-branch-chip" title="Ambiguous concept — the only part POLOXI disambiguated."><i class="bi bi-question-circle"></i>@concept<em>DISAMBIGUATED</em></span>
                                    }
                                </div>
                            </div>
                        }
                        @if (SurvivingBranches.Count > 0)
                        {
                            <div class="poloxi-grounded-branches">
                                <small>Interpretation branches:</small>
                                @foreach (var level in UsedBranchLevels)
                                {
                                    <div class="poloxi-branch-level">
                                        @foreach (var branch in level)
                                        {
                                            <span class="poloxi-branch-chip" title="@branch.Interpretation"><i class="bi @(branch.GroundingStatusCode == "GROUNDED" ? "bi-check2-circle" : "bi-lightbulb")"></i>@branch.DisplayName<em>@(branch.CapabilityCode ?? branch.GroundingStatusCode)</em></span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (_response.SuggestedActions.Count > 0)
                        {
                            <div class="poloxi-grounded-branches">
                                <small>Suggested actions:</small>
                                <div class="poloxi-branch-level">
                                    @foreach (var action in _response.SuggestedActions)
                                    {
                                        <span class="poloxi-branch-chip poloxi-action-chip" title="@action.Rationale" @onclick="() => OpenRoute(action.NavigationRoute)"><i class="bi bi-arrow-right-circle"></i>@action.DisplayName</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            @KpiStrip

            @if (_response.InformationRounds.Count > 0)
            {
                <section class="poloxi-panel">
                    <div class="poloxi-panel-header"><div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-radar"></i></span><div><span>V2.2 information-directed exploration · the LLM predicts, POLOXI measures</span><h2>Information rounds</h2></div></div><span class="poloxi-status" title="Rounds executed · targets evaluated · total measured uncertainty reduction (bits)">@_response.InformationRounds.Count rounds · @_response.TotalActualInformationGain.ToString("0.###") bits</span></div>
                    @foreach (var round in _response.InformationRounds)
                    {
                        <article class="poloxi-info-round">
                            <div class="poloxi-info-round-head">
                                <strong>Round @round.RoundNumber</strong>
                                <span title="Normalized uncertainty before → after this round (deterministic Shannon entropy). Basis: BRANCH = competing interpretations; CANDIDATE = candidate-signal distribution.">@round.NormalizedEntropyBefore.ToString("P0") → @(round.NormalizedEntropyAfter?.ToString("P0") ?? "—") · @round.EntropyBasisCode</span>
                                <span title="Raw entropy audit: H / Hmax (bits) and measured population size N before → after. If N changed between measurements, normalized percentages are not directly comparable and the gain reading must be judged on raw bits.">H @round.EntropyBefore.ToString("0.####")@(round.MaxEntropyBefore is { } maxBefore ? $"/{maxBefore:0.####}" : null) → @(round.EntropyAfter is { } after ? $"{after:0.####}{(round.MaxEntropyAfter is { } maxAfter ? $"/{maxAfter:0.####}" : null)}" : "—") bits · N @(round.PopulationCountBefore?.ToString() ?? "—") → @(round.PopulationCountAfter?.ToString() ?? "—")</span>
                                @if (round.PopulationCountBefore is { } nBefore && round.PopulationCountAfter is { } nAfter && nBefore != nAfter)
                                {
                                    <span class="um-badge um-badge-warning" title="The measured population changed between the before and after measurements, so normalized percentages compare different distributions. Judge this round on raw bits.">POPULATION CHANGED</span>
                                }
                                @if (round.RawEntropyDelta is { } rawDelta)
                                {
                                    <span class="um-badge um-badge-neutral" title="Raw measured entropy change (EntropyBefore − EntropyAfter) — the single measured fact for this round, before any clamping. Measured by POLOXI math, never the LLM.">Information change: @((rawDelta >= 0m ? "+" : "\u2212") + Math.Abs(rawDelta).ToString("0.###")) bits</span>
                                    <span class="um-badge @(rawDelta > 0m ? "um-badge-success" : rawDelta < 0m ? "um-badge-warning" : "um-badge-neutral")" title="@(rawDelta < 0m ? "The new evidence INCREASED measured uncertainty. This is meaningful — it revealed prior overconfidence — and is not the same as no information." : rawDelta > 0m ? "The new evidence reduced measured uncertainty." : "The measured uncertainty did not change.")">Outcome: @(rawDelta > 0m ? "Uncertainty reduced" : rawDelta < 0m ? "Uncertainty increased" : "No measurable change")@(rawDelta != 0m && Math.Abs(rawDelta) < .05m ? " slightly" : null)</span>
                                }
                                else if (round.ActualInformationGain is { } gain)
                                {
                                    <span class="um-badge @(gain > 0m ? "um-badge-success" : "um-badge-neutral")" title="Actual information gain measured by POLOXI after targeted retrieval — never estimated by the LLM.">@gain.ToString("0.###") bits</span>
                                }
                            </div>
                            @foreach (var target in round.Targets)
                            {
                                <div class="poloxi-info-target @(target.WasSelected ? null : "poloxi-info-target-skipped")">
                                    <span class="poloxi-rank" title="@(target.WasSelected ? "Selected for targeted retrieval." : "Evaluated but not selected — kept for audit.")">@(target.SelectionRank?.ToString() ?? "–")</span>
                                    <div class="poloxi-evidence-main">
                                        <strong>@target.BranchDisplayName</strong>
                                        @if (!string.IsNullOrWhiteSpace(target.EvidenceTarget))
                                        {
                                            <p>@target.EvidenceTarget</p>
                                        }
                                        <div>
                                            <span class="um-badge um-badge-neutral" title="How unresolved this interpretation dimension is (LLM categorical estimate).">Uncertainty @target.UncertaintyCode</span>
                                            <span class="um-badge um-badge-neutral" title="How likely new evidence here changes the final ranking (LLM categorical estimate).">Impact @target.RankingImpactCode</span>
                                            <span class="um-badge um-badge-neutral" title="How well evidence here separates close candidates (LLM categorical estimate).">Discrimination @target.CandidateDiscriminationCode</span>
                                        </div>
                                    </div>
                                    <div class="poloxi-score"><strong>@target.AdjustedInformationValue.ToString("P0")</strong><small>Info value</small></div>
                                </div>
                            }
                        </article>
                    }
                </section>
            }

            @if (_response.Candidates.Count > 0)
            {
                <section class="poloxi-panel">
                    <div class="poloxi-panel-header"><div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-trophy"></i></span><div><span>Candidate × Branch competition · ranked by surviving interpretations</span><h2>POLOXI Answer ranking</h2></div></div><span class="poloxi-status" title="POLOXI Journey: interpretations explored → evidence-supported → final dimensions → ranked candidates">@_response.Branches.Count → @SurvivingBranches.Count → @ActiveBranchCount → @_response.Candidates.Count</span></div>
                    @foreach (var candidate in _response.Candidates)
                    {
                        <article class="poloxi-evidence @(candidate.IsConstraintViolation ? "poloxi-branch-unsupported" : null)">
                            <span class="poloxi-rank">@candidate.RankNumber</span>
                            <div class="poloxi-evidence-main">
                                <strong>@candidate.DisplayName</strong>
                                <p>@candidate.Detail</p>
                                <div>
                                    @if (candidate.IsConstraintViolation)
                                    {
                                        <span class="um-badge um-badge-danger" title="Failed a hard query constraint; kept visible, never hidden."><i class="bi bi-slash-circle"></i> RULED OUT</span>
                                    }
                                    else if (candidate.EvidenceCoverage < .5m)
                                    {
                                        <span class="um-badge um-badge-warning" title="This candidate has evidence on only some interpretation dimensions; its ranking is discounted accordingly."><i class="bi bi-exclamation-triangle"></i> LOW COVERAGE @candidate.EvidenceCoverage.ToString("P0")</span>
                                    }
                                    @foreach (var score in candidate.BranchScores)
                                    {
                                        @if (score.ChildScores.Count > 0)
                                        {
                                            <span class="um-badge um-badge-neutral" title="@RollUpTooltip(score)"><i class="bi bi-diagram-2" aria-hidden="true"></i> @score.BranchDisplayName @score.EvidenceScore.ToString("P0")</span>
                                        }
                                        else
                                        {
                                            <span class="um-badge um-badge-neutral" title="Candidate quality score for this interpretation dimension.">@score.BranchDisplayName @score.EvidenceScore.ToString("P0")</span>
                                        }
                                    }
                                </div>
                                @if (candidate.BranchScores.Any(score => score.ChildScores.Count > 0))
                                {
                                    <div class="poloxi-rollup">
                                        @foreach (var score in candidate.BranchScores.Where(score => score.ChildScores.Count > 0))
                                        {
                                            <small class="poloxi-rollup-line"><strong>@score.BranchDisplayName</strong> = 50% direct @((score.DirectScore ?? score.EvidenceScore).ToString("P0")) + 50% sub-criteria: @string.Join(" · ", score.ChildScores.OrderByDescending(child => child.EvidenceScore).Select(child => $"{child.BranchDisplayName} {child.EvidenceScore:P0}"))</small>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="poloxi-score"><strong>@candidate.QualityScore.ToString("P0")</strong><small>Quality</small></div>
                            <div class="poloxi-score" title="How well the evidence supports the quality score: independent-source diversity and dimension coverage. Weak evidence lowers this confidence, never the quality itself."><strong>@candidate.EvidenceConfidence.ToString("P0")</strong><small>Evidence</small></div>
                        </article>
                    }
                </section>
            }

                    @if (_response.ExternalReferences.Count > 0)
                    {
                        <div class="poloxi-answer-section poloxi-reveal">
                            <h3><i class="bi bi-globe2"></i> External sources <small class="poloxi-section-note">Real-world references · LLM knowledge (not enterprise-verified)</small></h3>
