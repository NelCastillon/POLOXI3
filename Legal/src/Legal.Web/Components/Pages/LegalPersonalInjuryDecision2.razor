    // Always-visible universal Factor Inventory checklist. Independent of the _showPipeline diagnostics
    // toggle so users can always see, per candidate, which required/supporting factors are satisfied
    // (AVAILABLE/SUPPLIED) vs. still missing — and how each factor affects that outcome in the pipeline.
    private RenderFragment FactorChecklistPanel => __builder =>
    {
        @if (_response?.DecisionInspector?.FactorInventory is { } inventory && inventory.Factors.Count > 0)
        {
            <section class="poloxi-panel poloxi-reveal poloxi-factorcheck-panel">
                <div class="poloxi-panel-header">
                    <div class="poloxi-panel-title">
                        <span class="poloxi-panel-icon"><i class="bi bi-list-check"></i></span>
                        <div><span>Factor inventory checklist</span><h2>What each outcome needs — and what is established</h2></div>
                    </div>
                    <span class="poloxi-status" title="Factors are derived from the actual normalized decision plan and matter data. Nothing is hardcoded.">@inventory.Factors.Count factors · @inventory.SharedFactorCount shared · @inventory.MissingFactorCount missing</span>
                </div>

                @if (inventory.IsProvisional || inventory.RejectedBindingCount > 0 || inventory.ContradictedFactorCount > 0 || inventory.UnvalidatedRequiredCount > 0 || inventory.UnsatisfiedRequiredDependencyCount > 0 || (inventory.BlockingObligations?.Count ?? 0) > 0)
                {
                    <div class="poloxi-provisional-banner" role="status">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            <strong>Provisional comparison — not a validated recommendation.</strong>
                            <span>
                                @(string.IsNullOrWhiteSpace(inventory.DecisionReadinessStatus) ? "PROVISIONAL" : inventory.DecisionReadinessStatus)
                                @if (inventory.RejectedBindingCount > 0)
                                {
                                    <text> · @inventory.RejectedBindingCount supplied value(s) could not establish their proposition</text>
                                }
                                @if (inventory.ContradictedFactorCount > 0)
                                {
                                    <text> · @inventory.ContradictedFactorCount proposition(s) have conflicting values across sources</text>
                                }
                                @if (inventory.UnvalidatedRequiredCount > 0)
                                {
                                    <text> · @inventory.UnvalidatedRequiredCount REQUIRED link(s) lack a validated basis</text>
                                }
                                @if (inventory.UnsatisfiedRequiredDependencyCount > 0)
                                {
                                    <text> · @inventory.UnsatisfiedRequiredDependencyCount REQUIRED dependency(ies) not established</text>
                                }
                            </span>
                            @if ((inventory.BlockingObligations?.Count ?? 0) > 0)
                            {
                                <ul class="poloxi-provisional-obligations">
                                    @foreach (var obligation in inventory.BlockingObligations!)
                                    {
                                        <li><i class="bi bi-shield-exclamation"></i> @obligation</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }

                <div class="poloxi-factor-sources">
                    <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.MatterDataLoaded ? "on" : "off")">Matter data: @(inventory.SourceStatus.MatterDataLoaded ? $"{inventory.SourceStatus.MatterFieldCount} fields" : "none")</span>
                    <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.DomainPackResolved ? "on" : "off")">Domain pack: @(inventory.SourceStatus.DomainPackResolved ? (inventory.SourceStatus.DomainPackCode ?? "resolved") : "not resolved")</span>
                    <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.DocumentCorpusStatus == "AVAILABLE" ? "on" : "off")">Documents: @inventory.SourceStatus.DocumentCorpusStatus</span>
                    <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.EvidenceStatus == "ADMITTED" ? "on" : "off")">Evidence: @inventory.SourceStatus.EvidenceStatus</span>
                </div>

                @{
                    // Group relationship rows by candidate so each outcome shows its own factor checklist.
                    var byCandidate = inventory.Relationships
                        .GroupBy(r => r.CandidateTitle)
                        .OrderByDescending(g => g.Count(x => x.IsRequired))
                        .ThenBy(g => g.Key)
                        .ToArray();
                    var factorById = inventory.Factors.ToDictionary(f => f.FactorId, StringComparer.OrdinalIgnoreCase);
                }

                @if (byCandidate.Length == 0)
                {
                    <p class="poloxi-factorcheck-empty">The normalized plan registered factors but no candidate relationships were produced for this run.</p>
                }
                else
                {
                    <div class="poloxi-factorcheck-grid">
                        @foreach (var grp in byCandidate)
                        {
                            var required = grp.Where(r => r.IsRequired).ToArray();
                            var met = required.Count(r => factorById.TryGetValue(r.FactorId, out var f) && f.Availability == "AVAILABLE");
                            <article class="poloxi-factorcheck-card">
                                <header>
                                    <h3>@grp.Key</h3>
                                    <span class="poloxi-factorcheck-progress" title="Required factors with an established (AVAILABLE) value.">@met / @required.Length required established</span>
                                </header>
                                <ul class="poloxi-factorcheck-list">
                                    @foreach (var rel in grp.OrderByDescending(r => r.IsRequired).ThenBy(r => r.FactorName))
                                    {
                                        factorById.TryGetValue(rel.FactorId, out var factor);
                                        var available = factor?.Availability == "AVAILABLE";
                                        var stateClass = available ? "met" : (rel.IsRequired ? "missing" : "pending");
                                        var icon = available ? "bi-check-circle-fill" : (rel.IsRequired ? "bi-x-circle-fill" : "bi-dash-circle");
                                        <li class="poloxi-factorcheck-item poloxi-factorcheck-item--@stateClass">
                                            <i class="bi @icon"></i>
                                            <div class="poloxi-factorcheck-item-body">
                                                <div class="poloxi-factorcheck-item-head">
                                                    <strong>@rel.FactorName</strong>
                                                    <span class="poloxi-factor-badge poloxi-factor-badge--@(rel.RelationType.ToLowerInvariant())">@rel.RelationType</span>
                                                    @if (factor is not null)
                                                    {
                                                        <span class="poloxi-factor-badge poloxi-factor-badge--@factor.Availability.ToLowerInvariant()">@factor.Availability</span>
                                                        <span class="poloxi-factor-badge poloxi-factor-badge--@factor.VerificationStatus.ToLowerInvariant()">@factor.VerificationStatus</span>
                                                        @if (!string.IsNullOrWhiteSpace(factor.EvidenceAdmissionState))
                                                        {
                                                            <span class="poloxi-factor-badge poloxi-factor-badge--@factor.EvidenceAdmissionState.ToLowerInvariant()" title="Evidence-admission state">@factor.EvidenceAdmissionState</span>
                                                        }
                                                        @if (string.Equals(factor.BindingAdmissibility, "REJECTED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="poloxi-factor-badge poloxi-factor-badge--rejected" title="The supplied value does not establish this proposition (category mismatch).">BINDING REJECTED</span>
                                                        }
                                                    }
                                                </div>
                                                <div class="poloxi-factorcheck-item-value">
                                                    @if (factor is not null && !string.IsNullOrWhiteSpace(factor.ActualValue))
                                                    {
                                                        <span><i class="bi bi-database"></i> @factor.ActualValue <em>(@factor.Source)</em></span>
                                                    }
                                                    else if (factor is not null && !string.IsNullOrWhiteSpace(factor.MissingInformation))
                                                    {
                                                        <span class="poloxi-factorcheck-missing">@factor.MissingInformation</span>
                                                    }
                                                </div>
                                                @if (factor is not null && !string.IsNullOrWhiteSpace(factor.VerificationObligation))
                                                {
                                                    <div class="poloxi-factorcheck-item-obligation"><i class="bi bi-shield-exclamation"></i> Verification required: @factor.VerificationObligation</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(rel.Rationale))
                                                {
                                                    <div class="poloxi-factorcheck-item-effect"><i class="bi bi-arrow-return-right"></i> @rel.Rationale</div>
                                                }
                                                @if (factor is not null && factor.References is { Count: > 0 })
                                                {
                                                    <FactorReferenceChips References="factor.References" OnReferenceSelected="OpenReferenceDetail" />
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    };

    // ══ Decision Change Intelligence (DCI) ═══════════════════════════════════════════════════════════
    // Attorney-facing interpretation of matter changes. Pure, read-only projections over the DB-backed
    // DecisionDelta records (_dciDeltas), calibration snapshots (_cdcSnapshots), the per-event impact
    // rows (_dciChangeReview) and the advisory proposition frontier (_propositionInfoValue). Nothing is
    // fabricated — when the pipeline produced no delta the views render their empty-states.
    internal IReadOnlyList<Legal.Application.Features.Intelligence.Decision.DecisionDeltaDto> DciDeltas =>
        _dciDeltas.OrderByDescending(d => d.OccurredDateUtc).ToArray();

    internal Legal.Application.Features.Intelligence.Decision.DecisionDeltaDto? DciSelectedDelta =>
        DciDeltas.FirstOrDefault(d => d.DecisionDeltaId == _dciSelectedDeltaId) ?? DciDeltas.FirstOrDefault();

    // "Since last review" cutoff: the evaluation time of the most recent attorney-approved snapshot.
    // KPIs count only deltas that occurred after this point so the header ("Changes Since Last Review")
    // stays truthful. When nothing has been approved yet, every recorded delta is "since last review".
    internal DateTime? DciLastReviewedUtc =>
        _cdcSnapshots.Where(s => s.IsAttorneyApproved)
                     .OrderByDescending(s => s.EvaluatedDateUtc)
                     .Select(s => (DateTime?)s.EvaluatedDateUtc)
                     .FirstOrDefault();

    private IReadOnlyList<Legal.Application.Features.Intelligence.Decision.DecisionDeltaDto> DciDeltasSinceReview =>
        DciLastReviewedUtc is { } cutoff
            ? DciDeltas.Where(d => d.OccurredDateUtc > cutoff).ToArray()
            : DciDeltas;

    // Live Decision Monitor KPIs — aggregated strictly from recorded delta data since the last reviewed
    // snapshot (0 when not computed).
    internal int DciNewEvidenceCount => DciDeltasSinceReview.Sum(d => d.AffectedEvidenceCount);
    internal int DciChangedPropositionCount => DciDeltasSinceReview.Sum(d => d.AffectedPropositionCount);
    internal int DciAffectedOutcomeCount => DciDeltasSinceReview.Sum(d => d.AffectedCandidateCount);
    internal int DciNewContradictionCount => DciDeltasSinceReview.Count(d =>
        (d.ClassificationCode ?? "").Contains("CONTRADICT", StringComparison.OrdinalIgnoreCase));
    internal int DciFrontierChangeCount => DciDeltasSinceReview.Count(d => d.FrontierChanged == true);
    internal int DciReviewRequiredCount => DciDeltasSinceReview.Count(d => d.AttorneyReviewRequired);

    internal static string DciDeltaKindLabel(string? code) => (code ?? "").ToUpperInvariant() switch
    {
        "WINNER_CHANGED" => "Material decision change",
        "MARGIN_SHIFTED" => "Margin shifted",
        "REEVALUATED_NO_CHANGE" => "Reevaluated · no change",
        _ => string.IsNullOrWhiteSpace(code) ? "Decision reevaluated" : code,
    };

    internal static string DciDeltaKindTone(string? code) => (code ?? "").ToUpperInvariant() switch
    {
        "WINNER_CHANGED" => "danger",
        "MARGIN_SHIFTED" => "warn",
        _ => "info",
    };

    internal static string DciScore(double? value) => value is { } v ? $"{Math.Round(v * 100)}%" : "—";
    internal static string DciDelta(double? previous, double? current)
    {
        if (previous is not { } p || current is not { } c) return "";
        var diff = (int)Math.Round((c - p) * 100);
        return diff == 0 ? "±0%" : diff > 0 ? $"+{diff}%" : $"{diff}%";
    }

    private Legal.Application.Features.Intelligence.Decision.DecisionSnapshotDto? DciSnapshotById(Guid? id) =>
        id is { } sid ? _cdcSnapshots.FirstOrDefault(s => s.DecisionSnapshotId == sid) : null;

    internal string DciSnapshotLabel(Guid? id)
    {
        var snap = DciSnapshotById(id);
        return snap is null ? "—" : $"Snapshot #{snap.SnapshotNumber}";
    }

    internal async Task SelectDciDeltaAsync(Legal.Application.Features.Intelligence.Decision.DecisionDeltaDto delta)
    {
        _dciSelectedDeltaId = delta.DecisionDeltaId;
        _dciChangeReview = null;
        if (delta.MatterChangeEventId is { } eventId)
            await LoadDciChangeReviewAsync(eventId);
    }

    // Loads the DB-backed impact rows for the selected delta's change event (Why It Changed traceability).
    private async Task LoadDciChangeReviewAsync(Guid changeEventId)
    {
        if (_dciChangeReviewLoading) return;
        _dciChangeReviewLoading = true;
        try { _dciChangeReview = await Api.GetLegalDecisionChangeReviewAsync(changeEventId); }
        catch { _dciChangeReview = null; }
        finally { _dciChangeReviewLoading = false; StateHasChanged(); }
    }

    internal async Task SelectDciViewAsync(string view)
    {
        _dciView = view;
        if (view == "Why It Changed" && _dciChangeReview is null && DciSelectedDelta?.MatterChangeEventId is { } eventId)
            await LoadDciChangeReviewAsync(eventId);
    }

    // Read-only Channel Scoring (LPI) dashboard: shows the formula legend, every channel contribution's
    // applied δ (or honest no-effect reason), per-dimension net push, and how it fed POLOXI's competition.
    private RenderFragment LegalAuthorityDashboard => __builder =>
    {
        var authorities = DaAuthorities;
        var contributions = LegalAuthorityContributions;
        var authorityReview = _legalAuthorityReviewItems
            .Where(i => string.Equals(i.AssertionTypeCode, "LegalAuthority", StringComparison.OrdinalIgnoreCase)
                     || string.Equals(i.RetrievalModeCode, "AuthorityDirected", StringComparison.OrdinalIgnoreCase))
            .ToArray();
