    // ══ Continuous Decision Calibration (CDC) projections ═══════════════════════════════════════════
    // All projections are pure, read-only views over already-loaded, DB-backed data (_response,
    // _cdcSnapshots, _cdcChangeEvents, _cdcReviewTasks, _documents). Nothing is fabricated; when the
    // pipeline produced no value the projection returns an empty collection or a null the UI renders
    // as an em dash / empty-state.
    private async Task LoadCalibrationDataAsync(Guid matterId)
    {
        try { _cdcSnapshots = await Api.GetLegalDecisionMatterSnapshotsAsync(matterId); } catch { _cdcSnapshots = []; }
        try { _cdcChangeEvents = await Api.GetLegalDecisionMatterChangeEventsAsync(matterId); } catch { _cdcChangeEvents = []; }
        try { _cdcReviewTasks = await Api.GetLegalDecisionMatterReviewTasksAsync(matterId); } catch { _cdcReviewTasks = []; }
        try { _dciDeltas = await Api.GetLegalDecisionMatterDeltasAsync(matterId); } catch { _dciDeltas = []; }
        _cdcSelectedSnapshotId ??= CdcSnapshots.FirstOrDefault()?.DecisionSnapshotId;
        _dciSelectedDeltaId ??= DciDeltas.FirstOrDefault()?.DecisionDeltaId;
        await LoadPropositionInfoValueAsync(matterId);
    }

    // Advisory proposition-IV load: scores the matter's atomic fact-propositions for the latest decision
    // session. Fails soft — any error leaves the panel in its empty-state without disrupting the CDC tab.
    private async Task LoadPropositionInfoValueAsync(Guid matterId)
    {
        if (_propositionInfoValueLoading)
            return;
        _propositionInfoValueLoading = true;
        try
        {
            var sessions = await Api.GetLegalDecisionMatterSessionsAsync(matterId);
            // Proposition-IV and NBA scoring run off the matter's evidence graph, not off a session row —
            // the session id is only a correlation tag. When a matter has no decision session yet (e.g. it
            // was opened without running a Wide2 analysis), fall back to the matter id so the advisory
            // overlays still render instead of forcing the user to "run an analysis" first.
            var correlationId = sessions
                .OrderByDescending(s => s.CreatedDateUtc)
                .Select(s => s.DecisionSessionId)
                .DefaultIfEmpty(matterId)
                .First();
            _propositionInfoValue = await Api.GetLegalMatterPropositionInformationValueAsync(matterId, correlationId);
            // Decision-directed Next Best Actions for the same correlation id (server composes requirements +
            // domain-pack actions + deterministic eligibility). Fails soft independently of proposition IV.
            try
            {
                _nextBestActions = await Api.GetLegalMatterNextBestActionsAsync(matterId, correlationId);
            }
            catch (Exception ex)
            {
                _nextBestActions = new Legal.Application.Features.Intelligence.Decision.NextBestActionResult(matterId, [], $"Next best actions could not be loaded: {ex.Message}");
            }
            // What To Resolve Next: a thin projection over the SAME proposition VIV / LegalADV frontier.
            // Loaded independently of NBA so the resolution-priority panel reflects POLOXI decision state,
            // not the NBA engine. Fails soft to a Blocked state so the panel stays honest.
            try
            {
                _whatToResolveNext = await Api.GetLegalMatterWhatToResolveNextAsync(matterId, correlationId);
            }
            catch (Exception ex)
            {
                _whatToResolveNext = new Legal.Application.Features.Intelligence.Decision.WhatToResolveNextResult(matterId, Legal.Application.Features.Intelligence.Decision.ResolutionTargetState.Blocked, $"Resolution priority is blocked: {ex.Message}", []);
            }
        }
        catch (Exception ex)
        {
            _propositionInfoValue = null;
            _nextBestActions = new Legal.Application.Features.Intelligence.Decision.NextBestActionResult(matterId, [], $"Next best actions could not be loaded: {ex.Message}");
            _whatToResolveNext = new Legal.Application.Features.Intelligence.Decision.WhatToResolveNextResult(matterId, Legal.Application.Features.Intelligence.Decision.ResolutionTargetState.Blocked, $"Resolution priority is blocked: {ex.Message}", []);
        }
        finally
        {
            _propositionInfoValueLoading = false;
        }
    }

