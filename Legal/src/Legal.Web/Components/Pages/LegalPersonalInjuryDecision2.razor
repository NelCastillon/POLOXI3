    // ── Decision Intelligence console (reads existing response + matter fields only) ──
    private string _dfiTab = "Overview";
    private static readonly string[] DfiTabs = ["Overview", "Decision Analysis", "Decision Contract", "Hierarchy", "Hierarchy Details", "Factor Matrix", "Evidence", "Document Intelligence", "Competition", "Readiness", "Decision Change Intelligence (DCI)", "Continuous Decision Calibration (CDC)", "Human Intelligence", "Investigation", "Audit"];

    private void SelectDfiTab(string tab)
    {
        _dfiTab = tab;
        if (tab == "Document Intelligence" && _evidenceGraph is null && !_evidenceGraphLoading)
            _ = LoadEvidenceGraphAsync();
        if (tab == "Document Intelligence" && _uploadBatches.Count == 0 && _evidenceOccurrences.Count == 0 && !_provenanceLoading)
            _ = LoadProvenanceAsync();
