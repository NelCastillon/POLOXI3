        _detailFactor = f;
    }

    private WideCandidateFactorRelationDto? DfiRelationFor(WideFactorDto f) =>
        DfiRelations.FirstOrDefault(r => r.FactorId == f.FactorId);

    internal string DfiFactorCandidate(WideFactorDto f) => DfiRelationFor(f)?.CandidateTitle ?? "All outcomes";
    internal string DfiFactorRelation(WideFactorDto f)
    {
        var rel = DfiRelationFor(f);
        if (rel is not null) return rel.RelationType;
        return f.Relationships.Count > 0 ? string.Join(", ", f.Relationships.Take(2)) : "—";
    }
    internal string DfiRelationTone(WideFactorDto f)
    {
        var rel = DfiFactorRelation(f);
        if (rel.Contains("REQUIRED", StringComparison.OrdinalIgnoreCase)) return "warn";
        if (rel.Contains("SUPPORTS", StringComparison.OrdinalIgnoreCase)) return "ok";
        return "muted";
    }
    internal string DfiFactorImpact(WideFactorDto f) =>
        (DfiRelationFor(f)?.IsRequired ?? f.Relationships.Any(r => r.Contains("REQUIRED", StringComparison.OrdinalIgnoreCase)))
            ? "May change outcome" : "Evaluative";

    // ── Authoritative readiness (driven by the Decision Inspector, never inferred from evidence alone) ──
    // The presentation states ("Decision ready", "Verified", attorney-ready) must reflect the SAME
    // authoritative result the inspector reports, not the mere existence of retrieved evidence. These
    // read the captured stage statuses so the UI can never claim readiness while the inspector reports
    // "Matter Decision Contract: INCOMPLETE" or "Core Evaluation" is BLOCKED/INCOMPLETE/NOT_REACHED.
    private IReadOnlyCollection<WideInspectorStageDto> DfiInspectorStages =>
        _response?.DecisionInspector?.Stages ?? [];
    private string? DfiStageStatus(string stageCode) =>
        DfiInspectorStages.FirstOrDefault(s => string.Equals(s.StageCode, stageCode, StringComparison.OrdinalIgnoreCase))?.Status;
    internal bool DfiHasInspector => _response?.DecisionInspector is not null;
    private bool DfiDecisionContractComplete =>
        !DfiHasInspector || string.Equals(DfiStageStatus("MATTER_CONTRACT"), "COMPLETED", StringComparison.OrdinalIgnoreCase);
    private bool DfiCoreEvaluationReady =>
        !DfiHasInspector || string.Equals(DfiStageStatus("CORE_EVALUATION"), "COMPLETED", StringComparison.OrdinalIgnoreCase);
    // Authoritative attorney-ready predicate: every gating condition must hold, including the inspector's
    // Decision Contract and Core Evaluation stages when present. Non-legal runs (no inspector) fall back
    // to the evidence-based check so unrelated runs are unaffected.
    private bool DfiDecisionReady =>
        _response is not null && TotalEvidenceCount > 0 && !DfiReviewRequired;

    internal bool DfiReviewRequired => _response is null || TotalEvidenceCount == 0 || _response.StatusCode == "USER_CLARIFICATION_REQUIRED" || !DfiDecisionContractComplete || !DfiCoreEvaluationReady;
    internal bool DfiShowIntegrityAlert => _response is not null && TotalEvidenceCount == 0;
    private string DfiIntegrityMessage =>
        "Candidate dependencies require validation. No independently verified evidence was admitted in the referenced execution.";

    internal string DfiReadinessLabel
    {
        get
        {
            if (_response is null) return "Not established";
            if (_response.StatusCode == "USER_CLARIFICATION_REQUIRED") return "Clarification needed";
            if (TotalEvidenceCount == 0) return "Not established";
            return (_response.DecisionConfidence ?? _response.FinalConfidence) >= 0.6m ? "Established" : "Provisional";
        }
    }
    internal string DfiReadinessTone => DfiReadinessLabel switch
    {
        "Established" => "ok",
        "Provisional" or "Clarification needed" => "warn",
        _ => "warn",
    };

    // Final pipeline stage label. Step 7 marks that the pipeline finished PROCESSING, which is distinct
    // from the DECISION being ready: when readiness gates are still open the label must say so instead of
    // implying an attorney-ready determination. Keeps the pipeline strip honest with the Readiness tab.
    private string DfiExecutionCompleteLabel => DfiDecisionReady
        ? "Processing complete · Decision ready"
        : $"Processing complete · Decision {DfiReadinessLabel.ToLowerInvariant()}";

    internal sealed record DfiIndicator(string Label, string Meaning, string Value, string Tone);

    // Authoritative, diagnostic-driven blockers for the Candidate Competition status card. Derived from
    // the DTO fields the pipeline already emits (normalization gate state, decision-contract completeness,
    // evidence grounding), NOT from ad-hoc UI inference. Empty when competition executed.
    internal IReadOnlyList<string> DfiCompetitionBlockers
    {
        get
        {
            var r = _response;
            if (r is null) return [];
            var blockers = new List<string>();
            if (!DfiDecisionContractComplete)
                blockers.Add("Decision Contract incomplete");
            var gate = r.MatterContext?.NormalizationGateStatus;
            if (gate is not null && gate.StartsWith("PLAN_INVALID", StringComparison.OrdinalIgnoreCase))
                blockers.Add("Invalid candidate identity or ineligible outcome pool");
            var readiness = r.MatterContext?.DecisionReadinessStatus;
            if (readiness is not null && readiness.StartsWith("REGISTERED_SCORING_BLOCKED", StringComparison.OrdinalIgnoreCase))
                blockers.Add("Dependency and evidence validation incomplete");
            if (TotalEvidenceCount == 0)
                blockers.Add("No independently verified evidence admitted");
            return blockers;
        }
    }

    internal IReadOnlyList<DfiIndicator> DfiIntegrityIndicators
    {
        get
        {
            var r = _response;
            bool competed = (r?.Candidates.Count ?? 0) > 0;
            int reachedScoring = r?.Candidates.Count(c => !c.IsConstraintViolation) ?? 0;
            bool grounded = TotalEvidenceCount > 0;
            bool structural = (r?.DepthReached ?? 0) >= 2 && SurvivingBranches.Count > 0;
            bool dependency = DfiDependencyCount > 0;
            bool authority = (r?.ProposedLegalAuthorities.Any(a => a.VerificationStatus == "VERIFIED")) ?? false;
            bool stable = (r?.WinnerStability ?? 0m) >= 0.6m;
            bool ready = grounded && competed && !DfiReviewRequired;
            // The competition "executed" once the pipeline actually produced competing candidates. Use the
            // same signal the console used before the readiness rework: a delivered candidate field means the
            // Candidate x Branch competition ran. The authoritative backend status (CandidateCompetitionStatus
            // = "RAN ..." / DecisionReadinessStatus = "CANDIDATES_REGISTERED_AND_COMPETED") is honored first so
            // a genuinely-executed run is never mislabeled; otherwise fall back to the presence of candidates.
            // Do NOT gate execution on reachedScoring >= 2 or on evidence being admitted — an executed but
            // unverified run is provisional, not "Not executed / Blocked".
            var competitionStatus = r?.MatterContext?.CandidateCompetitionStatus;
            var readinessStatus = r?.MatterContext?.DecisionReadinessStatus;
            bool backendCompeted =
                (competitionStatus?.StartsWith("RAN", StringComparison.OrdinalIgnoreCase) ?? false)
                || (readinessStatus?.StartsWith("CANDIDATES_REGISTERED_AND_COMPETED", StringComparison.OrdinalIgnoreCase) ?? false);
            // Use the SAME competing-outcomes signal the rest of this console trusts: the formal candidate
            // pool when it populated, otherwise the distinct L1 outcome branches the hierarchy produced
            // (DfiCompetingOutcomes). Before the readiness rework the card treated two or more competing
            // outcomes as an executed competition; gating only on _response.Candidates made a run whose
            // outcomes live on L1 branches (Candidates empty) read "Not executed" while the Explorer showed
            // several competing outcomes — a self-contradiction. Restore the outcome-count signal.
            bool competitionExecuted = backendCompeted || competed || DfiCompetingOutcomes >= 2;
            string competitionValue = competitionExecuted
                ? (grounded ? "Executed" : "Executed \u2014 no verified winner")
                : "Not executed";
            string competitionTone = competitionExecuted ? (grounded ? "ok" : "warn") : "warn";
            // Readiness stays a three-state signal: READY (grounded + competed + inspector clear),
            // PROVISIONAL (competed but a specific gate is still open), BLOCKED only when the competition
            // never executed. The provisional REASON is derived from the actual open gate, not hardcoded to
            // evidence: with admitted evidence present the blocker is usually the inspector's contract/core
            // evaluation stage or a clarification request, so naming "evidence pending" would be wrong.
            string provisionalReason =
                grounded && _response?.StatusCode == "USER_CLARIFICATION_REQUIRED" ? "clarification needed"
                : !grounded ? "evidence pending"
                : !DfiDecisionContractComplete ? "decision contract incomplete"
                : !DfiCoreEvaluationReady ? "core evaluation incomplete"
                : "review pending";
            string readinessValue = ready
                ? "Ready"
                : (competitionExecuted ? $"Provisional \u2014 {provisionalReason}" : "Blocked / unresolved");
            string readinessTone = ready ? "ok" : (competitionExecuted ? "warn" : "danger");
            return
            [
                new("Technical execution", "Did the pipeline finish?", r is null ? "Not run" : "Completed", r is null ? "muted" : "ok"),
                new("Structural validity", "Is the hierarchy internally coherent?", structural ? "Valid" : "Incomplete", structural ? "ok" : "warn"),
                new("Dependency validity", "Are candidate relationships justified?", dependency ? "Justified" : "Review needed", dependency ? "ok" : "warn"),
                new("Evidence grounding", "Are material propositions supported by admitted evidence?", grounded ? $"{(r?.DecisionEvidenceCoverage ?? 0m):P0} coverage" : "Not established", grounded ? "ok" : "warn"),
                new("Authority verification", "Are legal propositions backed by checked sources?", authority ? "Verified" : "Unverified", authority ? "ok" : "warn"),
                new("Candidate competition", "Did the intended competition execute?", competitionValue, competitionTone),
                new("Stability", "Are results consistent across equivalent executions?", stable ? "Stable" : "Unconfirmed", stable ? "ok" : "muted"),
                new("Decision readiness", "Ready for attorney review, or blocked?", readinessValue, readinessTone),
            ];
        }
    }

    internal IReadOnlyCollection<WideBranchDto> SurvivingBranches => _response?.Branches.Where(x => !x.IsEliminated).ToArray() ?? [];
    internal IReadOnlyCollection<WideInterpretiveResultDto> PrioritizedInterpretiveResults => _response?.InterpretiveResults.Where(x => x.BranchStateCode != "DORMANT").ToArray() ?? [];
    internal IReadOnlyCollection<WideInterpretiveResultDto> SecondaryInterpretiveResults => _response?.InterpretiveResults.Where(x => x.BranchStateCode == "DORMANT").ToArray() ?? [];

    // The interpretive answer LLM usually returns a null per-item Score, so the real Cs must be sourced
    // from the computed Candidate × Branch competition (_response.Candidates). We join item (candidate) ×
    // result (branch) back onto WideCandidateDto.BranchScores by display name; the candidate's CompositeScore
    // is the reliable fallback when the exact branch cell is absent, then the item's own LLM score last.
    // LLM score: the model's own per-item score returned in the interpretive result.
    private decimal? InterpretiveItemLlmScore(WideInterpretiveResultItemDto item)
        => item.Score is { } llm ? Math.Clamp(llm, 0m, 1m) : null;

    // POLOXI Candidate × Branch Cs. The authoritative gated Cs is now computed in the pipeline
    // (WideCandidateBranchScoring.GatedCs) and PERSISTED on each candidate's branch cell, so the chip
    // simply reads that cell to stay consistent with ranking/ABV/narratives — no re-gating here (that
    // would double-apply the formula). When the item does not resolve to a candidate cell, fall back to
    // the item's own LLM prior, then the candidate composite, so the chip is never a misleading 0%.
    private decimal? InterpretiveItemPoloxiScore(WideInterpretiveResultDto result, WideInterpretiveResultItemDto item)
    {
        var candidate = _response?.Candidates
            .FirstOrDefault(c => string.Equals(c.DisplayName?.Trim(), item.Name?.Trim(), StringComparison.OrdinalIgnoreCase));
        var cell = candidate?.BranchScores
            .FirstOrDefault(b => string.Equals(b.BranchDisplayName?.Trim(), result.BranchDisplayName?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (cell is not null)
            return Math.Clamp(cell.EvidenceScore, 0m, 1m);

        if (item.Score is { } llm)
            return Math.Clamp(llm, 0m, 1m);

        return candidate is not null ? Math.Clamp(candidate.CompositeScore, 0m, 1m) : null;
    }
    internal IReadOnlyCollection<WideBranchDto> EliminatedBranches => _response?.Branches.Where(x => x.IsEliminated).ToArray() ?? [];
    internal IEnumerable<IGrouping<int, WideBranchDto>> BranchLevels => (_response?.Branches ?? []).OrderBy(x => x.SortOrder).GroupBy(x => x.LevelNumber).OrderBy(group => group.Key);
    internal IEnumerable<IGrouping<int, WideBranchDto>> UsedBranchLevels => SurvivingBranches.OrderBy(x => x.SortOrder).GroupBy(x => x.LevelNumber).OrderBy(group => group.Key);
    internal bool HasEnterpriseEvidence => _response?.EnterpriseEvidenceCount > 0;

    // E/F telemetry honesty: when the run admitted zero evidence signals, presentation must not imply
    // grounding or an evidence-weighted confidence. These pure-presentation helpers drive the honest
    // labels ("survived interpretive narrowing", "Evidence confidence: NONE", CandidateUncertainty =
    // NOT_APPLICABLE). They read existing response counts only and never change core values.
    internal int TotalEvidenceCount => _response is null ? 0 : _response.EnterpriseEvidenceCount + _response.ExternalEvidenceCount;
    internal bool HasAnyEvidence => TotalEvidenceCount > 0;

    // Evidence-admission diagnostic (pure presentation): mirrors the deterministic admission gate in
    // IntelligenceWide2Service so the Evidence tab can explain WHY a retrieved source was or was not
    // credited. A source counts as admitted only when it passed identity verification and is not marked
    // UNVERIFIED / SCOPE_INELIGIBLE. Reads response fields only; never changes any pipeline value.
    internal static bool DfiIsAdmitted(WideExternalKnowledgeSnippet snip)
        => snip.AuthorityIdentityVerified
           && !string.Equals(snip.PropositionSupportStatus, "UNVERIFIED", StringComparison.OrdinalIgnoreCase)
           && !string.Equals(snip.PropositionSupportStatus, "SCOPE_INELIGIBLE", StringComparison.OrdinalIgnoreCase);

    // Stable identity for an external source so the same authority (e.g. one statute retrieved once per
    // branch/proposition) is listed once instead of as several near-identical admission rows. Prefer the
    // canonical URL; fall back to Title + AuthorityKind + Jurisdiction when no URL is present.
    internal static string DfiSourceKey(WideExternalKnowledgeSnippet snip)
    {
        if (!string.IsNullOrWhiteSpace(snip.Url))
            return snip.Url.Trim().ToLowerInvariant();
        return string.Join(
            "|",
            (snip.Title ?? string.Empty).Trim().ToLowerInvariant(),
            (snip.AuthorityKind ?? string.Empty).Trim().ToLowerInvariant(),
            (snip.Jurisdiction ?? string.Empty).Trim().ToLowerInvariant());
    }

    internal static string DfiAdmissionReason(WideExternalKnowledgeSnippet snip)
    {
        if (!snip.AuthorityIdentityVerified)
            return "Rejected: identity verification failed — the retrieved source did not actually reference the cited authority.";
        if (string.Equals(snip.PropositionSupportStatus, "SCOPE_INELIGIBLE", StringComparison.OrdinalIgnoreCase))
            return "Rejected: out of jurisdiction — the source names a different governing-law sovereign than the matter.";
        if (string.Equals(snip.PropositionSupportStatus, "UNVERIFIED", StringComparison.OrdinalIgnoreCase))
            return "Rejected: unverified — the source could not be admitted as support for the proposition.";
        if (string.Equals(snip.PropositionSupportStatus, "AUTHORITY_FOUND_BUT_SUPPORT_UNCLEAR", StringComparison.OrdinalIgnoreCase))
            return "Admitted (weak): authority verified, but proposition support is unclear (low claim overlap).";
        if (string.Equals(snip.PropositionSupportStatus, "VERIFIED_SUPPORT", StringComparison.OrdinalIgnoreCase))
            return "Admitted: identity verified and the source text supports the proposition.";
        return "Admitted: identity verified.";
    }
    private string EvidenceConfidenceLabel => HasAnyEvidence ? $"{ConfidenceLabel} evidence confidence" : "Evidence confidence: NONE";
    private string SurvivalVerb => HasAnyEvidence ? "survived grounding" : "survived interpretive narrowing";
    // Candidate-basis uncertainty is only meaningful when a Candidate x Branch competition scored
    // candidates against evidence. With no evidence and no competition, it is NOT_APPLICABLE.
    private string CandidateUncertaintyDisplay => (HasAnyEvidence && IsEvidenceWeightedConfidence)
        ? _response!.FinalNormalizedEntropy.ToString("P0")
        : "NOT_APPLICABLE";

    private (decimal InterpretationPrior, decimal EvidenceSupport, decimal PoloxiConfidence) AmbiguityGroupScoreBreakdown(WideAmbiguityGroupDto group)
    {
        if (group.InterpretationPrior > 0 || group.EvidenceSupport > 0 || group.PoloxiConfidence > 0)
            return (group.InterpretationPrior, group.EvidenceSupport, group.PoloxiConfidence > 0 ? group.PoloxiConfidence : group.Confidence);
        var root = _response?.Branches.FirstOrDefault(branch => branch.WideBranchId == group.RootWideBranchId)
            ?? _response?.Branches.FirstOrDefault(branch => branch.LevelNumber == 1 && branch.DisplayName.Equals(group.DisplayName, StringComparison.OrdinalIgnoreCase));
        return root is null ? (0m, 0m, group.Confidence) : (root.InterpretationPrior, root.EvidenceSupport, root.PoloxiConfidence > 0 ? root.PoloxiConfidence : group.Confidence);
    }

    private static readonly System.Text.RegularExpressions.Regex BranchLevelPrefixPattern = new(@"^L\d+\s*(?:·|-|:)?\s+", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);
    private static readonly HashSet<string> ContractAssociationStopwords = new(StringComparer.OrdinalIgnoreCase)
    {
        "a","an","and","are","as","at","be","best","by","criteria","criterion","for","from","in","is","of","on","or","places","ranking","the","to","used","with"
    };
    internal sealed record BranchContractEntry(string Value,string Label,string Icon,string Title);
    private static IReadOnlyCollection<BranchContractEntry> AssociatedContractEntries(WideBranchDto branch,WideQueryContract contract)
    {
        var branchTokens=ContractAssociationTokens($"{branch.DisplayName} {branch.Interpretation}");
        if(branchTokens.Count==0)return [];
        var entries=new List<BranchContractEntry>();
        Add(contract.TargetObject??contract.EntityType,"UNIT","bi-bullseye","Comparison unit fixed by the query contract.");
        Add(contract.GeographicConstraint,"FIXED","bi-geo-alt","Geographic scope fixed by the query contract.");
        foreach(var constraint in contract.HardConstraints)Add(constraint,"FIXED","bi-lock","Hard constraint fixed by the query contract.");
        Add(contract.RankingConcept,"RANKING","bi-sliders","Evaluative concept this branch helps operationalize.");
        foreach(var concept in contract.AmbiguousConcepts)Add(concept,"AMBIGUOUS","bi-question-circle","Ambiguous concept this branch helps disambiguate.");
        return entries;

        void Add(string? value,string label,string icon,string title)
        {
            if(string.IsNullOrWhiteSpace(value))return;
            var entryTokens=ContractAssociationTokens(value);
            if(entryTokens.Count==0||!entryTokens.Overlaps(branchTokens))return;
            entries.Add(new(value.Trim(),label,icon,title));
        }
    }
    private static HashSet<string> ContractAssociationTokens(string value)=>System.Text.RegularExpressions.Regex.Matches(value,@"[\p{L}\p{N}]+")
        .Select(match=>match.Value.ToLowerInvariant())
        .Where(token=>token.Length>2&&!ContractAssociationStopwords.Contains(token))
        .Select(token=>token.Length>4&&token.EndsWith('s')?token[..^1]:token)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    private static string LevelPrefix(int levelNumber) => levelNumber > 0 ? $"L{levelNumber}" : "LN";
    private static string StripExistingLevelPrefix(string displayName) => string.IsNullOrWhiteSpace(displayName) ? displayName : BranchLevelPrefixPattern.Replace(displayName.Trim(), string.Empty);
    private static string BranchDisplayWithLevel(WideBranchDto branch) => $"{LevelPrefix(branch.LevelNumber)} · {StripExistingLevelPrefix(branch.DisplayName)}";
    private string InterpretiveBranchDisplayWithLevel(WideInterpretiveResultDto result) => $"{LevelPrefix(result.LevelNumber)} · {StripExistingLevelPrefix(result.BranchDisplayName)}";
    private string BranchNameWithLevel(string branchDisplayName)
    {
        var branch = _response?.Branches.FirstOrDefault(item => item.DisplayName.Equals(branchDisplayName, StringComparison.OrdinalIgnoreCase));
        return branch is null ? $"LN · {StripExistingLevelPrefix(branchDisplayName)}" : BranchDisplayWithLevel(branch);
    }

    internal string VerificationLabel => _response?.AnswerVerificationCode switch
    {
        // V2.5: "verified" is reserved for answers actually backed by enterprise evidence. Answers
        // grounded only in live external sources are honestly labeled as externally grounded.
        "VERIFIED" when HasEnterpriseEvidence => "Fully verified against enterprise evidence",
        "VERIFIED" => "Grounded in live external sources — no enterprise evidence involved",
        "PARTIALLY_VERIFIED" when HasEnterpriseEvidence => "Partially verified against enterprise evidence",
        "PARTIALLY_VERIFIED" => "Grounded in live external sources — no enterprise evidence involved",
        _ => "Interpretation not verified against enterprise data"
    };
    internal string AnswerHeading => _response?.AnswerVerificationCode == "VERIFIED" && HasEnterpriseEvidence ? "Verified answer" : "Grounded answer";

    // V2.4: the final visible ranking deterministically follows the Candidate × Branch competition.
    internal IReadOnlyList<WideCandidateDto> FinalRankedCandidates => _response is null ? []
        : _response.Candidates.Where(c => !c.IsConstraintViolation).OrderBy(c => c.RankNumber).Take(10).ToArray();
    internal bool ShouldShowComparisonPanel => _response is not null
        && (FinalRankedCandidates.Count > 0
            || BaselineRankedCandidates.Count > 0
            || LlmRawItems.Count > 0
            || string.Equals(_response.AnswerKindCode, "ENTITY_RANKING", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_response.QueryContract?.OutputShape, "ranked_list", StringComparison.OrdinalIgnoreCase));
    // Naive baseline ranking: mention frequency first, then a PLAIN unweighted average of the
    // per-dimension scores as tie-break — never POLOXI's RankNumber, so tied mention counts don't
    // silently mirror the POLOXI ranking. No coverage scaling, evidence confidence, or competition.
    internal IReadOnlyList<WideCandidateDto> BaselineRankedCandidates => _response is null ? []
        : _response.Candidates
            .Where(c => !c.IsConstraintViolation && c.InterpretiveSupportCount > 0)
            .OrderByDescending(c => c.InterpretiveSupportCount)
            .ThenByDescending(c => c.BranchScores.Count > 0 ? c.BranchScores.Average(s => s.EvidenceScore) : 0m)
            .ThenBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase)
            .Take(Math.Max(FinalRankedCandidates.Count, 1)).ToArray();

    internal string PoloxiUnavailableReason => _response switch
    {
        null => "no response loaded",
        { Candidates.Count: > 0 } when _response.Candidates.All(c => c.IsConstraintViolation) => "all candidate rows were ruled out by constraints or admission gates",
        { InterpretiveResults.Count: 0 } => "no interpretive ranked candidate items were returned to seed competition",
        { AnswerKindCode: not "ENTITY_RANKING" } when _response.QueryContract?.OutputShape != "ranked_list" => $"answer kind was routed as {_response.AnswerKindCode?.Replace('_', ' ') ?? "unclassified"}, so final candidate ranking was not required",
        { ExternalEvidenceCount: 0, EnterpriseEvidenceCount: 0 } => "no enterprise or external evidence was available to score candidates against branches",
        { DecisionEvidenceCoverage: 0 } => "candidate matrix did not resolve usable scored decision dimensions",
        { Candidates.Count: 0 } => "candidate normalization, matrix scoring, or LLM structured output produced no admissible candidates",
        _ => "no final non-violating candidate ranking was available"
    };

    internal string BaselineUnavailableReason => _response switch
    {
        null => "no response loaded",
        { Candidates.Count: 0 } => "no normalized POLOXI candidate pool was produced",
        _ when !_response.Candidates.Any(c => !c.IsConstraintViolation) => "all candidates were ruled out before baseline ranking",
        _ when !_response.Candidates.Any(c => c.InterpretiveSupportCount > 0) => "candidate rows have no interpretive mention counts to rank by frequency",
        _ => "no baseline candidates remained after filtering"
    };

    // Tooltip text explaining a baseline mention count: every interpretive dimension that named the
    // candidate with its quality score, straight from the Candidate × Branch data — no re-ranking.
    private static string MentionBreakdown(WideCandidateDto candidate) => candidate.BranchScores.Count == 0
        ? $"Named by {candidate.InterpretiveSupportCount} interpretive dimension(s); per-dimension scores unavailable for this candidate."
        : $"Named by {candidate.InterpretiveSupportCount} interpretive dimension(s):\n" + string.Join("\n",
            candidate.BranchScores.OrderByDescending(s => s.EvidenceScore).Select(s => $"• {s.BranchDisplayName}: {s.EvidenceScore:P0} quality score"));

    // Per-dimension evidence-score tooltip: the branch (interpretation dimension) that scored this
    // candidate. When a hierarchical roll-up applies, disclose the flat parent-level DirectScore too.
    internal static string BranchScoreTooltip(WideCandidateBranchScoreDto branch) => branch.DirectScore is { } direct
        ? $"{branch.BranchDisplayName}: {branch.EvidenceScore:P0} rolled-up quality score (flat parent judgment {direct:P0})."
        : $"{branch.BranchDisplayName}: {branch.EvidenceScore:P0} quality score.";

    // V3.5 hierarchical roll-up tooltip: shows how a parent dimension score was derived from the
    // model's direct judgment blended with the confidence-weighted narrowing sub-criteria.
    private static string RollUpTooltip(WideCandidateBranchScoreDto score) =>
        $"Rolled up from progressive narrowing (50% direct + 50% sub-criteria).\nDirect judgment: {(score.DirectScore ?? score.EvidenceScore):P0}\n" + string.Join("\n",
            score.ChildScores.OrderByDescending(child => child.EvidenceScore).Select(child => $"• {child.BranchDisplayName}: {child.EvidenceScore:P0} (weight {child.Confidence:P0})"));

    // The raw first LLM result: a genuine single-shot answer to the plain query from the selected model,
    // captured server-side in parallel with the POLOXI pipeline — exactly what the model's own chat
    // interface would have returned, before any evidence, competition, or filtering.
    internal IReadOnlyList<WideInterpretiveResultItemDto> LlmRawItems => _response is null ? []
        : _response.LlmRawItems.OrderBy(x => x.RankNumber).ToArray();

    // Where a raw-LLM entry landed in the POLOXI ranking (1-based), or null when POLOXI excluded it.
    // Tolerant match: raw chat answers often omit qualifiers ("Irvine" vs "Irvine, CA") or corporate
    // suffixes ("Alphabet (GOOGL)" vs "Alphabet Inc. (GOOGL)"). Matching order: exact, then identical
    // parenthetical code (ticker/symbol — the canonical key when both sides provide one), then
    // containment, then primary-name (text before any comma/parenthesis/dash qualifier) equality.
    private int? FindPoloxiRank(string rawName)
    {
        var rawCode = ParentheticalCode(rawName);
        var rawPrimary = PrimaryName(rawName);
        for (var index = 0; index < FinalRankedCandidates.Count; index++)
        {
            var candidate = FinalRankedCandidates[index].DisplayName;
            if (candidate.Equals(rawName, StringComparison.OrdinalIgnoreCase)) return index + 1;
            if (rawCode is not null && rawCode.Equals(ParentheticalCode(candidate), StringComparison.OrdinalIgnoreCase)) return index + 1;
            if (candidate.Contains(rawName, StringComparison.OrdinalIgnoreCase)
                || rawName.Contains(candidate, StringComparison.OrdinalIgnoreCase)) return index + 1;
            if (rawPrimary.Length >= 4 && rawPrimary.Equals(PrimaryName(candidate), StringComparison.OrdinalIgnoreCase)) return index + 1;
        }
        return null;
    }

    // The code inside the last parentheses, e.g. "NVIDIA Corporation (NVDA)" -> "NVDA".
    private static string? ParentheticalCode(string name)
    {
        var open = name.LastIndexOf('(');
        var close = name.LastIndexOf(')');
        return open >= 0 && close > open + 1 ? name[(open + 1)..close].Trim() : null;
    }

    // The entity name before any qualifier, with common corporate suffixes stripped:
    // "Meta Platforms, Inc. (META)" -> "Meta Platforms".
    private static string PrimaryName(string name)
    {
        var primary = name.Split(',', '(', '\u2013', '\u2014')[0].Trim();
        foreach (var suffix in new[] { " Inc.", " Inc", " Corporation", " Corp.", " Corp", " Co.", " Company", " Ltd.", " Ltd", " PLC", " LLC" })
            if (primary.EndsWith(suffix, StringComparison.OrdinalIgnoreCase)) { primary = primary[..^suffix.Length].Trim(); break; }
        return primary;
    }

    // Contested/resolved zone for the POLOXI cell background tint: a candidate is CONTESTED (1)
    // when it sits within scoring noise (<3%) of the candidate above or below — a visual band of
    // near-ties. It is CLEAR (2) when separated by ≥5% on both sides (or the relevant side at the
    // edges). Anything in between is neutral (0). Pure presentation over the same composite scores.
    private int ContestZoneAt(int rowIndex)
    {
        if (rowIndex < 0 || rowIndex >= FinalRankedCandidates.Count) return 0;
        var gapAbove = rowIndex > 0 ? FinalRankedCandidates[rowIndex - 1].CompositeScore - FinalRankedCandidates[rowIndex].CompositeScore : (decimal?)null;
        var gapBelow = rowIndex < FinalRankedCandidates.Count - 1 ? FinalRankedCandidates[rowIndex].CompositeScore - FinalRankedCandidates[rowIndex + 1].CompositeScore : (decimal?)null;
        if (gapAbove is < .03m || gapBelow is < .03m) return 1;
        if ((gapAbove is null or >= .05m) && (gapBelow is null or >= .05m)) return 2;
        return 0;
    }

    // Margin gap: how far this POLOXI-ranked candidate leads the next one. Complements the
    // entropy funnel — the funnel measures the whole distribution, while the gap shows exactly
    // WHERE the ranking is contested (tiny gap = within scoring noise) vs resolved (clear lead).
    private decimal? MarginToNext(int rowIndex) =>
        rowIndex >= 0 && rowIndex < FinalRankedCandidates.Count - 1
            ? Math.Max(FinalRankedCandidates[rowIndex].CompositeScore - FinalRankedCandidates[rowIndex + 1].CompositeScore, 0m)
            : null;

    // Ambiguity funnel diagram: starts at the measured initial normalized entropy, passes through
    // each information round's measured after-round entropy in order, and ends at the final
    // normalized entropy. All values come from POLOXI's deterministic measurements; this is an
    // execution-level metric, not a per-candidate one.
    private IReadOnlyList<(string Label, decimal Value)> FunnelStages
    {
        get
        {
            if (_response is null) return [];
            var stages = new List<(string, decimal)> { ("Initial ambiguity", _response.InitialNormalizedEntropy) };
            stages.AddRange(_response.InformationRounds.OrderBy(r => r.RoundNumber).Where(r => r.NormalizedEntropyAfter.HasValue).Select(r => ($"After round {r.RoundNumber}", r.NormalizedEntropyAfter!.Value)));
            stages.Add(("After convergence", _response.FinalNormalizedEntropy));
            return stages;
        }
    }
    internal string GroundingBadge => _response switch
    {
        { AnswerVerificationCode: "VERIFIED" } when HasEnterpriseEvidence => "VERIFIED",
        { AnswerVerificationCode: "VERIFIED" or "PARTIALLY_VERIFIED" } => "LIVE-GROUNDED",
        { AnswerKindCode: "ENTITY_RANKING", DecisionEvidenceCoverage: >= .5m } => "DECISION GROUNDED",
        { EvidenceCoverage: >= .5m } => "PARTIALLY GROUNDED",
        _ => "LIMITED EVIDENCE"
    };
    private static string BranchStateLabel(WideBranchDto branch) => branch.BranchStateCode switch
    {
        "PRUNED" => "RULED OUT",
        "DORMANT" => "NOT PRIORITIZED",
        "SECONDARY" => "ALSO RELEVANT",
        _ => branch.IsEliminated ? "RULED OUT" : branch.GroundingStatusCode
    };
    internal int ActiveBranchCount => SurvivingBranches.Count(x => x.BranchStateCode == "ACTIVE");

    // ── Assessment / Why for every generated L1..Ln branch, mirroring /personalinjury_decision.
    // The Wide engine exposes a three-score model (interpretation prior · evidence support · POLOXI
    // confidence) plus grounding/evidence, so the same qualitative buckets are derived from those factors.
    private static string BranchAssessment(WideBranchDto branch)
    {
        if (branch.IsEliminated || branch.BranchStateCode == "PRUNED")
            return "Ruled out";
        var evidenceSupport = branch.EvidenceSupport;
        var confidence = branch.PoloxiConfidence > 0 ? branch.PoloxiConfidence : branch.Confidence;
        var grounded = branch.GroundingStatusCode == "GROUNDED";
        if (grounded && evidenceSupport >= 0.75m && confidence >= 0.8m)
            return "Very good";
        if (grounded && evidenceSupport >= 0.55m && confidence >= 0.6m)
            return branch.EvidenceCount < 2 ? "Good, but broad" : "Good";
        if (confidence >= 0.6m)
            return "Relevant, but limited";
        return "Needs refinement";
    }

    private static string BranchAssessmentWhy(WideBranchDto branch)
    {
        if (branch.IsEliminated && !string.IsNullOrWhiteSpace(branch.EliminationReason))
            return branch.EliminationReason!;
        var confidence = branch.PoloxiConfidence > 0 ? branch.PoloxiConfidence : branch.Confidence;
        if (branch.GroundingStatusCode == "GROUNDED" && branch.EvidenceSupport >= 0.75m)
            return $"Strongly supported by evidence (support {branch.EvidenceSupport:P0}; {branch.EvidenceCount} evidence; confidence {confidence:P0}).";
        if (branch.GroundingStatusCode == "GROUNDED")
            return $"Grounded in {branch.EvidenceCount} evidence item(s), but support is partial (support {branch.EvidenceSupport:P0}; confidence {confidence:P0}).";
        if (branch.InterpretationPrior >= 0.6m)
            return $"Plausible interpretive path (LLM prior {branch.InterpretationPrior:P0}), but not yet enterprise-grounded.";
        return "Interpretive reasoning path with limited support; less likely to change the current ranking.";
    }

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Intelligence", "/intelligence"), new("Personal Injury Decision 2", "/legal/personalinjury_decision2"));

        // Honor a deep-linked starting tab (?tab=) when it matches a known cockpit tab.
        if (!string.IsNullOrWhiteSpace(InitialTab))
        {
            var match = DfiTabs.FirstOrDefault(t => string.Equals(t, InitialTab, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
                _dfiTab = match;
        }

        // Keep the full-page loading overlay up until the API host is reachable. When the backend is
        // still starting (connection refused / socket error), wait for it instead of flashing an empty
        // page, mirroring the loading behavior on the matters list pages.
        try
        {
            await WaitForApiReadyAsync();
            await LoadInitialDataAsync();
        }
        finally
        {
            _initializing = false;
            StateHasChanged();
        }
    }

    private async Task LoadInitialDataAsync()
    {
        // These three loads are independent of the matter and of each other, so start them up front and
        // let them run concurrently with the matter-scoped loads below instead of awaiting each in series.
        var modelsTask = SafeAsync(() => Api.GetIntelligenceWide2ModelsAsync(), (IReadOnlyCollection<WideModelOptionDto>)[]);
        var showPipelineTask = SafeAsync(() => Api.GetSearch2ShowPipelineAsync(), false);
        var contextsTask = SafeAsync(() => Api.GetIntelligenceSearch2ContextsAsync(), (IReadOnlyCollection<WideSearchContextDto>)[]);

        if (MatterId is { } matterId && matterId != Guid.Empty)
        {
            // Restore the last Overview result for this matter so returning from the
            // Candidate Full Analysis drill-down shows exactly what the user was viewing
            // instead of a blank page. The cache is circuit-scoped working memory.
            _response = OverviewState.TryGet(matterId);

            // Analysis History "View Decision2 results": rehydrate the full saved Wide run read-only.
            if (IsSavedRunView && RunId is { } savedRunId)
            {
                try
                {
                    var saved = await Api.GetSavedWideResultAsync(savedRunId);
                    if (saved is not null)
                        _response = saved;
                    else
                        _savedRunError = "This run has no saved Decision2 results to display.";
                }
                catch (Exception ex)
                {
                    _savedRunError = $"Unable to load saved results: {ex.Message}";
                }
            }
            try
            {
                // Matter, documents and calibration are all keyed only on matterId (not on each other),
                // so fetch them concurrently; total wait becomes the slowest call, not their sum.
                var matterTask = Api.GetLegalDecisionMatterAsync(matterId);
                var documentsTask = SafeAsync(() => Api.GetLegalMatterDocumentsAsync(matterId), (IReadOnlyCollection<LegalDocumentDto>)[]);
                var calibrationTask = LoadCalibrationDataAsync(matterId);

                _matter = await matterTask;
                _documents = await documentsTask;
                await calibrationTask;

                // Remember the matter in view so the static top-nav Case Command Center / Provider Portal
                // links can restore it instead of dropping to the empty "Open a Matter" state.
                ActiveMatter.Set(_matter?.DecisionMatterId ?? matterId);
                if (_matter is not null && string.IsNullOrWhiteSpace(_query))
                {
                    // Seed only a readable default question from the matter title. The full structured
                    // Matter context (distinct legal scope, PI profile, facts, evidence, provenance) is
                    // projected server-side from the immutable Matter Context Snapshot via MatterId — it is
                    // NOT concatenated into the free-text question here, so distinct legal fields never
                    // collapse and the user can freely edit the question without losing matter context.
                    _query = _matter.Title ?? string.Empty;
                }
            }
            catch { _matter = null; }
        }

        _models = await modelsTask;
        // Auto (empty) is always valid. Only reset an explicit selection that is no longer a DB-backed model.
        if (!string.IsNullOrWhiteSpace(_selectedModelCode) && !_models.Any(m => string.Equals(m.ModelCode, _selectedModelCode, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedModelCode = "";
        }
        // Default to the GPT Luna model when no explicit selection has been made and it is available.
        if (string.IsNullOrWhiteSpace(_selectedModelCode))
        {
            var lunaModel = _models.FirstOrDefault(m => m.ModelCode.Contains("luna", StringComparison.OrdinalIgnoreCase));
            if (lunaModel is not null)
            {
                _selectedModelCode = lunaModel.ModelCode;
            }
        }
        _showPipeline = await showPipelineTask;
        _contexts = await contextsTask;
        if (_contexts.Count > 0)
        {
            // Prefer the Legal context; otherwise fall back to the flagged default/first context.
            var preferred = _contexts.FirstOrDefault(c => string.Equals(c.ContextCode, "Legal", StringComparison.OrdinalIgnoreCase));
            var defaultContext = preferred ?? _contexts.FirstOrDefault(c => c.IsDefault) ?? _contexts.FirstOrDefault();
            if (defaultContext is not null) _selectedContextCode = defaultContext.ContextCode;
        }
        // If a cached Overview result was restored above, reload the DB-backed intelligence
        // layers it depends on so the restored view shows real Document Intelligence,
        // Decision Structure, and readiness values instead of empty panels.
        if (_response is not null)
        {
            try { await RefreshPostAnswerIntelligenceAsync(); } catch { /* fail-soft: keep the restored answer visible */ }
        }
    }

    // Awaits a fail-soft API call, returning a fallback value if it throws. Mirrors the per-call
    // try/catch fallbacks used throughout initial load so independent calls can run concurrently.
    private static async Task<T> SafeAsync<T>(Func<Task<T>> call, T fallback)
    {
        try { return await call(); }
        catch { return fallback; }
    }

    // Blocks (with the loading overlay visible) until the API host accepts connections. A connection
    // refused / socket error means the backend isn't ready yet, so we retry quietly instead of
    // rendering an empty page while the service is still starting up.
    private async Task WaitForApiReadyAsync()
    {
        const int maxAttempts = 30;
        for (var attempt = 1; attempt <= maxAttempts; attempt++)
        {
            try
            {
                await Api.GetSearch2ShowPipelineAsync();
                return;
            }
            catch (Exception ex) when (IsApiNotReady(ex) && attempt < maxAttempts)
            {
                await Task.Delay(1000);
            }
            catch
            {
                // A non-connectivity error (e.g. auth) means the host IS up; stop waiting and
                // let the normal fail-soft loads below handle it.
                return;
            }
        }
    }

    // True when the failure indicates the API host is not accepting connections yet
    // (still starting up) rather than a genuine application error.
    private static bool IsApiNotReady(Exception ex)
    {
        for (var e = ex; e is not null; e = e.InnerException!)
        {
            if (e is System.Net.Sockets.SocketException) return true;
            if (e is HttpRequestException hre && hre.StatusCode is null) return true;
            if (e.InnerException is null) break;
        }
        return false;
    }

    // Browser sessionStorage key for the persisted Overview answer, scoped per matter so a full
    // page reload (which recreates the circuit and empties the in-memory cache) can still restore it.
    private static string OverviewStorageKey(Guid matterId) => $"poloxi.overview.{matterId:N}";

    // Set once the circuit cache has been checked against sessionStorage, so we only restore once.
    private bool _overviewRestoreAttempted;

    private async Task PersistOverviewAsync(Guid matterId, WideSearchResponse response)
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(response);
            await JS.InvokeVoidAsync("sessionStorage.setItem", OverviewStorageKey(matterId), json);
        }
        catch { /* best-effort persistence; never block the UI on storage failures */ }
    }

    // Restores a persisted Overview answer from the browser after a full reload, when neither the
    // in-memory circuit cache nor a fresh pipeline run produced a response. Runs after first render
    // (JS interop is unavailable during prerender/OnInitialized on Blazor Server).
    private async Task TryRestorePersistedOverviewAsync()
    {
        if (_overviewRestoreAttempted) return;
        _overviewRestoreAttempted = true;

        if (_response is not null) return; // already have a result (circuit cache or fresh run)
        if (MatterId is not { } matterId || matterId == Guid.Empty) return;

        try
        {
            var json = await JS.InvokeAsync<string?>("sessionStorage.getItem", OverviewStorageKey(matterId));
            if (string.IsNullOrWhiteSpace(json)) return;

            var restored = System.Text.Json.JsonSerializer.Deserialize<WideSearchResponse>(json);
            if (restored is null) return;

            _response = restored;
            OverviewState.Save(matterId, restored); // rehydrate the circuit cache too
            // Reload the DB-backed intelligence layers the restored answer depends on.
            try { await RefreshPostAnswerIntelligenceAsync(); } catch { /* fail-soft: keep the restored answer visible */ }
            StateHasChanged();
        }
        catch { /* corrupt/absent payload — fall back to the empty state */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Restore a persisted answer once the init overlay has cleared. We can't rely on firstRender
        // alone because initialization (WaitForApiReady) finishes on a later render, so attempt the
        // one-shot restore on any post-init render until it has run.
        if (!_initializing && !_overviewRestoreAttempted)
        {
            await TryRestorePersistedOverviewAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) || _query.Trim().Length < 2) return;
        _clarificationAnswer = "";
        _loading = true;
        _error = null;
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        var correlationId = Guid.NewGuid().ToString("N");
        // Show the 1->7 pipeline strip for the ENTIRE run. The strip's visibility gate
        // (DfiShowLiveExecution) needs _livePhaseLog.Count > 0, previously fed only by SignalR.
        // Seed a local ANALYZING snapshot up front so the indicator is visible immediately, even
        // during just-in-time corpus activation below and even if the live SignalR feed never
        // connects (transport/tenant/auth). Real "progress" messages simply replace this entry.
        SeedLiveProgress(correlationId);
        await InvokeAsync(StateHasChanged);
        // Connect the live SignalR progress feed FIRST so the hub subscription is established before the
        // (potentially long) just-in-time corpus activation runs. Otherwise the strip sits frozen at the
        // seeded 0/0/0 snapshot for the entire enrichment window and any early pipeline frames are missed.
        await StartLiveProgressAsync(correlationId);
        // Activate any prepared-but-not-enriched corpus documents before answering, using the model
        // selected for this answer. Enrichment + CDC were deferred at upload; run them just-in-time so
        // the answer reasons over a fully activated corpus. Fail-soft: activation must not block the answer.
        await ActivateMatterCorpusForAnswerAsync();
        try
        {
            _response = await Api.IntelligentSearchWide2DynamicAsync(new(Guid.Empty, Guid.Empty, _query.Trim(), 50, correlationId) { UsePoloxiEngine = _usePoloxiEngine, UseDomainPack = _useDomainPack, ModelCode = _selectedModelCode, ForceRequestedModelAllStages = !string.IsNullOrWhiteSpace(_selectedModelCode), ContextCode = _selectedContextCode, MatterId = MatterId }, _searchCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            // User-initiated cancel — not an error; keep any previous result on screen.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            await StopLiveProgressAsync();
            // Reload the DB-backed intelligence layers the Overview depends on so Document Intelligence,
            // Decision Structure, Latest Intelligence, change drivers, and readiness blockers show real values.
            if (_response is not null)
            {
                // Cache the result so navigating into Full Analysis and back restores this view.
                if (MatterId is { } matterId && matterId != Guid.Empty)
                {
                    OverviewState.Save(matterId, _response);
                    // Also persist to the browser so a full page reload restores the answer
                    // instead of forcing the user to re-run the pipeline.
                    await PersistOverviewAsync(matterId, _response);
                }
                await RefreshPostAnswerIntelligenceAsync();
            }
        }
    }

    // Drives just-in-time corpus activation on the Disambiguate & Answer path.
    // prepared only (extracted text, no propositions); this enriches the pending versions and runs CDC
    // in bounded batches, animating the integrated pipeline's "Activated on answer" chips, before the
    // answer request runs. Fail-soft: any activation failure is surfaced only in stage state, never fatal.
    private bool _activating;
    // Human-readable outcome of the most recent answer-time activation. Non-null only when activation
    // was attempted and either failed outright or could not enrich every prepared version (e.g. the
    // tenant has no usable CHAT route). Surfaced in the UI so an empty Evidence tab is never silent.
    internal string? _activationNotice;
    private bool _activationFailed;
    // Reflects the current corpus activation state into the pipeline's "Activated on answer" chips
    // without running activation. Pending versions -> Queued; fully enriched -> Done; unknown -> Queued.
    private async Task SyncActivationIndicatorAsync(Guid matterId)
    {
        try
        {
            var status = await Api.GetLegalMatterCorpusStatusAsync(matterId, _searchCancellation?.Token ?? default);
            _uploadStages ??= BuildUploadStages();
            if (status is not null && status.PendingVersions <= 0 && status.EnrichedVersions > 0)
            {
                SetUploadStage("propositions", UploadStageState.Done);
                SetUploadStage("cdc", UploadStageState.Done);
            }
            else
            {
                SetUploadStage("propositions", UploadStageState.Queued);
                SetUploadStage("cdc", UploadStageState.Queued);
            }
        }
        catch
        {
            // Status is best-effort here; leave stages at their default (Queued) so the indicator still shows.
            _uploadStages ??= BuildUploadStages();
        }
    }
    private async Task ActivateMatterCorpusForAnswerAsync()
    {
        if (MatterId is not { } matterId || matterId == Guid.Empty || _activating) return;
        _activating = true;
        try
        {
            var status = await Api.GetLegalMatterCorpusStatusAsync(matterId, _searchCancellation?.Token ?? default);
            if (status is null || status.PendingVersions <= 0) return;

            _uploadStages ??= BuildUploadStages();
            SetUploadStage("propositions", UploadStageState.Active);
            SetUploadStage("cdc", UploadStageState.Active);
            _activationNotice = null;
            _activationFailed = false;
            _documentActivationLog.Clear();

            // Surface preparation on the live pipeline strip so it isn't frozen at the seeded snapshot
            // while the (potentially multi-minute) document enrichment runs before the decision pipeline.
            // Counts reflect the authoritative DB corpus size (EnrichedVersions of TotalVersions).
            ReportPreparingPhase(status.EnrichedVersions, status.TotalVersions);
            await InvokeAsync(StateHasChanged);

            var model = string.IsNullOrWhiteSpace(_selectedModelCode) ? null : _selectedModelCode;
            var guard = 0;
            var lastPending = status.PendingVersions;
            // Process bounded batches until no prepared versions remain — or until a batch makes no
            // forward progress (pending count did not drop), which means those versions cannot be
            // enriched (e.g. no CHAT route). Re-running the same stuck versions only wastes time/money.
            while (guard++ < 50)
            {
                var token = _searchCancellation?.Token ?? default;
                token.ThrowIfCancellationRequested();
                var result = await Api.ActivateLegalMatterCorpusAsync(matterId, model, 3, token);
                if (result is null)
                    break;
                // Accumulate every document processed in this batch into the expandable activation log,
                // then report the real DB progress naming the current document on the pipeline line.
                foreach (var doc in result.BatchDetails)
                {
                    _documentActivationLog.RemoveAll(d => d.LegalDocumentVersionId == doc.LegalDocumentVersionId);
                    _documentActivationLog.Insert(0, doc);
                }
                ReportPreparingPhase(result.EnrichedVersions, result.TotalVersions, result.CurrentDocument);
                await InvokeAsync(StateHasChanged);
                if (result.IsComplete)
                    break;
                // Stop if this batch did not reduce the pending backlog — no genuine progress was made.
                if (result.PendingVersions >= lastPending)
                    break;
                lastPending = result.PendingVersions;
            }

            await LoadEvidenceGraphAsync();
            var final = await Api.GetLegalMatterCorpusStatusAsync(matterId, _searchCancellation?.Token ?? default);
            if (final is null || final.PendingVersions <= 0)
            {
                SetUploadStage("propositions", UploadStageState.Done);
                SetUploadStage("cdc", UploadStageState.Done);
                // Activation succeeded — the prepared-only banner is now stale, so clear it.
                _uploadOutcome = null;
                _activationNotice = null;
                _activationFailed = false;
            }
            else
            {
                // Some versions could not be enriched (e.g. no CHAT route); keep them visibly deferred
                // and tell the user why the Evidence tab may still be empty.
                SetUploadStage("propositions", UploadStageState.Skipped);
                SetUploadStage("cdc", UploadStageState.Skipped);
                _activationFailed = true;
                // Prefer the ACTUAL backend failure reason captured during the activation pass over the
                // generic "no CHAT route" guess. The server now records the real exception per document
                // version, so we surface the distinct reasons (route/deployment/parse/timeout) verbatim.
                var failureReasons = _documentActivationLog
                    .Where(d => !d.Succeeded && !string.IsNullOrWhiteSpace(d.FailureReason))
                    .Select(d => $"'{d.FileName}': {d.FailureReason}")
                    .Distinct()
                    .ToList();
                if (failureReasons.Count > 0)
                {
                    _activationNotice =
                        $"{final.PendingVersions} document version(s) could not be activated into the reasoning engine, " +
                        "so no propositions or evidence were derived for them. The answer was still produced from " +
                        "available sources, but the Evidence Graph may remain empty until this is resolved. " +
                        $"Actual cause: {string.Join(" | ", failureReasons)}";
                }
                else
                {
                    _activationNotice =
                        $"{final.PendingVersions} document version(s) could not be activated into the reasoning engine, " +
                        "so no propositions or evidence were derived for them. This usually means the tenant has no active " +
                        "CHAT model route configured for LEGAL_DOCUMENT_SEMANTIC_EXTRACTION. The answer was still produced " +
                        "from available sources, but the Evidence Graph may remain empty until routing is fixed.";
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Answer was cancelled during activation — leave stage state as-is.
        }
        catch (Exception ex)
        {
            SetUploadStage("propositions", UploadStageState.Skipped);
            SetUploadStage("cdc", UploadStageState.Skipped);
            _activationFailed = true;
            _activationNotice =
                "Corpus activation failed before any evidence could be derived, so the Evidence Graph may be empty. " +
                $"The answer was still produced from available sources. Details: {ex.Message}";
        }
        finally
        {
            _activating = false;
        }
    }

    // V2.8: submitting a clarification answer continues the SAME reasoning context — the answer is
    // sent as an added constraint alongside the original query, so POLOXI reweights instead of restarting.
    private async Task SubmitClarificationAsync(string answer)
    {
        if (string.IsNullOrWhiteSpace(answer) || _response is null) return;
        var target = _response.ClarificationTarget;
        // V2.8.5: carry the round counter and the asking execution's intent entropy so the backend
        // can measure Clarification Gain and enforce the multi-round stop rules.
        var round = _response.ClarificationRound + 1;
        var priorIntentEntropy = _response.IntentEntropy;
        // V3.2.3: carry the original run's AnswerKind so the continuation inherits the original task
        // classification instead of re-classifying the answer-polluted text.
        var originalAnswerKind = _response.AnswerKindCode;
        // V3.4: the continuation token — the server derives the whole epistemic chain (round, prior
        // entropy, answer kind, target, original query) from this persisted execution row; the
        // client-carried fields below remain only as a legacy fallback.
        var parentExecutionId = _response.WideExecutionId;
        _loading = true;
        _error = null;
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        var correlationId = Guid.NewGuid().ToString("N");
        await StartLiveProgressAsync(correlationId);
        try
        {
            _response = await Api.IntelligentSearchWide2DynamicAsync(new(Guid.Empty, Guid.Empty, _query.Trim(), 50, correlationId) { UsePoloxiEngine = _usePoloxiEngine, UseDomainPack = _useDomainPack, ClarificationAnswer = answer.Trim(), ClarificationTarget = target, ClarificationRound = round, PriorIntentEntropy = priorIntentEntropy, OriginalAnswerKind = originalAnswerKind, ParentWideExecutionId = parentExecutionId, ModelCode = _selectedModelCode, ForceRequestedModelAllStages = !string.IsNullOrWhiteSpace(_selectedModelCode), ContextCode = _selectedContextCode, MatterId = MatterId }, _searchCancellation.Token);
            _clarificationAnswer = "";
        }
        catch (OperationCanceledException)
        {
            // User-initiated cancel — not an error; keep the clarification context on screen.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            await StopLiveProgressAsync();
            // Reload the DB-backed intelligence layers so the Overview reflects the refined decision.
            if (_response is not null)
            {
                // Cache the refined result so navigating into Full Analysis and back restores this view.
                if (MatterId is { } matterId && matterId != Guid.Empty)
                {
                    OverviewState.Save(matterId, _response);
                    // Also persist to the browser so a full page reload restores the answer.
                    await PersistOverviewAsync(matterId, _response);
                }
                await RefreshPostAnswerIntelligenceAsync();
            }
        }
    }

    // Cancels the in-flight wide search: stops the client poll loop and (best-effort) the server-side pipeline.
    private void CancelSearch() => _searchCancellation?.Cancel();

    private CancellationTokenSource? _searchCancellation;

    private async Task ClarificationKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SubmitClarificationAsync(_clarificationAnswer);
    }

    private async Task KeyDown(KeyboardEventArgs args)
    {
        // Enter submits; Shift+Enter inserts a new line (multi-line enterprise composer).
        if (args.Key == "Enter" && !args.ShiftKey) await SearchAsync();
    }

    private void OpenEvidence(PoloxiEvidenceDto evidence)
    {
        if (!string.IsNullOrWhiteSpace(evidence.NavigationRoute)) Navigation.NavigateTo(evidence.NavigationRoute);
    }

    private void OpenRoute(string route)
    {
        if (!string.IsNullOrWhiteSpace(route)) Navigation.NavigateTo(route);
    }

    private async Task OpenExternal(string url)
    {
        if (!string.IsNullOrWhiteSpace(url)) await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
    }
}




