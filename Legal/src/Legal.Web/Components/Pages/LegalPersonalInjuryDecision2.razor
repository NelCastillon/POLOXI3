    // ── Add-Proposition Decision Model Hierarchy (tree panel) ────────────────────────────────────────
    // Read-only projection over the DB-backed HiNodes. Candidate short-codes (C1/C2/…) are the ordinal of
    // the L1 candidate nodes; score badges surface the authoritative EvaluatedValue (or the approved matter
    // assessment) — never a fabricated value.
    internal string _adiTreeView = "Hierarchy";
    internal string _adiTreeSearch = string.Empty;
    private readonly HashSet<Guid> _adiCollapsed = new();

    private IReadOnlyList<Legal.Application.Features.Intelligence.Decision.AttorneyDecisionNodeDto> AdiCandidates
        => HiNodes.Where(n => n.NodeLevel == 1).OrderBy(n => n.PlacementKey).ThenBy(n => n.CanonicalKey).ToList();

    internal string AdiCandidateCode(Guid candidateNodeId)
    {
        var list = AdiCandidates;
        for (var i = 0; i < list.Count; i++)
        {
            if (list[i].DecisionNodeId == candidateNodeId) return $"C{i + 1}";
        }
        return "C?";
    }

    private IReadOnlyList<Legal.Application.Features.Intelligence.Decision.AttorneyDecisionNodeDto> AdiChildren(Guid parentNodeId)
        => HiNodes.Where(n => n.ParentNodeId == parentNodeId)
            .OrderBy(n => n.PlacementKey).ThenBy(n => n.CanonicalKey).ToList();

    internal static decimal? AdiNodeScore(Legal.Application.Features.Intelligence.Decision.AttorneyDecisionNodeDto node)
        => node.ApprovedAssessment?.ConfirmedValue ?? node.EvaluatedValue;

    internal static string AdiScoreTone(decimal? value) => value switch
    {
        null => "muted",
        >= 70m => "ok",
        >= 45m => "warn",
        _ => "danger"
    };

    private bool AdiIsCollapsed(Guid id) => _adiCollapsed.Contains(id);

    private void AdiToggleNode(Guid id)
    {
        if (!_adiCollapsed.Add(id)) _adiCollapsed.Remove(id);
    }

    // Flat projection for the "List View" and "Search" sub-tabs.
    internal IReadOnlyList<Legal.Application.Features.Intelligence.Decision.AttorneyDecisionNodeDto> AdiFlatNodes
    {
        get
        {
            var q = HiNodes.AsEnumerable();
            if (_adiTreeView == "Search" && !string.IsNullOrWhiteSpace(_adiTreeSearch))
            {
                var term = _adiTreeSearch.Trim();
                q = q.Where(n => n.NodeText.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || n.CanonicalKey.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return q.OrderBy(n => n.NodeLevel).ThenBy(n => n.PlacementKey).ThenBy(n => n.CanonicalKey).ToList();
        }
    }

    // Recursive child renderer for the Decision Model Hierarchy tree. Indents by depth, shows a chevron
    // when a node has children, surfaces the authoritative score, and renders the "Insert proposition here"
    // marker beneath the currently selected placement parent.
    private RenderFragment AdiTreeChildren(Guid parentId, int depth) => builder =>
    {
        var seq = 0;
        foreach (var child in AdiChildren(parentId))
        {
            var children = AdiChildren(child.DecisionNodeId);
            var collapsed = AdiIsCollapsed(child.DecisionNodeId);
            var score = AdiNodeScore(child);
            var isSelected = _hiSelectedNodeId == child.DecisionNodeId;

            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", $"adi-tree-row adi-tree-row--node{(isSelected ? " adi-tree-row--active" : "")}");
            builder.AddAttribute(seq++, "style", $"padding-left:{8 + depth * 16}px");
            var captured = child.DecisionNodeId;
            builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => _hiSelectedNodeId = captured));

            if (children.Count > 0)
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "adi-tree-caret");
                builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
                builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => AdiToggleNode(captured)));
                builder.OpenElement(seq++, "i");
                builder.AddAttribute(seq++, "class", $"bi {(collapsed ? "bi-chevron-right" : "bi-chevron-down")}");
                builder.CloseElement();
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "adi-tree-caret adi-tree-caret--leaf");
                builder.CloseElement();
            }

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "adi-tree-lvl");
            builder.AddContent(seq++, $"L{child.NodeLevel}");
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "adi-tree-text");
            builder.AddAttribute(seq++, "title", child.NodeText);
            builder.AddContent(seq++, child.NodeText);
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", $"adi-score adi-score--{AdiScoreTone(score)}");
            builder.AddContent(seq++, score?.ToString("0") ?? "—");
            builder.CloseElement();

            builder.CloseElement(); // button row

            // Insert marker beneath the chosen placement parent.
            if (_adiParentNodeId == child.DecisionNodeId)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "adi-tree-insert");
                builder.AddAttribute(seq++, "style", $"margin-left:{8 + (depth + 1) * 16}px");
                builder.OpenElement(seq++, "i");
                builder.AddAttribute(seq++, "class", "bi bi-plus-circle-fill");
                builder.CloseElement();
                builder.AddContent(seq++, "Insert proposition here");
                builder.CloseElement();
            }

            if (!collapsed && children.Count > 0)
            {
                builder.AddContent(seq++, AdiTreeChildren(child.DecisionNodeId, depth + 1));
            }
        }
    };

    // Recursive renderer for the live-hierarchy branch tree used by the Add-Proposition placement panel.
    // Each branch is selectable as the placement parent; descendants (L2/L3/L4/L5) indent by depth.
    internal RenderFragment AdiBranchTree(Guid parentBranchId, int depth) => builder =>
    {
        var seq = 0;
        foreach (var child in AdiBranchChildren(parentBranchId))
        {
            var grandchildren = AdiBranchChildren(child.WideBranchId);
            var collapsed = AdiBranchCollapsed(child.WideBranchId);
            var isSelected = _adiBranchId == child.WideBranchId;
            var captured = child.WideBranchId;

            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", $"adi-tree-row adi-tree-row--node{(isSelected ? " adi-tree-row--active" : "")}");
            builder.AddAttribute(seq++, "style", $"padding-left:{8 + depth * 16}px");
            builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => AdiSelectBranch(captured)));

            if (grandchildren.Count > 0)
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "adi-tree-caret");
                builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
                builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => AdiToggleBranch(captured)));
                builder.OpenElement(seq++, "i");
                builder.AddAttribute(seq++, "class", $"bi {(collapsed ? "bi-chevron-right" : "bi-chevron-down")}");
                builder.CloseElement();
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "adi-tree-caret adi-tree-caret--leaf");
                builder.CloseElement();
            }

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "adi-tree-lvl");
            builder.AddContent(seq++, $"L{child.LevelNumber}");
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "adi-tree-text");
            builder.AddAttribute(seq++, "title", child.Interpretation ?? child.DisplayName);
            builder.AddContent(seq++, child.DisplayName);
            builder.CloseElement();

            builder.CloseElement(); // button

            if (!collapsed && grandchildren.Count > 0)
            {
                builder.AddContent(seq++, AdiBranchTree(child.WideBranchId, depth + 1));
            }
        }
    };

