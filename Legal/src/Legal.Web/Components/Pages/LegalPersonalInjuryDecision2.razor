    internal string? DfiPostureTag => _matter?.Posture ?? _matter?.RequestedDisposition;

    internal WideCandidateDto? DfiTopCandidate => FinalRankedCandidates.Count > 0 ? FinalRankedCandidates[0] : null;
    // Competing outcomes = the formal candidate competition when it ran; otherwise the distinct L1
    // outcome branches the hierarchy actually produced. The Mendoza run never executes candidate
    // competition (Candidates is empty) yet the Explorer shows 5 competing L1 outcomes — the KPI must
    // reflect them so the console is not self-contradictory. Integrity still reports "Not executed".
    internal int DfiL1OutcomeCount => SurvivingBranches.Count(b => b.LevelNumber == 1);
    internal int DfiCompetingOutcomes => _response is null ? 0
        : _response.Candidates.Count > 0 ? _response.Candidates.Count
        : DfiL1OutcomeCount;
    // The outcome under review: the winning formal candidate if competition ran, else the top L1 branch.
    private string? DfiReviewedOutcomeName => DfiTopCandidate?.DisplayName
        ?? SurvivingBranches.Where(b => b.LevelNumber == 1).OrderByDescending(b => b.Confidence).FirstOrDefault()?.DisplayName;
    internal IReadOnlyCollection<WideFactorDto> DfiFactors => _response?.DecisionInspector?.FactorInventory?.Factors ?? [];
    internal int DfiFactorCount => _response?.DecisionInspector?.FactorInventory?.Factors.Count ?? 0;
    internal int DfiMissingFactorCount => _response?.DecisionInspector?.FactorInventory?.MissingFactorCount ?? 0;
    internal int DfiDependencyCount => _response?.DecisionInspector?.SharedDependencies.Count ?? 0;
    internal IReadOnlyCollection<WideCandidateFactorRelationDto> DfiRelations => _response?.DecisionInspector?.FactorInventory?.Relationships ?? [];

    // ── Decision command center (Overview) signals ──────────────────────────────────────────────
    // Pure-presentation projections over the existing response. "Scored candidates" is the formal
    // candidate pool when the competition ran, otherwise the distinct competing L1 outcomes the
    // hierarchy produced (never a fabricated count). Coverage/stability mirror the authoritative
    // decision metrics; the command center never invents values the pipeline did not emit.
    internal int DfiScoredCandidateCount => FinalRankedCandidates.Count > 0 ? FinalRankedCandidates.Count : DfiCompetingOutcomes;
    // Evidence coverage tile: the authoritative decision-dimension coverage, but when the Candidate x Branch
    // competition produced no evidence-backed deciding branch (DecisionEvidenceCoverage == 0) we fall back to
    // the whole-frontier EvidenceCoverage (share of surviving branches supported by admitted evidence) so the
    // tile reflects the evidence that WAS admitted instead of a misleading 0%. Both are authoritative pipeline
    // metrics; nothing is fabricated.
    internal decimal DfiEvidenceCoveragePct => _response is null
        ? 0m
        : (_response.DecisionEvidenceCoverage > 0m ? _response.DecisionEvidenceCoverage : _response.EvidenceCoverage);
    // Top-3 stability tile: TopKStability is null when the decision had fewer than two ranking snapshots
    // (a single provisional competition round). Per the WideSearchResponse contract this undefined case is
    // neutral (1.0), never penalizing  so a provisional single-round decision must not read 0%.
    internal decimal DfiTopKStabilityPct => _response?.TopKStability ?? 1m;

    // Execution health = the four command-center rows, projected from the authoritative integrity
    // indicators so the card can never disagree with the Readiness tab.
    private IReadOnlyList<DfiIndicator> DfiExecutionHealth
    {
        get
        {
            string[] wanted = ["Technical execution", "Candidate competition", "Evidence grounding", "Decision readiness"];
            return DfiIntegrityIndicators
                .Where(i => wanted.Contains(i.Label))
                .OrderBy(i => Array.IndexOf(wanted, i.Label))
                .ToArray();
        }
    }

    // Next required work: derived from real open gates (claim identity / bindings / dependencies /
    // evidence), never a hardcoded checklist. Falls back to the competition blockers so the card is
    // never empty while a genuine blocker exists.
    internal IReadOnlyList<string> DfiNextRequiredWork
    {
        get
        {
            var r = _response;
            if (r is null) return [];
            var work = new List<string>();
            var gate = r.MatterContext?.NormalizationGateStatus;
            if ((gate is not null && gate.StartsWith("PLAN_INVALID", StringComparison.OrdinalIgnoreCase))
                || r.StatusCode == "USER_CLARIFICATION_REQUIRED")
            {
                work.Add("Resolve claim identity and settlement-status conflict.");
            }
            var inv = r.DecisionInspector?.FactorInventory;
            if (inv is not null && (inv.RejectedBindingCount > 0 || inv.IsProvisional))
                work.Add("Correct proposition-to-value bindings.");
            if (DfiDependencyCount == 0 || !DfiCoreEvaluationReady)
                work.Add("Validate candidate dependencies.");
            if (TotalEvidenceCount == 0 || DfiEvidenceCoveragePct < 0.5m)
                work.Add("Obtain and verify matter evidence.");
            return work.Count > 0 ? work : DfiCompetitionBlockers;
        }
    }

    internal void OpenInvestigationPlan() => _dfiTab = "Investigation";

    // ── Overview · Decision Landscape (mockup-aligned outcome projection) ────────────────────────
    // Pure presentation over the authoritative response: every value is derived from data the
    // pipeline already emitted (ranked candidates, per-candidate REQUIRED dependency satisfaction,
    // branch evidence scores, competition blockers). No fabricated outcomes or hardcoded metrics.
    internal string _ovComparisonView = "Cards";
    internal static readonly string[] OvComparisonViews = ["Cards", "Table", "Graph"];

    // Active Decision-Outcomes KPI/metric filter. null = show all. Values:
    //   "leader"         → only the current leader
    //   "competing"      → only competing (non-leader) outcomes
    //   "evidence"       → outcomes that are evidence-backed
    //   "supporting"     → outcomes that have key supporting factors
    //   "dependencies"   → outcomes that have critical dependencies
    //   "missing"        → outcomes with missing/unverified evidence
    //   "vulnerabilities"→ outcomes with main vulnerabilities
    internal string? _ovKpiFilter;

    // The outcomes rendered by the Cards/Table/Graph views after applying the active KPI filter.
    internal IReadOnlyList<OvOutcome> OvFilteredOutcomes
    {
        get
        {
            var all = OvOutcomes;
            return _ovKpiFilter switch
            {
                "leader" => all.Where(o => o.IsLeader).ToList(),
                "competing" => all.Where(o => !o.IsLeader).ToList(),
                "evidence" => all.Where(o => o.Tags.Any(t => t.Label == "Evidence backed")).ToList(),
                "support" => all.Where(o => o.SupportPct > 0).ToList(),
                "coverage" => all.Where(o => o.EvidenceCoveragePct > 0).ToList(),
                "interpretive" => all.Where(o => o.InterpretiveSupport > 0).ToList(),
                "branches" => all.Where(o => o.BranchWinCount > 0).ToList(),
                _ => all is List<OvOutcome> list ? list : all.ToList(),
            };
        }
    }

    internal void SetOvKpiFilter(string filter)
    {
        if (filter == "__all")
        {
            _ovKpiFilter = null;
            return;
        }
        _ovKpiFilter = string.Equals(_ovKpiFilter, filter, StringComparison.Ordinal) ? null : filter;
    }

    // Authoritative lifecycle subtitle for an outcome card. Label is the lawyer-facing line shown under the
    // card title; Tone maps to the ov-tag/ov badge tones (info = prospective, warn = historical/verify-first);
    // IsHistorical drives visual separation so a recorded status is never shown as a live competitor.
    internal sealed record OvLifecycle(string Label, string Tone, bool IsHistorical);

    internal sealed record OvOutcome(
        int Index,
        string Title,
        string? Detail,
        decimal CompositeScore,
        int SupportPct,
        bool IsLeader,
        string ViabilityLabel,
        string ViabilityTone,
        IReadOnlyList<(string Label, string Tone)> Tags,
        int KeySupportingFactors,
        int CriticalDependencies,
        int MissingEvidence,
        int MainVulnerabilities,
        string? EstimatedResolutionLabel,
        string? EstimatedCostBand,
        IReadOnlyList<WideCandidateBranchScoreDto> BranchScores)
    {
        // LLM-composed, candidate-landscape overview narrative (55-90 words) for this outcome. When present
        // it replaces the raw Detail text in the Overview card. Null degrades to the existing Detail.
        public string? Narrative { get; init; }

        // Long-form, complete candidate-landscape analysis (labelled prose sections) composed in the same
        // live run as the short Narrative. Rendered on the card directly below the short narrative. Empty
        // when the composer did not run or produced no deep sections for this candidate.
        public IReadOnlyList<(string Label, string Text)> FullNarrative { get; init; } = [];

        // Candidate-level evidence coverage from the Candidate x Branch competition (0..1). On a legal
        // matter with no retrieved evidence the competition still runs over reframed hierarchy dimensions,
        // so a scored card can carry 0 coverage. The card discloses this as UNVERIFIED so a POLOXI score is
        // never mistaken for an evidence-grounded, attorney-ready determination.
        public decimal EvidenceCoverage { get; init; }

        // Advisory Domain Pack mapping (UseDomainPack only): the canonical pack OutcomeCandidate(s) that the
        // Candidate Landscape composer semantically mapped this LLM-proposed outcome to. Presentation/routing
        // only — it never scores, ranks, selects, or establishes eligibility; the LLM outcome remains the
        // scored C card. Empty when the composer mapped nothing (rendered as a muted disclosure in pack mode).
        public IReadOnlyList<(string Code, string Name)> MappedOutcomes { get; init; } = [];

        // Authoritative, DB-backed lifecycle for the card subtitle. Prospective pathways compete; historical
        // (asserted / verification-required) statuses are relabeled "Historical status — verification required"
        // and visually separated so a recorded status never appears to compete with prospective outcomes.
        public OvLifecycle Lifecycle { get; init; } = new("Prospective pathway · Assessment pending", "info", false);

        // ── Reliable per-outcome signals for the Overview metric tiles ──────────────────────────────
        // These replace the legacy factor-graph counts (Key supporting factors / Critical dependencies /
        // Missing evidence / Main vulnerabilities), which joined by candidate title and therefore read 0
        // for the dynamic, LLM-proposed outcome set. Every value below is already persisted on this record
        // from the live run (Candidate × Branch competition), so nothing is fabricated and nothing falls to 0
        // merely because a title join missed.

        // Evidence coverage expressed as a whole percentage (0..100) for the tile value.
        public int EvidenceCoveragePct => (int)Math.Round((double)EvidenceCoverage * 100);

        // Number of decision branches (Candidate × Branch dimensions) this outcome was scored against.
        public int BranchWinCount => BranchScores.Count;

        // Interpretive mentions that named this outcome (InterpretiveSupportCount is mapped onto the
        // KeySupportingFactors slot by the builders). Kept as a named accessor for tile clarity.
        public int InterpretiveSupport => KeySupportingFactors;

        // Deterministic text for the Overview card so it is NEVER blank: prefer the composed landscape
        // narrative, then the candidate Detail, then a derived viability/support summary built from the
        // persisted scores already on this record. Nothing is fabricated — every value comes from the run.
        public string CardText
        {
            get
            {
                if (!string.IsNullOrWhiteSpace(Narrative)) return Narrative!;
                if (!string.IsNullOrWhiteSpace(Detail)) return Detail!;
                var lead = IsLeader ? "Current leader" : "Competing outcome";
                return $"{lead} with {SupportPct}% relative support and {ViabilityLabel.ToLowerInvariant()}. "
                    + $"{EvidenceCoveragePct}% evidence coverage, {InterpretiveSupport} interpretive mention(s), "
                    + $"scored across {BranchWinCount} decision branch(es).";
            }
        }

        // Small-print methodology line disclosing HOW this outcome's score and rank were computed, built
        // only from persisted run values (nothing fabricated). The engine label switches between POLOXI
        // (authoritative Candidate × Branch competition) and LLM (advisory proposal score) based on whether
        // the competition actually executed. Shown under the support bar.
        public string ScoreFormulaFor(bool poloxiScored)
        {
            var dims = BranchScores.Count;
            var dimText = dims == 1 ? "1 scored dimension" : $"{dims} scored dimensions";
            var engine = poloxiScored ? "POLOXI" : "LLM";
            return $"{engine} · Rank #{Index} · composite score {CompositeScore:P0} aggregated across {dimText} "
                + $"(Candidate × Branch matrix); support {SupportPct}% = this score ÷ sum of all candidates' scores.";
        }
    }

    // Resolves the candidate-landscape overview narrative for a candidate display name from the Wide
    // response (fail-soft: null when the composer did not run or produced nothing for this candidate).
    private string? OvNarrativeFor(string displayName)
    {
        var candidates = _response?.CandidateLandscape?.Candidates;
        if (candidates is null || string.IsNullOrWhiteSpace(displayName)) return null;
        var match = candidates.FirstOrDefault(c =>
            string.Equals(c.CandidateName, displayName, StringComparison.OrdinalIgnoreCase)
            || c.CandidateName.Contains(displayName, StringComparison.OrdinalIgnoreCase)
            || displayName.Contains(c.CandidateName, StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(match?.OverviewNarrative) ? null : match!.OverviewNarrative;
    }

    // Resolves the advisory Domain Pack outcome mapping for a candidate display name from the Wide response.
    // The Candidate Landscape composer attaches the canonical pack OutcomeCandidate(s) it semantically mapped
    // each LLM outcome to (code + name). Presentation/routing only — never scores, ranks, or selects. Fail-soft:
    // empty when the composer did not run, produced no mapping, or the candidate is unmatched.
    private IReadOnlyList<(string Code, string Name)> OvMappedOutcomesFor(string displayName)
    {
        var candidates = _response?.CandidateLandscape?.Candidates;
        if (candidates is null || string.IsNullOrWhiteSpace(displayName)) return [];
        var match = candidates.FirstOrDefault(c =>
            string.Equals(c.CandidateName, displayName, StringComparison.OrdinalIgnoreCase)
            || c.CandidateName.Contains(displayName, StringComparison.OrdinalIgnoreCase)
            || displayName.Contains(c.CandidateName, StringComparison.OrdinalIgnoreCase));
        var mapped = match?.MappedOutcomes;
        if (mapped is null || mapped.Count == 0) return [];
        return mapped
            .Where(m => !string.IsNullOrWhiteSpace(m.OutcomeCode) && !string.IsNullOrWhiteSpace(m.Name))
            .Select(m => (m.OutcomeCode, m.Name))
            .ToArray();
    }

    // Resolves the AUTHORITATIVE, DB-backed lifecycle label for an outcome card from the validated,
    // persisted assessment (the saved candidate set), not from a raw LLM guess. The canonical mapped pack
    // outcome carries RoleCode (PATHWAY = prospective resolution; ASSERTED_HISTORICAL = a possibly-completed
    // historical status) and RequiresVerification. A historical/verification-required outcome is surfaced as
    // "Historical status — verification required" so it is visibly SEPARATED from prospective competitors
    // rather than appearing to compete with them. When no canonical mapping exists the card falls back to the
    // shared classifier role so a pure-LLM outcome still gets a sensible, non-fabricated subtitle. Fail-soft:
    // a blank display name yields the default prospective, assessment-pending subtitle.
    private OvLifecycle OvLifecycleFor(string displayName)
    {
        var defaultLifecycle = new OvLifecycle("Prospective pathway · Assessment pending", "info", false);
        var candidates = _response?.CandidateLandscape?.Candidates;
        if (candidates is null || string.IsNullOrWhiteSpace(displayName)) return defaultLifecycle;
        var match = candidates.FirstOrDefault(c =>
            string.Equals(c.CandidateName, displayName, StringComparison.OrdinalIgnoreCase)
            || c.CandidateName.Contains(displayName, StringComparison.OrdinalIgnoreCase)
            || displayName.Contains(c.CandidateName, StringComparison.OrdinalIgnoreCase));
        var mapped = match?.MappedOutcomes;
        if (mapped is null || mapped.Count == 0) return defaultLifecycle;
        // A single mapped outcome whose authoritative role is historical/asserted OR that requires
        // verification is a "Historical status" card. If ANY mapped outcome is historical, the card is
        // treated as historical (verify-first) so a recorded status never masquerades as a live competitor.
        var isHistorical = mapped.Any(m =>
            m.RequiresVerification
            || string.Equals(m.RoleCode, "ASSERTED_HISTORICAL", StringComparison.OrdinalIgnoreCase));
        return isHistorical
            ? new OvLifecycle("Historical status — verification required", "warn", true)
            : defaultLifecycle;
    }

    // Resolves the deep, long-form candidate-landscape analysis for a candidate display name, composed in
    // the SAME live run as the short overview narrative. Returns the labelled prose sections (executive
    // assessment, why current position, evidence/authority, comparison with the strongest alternative,
    // strongest case against, material uncertainty, what strengthens/weakens, what could change position,
    // next best information, current decision position) so the card can show the complete narrative just
    // below the short one. Fail-soft: empty list when the composer did not run or produced nothing.
    private IReadOnlyList<(string Label, string Text)> OvFullNarrativeFor(string displayName)
    {
        var candidates = _response?.CandidateLandscape?.Candidates;
        if (candidates is null || string.IsNullOrWhiteSpace(displayName)) return [];
        var match = candidates.FirstOrDefault(c =>
            string.Equals(c.CandidateName, displayName, StringComparison.OrdinalIgnoreCase)
            || c.CandidateName.Contains(displayName, StringComparison.OrdinalIgnoreCase)
            || displayName.Contains(c.CandidateName, StringComparison.OrdinalIgnoreCase));
        var fa = match?.FullAnalysis;
        if (fa is null) return [];
        var sections = new List<(string Label, string Text)>();
        void Add(string label, string? text)
        {
            if (!string.IsNullOrWhiteSpace(text)) sections.Add((label, text!.Trim()));
        }
        Add("Executive assessment", fa.ExecutiveAssessment);
        Add("Why the current position", fa.WhyCurrentPosition);
        Add("Evidence and authority position", fa.EvidenceAndAuthorityPosition);
        Add("Comparison with the strongest alternative", fa.ComparisonWithStrongestAlternative);
        Add("Strongest case against", fa.StrongestCaseAgainst);
        Add("Material uncertainty", fa.MaterialUncertainty);
        Add("What strengthens this candidate", fa.WhatStrengthensCandidate);
        Add("What weakens this candidate", fa.WhatWeakensCandidate);
        Add("What could change its position", fa.WhatCouldChangePosition);
        Add("Next best information", fa.NextBestInformation);
        Add("Current decision position", fa.CurrentDecisionPosition);
        return sections;
    }

    internal IReadOnlyList<OvOutcome> OvOutcomes
    {
        get
        {
            // Always surface the full competing field, not just the surviving leader. FinalRankedCandidates
            // drops IsConstraintViolation candidates, so a matter whose only survivor is the leader would
            // render a single card even though the narrative references excluded competitors (e.g. the
            // "Liability Accepted Outcome" that was excluded for lack of credible support). Build the pool
            // from every candidate, ordering survivors first (by rank) and excluded competitors after (by
            // composite score). Excluded competitors are disclosed by the viability/excluded tags below.
            var ranked = _response is null ? FinalRankedCandidates
                : _response.Candidates
                    .OrderBy(c => c.IsConstraintViolation)
                    .ThenBy(c => c.RankNumber)
                    .ThenByDescending(c => c.CompositeScore)
                    .Take(10)
                    .ToArray();
            // Fallback: when no candidate cleared the evidence-admission gate (e.g. "Evidence unverified"
            // matters), still render the Decision Outcomes comparison from the provisional/ranked pool so
            // the Overview shows the decision landscape instead of only the command center. These are
            // disclosed as provisional by the existing viability/evidence tags; nothing is fabricated.
            if (ranked.Count == 0 && _response is not null)
            {
                ranked = _response.Candidates
                    .OrderBy(c => c.IsConstraintViolation)
                    .ThenByDescending(c => c.CompositeScore)
                    .Take(10)
                    .ToArray();
            }
            // Decision Outcome cards are populated ONLY from persisted decision candidates — never from
            // L1 hierarchy branches. The shared L1→Ln forest supplies each candidate's supporting analysis;
            // it must never REPLACE candidate names (e.g. a card must stay "Confidential negotiated
            // settlement", never collapse to an analytical dimension like "Liability and comparative fault").
            // When no candidate rows exist the comparison is simply empty; the command-center / readiness
            // panels explain why. Being displayed does not imply competition eligibility — scores and a
            // leader are rendered only from a valid competition result (the scored branch below).
            //
            // Proposed-candidate fallback: when no competition candidate rows exist (e.g. an evidence/
            // readiness-BLOCKED run where registration succeeded but scoring never ran), the matter still
            // has genuinely distinct PROPOSED outcomes in the Decision Inspector's normalized candidate
            // pool. Render those as Proposed Outcome cards so the Overview is never blank — preserving each
            // candidate's own identity (OriginalTitle). This is NOT the prohibited L1 hierarchy fallback:
            // the source is the persisted/normalized DECISION CANDIDATE pool, never L1–Ln factor branches.
            // Nothing is scored or ranked here; OvCompetitionValid stays false, so every leader/support
            // display remains suppressed and the cards show "Proposed Outcome / Not scored".
            if (ranked.Count == 0)
            {
                var normalized = _response?.DecisionInspector?.NormalizedCandidates;
                if (normalized is null || normalized.Count == 0) return [];
                var proposed = new List<OvOutcome>();
                var seenTitles = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                var idx = 0;
                foreach (var nc in normalized)
                {
                    var title = string.IsNullOrWhiteSpace(nc.OriginalTitle) ? nc.NormalizedCandidateId : nc.OriginalTitle;
                    if (string.IsNullOrWhiteSpace(title) || !seenTitles.Add(title)) continue;
                    idx++;
                    // Build the dependency summary directly from the factor-relationship inventory (joined
                    // by candidate TITLE) so the proposed cards get a real establishment ratio even though
                    // _response.Candidates — and therefore DfiCandidateDependencySummaries — is empty here.
                    var psum = BuildDependencySummaryForTitle(title);
                    var pTotal = psum?.Total ?? 0;
                    var pEstablished = psum?.Established ?? 0;
                    var pMissing = pTotal - pEstablished;
                    var pVulns = psum?.Required.Count(d => string.Equals(d.Tone, "danger", StringComparison.OrdinalIgnoreCase)) ?? 0;
                    // Proposed-candidate score: no Candidate × Branch competition ran, so derive a real,
                    // traceable support value from how many of this candidate's required dependencies are
                    // established (established ÷ total). This replaces the hardcoded "Not scored / 0%" with
                    // the dependency-establishment ratio actually present on the run.
                    var pScore = pTotal > 0 ? (decimal)pEstablished / pTotal : 0m;
                    var pSupportPct = (int)Math.Round((double)pScore * 100);
                    var proposedTags = new List<(string, string)>
                    {
                        ("Proposed outcome", "info"),
                        (nc.CompetitionEligible ? "Competition eligible" : "Not scored",
                            nc.CompetitionEligible ? "warn" : "muted"),
                    };
                    proposed.Add(new OvOutcome(
                        idx,
                        title,
                        nc.MaterialDistinction,
                        pScore,
                        pSupportPct,
                        false,
                        "Proposed — not scored",
                        "muted",
                        proposedTags,
                        0,
                        pTotal,
                        pMissing,
                        pVulns,
                        null,
                        null,
                        [])
                        { Narrative = OvNarrativeFor(title), FullNarrative = OvFullNarrativeFor(title), MappedOutcomes = OvMappedOutcomesFor(title), Lifecycle = OvLifecycleFor(title) });
                    if (proposed.Count >= 10) break;
                }
                return proposed;
            }
            var top = ranked.ToList();
            var scoreSum = ranked.Sum(c => c.CompositeScore);
            // Absolute-support floor: supportPct is a RELATIVE share (CompositeScore / scoreSum), so a lone
            // survivor with a negligible composite would otherwise render as 100% even though no candidate
            // earned credible support. When the total composite support across the field is below a small
            // floor, report 0% ("No credible support") instead of a misleading relative winner. The floor is
            // deliberately small so a genuinely-supported field is never suppressed.
            const decimal OvCredibleSupportFloor = 0.05m;
            var hasCredibleSupport = scoreSum >= OvCredibleSupportFloor;
            // Branch-evidence fallback: CompositeScore = Min(composite, CertaintyCeiling), and the certainty
            // ceiling = min(legal, fact, evidence, authority). On an unverified / no-admitted-evidence matter
            // the evidence (and often verification) dimension is ~0, which clamps EVERY candidate composite to
            // ~0 even though the Candidate × Branch dimensions carry real EvidenceScores. In that case the
            // composite-relative support collapses to 0% for the whole field, which is misleading. When the
            // composite field is not credible but the branches DO carry evidence, derive support from the mean
            // branch EvidenceScore actually present on each candidate (a real, traceable signal) instead of 0.
            decimal MeanBranchEvidence(WideCandidateDto c) =>
                c.BranchScores.Count > 0 ? c.BranchScores.Average(b => b.EvidenceScore) : 0m;
            var branchEvidenceSum = ranked.Sum(MeanBranchEvidence);
            var useBranchFallback = !hasCredibleSupport && branchEvidenceSum >= OvCredibleSupportFloor;
            var summaries = DfiCandidateDependencySummaries
                .ToDictionary(s => s.CandidateTitle, s => s, StringComparer.OrdinalIgnoreCase);
            var outcomes = new List<OvOutcome>();
            for (var i = 0; i < top.Count; i++)
            {
                var c = top[i];
                summaries.TryGetValue(c.DisplayName, out var sum);
                var total = sum?.Total ?? 0;
                var established = sum?.Established ?? 0;
                var missing = total - established;
                var vulns = sum?.Required.Count(d => string.Equals(d.Tone, "danger", StringComparison.OrdinalIgnoreCase)) ?? 0;
                var supportPct =
                    (hasCredibleSupport && scoreSum > 0)
                        ? (int)Math.Round((double)(c.CompositeScore / scoreSum) * 100)
                        : (useBranchFallback && branchEvidenceSum > 0)
                            ? (int)Math.Round((double)(MeanBranchEvidence(c) / branchEvidenceSum) * 100)
                            : 0;

                var tier = c.SupportTierCode;
                var viabilityLabel = tier switch
                {
                    "STRONG" => "High viability",
                    "MODERATE" => "Moderate viability",
                    "LIMITED" => "Limited viability",
                    _ => "Moderate viability",
                };
                var viabilityTone = tier switch
                {
                    "STRONG" => "ok",
                    "LIMITED" => "danger",
                    _ => "warn",
                };

                var tags = new List<(string, string)>
                {
                    (i == 0 ? "Higher likelihood" : missing > established ? "Higher risk" : "Moderate risk",
                        i == 0 ? "ok" : missing > established ? "danger" : "warn"),
                    (viabilityLabel, viabilityTone),
                    (c.EvidenceCoverage >= 0.6m ? "Evidence backed" : "Evidence dependent",
                        c.EvidenceCoverage >= 0.6m ? "ok" : "warn"),
                };
                if (c.IsConstraintViolation)
                {
                    tags.Insert(0, ("Excluded competitor", "danger"));
                }

                outcomes.Add(new OvOutcome(
                    i + 1,
                    c.DisplayName,
                    c.Detail,
                    c.CompositeScore,
                    supportPct,
                    i == 0,
                    viabilityLabel,
                    viabilityTone,
                    tags,
                    c.InterpretiveSupportCount,
                    total,
                    missing,
                    vulns,
                    c.EstimatedResolutionLabel,
                    c.EstimatedCostBand,
                    c.BranchScores.Take(8).ToArray())
                    { Narrative = OvNarrativeFor(c.DisplayName), FullNarrative = OvFullNarrativeFor(c.DisplayName), EvidenceCoverage = c.EvidenceCoverage, MappedOutcomes = OvMappedOutcomesFor(c.DisplayName), Lifecycle = OvLifecycleFor(c.DisplayName) });
            }
            return outcomes;
        }
    }

    // Union of branch dimensions across the compared outcomes, used as the radar/table axes.
    internal IReadOnlyList<string> OvComparisonDimensions =>
        OvOutcomes.SelectMany(o => o.BranchScores.Select(b => b.BranchDisplayName))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(6)
            .ToArray();

    private decimal OvDimensionScore(OvOutcome outcome, string dimension) =>
        outcome.BranchScores
            .FirstOrDefault(b => string.Equals(b.BranchDisplayName, dimension, StringComparison.OrdinalIgnoreCase))
            ?.EvidenceScore ?? 0m;

    // Radar polygon points for one outcome over the shared dimensions (viewBox 0 0 200 200, centre 100,100).
    internal string OvRadarPolygon(OvOutcome outcome)
    {
        var dims = OvComparisonDimensions;
        if (dims.Count == 0) return "";
        var pts = new List<string>();
        for (var i = 0; i < dims.Count; i++)
        {
            var angle = (Math.PI * 2 * i / dims.Count) - (Math.PI / 2);
            var value = Math.Clamp((double)OvDimensionScore(outcome, dims[i]), 0d, 1d);
            var radius = 12 + (value * 76);
            var x = 100 + (radius * Math.Cos(angle));
            var y = 100 + (radius * Math.Sin(angle));
            pts.Add($"{x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}");
        }
        return string.Join(" ", pts);
    }

    internal (double X, double Y) OvRadarAxisLabelPoint(int index, int count)
    {
        var angle = (Math.PI * 2 * index / count) - (Math.PI / 2);
        return (100 + (96 * Math.Cos(angle)), 100 + (96 * Math.Sin(angle)));
    }

    private static readonly string[] OvOutcomePalette = ["#16a34a", "#2563eb", "#f97316"];
    internal string OvOutcomeColor(int index) => OvOutcomePalette[Math.Clamp(index, 0, OvOutcomePalette.Length - 1)];

    // Key insights: grounded, derived from the leader, open blockers, and next required work — never
    // a hardcoded advisory list.
    internal IReadOnlyList<(string Text, string Tone)> OvKeyInsights
    {
        get
        {
            var insights = new List<(string, string)>();
            var leader = OvOutcomes.FirstOrDefault();
            if (leader is not null)
                insights.Add(($"{leader.Title} is the most supportable outcome given current evidence.", "ok"));
            foreach (var vuln in OvOutcomes.Where(o => o.MainVulnerabilities > 0))
                insights.Add(($"{vuln.Title} has {vuln.MainVulnerabilities} unresolved dependency risk(s) that may weaken it.", "warn"));
            foreach (var work in DfiNextRequiredWork.Take(2))
                insights.Add((work, "info"));
            foreach (var blocker in DfiCompetitionBlockers.Take(2))
                insights.Add((blocker, "warn"));
            return insights.Take(5).ToList();
        }
    }

    // ── Enterprise Overview read model ───────────────────────────────────────────────────────────
    // Pure presentation projections over the authoritative live Wide2 response, matter, evidence,
    // documents, and CDC change-event state. Never fabricates values the pipeline did not emit; all
    // panels degrade honestly (em dash / empty state) when a signal is absent.
    internal sealed record OvKpiTile(string Icon, string Value, string Label, string Tone);
    private IReadOnlyList<OvKpiTile> OvKpiTiles
    {
        get
        {
            var verifiedAuthorities = _response?.ProposedLegalAuthorities.Count(a => a.VerificationStatus == "VERIFIED") ?? 0;
            var openQuestions = _response?.DecisionInspector?.FactorInventory?.MissingFactorCount ?? DfiMissingFactorCount;
            return
            [
                new("bi-diagram-2", OvOutcomes.Count.ToString(), "Decision Outcomes", "info"),
                new("bi-file-earmark-text", _documents.Count.ToString(), "Total Documents", "info"),
                new("bi-shield-check", TotalEvidenceCount.ToString(), "Verified Evidence Items", TotalEvidenceCount > 0 ? "ok" : "warn"),
                new("bi-bank", verifiedAuthorities.ToString(), "Key Authorities", verifiedAuthorities > 0 ? "ok" : "warn"),
                new("bi-question-circle", openQuestions.ToString(), "Open Questions", openQuestions > 0 ? "warn" : "ok"),
                new("bi-graph-up-arrow", $"{OvReadinessPct}%", "Readiness", DfiReadinessTone),
            ];
        }
    }

    // Overall decision confidence (evidence-weighted when competition ran, else interpretation prior).
    internal decimal OvConfidenceValue => _response?.DecisionConfidence ?? _response?.FinalConfidence ?? 0m;
    internal int OvConfidencePct => (int)Math.Round(OvConfidenceValue * 100m);
    internal decimal OvEntropy => _response?.FinalNormalizedEntropy ?? 0m;
    internal string OvConfidenceLabel => OvConfidenceValue switch
    {
        >= 0.75m => "High",
        >= 0.5m => "Moderate",
        > 0m => "Low",
        _ => "—",
    };
    internal string OvConfidenceTone => OvConfidenceValue switch
    {
        >= 0.75m => "ok",
        >= 0.5m => "warn",
        _ => "warn",
    };

    // Key factors impacting outcomes: scored decision factors projected to a 0-100 strength bar from
    // their validated binding/verification state, newest/most-impactful first.
    internal sealed record OvFactor(string Name, int Pct, string Tone);
    internal IReadOnlyList<OvFactor> OvKeyFactors
    {
        get
        {
            var factors = DfiFactors;
            if (factors.Count == 0) return [];
            return factors
                .Select(f =>
                {
                    var (state, tone) = DfiFactorState(f);
                    var pct = state switch
                    {
                        "SUPPORTED" => 85,
                        "SUPPLIED" => 55,
                        _ => 30,
                    };
                    return new OvFactor(f.FactorName, pct, tone);
                })
                .OrderByDescending(f => f.Pct)
                .Take(6)
                .ToList();
        }
    }

    // ── What To Resolve Next ──────────────────────────────────────────────────────────────────────
    // A thin projection over the EXISTING proposition VIV / LegalADV frontier. Presentation-only: no
    // scoring and no operational action here. The panel renders one of four explicit states so
    // "not calculated", "blocked", and "none required" never collapse into one misleading message.
    internal IReadOnlyList<Legal.Application.Features.Intelligence.Decision.ResolutionTargetDto> OvResolutionTargets =>
        _whatToResolveNext?.State == Legal.Application.Features.Intelligence.Decision.ResolutionTargetState.Calculated
            ? _whatToResolveNext!.Targets
            : [];

    internal bool OvResolutionCalculated =>
        _whatToResolveNext?.State == Legal.Application.Features.Intelligence.Decision.ResolutionTargetState.Calculated
        && OvResolutionTargets.Count > 0;

    internal string OvResolutionStateText => _whatToResolveNext?.State switch
    {
        Legal.Application.Features.Intelligence.Decision.ResolutionTargetState.NotCalculated => "Resolution priority has not been calculated.",
        Legal.Application.Features.Intelligence.Decision.ResolutionTargetState.Blocked => string.IsNullOrWhiteSpace(_whatToResolveNext?.Reason) ? "Resolution priority is blocked." : _whatToResolveNext!.Reason,
        Legal.Application.Features.Intelligence.Decision.ResolutionTargetState.NoneRequired => "No unresolved decision-material propositions currently require resolution.",
        Legal.Application.Features.Intelligence.Decision.ResolutionTargetState.Calculated => string.Empty,
        _ => "Resolution priority has not been calculated.",
    };

    // ── What To Resolve Next grid paging ─────────────────────────────────────────────────────────
    internal const int WtrnPageSize = 10;
    private int _wtrnPage = 1;
    internal int WtrnPage => Math.Min(Math.Max(_wtrnPage, 1), Math.Max(WtrnPageCount, 1));
    internal int WtrnPageCount => (int)Math.Ceiling(OvResolutionTargets.Count / (double)WtrnPageSize);
    internal IReadOnlyList<Legal.Application.Features.Intelligence.Decision.ResolutionTargetDto> WtrnPagedTargets =>
        OvResolutionTargets.Skip((WtrnPage - 1) * WtrnPageSize).Take(WtrnPageSize).ToList();
    internal void WtrnGoToPage(int page) => _wtrnPage = Math.Min(Math.Max(page, 1), Math.Max(WtrnPageCount, 1));

    // Next best actions: decision-directed actions composed server-side (NextBestActionService). POLOXI
    // selects the unresolved high-value propositions, the Domain Pack supplies domain-appropriate actions,
    // and a deterministic eligibility gate selects the winners. Presentation-only — no scoring happens here.
    internal sealed record OvAction(string Title, string? Context, decimal Adv, string ImpactLabel, string ImpactTone, IReadOnlyList<string> HierarchyPath);
    internal IReadOnlyList<OvAction> OvNextBestActions
    {
        get
        {
            var actions = _nextBestActions?.Actions;
            if (actions is null || actions.Count == 0) return [];
            return actions
                .Select(a => new OvAction(
                    a.Title,
                    string.IsNullOrWhiteSpace(a.InformationSought) ? a.Context : a.InformationSought,
                    a.Adv,
                    a.ImpactLabel,
                    a.ImpactTone,
                    a.HierarchyPath ?? []))
                .ToList();
        }
    }

    // ── Next Best Actions grid paging ─────────────────────────────────────────
    internal const int NbaPageSize = 10;
    private int _nbaPage = 1;
    internal int NbaPage => Math.Min(Math.Max(_nbaPage, 1), Math.Max(NbaPageCount, 1));
    internal int NbaPageCount => (int)Math.Ceiling(OvNextBestActions.Count / (double)NbaPageSize);
    internal IReadOnlyList<OvAction> NbaPagedActions =>
        OvNextBestActions.Skip((NbaPage - 1) * NbaPageSize).Take(NbaPageSize).ToList();
    internal void NbaGoToPage(int page) => _nbaPage = Math.Min(Math.Max(page, 1), Math.Max(NbaPageCount, 1));


    // Empty-state copy for the Next Best Actions panels. Surfaces the server-supplied NotRunReason
    // (e.g. "No scored propositions yet", "temporarily unavailable") so the user can distinguish
    // "everything is resolved" from "the advisory overlay could not run".
    internal string OvNextBestActionsEmptyText =>
        string.IsNullOrWhiteSpace(_nextBestActions?.NotRunReason)
            ? "No outstanding resolution targets — every decision-material proposition is resolved or awaiting analysis."
            : _nextBestActions!.NotRunReason!;

    // Matter snapshot: authoritative matter attributes (never hardcoded).
    internal sealed record OvSnapshotItem(string Icon, string Label, string? Value);
    internal IReadOnlyList<OvSnapshotItem> OvMatterSnapshot =>
    [
        new("bi-folder2-open", "Case Type", (_matter?.ClaimTypeCode ?? _matter?.MatterTypeCode)?.Replace('_', ' ')),
        new("bi-geo-alt", "Jurisdiction", _matter?.State ?? _matter?.Jurisdiction),
        new("bi-flag", "Status", _matter?.Posture ?? _matter?.RequestedDisposition ?? _matter?.StatusCode),
        new("bi-calendar-event", "Filed Date", _matter?.CreatedDateUtc.ToString("MMM dd, yyyy")),
        new("bi-flag-fill", "Current Outcome", _matter?.CurrentOutcome),
        new("bi-building", "Practice Area", (_matter?.PracticeAreaCode)?.Replace('_', ' ')),
