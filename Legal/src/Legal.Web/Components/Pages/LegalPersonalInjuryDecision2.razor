                    <div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-diagram-2"></i></span><div><span>Ambiguity-first grouped execution</span><h2>Possible meanings and result groups</h2></div></div>
                    <span class="poloxi-status">@_response.AmbiguityGroups.Count groups</span>
                </div>
                <div class="poloxi-ambiguity-groups">
                    @foreach (var group in _response.AmbiguityGroups)
                    {
