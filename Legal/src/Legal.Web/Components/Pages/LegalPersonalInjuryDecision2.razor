    // ── Live-hierarchy branch sourcing for the Add-Proposition wizard ──────────────────────────────
    // The wizard's "Decision Model Hierarchy" and the owning-candidate / parent selectors are seeded from
    // the SAME surviving Wide branches that drive the Hierarchy tab (WideBranchDto), not the ADI node
    // projection (which is empty until attorneys add nodes). On save the selected branch and its ancestor
    // chain are resolved to real decision nodes (§2/§7) so the proposition attaches to a DB-backed node.
    internal Guid? _adiBranchId;                 // selected placement branch (parent of the new proposition)
    private readonly HashSet<Guid> _adiBranchCollapsed = new();

    // L1 roots from the live hierarchy (same source as the Hierarchy tab).
    internal IReadOnlyList<WideBranchDto> AdiBranchRoots
        => SurvivingBranches.Where(b => b.LevelNumber == 1).OrderBy(b => b.SortOrder).ToList();

    private IReadOnlyList<WideBranchDto> AdiBranchChildren(Guid parentBranchId)
        => SurvivingBranches.Where(b => b.ParentWideBranchId == parentBranchId)
            .OrderBy(b => b.SortOrder).ToList();

    internal WideBranchDto? AdiBranch(Guid id) => SurvivingBranches.FirstOrDefault(b => b.WideBranchId == id);

    internal bool AdiBranchCollapsed(Guid id) => _adiBranchCollapsed.Contains(id);
    internal void AdiToggleBranch(Guid id) { if (!_adiBranchCollapsed.Add(id)) _adiBranchCollapsed.Remove(id); }

    internal bool AdiHasLiveHierarchy => SurvivingBranches.Count > 0;

    // Short display code for a branch — its own BranchCode, else a derived L{level} label.
    internal static string AdiBranchCode(WideBranchDto b)
        => string.IsNullOrWhiteSpace(b.BranchCode) ? $"L{b.LevelNumber}" : b.BranchCode;

    // The ordered ancestor chain root(L1) → branch, used to materialize decision nodes on save.
    private IReadOnlyList<WideBranchDto> AdiBranchChain(Guid branchId)
    {
        var byId = SurvivingBranches.ToDictionary(b => b.WideBranchId);
        var chain = new List<WideBranchDto>();
        var guard = 0;
        var cur = byId.TryGetValue(branchId, out var start) ? start : null;
        while (cur is not null && guard++ < 25)
        {
            chain.Add(cur);
            cur = cur.ParentWideBranchId is { } pid && byId.TryGetValue(pid, out var parent) ? parent : null;
        }
        chain.Reverse();
        return chain;
    }

    // Map a Wide level to the ADI node kind code used by the decision model.
    private static string AdiKindForLevel(int level) => level switch
    {
        1 => "Candidate",
        2 => "Factor",
        _ => "Proposition"
    };

    internal void AdiSelectBranch(Guid branchId)
    {
        _adiBranchId = branchId;
        if (AdiBranch(branchId) is { } b)
        {
            // Default the new proposition to one level deeper than the chosen placement branch.
            _adiLevel = Math.Clamp(b.LevelNumber + 1, 2, 5);
            _adiKind = AdiKindForLevel(_adiLevel);
        }
    }

    // Resolve the selected branch chain into real decision nodes and bind the candidate/parent scope.
    private async Task<bool> AdiEnsureBranchResolvedAsync(Guid matterId)
    {
        if (_adiBranchId is not { } branchId) return _adiCandidateNodeId is not null;
        var chain = AdiBranchChain(branchId);
        if (chain.Count == 0) return _adiCandidateNodeId is not null;

        var descriptors = chain.Select(b => new Legal.Application.Features.Intelligence.Decision.BranchNodeDescriptor(
            b.WideBranchId, b.ParentWideBranchId, b.LevelNumber, AdiKindForLevel(b.LevelNumber), b.DisplayName)).ToList();

        var resolved = await Api.ResolveLegalBranchNodeAsync(matterId, new(matterId, descriptors));
        if (resolved is null) return false;

        _adiCandidateNodeId = resolved.CandidateNodeId;
        _adiParentNodeId = resolved.DecisionNodeId; // the selected branch node becomes the parent
        return true;
    }

    internal void SelectAdiType(string kind, int level)
    {
        _adiKind = kind;
        _adiLevel = level;
        _adiParentNodeId = null;
    }

    internal void ApplyMidpoint(bool use)
    {
        _adiUseMidpoint = use;
        if (use && _adiPlacement is { SuggestedMidpoint: { } mid })
            _adiConfirmedValue = (double)mid;
    }

    internal async Task AdiNext()
    {
        if (MatterId is not { } matterId) return;
        _adiBusy = true;
        _adiError = null;
        try
        {
            switch (_adiStep)
            {
                case 1:
                    // Define → resolve the selected live-hierarchy branch into real decision nodes, run
                    // deterministic structural checks, then advance to placement.
                    if (!await AdiEnsureBranchResolvedAsync(matterId))
                    {
                        _adiError = "Select a placement in the decision model hierarchy first.";
                        return;
                    }
                    _adiDraft = await Api.CreateLegalAttorneyDraftAsync(matterId, new(
                        matterId, _adiParentNodeId, _adiCandidateNodeId!.Value, _adiKind, _adiLevel, _adiText, _adiRationale));
                    await AdiLoadPlacementAsync(matterId);
                    _adiStep = 2;
                    break;
                case 2:
                    await AdiLoadPreviewAsync(matterId);
                    _adiStep = 3;
                    break;
                case 3:
                    _adiStep = 4;
                    break;
            }
        }
        catch (Exception ex)
        {
            _adiError = ex.Message;
        }
        finally
        {
            _adiBusy = false;
            StateHasChanged();
        }
    }

    internal void AdiBack()
    {
        if (_adiStep > 1) _adiStep--;
    }

    private async Task AdiLoadPlacementAsync(Guid matterId)
    {
        // Determine ordered neighbors within the target scope so the midpoint reflects the real position.
        var siblings = HiNodes.Where(n => n.NodeLevel == _adiLevel
                && ((_adiParentNodeId is null && n.ParentNodeId is null) || n.ParentNodeId == _adiParentNodeId))
            .OrderBy(n => n.PlacementKey).ToList();
        Guid? prev = siblings.Count > 0 ? siblings[0].DecisionNodeId : null;
        Guid? next = siblings.Count > 1 ? siblings[1].DecisionNodeId : null;

        _adiPlacement = await Api.AnalyzeLegalAttorneyPlacementAsync(matterId, new(
            matterId, _adiParentNodeId, _adiCandidateNodeId!.Value, _adiLevel, prev, next));

        if (_adiPlacement is { SuggestedMidpoint: { } mid } && _adiUseMidpoint)
            _adiConfirmedValue = (double)mid;
    }

