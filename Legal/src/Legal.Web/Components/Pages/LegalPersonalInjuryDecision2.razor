    // The three headline outcomes: current leader + up to two competitors, taken from the real ranked
    // candidate pool (or the L1-outcome fallback shared with the Overview tab via OvOutcomes).
    internal sealed record CdcOutcome(int Index, string Code, string Title, int SupportPct, bool IsLeader);
    internal IReadOnlyList<CdcOutcome> CdcOutcomes
    {
        get
        {
            var outcomes = OvOutcomes;
            if (outcomes.Count == 0) return [];
            return outcomes.Take(3)
                .Select((o, i) => new CdcOutcome(i, $"C{i + 1}", o.Title, o.SupportPct, i == 0))
                .ToArray();
        }
    }

    // Calibration status rows — derived from the real pipeline/response signals.
    internal sealed record CdcStatusRow(string Label, string Detail, bool Done);
    internal IReadOnlyList<CdcStatusRow> CdcCalibrationStatus
    {
        get
        {
            var docCount = _documents.Count;
            var propsUpdated = _cdcChangeEvents.Sum(e => e.AffectedPropositionCount);
            var candCount = CdcOutcomes.Count;
            var latest = CdcSnapshots.FirstOrDefault();
            return
            [
                new("New information processed", docCount > 0 ? $"{docCount} document{(docCount == 1 ? "" : "s")}" : "—", docCount > 0),
                new("Affected propositions updated", propsUpdated > 0 ? $"{propsUpdated} recalculated" : "—", propsUpdated > 0),
                new("Candidate outcomes evaluated", candCount > 0 ? $"{candCount} candidate{(candCount == 1 ? "" : "s")}" : "—", candCount > 0),
                new("Decision snapshot created", latest is not null ? $"V{latest.SnapshotNumber} · {latest.EvaluatedDateUtc:MMM dd, yyyy h:mm tt}" : "—", latest is not null),
            ];
        }
    }

    // Recent activity feed — real change events, newest first.
    internal sealed record CdcActivity(string Title, string? Detail, DateTime When, string Status, string Tone);
    internal IReadOnlyList<CdcActivity> CdcRecentActivity =>
        _cdcChangeEvents
            .OrderByDescending(e => e.CreatedDateUtc)
            .Take(8)
            .Select(e => new CdcActivity(
                e.Summary ?? e.SourceLabel ?? "Matter change processed",
                e.SourceLabel,
                e.ProcessedDateUtc ?? e.CreatedDateUtc,
                CdcStatusLabel(e.ProcessingStatusCode),
                CdcStatusTone(e.ProcessingStatusCode)))
            .ToArray();

    private static string CdcStatusLabel(string? code) => code?.ToUpperInvariant() switch
    {
        "PROCESSED" or "COMPLETE" or "COMPLETED" => "Complete",
        "PROCESSING" or "PENDING" => "Processing",
        "REVIEW" or "REVIEW_REQUIRED" => "Review",
        null or "" => "—",
        _ => code!,
    };
    private static string CdcStatusTone(string? code) => code?.ToUpperInvariant() switch
    {
        "PROCESSED" or "COMPLETE" or "COMPLETED" => "ok",
        "PROCESSING" or "PENDING" => "info",
        "REVIEW" or "REVIEW_REQUIRED" => "warn",
        _ => "info",
    };

    // Support-index trend: one point per outcome per snapshot is not persisted, so we chart the
    // current outcomes' support across the loaded snapshots when snapshot support is available; when
    // only the current execution exists we render the single current point. This never fabricates
    // historical values — it uses the number of distinct snapshots as the x-axis.
    internal IReadOnlyList<Legal.Application.Features.Intelligence.Decision.DecisionSnapshotDto> CdcTrendSnapshots =>
        CdcSnapshots.OrderBy(s => s.SnapshotNumber).ToArray();

    // "Changed by this calibration" summary counts, all from real change-event / response data.
    internal sealed record CdcChangeSummary(string Label, string Value, string Tone, string? Chips);
    internal IReadOnlyList<CdcChangeSummary> CdcChangedSummary
    {
        get
        {
            var propsUpdated = _cdcChangeEvents.Sum(e => e.AffectedPropositionCount);
            var candAffected = _cdcChangeEvents.Sum(e => e.AffectedCandidateCount);
            var newEvidence = _response?.Evidence.Count ?? 0;
            var openQuestions = _cdcReviewTasks.Count(t => !string.Equals(t.StatusCode, "RESOLVED", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(t.StatusCode, "DISMISSED", StringComparison.OrdinalIgnoreCase));
            var factorsAffected = DfiFactorCount;
            var candChips = string.Join(", ", CdcOutcomes.Select(o => o.Code));
            // Contradictions identified: real count of factors carrying conflicting values across sources.
            var contradictions = DfiFactors.Count(f => f.Contradictions.Count > 0
                || string.Equals(f.EvidenceAdmissionState, "CONTRADICTED", StringComparison.OrdinalIgnoreCase));
            // Previously unresolved resolved: real count of review tasks the attorney has closed out.
            var resolved = _cdcReviewTasks.Count(t => string.Equals(t.StatusCode, "RESOLVED", StringComparison.OrdinalIgnoreCase));
            return
            [
                new("Propositions updated", propsUpdated.ToString(), "info", null),
                new("Factors affected", factorsAffected.ToString(), "info", null),
                new("Candidate dependencies affected", candAffected.ToString(), "info", candAffected > 0 ? candChips : null),
                new("New evidence items", newEvidence.ToString(), "ok", null),
                new("Contradictions identified", contradictions.ToString(), contradictions > 0 ? "danger" : "ok", null),
                new("Previously unresolved resolved", resolved.ToString(), "ok", null),
                new("New open questions", openQuestions.ToString(), openQuestions > 0 ? "warn" : "ok", null),
            ];
        }
    }

    // Key drivers of change — top change-event impacted propositions/factors (real change events).
    internal sealed record CdcDriver(string Factor, string ChangeDir, string Impact, string ImpactTone, string Reason, string LinkedCandidates);
    internal IReadOnlyList<CdcDriver> CdcKeyDrivers =>
        _cdcChangeEvents
            .Where(e => e.AffectedPropositionCount > 0 || e.AffectedCandidateCount > 0)
            .OrderByDescending(e => e.AffectedCandidateCount)
            .ThenByDescending(e => e.AffectedPropositionCount)
            .Take(6)
            .Select(e => new CdcDriver(
                e.SourceLabel ?? e.ClassificationCode ?? "Change",
                e.AffectedCandidateCount > 0 ? "up" : "flat",
                e.AffectedCandidateCount >= 3 ? "High" : e.AffectedCandidateCount >= 1 ? "Medium" : "Low",
                e.AffectedCandidateCount >= 3 ? "danger" : e.AffectedCandidateCount >= 1 ? "warn" : "info",
                e.Summary ?? "—",
                string.Join(", ", CdcOutcomes.Take(Math.Clamp(e.AffectedCandidateCount, 0, 3)).Select(o => o.Code))))
            .ToArray();

    // Information value (Top 5) — real information-round targets ranked by adjusted information value.
    internal sealed record CdcInfoValue(string Proposition, decimal Score, string Status, string StatusTone, string NextAction);
    internal IReadOnlyList<CdcInfoValue> CdcInfoValues =>
        (_response?.InformationRounds ?? [])
            .SelectMany(r => r.Targets)
            .OrderByDescending(t => t.AdjustedInformationValue)
            .Take(5)
            .Select(t => new CdcInfoValue(
                t.BranchDisplayName,
                t.AdjustedInformationValue,
                t.WasSelected ? "Selected" : "Unresolved",
                t.WasSelected ? "ok" : "warn",
                string.IsNullOrWhiteSpace(t.EvidenceTarget) ? "Investigate" : t.EvidenceTarget!))
            .ToArray();
    internal decimal CdcMaxInfoValue => CdcInfoValues.Count > 0 ? Math.Max(0.01m, CdcInfoValues.Max(v => v.Score)) : 1m;

    // Evidence coverage — real, from the authoritative decision metrics.
    internal decimal CdcEvidenceCoveragePct => _response?.DecisionEvidenceCoverage ?? 0m;
    internal int CdcTotalEvidence => _response?.Evidence.Count ?? 0;
    internal int CdcUniqueSources => _response?.Evidence.Select(e => e.ModuleCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).Count() ?? 0;

    // Evidence-support breakdown — real, from the authoritative per-factor evidence-admission states.
    // Supported   = factors admitted at SUPPORTED / VERIFIED (evidence establishes the proposition).
    // Contradictory = factors whose proposition is CONTRADICTED (conflicting values across sources).
    // Unresolved  = every remaining factor (SUPPLIED / SOURCE_AVAILABLE / EXTRACTED / UNRESOLVED / MISSING).
    // Nothing is fabricated: when no factor inventory exists all three counts are zero and the panel
    // renders an em-dash-only breakdown.
    internal sealed record CdcCoverageSegment(string Label, string Tone, int Count, decimal Pct);
    internal IReadOnlyList<CdcCoverageSegment> CdcCoverageBreakdown
    {
        get
        {
            var factors = DfiFactors;
            var total = factors.Count;
            if (total == 0) return [];
            static bool IsSupported(WideFactorDto f)
            {
                var s = f.EvidenceAdmissionState?.ToUpperInvariant();
                return (s == "SUPPORTED" || s == "VERIFIED") && f.Contradictions.Count == 0;
            }
            static bool IsContradictory(WideFactorDto f)
                => f.Contradictions.Count > 0
                   || string.Equals(f.EvidenceAdmissionState, "CONTRADICTED", StringComparison.OrdinalIgnoreCase);
            var supported = factors.Count(IsSupported);
            var contradictory = factors.Count(IsContradictory);
            var unresolved = Math.Max(0, total - supported - contradictory);
            return
            [
                new("Supported", "ok", supported, (decimal)supported / total),
                new("Contradictory", "danger", contradictory, (decimal)contradictory / total),
                new("Unresolved", "muted", unresolved, (decimal)unresolved / total),
            ];
        }
    }

    // Pending attorney review — real open review tasks requiring attention.
    internal IReadOnlyList<Legal.Application.Features.Intelligence.Decision.DecisionReviewTaskDto> CdcPendingReview =>
        _cdcReviewTasks
            .Where(t => !string.Equals(t.StatusCode, "RESOLVED", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(t.StatusCode, "DISMISSED", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(t => t.PriorityCode == "HIGH")
            .ThenByDescending(t => t.CreatedDateUtc)
            .ToArray();
    internal bool CdcAutoCalibrationEnabled => _matter is not null;

    // "Run Calibration Now" re-runs the current decision execution (same path as a search), then
    // reloads calibration history so new snapshots/tasks surface. No new backend contract is added.
    internal async Task RunCalibrationNowAsync()
    {
        if (_loading) return;
        await SearchAsync();
        if (MatterId is { } matterId && matterId != Guid.Empty)
        {
            await LoadCalibrationDataAsync(matterId);
        }
    }


    private string DfiMatterTitle => _matter?.Title ?? "Decision Intelligence workspace";
    private string DfiMatterSubtitle
    {
        get
        {
            var parts = new[] { _matter?.ClaimTypeCode ?? _matter?.MatterTypeCode, "Matter workspace" }
                .Where(x => !string.IsNullOrWhiteSpace(x));
            return string.Join(" · ", parts);
        }
    }
    private string DfiPracticeAreaLabel => (_matter?.PracticeAreaCode ?? "PERSONAL INJURY").Replace('_', ' ').ToUpperInvariant();
    internal string? DfiJurisdictionTag
    {
        get
        {
            var jur = _matter?.State ?? _matter?.Jurisdiction;
            if (string.IsNullOrWhiteSpace(jur)) return null;
            return _documents.Count > 0 ? $"{jur} · Supplied" : jur;
        }
