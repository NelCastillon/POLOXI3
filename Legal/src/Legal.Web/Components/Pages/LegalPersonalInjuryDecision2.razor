    // Document Intelligence overview stats, from the matter evidence graph.
    private sealed record OvDocStat(string Label, string Value);
    private IReadOnlyList<OvDocStat> OvDocumentIntelligence
    {
        get
        {
            if (_evidenceGraph is null) return [];
            var verified = _evidenceGraph.Evidence.Count(e =>
                string.Equals(e.EvidenceStateCode, "VERIFIED", StringComparison.OrdinalIgnoreCase)
                || string.Equals(e.EvidenceStateCode, "SUPPORTED", StringComparison.OrdinalIgnoreCase));
            var contradictions = _evidenceGraph.Propositions.Sum(p =>
                p.Support.Count(s => string.Equals(s.RelationshipTypeCode, "CONTRADICTS", StringComparison.OrdinalIgnoreCase)));
            return
            [
                new("Documents", _evidenceGraph.DocumentCount.ToString()),
                new("Source Assertions", _evidenceGraph.SourceAssertions.Count.ToString()),
                new("Evidence Bindings", _evidenceGraph.Evidence.Count.ToString()),
                new("Fact Propositions", _evidenceGraph.Propositions.Count.ToString()),
                new("Verified", verified.ToString()),
                new("Contradictions", contradictions.ToString()),
            ];
        }
