    // Snapshots newest-first (highest SnapshotNumber = latest calibrated version).
    internal IReadOnlyList<Legal.Application.Features.Intelligence.Decision.DecisionSnapshotDto> CdcSnapshots =>
        _cdcSnapshots.OrderByDescending(s => s.SnapshotNumber).ToArray();
