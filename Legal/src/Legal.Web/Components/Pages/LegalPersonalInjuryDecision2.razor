    // Calibration status rows — derived from the real pipeline/response signals.
    private sealed record CdcStatusRow(string Label, string Detail, bool Done);
    private IReadOnlyList<CdcStatusRow> CdcCalibrationStatus
    {
        get
        {
            var docCount = _documents.Count;
            var propsUpdated = _cdcChangeEvents.Sum(e => e.AffectedPropositionCount);
            var candCount = CdcOutcomes.Count;
            var latest = CdcSnapshots.FirstOrDefault();
            return
            [
                new("New information processed", docCount > 0 ? $"{docCount} document{(docCount == 1 ? "" : "s")}" : "—", docCount > 0),
                new("Affected propositions updated", propsUpdated > 0 ? $"{propsUpdated} recalculated" : "—", propsUpdated > 0),
                new("Candidate outcomes evaluated", candCount > 0 ? $"{candCount} candidate{(candCount == 1 ? "" : "s")}" : "—", candCount > 0),
                new("Decision snapshot created", latest is not null ? $"V{latest.SnapshotNumber} · {latest.EvaluatedDateUtc:MMM dd, yyyy h:mm tt}" : "—", latest is not null),
            ];
        }
    }

