    // ── Decision Intelligence Overview projections (live-data only) ────────────────────────────────
    // Decision Status trust strip: the authoritative at-a-glance state of the decision. Every value is
    // derived from the live Wide2 response / factor inventory; nothing is fabricated.
    private sealed record OvStatusChip(string Label, string Value, string Tone, string Tooltip);
    private string OvDecisionStateLabel => DfiReadinessLabel;
    private string OvDecisionStateTone => DfiReadinessTone;
    private IReadOnlyList<OvStatusChip> OvDecisionStatusChips
    {
        get
        {
            var verifiedAuthorities = _response?.ProposedLegalAuthorities.Count(a => a.VerificationStatus == "VERIFIED") ?? 0;
            var openQuestions = _response?.DecisionInspector?.FactorInventory?.MissingFactorCount ?? DfiMissingFactorCount;
            return
            [
                new("Candidates", OvOutcomes.Count.ToString(), "info",
                    "Candidates — the number of distinct competing outcomes (candidate answers) generated and scored for this matter. Formula: count of scored outcomes in the current analysis. More candidates means a wider decision space was explored."),
                new("Verified Evidence", TotalEvidenceCount.ToString(), TotalEvidenceCount > 0 ? "ok" : "warn",
                    "Verified Evidence — count of independently verified evidence items admitted into the decision. Formula: count of evidence items with verification status = VERIFIED. Unverified allegations are excluded and do not count."),
                new("Verified Authorities", verifiedAuthorities.ToString(), verifiedAuthorities > 0 ? "ok" : "warn",
                    "Verified Authorities — count of cited legal authorities (statutes, cases, rules) confirmed against an authoritative source. Formula: count of proposed legal authorities where verification status = VERIFIED."),
                new("Open Questions", openQuestions.ToString(), openQuestions > 0 ? "warn" : "ok",
                    "Open Questions — unresolved, decision-material atomic factors still missing evidence or a determination. Formula: count of atomic (non-grouping) factors in the inventory with no established fact state. Lower is better."),
                new("Decision Readiness", $"{OvReadinessPct}%", DfiReadinessTone,
                    "Decision Readiness — how close the decision is to being defensible end to end. Formula: average of the readiness gates (Structure, Evidence, Analysis, Open Questions) as a 0–100% score. 100% means all gates are satisfied."),
                new("Confidence", OvConfidenceValue > 0m ? $"{OvConfidencePct}%" : "—", OvConfidenceTone,
                    "Confidence — how decisively the leading candidate separates from the rest. Formula: derived from outcome entropy H and winner separation, normalized to 0–100% (higher = lower entropy / clearer winner). Shows “—” until a confidence value is available."),
            ];
        }
    }

    // Why It Leads: the leading candidate's strongest scored dimensions (branch evidence scores 0-100).
    private sealed record OvLeaderFactor(string Name, int Pct, string Tone);
    private IReadOnlyList<OvLeaderFactor> OvWhyItLeads
    {
        get
        {
            var leader = OvOutcomes.FirstOrDefault();
            if (leader is null) return [];
            return leader.BranchScores
                .OrderByDescending(b => b.EvidenceScore)
                .Take(5)
                .Select(b =>
                {
                    var pct = (int)Math.Round((double)Math.Clamp(b.EvidenceScore, 0m, 1m) * 100);
                    var tone = pct >= 70 ? "ok" : pct >= 45 ? "warn" : "danger";
                    return new OvLeaderFactor(b.BranchDisplayName, pct, tone);
                })
                .ToList();
        }
    }

    // What Could Flip It: factors that are contradicted or unresolved — the live risks that could change
    // the ranking. Contradictions first, then unsupported factors. Derived from the factor inventory.
    private sealed record OvFlipPoint(string Name, string StateLabel, string Tone);
    private IReadOnlyList<OvFlipPoint> OvWhatCouldFlipIt
    {
        get
        {
            var factors = DfiFactors;
            if (factors.Count == 0) return [];
            var flips = new List<OvFlipPoint>();
            foreach (var f in factors.Where(f => f.Contradictions.Count > 0))
                flips.Add(new OvFlipPoint(f.FactorName, "Contradicted", "danger"));
            foreach (var f in factors.Where(f => f.Contradictions.Count == 0))
            {
                var (state, _) = DfiFactorState(f);
                if (state != "SUPPORTED")
                    flips.Add(new OvFlipPoint(f.FactorName, state == "SUPPLIED" ? "Unverified" : "Unsupported", state == "SUPPLIED" ? "warn" : "danger"));
            }
            return flips.Take(5).ToList();
        }
    }

