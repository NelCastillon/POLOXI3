    // aggregate confidence — honest to label it as such rather than "evidence-backed". Reporting only:
    // this reads existing core values and never changes ranking, confidence, termination, or persistence.
    internal bool IsEvidenceWeightedConfidence => _response?.DecisionConfidence is not null;
