    // All data is DB/API-backed and read-only except the governed run/accept/reject actions, which are
    // routed through the same server endpoints the Legal Decision console already uses. Legal Authority
    // orchestration is park-only; POLOXI Core remains the sole scorer.
    internal async Task LoadLegalAuthorityWorkspaceAsync()
    {
        if (MatterId is not { } matterId || matterId == Guid.Empty || _legalAuthorityLoading)
            return;
        _legalAuthorityLoading = true;
        _legalAuthorityError = null;
        try
        {
            _legalAuthorityReviewItems = await Api.GetRetrievedPropositionReviewAsync(matterId);
            if (!_channelScoringLoaded && !_channelScoringLoading)
                await LoadChannelScoringAsync();
            _legalAuthorityLoaded = true;
        }
        catch (Exception ex)
        {
            _legalAuthorityError = $"Failed to load the Legal Authority workspace: {ex.Message}";
        }
        finally
        {
            _legalAuthorityLoading = false;
            StateHasChanged();
        }
    }

    // Trigger one Legal Authority pass: the server scans VERIFIED legal-authority evidence, matches it to
    // authoritative hierarchy nodes, and parks matched/unmatched propositions for attorney review. It never
    // scores or ranks. On success we refresh the review queue so newly parked items appear.
    internal async Task RunLegalAuthorityPassAsync()
    {
        if (MatterId is not { } matterId || matterId == Guid.Empty || _legalAuthorityBusy)
            return;
        _legalAuthorityBusy = true;
        _legalAuthorityBanner = null;
        try
        {
            var result = await Api.RunAuthorityPassAsync(matterId);
            if (result is null)
                SetLegalAuthorityBanner("Authority pass completed, but no summary was returned.", isError: true);
            else if (string.Equals(result.StatusCode, "Failed", StringComparison.OrdinalIgnoreCase))
                SetLegalAuthorityBanner($"Authority pass failed: {result.FailureReason}", isError: true);
            else
                SetLegalAuthorityBanner($"Authority pass {result.StatusCode}: scanned {result.AuthoritiesScanned} authority(ies), matched {result.AuthoritiesMatched}, parked {result.ItemsParked} for review.", isError: false);
            await RefreshLegalAuthorityReviewAsync();
        }
        catch (Exception ex)
        {
            SetLegalAuthorityBanner($"Authority pass failed: {ex.Message}", isError: true);
        }
        finally
        {
            _legalAuthorityBusy = false;
            StateHasChanged();
        }
    }

    private async Task RefreshLegalAuthorityReviewAsync()
    {
        if (MatterId is not { } matterId || matterId == Guid.Empty)
            return;
        try
        {
            _legalAuthorityReviewItems = await Api.GetRetrievedPropositionReviewAsync(matterId);
        }
        catch (Exception ex)
        {
            _legalAuthorityError = $"Failed to refresh the review queue: {ex.Message}";
        }
    }

