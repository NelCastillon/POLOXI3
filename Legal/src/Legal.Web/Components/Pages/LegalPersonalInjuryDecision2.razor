    private async Task ExecuteCleanupAsync()
    {
        if (_matter is null || _cleanupConfirm is null) return;
        _cleanupBusy = true;
        _cleanupError = null;
        try
        {
            _cleanupResult = await Api.PurgeLegalMatterDocumentsAsync(_matter.DecisionMatterId, _cleanupConfirm.DocumentIds);
            _cleanupConfirm = null;
            _selectedCleanupDocumentIds.Clear();
            // Refresh the DB-backed corpus, evidence graph and provenance so all recomputed
            // scoring/statuses are reflected immediately in the workspace.
            _documents = await Api.GetLegalMatterDocumentsAsync(_matter.DecisionMatterId);
            await LoadEvidenceGraphAsync();
            await LoadProvenanceAsync();
        }
        catch (Exception ex)
        {
            _cleanupError = $"Cleanup failed: {ex.Message}";
        }
        finally
        {
            _cleanupBusy = false;
        }
    }

