            : _propositionInfoValue.Propositions
                .OrderByDescending(p => p.InformationValue)
                .Take(5)
                .ToArray();

    internal decimal PropositionInfoValueMax =>
        PropositionInfoValues.Count > 0 ? Math.Max(0.001m, PropositionInfoValues.Max(p => p.InformationValue)) : 1m;

