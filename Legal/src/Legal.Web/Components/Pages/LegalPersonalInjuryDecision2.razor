    internal async Task UploadDocumentAsync(InputFileChangeEventArgs args)
    {
        if (MatterId is not { } matterId || _uploading)
            return;
        _uploading = true;
        _error = null;
        _uploadOutcome = null;
        _uploadEnriched = false;
        _uploadResult = UploadResult.None;
        _uploadStages = BuildUploadStages();
        var failures = new List<string>();
        var succeeded = 0;
        try
        {
            // Real intake: each file is streamed to Blob storage, the true SHA-256 of the uploaded
            // bytes is computed, and Azure Document Intelligence extraction runs server-side. Multiple
            // files are uploaded one request per file so a single bad file does not fail the batch.
            var files = args.GetMultipleFiles(maximumFileCount: 50);
            _uploadTotal = files.Count;
            _uploadIndex = 0;
            SetUploadStage("upload", UploadStageState.Active);

            // Open one upload batch for this "add evidence" action so provenance occurrences and the
            // per-batch report (accepted / duplicates / reused) are grouped for the upload dashboard.
            Guid? batchId = null;
            var source = new Legal.Application.Features.Intelligence.Decision.EvidenceSourceDescriptor
            {
                SourceTypeCode = string.IsNullOrWhiteSpace(_evSourceType) ? "USER_UPLOAD" : _evSourceType,
                Custodian = _evCustodian,
                ProducedBy = _evProducedBy,
                ProductionId = _evProductionId,
                BatesStart = _evBatesStart,
                BatesEnd = _evBatesEnd
            };
            try
            {
                batchId = await Api.StartLegalUploadBatchAsync(matterId, new Legal.Application.Features.Intelligence.Decision.StartUploadBatchCommand
                {
                    SourceTypeCode = source.SourceTypeCode,
                    Custodian = _evCustodian,
                    ProducedBy = _evProducedBy,
                    ProductionId = _evProductionId,
                    ReceivedDateUtc = DateTime.UtcNow
                });
            }
            catch
            {
                // Fail-soft: if the batch could not be opened, uploads still proceed as standalone
                // occurrences. The evidence is never blocked by the provenance/reporting layer.
                batchId = null;
            }

            // Report how many files this action discovered so the batch report can reconcile
            // discovered vs. accepted vs. duplicate. Fail-soft: reporting never blocks intake.
            if (batchId is { } discoveredBatchId)
            {
                try { await Api.SetLegalUploadBatchDiscoveredAsync(matterId, discoveredBatchId, files.Count); }
                catch { /* fail-soft: reporting only */ }
            }

            foreach (var file in files)
            {
                _uploadIndex++;
                StateHasChanged();
                try
                {
                    // Request identity: a stable per-file idempotency key means an accidental browser
                    // retry of the same file returns the same result instead of a duplicate intake.
                    var idempotencyKey = $"{matterId:N}:{file.Name}:{file.Size}:{file.LastModified.UtcTicks}";
                    await Api.UploadLegalMatterDocumentAsync(
                        matterId, file, null, DecisionDomainPackCodes.PersonalInjury,
                        string.IsNullOrWhiteSpace(_selectedModelCode) ? null : _selectedModelCode,
                        default, idempotencyKey, batchId, source);
                    succeeded++;
                }
                catch (Exception ex)
                {
                    failures.Add($"{file.Name}: {ex.Message}");
                }
            }
            // The intake endpoint is synchronous and prepare-only: on a successful response the server
            // has already run malware scan → Blob storage → database persistence → text extraction. The
            // metered reasoning (atomic propositions + CDC) is deferred to the Disambiguate & Answer path.
            if (succeeded > 0)
            {
                SetUploadStage("upload", UploadStageState.Done);
                SetUploadStage("scan", UploadStageState.Done);
                SetUploadStage("blob", UploadStageState.Done);
                SetUploadStage("db", UploadStageState.Done);
                SetUploadStage("extract", UploadStageState.Done);
                SetUploadStage("propositions", UploadStageState.Queued);
                SetUploadStage("cdc", UploadStageState.Queued);
            }
            else if (failures.Count > 0)
            {
                SetUploadStage("upload", UploadStageState.Failed);
                SetUploadResult(UploadResult.Fail);
            }
            _documents = await Api.GetLegalMatterDocumentsAsync(matterId);
            // Close the upload batch so its report (accepted / duplicates / reused) is finalized for the
            // dashboard. Fail-soft: a reporting failure never blocks the completed intake.
            if (batchId is { } closeBatchId)
            {
                try { await Api.CloseLegalUploadBatchAsync(matterId, closeBatchId, failures.Count == 0 ? "COMPLETED" : "COMPLETED_WITH_ERRORS"); }
                catch { /* fail-soft: reporting only */ }
            }
            // Surface the machine-extracted evidence for the freshly analyzed documents.
            await LoadEvidenceGraphAsync();
            await LoadProvenanceAsync();
            if (succeeded > 0)
            {
                // Prepare-only: documents are stored and text-extracted. Atomic propositions and CDC are
                // activated when the user clicks Disambiguate & Answer, using the answer-time model.
                _uploadEnriched = false;
                SetUploadResult(UploadResult.Pass);
                _uploadOutcome =
                    $"{succeeded} document(s) prepared. Each was scanned, stored, and its text extracted into passages. " +
                    "Atomic propositions and the decision re-check (CDC) run automatically when you click Disambiguate & Answer, " +
                    "so they enrich the corpus using the model you select for the answer. Review the Evidence Graph below after answering.";
            }
            if (failures.Count > 0)
                _error = $"{succeeded} uploaded, {failures.Count} failed: {string.Join("; ", failures)}";
        }
        catch (Exception ex)
        {
            _error = $"Document upload failed: {ex.Message}";
            SetUploadResult(UploadResult.Fail);
        }
        finally
        {
            _uploading = false;
            _uploadTotal = 0;
            _uploadIndex = 0;
            StateHasChanged();
        }
    }

    // Refreshes the DB-backed intelligence layers the Overview depends on AFTER an answer runs.
