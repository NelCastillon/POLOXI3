@page "/admin/users"
@using Legal.Application.Features.Saas
@inject ApiClient Api

<LegalWorkspace>
<div class="intel-page">
    <header class="intel-header">
        <div>
            <span>Administration · Members</span>
            <h1>User Management</h1>
            <p>Manage members of your organization. Invite or create users, assign a role, and activate, suspend, or remove access. You may grant only the tenant roles Owner, Admin, Member, and Viewer.</p>
        </div>
        <div class="um-header-actions">
            <button class="um-btn um-btn-primary" @onclick="() => OpenForm(false)"><i class="bi bi-person-plus"></i> Add member</button>
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_error</div>
    }

    @if (_loading)
    {
        <div class="intel-state">Loading members…</div>
    }
    else
    {
        <section class="intel-kpis">
            <article class="intel-kpi-link @(_statusFilter is null ? "intel-kpi-active" : null)" role="button" tabindex="0"
                     title="Show all members" @onclick="() => SetStatus(null)">
                <span>All members</span><strong>@_memberTotalCount</strong>
            </article>
            <article class="intel-kpi-link @(_statusFilter == "Active" ? "intel-kpi-active" : null)" role="button" tabindex="0"
                     title="Show active members" @onclick="@(() => SetStatus("Active"))">
                <span>Active</span><strong>@_activeCount</strong>
            </article>
            <article class="intel-kpi-link @(_statusFilter == "Suspended" ? "intel-kpi-active" : null)" role="button" tabindex="0"
                     title="Show suspended members" @onclick="@(() => SetStatus("Suspended"))">
                <span>Suspended</span><strong>@_suspendedCount</strong>
            </article>
            <article class="intel-kpi-link @(_statusFilter == "Disabled" ? "intel-kpi-active" : null)" role="button" tabindex="0"
                     title="Show disabled members" @onclick="@(() => SetStatus("Disabled"))">
                <span>Disabled</span><strong>@_disabledCount</strong>
            </article>
        </section>

        <div class="um-list-controls">
            <form @onsubmit="SearchMembersAsync" @onsubmit:preventDefault>
                <label class="visually-hidden" for="member-search">Search members</label>
                <input id="member-search" class="form-control" type="search" @bind="_memberSearch" placeholder="Search name, email, or organization…" />
                <button type="submit" class="um-btn um-btn-ghost" disabled="@_loading"><i class="bi bi-search"></i> Search</button>
            </form>
            <select class="form-control um-input-sm" aria-label="Members per page" @bind="_memberPageSize" @bind:after="ChangeMemberPageSizeAsync">
                <option value="10">10 per page</option>
                <option value="25">25 per page</option>
                <option value="50">50 per page</option>
            </select>
        </div>

        @if (_members.Count == 0)
        {
            <div class="intel-state">No members match this view.</div>
        }
        else
        {
            <section class="intel-panel">
                <table class="um-table">
                    <thead>
                        <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _members)
                        {
                            <tr>
                                <td>@($"{m.FirstName} {m.LastName}".Trim())</td>
                                <td>@m.Email @if (!m.EmailConfirmed) { <span class="um-tag">unverified</span> }</td>
                                <td>
                                    <select class="form-control um-input-sm" value="@m.RoleCode" @onchange="@(e => ChangeRole(m, e))" disabled="@(m.RoleCode == "SUPERADMIN")">
                                        @foreach (var r in _roles)
                                        {
                                            <option value="@r.Code">@r.DisplayName</option>
                                        }
                                        @if (m.RoleCode == "SUPERADMIN")
                                        {
                                            <option value="SUPERADMIN">Super Admin</option>
                                        }
                                    </select>
                                </td>
                                <td><AppStatusBadge Status="@m.StatusCode" /></td>
                                <td>@m.JoinedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="um-row-actions">
                                    @if (m.StatusCode == "Active")
                                    {
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Suspend" @onclick="@(() => ChangeStatus(m, "Suspended"))" disabled="@(m.RoleCode == "SUPERADMIN")"><i class="bi bi-pause-circle"></i></button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Disable" @onclick="@(() => ChangeStatus(m, "Disabled"))" disabled="@(m.RoleCode == "SUPERADMIN")"><i class="bi bi-slash-circle"></i></button>
                                    }
                                    else
                                    {
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Activate" @onclick="@(() => ChangeStatus(m, "Active"))"><i class="bi bi-play-circle"></i></button>
                                    }
                                    <button class="um-btn um-btn-ghost um-btn-sm" title="View usage and audit events" @onclick="@(() => OpenActivity(m))"><i class="bi bi-activity"></i></button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" title="View legal consent" @onclick="@(() => OpenConsent(m))"><i class="bi bi-file-earmark-check"></i></button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" title="Set temporary password" @onclick="@(() => AskSetPassword(m))" disabled="@(m.RoleCode == "SUPERADMIN")"><i class="bi bi-key"></i></button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" title="Remove" @onclick="() => AskRemove(m)" disabled="@(m.RoleCode == "SUPERADMIN")"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
                <div class="um-pager">
                    <span>@MemberResultSummary</span>
                    <div>
                        <button class="um-btn um-btn-ghost" @onclick="PreviousMemberPageAsync" disabled="@(_loading || _memberPage <= 1)">Previous</button>
                        <span>Page @_memberPage of @MemberPageCount</span>
                        <button class="um-btn um-btn-ghost" @onclick="NextMemberPageAsync" disabled="@(_loading || _memberPage >= MemberPageCount)">Next</button>
                    </div>
                </div>
            </section>
        }

        <section class="intel-panel" style="margin-top:1.25rem;">
            <div class="um-panel-head" style="display:flex;align-items:center;gap:.75rem;">
                <div>
                    <h2 style="margin:0;">Pending invitations</h2>
                    <p style="margin:.15rem 0 0;color:var(--intel-muted,#6b7280);">Invitations awaiting acceptance. Resend to issue a fresh link, or revoke to cancel access.</p>
                </div>
                <button class="um-btn um-btn-primary ms-auto" @onclick="OpenInvite"><i class="bi bi-envelope-plus"></i> Invite by email</button>
            </div>

            @if (_invitations.Count == 0)
            {
                <div class="intel-state">No invitations yet.</div>
            }
            else
            {
                <table class="um-table">
                    <thead>
                        <tr><th>Email</th><th>Role</th><th>Status</th><th>Expires</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in _invitations)
                        {
                            <tr>
                                <td>@inv.Email</td>
                                <td>@inv.RoleName</td>
                                <td><AppStatusBadge Status="@inv.StatusCode" /></td>
                                <td>@inv.ExpiresAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="um-row-actions">
                                    @if (inv.StatusCode is "Pending" or "Expired")
                                    {
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Resend" @onclick="@(() => ResendInvite(inv))" disabled="@_saving"><i class="bi bi-arrow-repeat"></i></button>
                                    }
                                    @if (inv.StatusCode == "Pending")
                                    {
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Revoke" @onclick="@(() => AskRevoke(inv))" disabled="@_saving"><i class="bi bi-x-circle"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@if (_activityTarget is not null)
{
    <div class="um-modal-backdrop" role="presentation" @onclick="CloseActivity">
        <div class="um-modal um-modal--wide" role="dialog" aria-modal="true" aria-labelledby="member-activity-title" @onclick:stopPropagation>
            <div class="um-modal-header">
                <i class="bi bi-activity"></i>
                <span id="member-activity-title">Usage &amp; audit — @($"{_activityTarget.FirstName} {_activityTarget.LastName}".Trim())</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" aria-label="Close member activity" @onclick="CloseActivity"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="um-activity-toolbar">
                    <p>Metered feature consumption and audit events attributed to this member within your tenant.</p>
                    <select class="form-control um-input-sm" @bind="_activityDays" @bind:after="ResetAndReloadActivityAsync">
                        <option value="7">Last 7 days</option><option value="30">Last 30 days</option><option value="90">Last 90 days</option><option value="365">Last 365 days</option>
                    </select>
                </div>
                @if (_activityLoading) { <div class="intel-state">Loading member activity…</div> }
                else if (_activityError is not null) { <div class="alert alert-danger">@_activityError</div> }
                else
                {
                    <h3 class="um-activity-title">Metered feature usage</h3>
                    @if (_activityUsage.Count == 0) { <div class="intel-state">No metered usage recorded in this window.</div> }
                    else
                    {
                        <div class="um-table-scroll"><table class="um-table"><thead><tr><th>Meter</th><th>Class</th><th>Quantity</th><th>Events</th><th>Last used (UTC)</th></tr></thead><tbody>
                            @foreach (var usage in _activityUsage) { <tr><td>@usage.MeterCode</td><td>@usage.UsageClass</td><td>@usage.TotalQuantity</td><td>@usage.EventCount</td><td>@FormatUtc(usage.LastOccurredAtUtc)</td></tr> }
                        </tbody></table></div>
                    }
                    <div class="um-activity-heading">
                        <h3 class="um-activity-title">Audit events</h3>
                        <form @onsubmit="SearchActivityAsync" @onsubmit:preventDefault>
                            <input class="form-control" type="search" aria-label="Search member audit events" @bind="_activitySearch" placeholder="Search audit events…" />
                            <button class="um-btn um-btn-ghost" type="submit"><i class="bi bi-search"></i> Search</button>
                        </form>
                    </div>
                    @if (_activityAudit.Count == 0) { <div class="intel-state">No audit events match this view.</div> }
                    else
                    {
                        <div class="um-table-scroll"><table class="um-table"><thead><tr><th>When (UTC)</th><th>Event</th><th>Resource</th><th>Resource ID</th><th>Correlation</th></tr></thead><tbody>
                            @foreach (var audit in _activityAudit) { <tr><td>@FormatUtc(audit.OccurredAtUtc)</td><td>@audit.EventType</td><td>@Display(audit.ResourceType)</td><td>@Display(audit.ResourceId?.ToString())</td><td>@Display(audit.CorrelationId)</td></tr> }
                        </tbody></table></div>
                        <div class="um-pager"><span>@ActivityResultSummary</span><div>
                            <button class="um-btn um-btn-ghost" @onclick="PreviousActivityPageAsync" disabled="@(_activityPage <= 1)">Previous</button>
                            <span>Page @_activityPage of @ActivityPageCount</span>
                            <button class="um-btn um-btn-ghost" @onclick="NextActivityPageAsync" disabled="@(_activityPage >= ActivityPageCount)">Next</button>
                        </div></div>
                    }
                }
            </div>
            <div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="CloseActivity">Close</button></div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="um-modal-backdrop">
        <div class="um-modal">
            <div class="um-modal-header">
                <i class="bi bi-person-plus"></i>
                <span>Add member</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SubmitForm">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Provisioning</span>
                            <select class="form-control" @bind="_form.Mode">
                                <option value="Invite">Invite by email (user verifies)</option>
                                <option value="Create">Create with temporary password</option>
                            </select>
                        </label>
                        <label class="um-field">
                            <span class="um-field-label">First name</span>
                            <InputText class="form-control" @bind-Value="_form.FirstName" placeholder="e.g. Jordan" />
                            <ValidationMessage For="() => _form.FirstName" class="text-danger" />
                        </label>
                        <label class="um-field">
                            <span class="um-field-label">Last name</span>
                            <InputText class="form-control" @bind-Value="_form.LastName" placeholder="e.g. Rivera" />
                            <ValidationMessage For="() => _form.LastName" class="text-danger" />
                        </label>
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Email</span>
                            <InputText class="form-control" @bind-Value="_form.Email" placeholder="name@company.com" />
                            <ValidationMessage For="() => _form.Email" class="text-danger" />
                        </label>
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Role</span>
                            <InputSelect class="form-control" @bind-Value="_form.RoleCode">
                                @foreach (var r in _roles)
                                {
                                    <option value="@r.Code">@r.DisplayName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.RoleCode" class="text-danger" />
                        </label>
                        @if (_form.Mode == "Create")
                        {
                            <label class="um-field um-field--full">
                                <span class="um-field-label">Temporary password</span>
                                <InputText type="password" class="form-control" @bind-Value="_form.TemporaryPassword" placeholder="Minimum 8 characters" />
                                <ValidationMessage For="() => _form.TemporaryPassword" class="text-danger" />
                            </label>
                        }
                    </div>
                    @if (_formError is not null)
                    {
                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@_formError</div>
                    }
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_removeTarget is not null)
{
    <div class="um-modal-backdrop">
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-exclamation-triangle"></i></div>
            <h3>Remove member?</h3>
            <p>Remove <strong>@_removeTarget.Email</strong> from this organization? Their access will be revoked. This does not delete their account.</p>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _removeTarget = null">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ConfirmRemove" disabled="@_saving">Remove</button>
            </div>
        </div>
    </div>
}

@if (_passwordTarget is not null)
{
    <div class="um-modal-backdrop">
        <div class="um-modal">
            <div class="um-modal-header">
                <i class="bi bi-key"></i>
                <span>Set temporary password</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _passwordTarget = null"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_passwordForm" OnValidSubmit="ConfirmSetPassword">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <p>Set a new temporary password for <strong>@_passwordTarget.Email</strong>. This replaces their current password and clears any sign-in lockout. Share it securely; the member should change it after signing in.</p>
                    <div class="um-form-grid">
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Temporary password</span>
                            <InputText type="password" class="form-control" @bind-Value="_passwordForm.TemporaryPassword" placeholder="Minimum 8 characters" />
                            <ValidationMessage For="() => _passwordForm.TemporaryPassword" class="text-danger" />
                        </label>
                    </div>
                    @if (_passwordError is not null)
                    {
                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@_passwordError</div>
                    }
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _passwordTarget = null">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Saving…" : "Set password")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_consentTarget is not null)
{
    <div class="um-modal-backdrop">
        <div class="um-modal um-modal--wide">
            <div class="um-modal-header">
                <i class="bi bi-file-earmark-check"></i>
                <span>Legal consent — @($"{_consentTarget.FirstName} {_consentTarget.LastName}".Trim())</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _consentTarget = null"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body">
                <p class="um-consent-note">
                    Append-only clickwrap evidence: the exact agreement version and content hash the member accepted,
                    with the acceptance method, IP address, and user-agent captured at signup.
                </p>
                @if (_consentLoading)
                {
                    <div class="intel-state">Loading consent records…</div>
                }
                else if (_consentError is not null)
                {
                    <div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@_consentError</div>
                }
                else if (_consentRecords.Count == 0)
                {
                    <div class="intel-state">No consent records found for this member.</div>
                }
                else
                {
                    <table class="um-table">
                        <thead>
                            <tr><th>Agreement</th><th>Version</th><th>Accepted</th><th>Method</th><th>IP address</th><th>Hash</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _consentRecords)
                            {
                                <tr>
                                    <td>@c.AgreementType</td>
                                    <td><code>@c.AgreementVersion</code></td>
                                    <td>@c.AcceptedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                    <td>@c.AcceptanceMethod</td>
                                    <td>@(string.IsNullOrWhiteSpace(c.IpAddress) ? "—" : c.IpAddress)</td>
                                    <td class="um-consent-hash" title="@c.ContentHash">@c.ContentHash</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _consentTarget = null">Close</button>
            </div>
        </div>
    </div>
}

@if (_showInvite)
{
    <div class="um-modal-backdrop">
        <div class="um-modal">
            <div class="um-modal-header">
                <i class="bi bi-envelope-plus"></i>
                <span>Invite by email</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showInvite = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_inviteForm" OnValidSubmit="SubmitInvite">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Email</span>
                            <InputText class="form-control" @bind-Value="_inviteForm.Email" placeholder="name@company.com" />
                            <ValidationMessage For="() => _inviteForm.Email" class="text-danger" />
                        </label>
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Role</span>
                            <InputSelect class="form-control" @bind-Value="_inviteForm.RoleCode">
                                @foreach (var r in _roles)
                                {
                                    <option value="@r.Code">@r.DisplayName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _inviteForm.RoleCode" class="text-danger" />
                        </label>
                    </div>
                    @if (_inviteError is not null)
                    {
                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@_inviteError</div>
                    }
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showInvite = false">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Sending…" : "Send invitation")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_revokeTarget is not null)
{
    <div class="um-modal-backdrop">
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-exclamation-triangle"></i></div>
            <h3>Revoke invitation?</h3>
            <p>Revoke the invitation for <strong>@_revokeTarget.Email</strong>? The existing link will stop working immediately.</p>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _revokeTarget = null">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ConfirmRevoke" disabled="@_saving">Revoke</button>
            </div>
        </div>
    </div>
}
</LegalWorkspace>

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _formError;
    private string? _statusFilter;
    private bool _showForm;
    private ManagedMemberDto? _removeTarget;
    private ManagedMemberDto? _passwordTarget;
    private string? _passwordError;
    private readonly PasswordForm _passwordForm = new();
    private IReadOnlyList<ManagedMemberDto> _members = [];
    private string _memberSearch = string.Empty;
    private int _memberPage = 1;
    private int _memberPageSize = 25;
    private int _memberTotalCount;
    private int _activeCount;
    private int _suspendedCount;
    private int _disabledCount;
    private IReadOnlyList<AssignableRoleDto> _roles = [];
    private readonly MemberForm _form = new();

    private bool _showInvite;
    private string? _inviteError;
    private TenantInvitationDto? _revokeTarget;
    private IReadOnlyList<TenantInvitationDto> _invitations = [];
    private readonly InviteForm _inviteForm = new();

    private ManagedMemberDto? _consentTarget;
    private bool _consentLoading;
    private string? _consentError;
    private IReadOnlyList<ConsentRecordDto> _consentRecords = [];

    private ManagedMemberDto? _activityTarget;
    private bool _activityLoading;
    private string? _activityError;
    private int _activityDays = 30;
    private IReadOnlyList<AuditEventDto> _activityAudit = [];
    private IReadOnlyList<UsageSummaryDto> _activityUsage = [];
    private string _activitySearch = string.Empty;
    private int _activityPage = 1;
    private const int ActivityPageSize = 25;
    private int _activityTotalCount;

    private int MemberPageCount => Math.Max(1, (int)Math.Ceiling(_memberTotalCount / (double)_memberPageSize));
    private int ActivityPageCount => Math.Max(1, (int)Math.Ceiling(_activityTotalCount / (double)ActivityPageSize));
    private string MemberResultSummary => ResultSummary(_memberPage, _memberPageSize, _memberTotalCount);
    private string ActivityResultSummary => ResultSummary(_activityPage, ActivityPageSize, _activityTotalCount);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _roles = await Api.GetTenantAssignableRolesAsync();
            var memberPage = await Api.GetTenantMembersPageAsync(_memberSearch, _statusFilter, _memberPage, _memberPageSize);
            _members = memberPage.Items;
            _memberTotalCount = memberPage.TotalCount;
            _activeCount = memberPage.ActiveCount;
            _suspendedCount = memberPage.SuspendedCount;
            _disabledCount = memberPage.DisabledCount;
            _invitations = await Api.GetTenantInvitationsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load members: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenActivity(ManagedMemberDto member)
    {
        _activityTarget = member;
        _activityPage = 1;
        _activitySearch = string.Empty;
        await ReloadActivityAsync();
    }

    private async Task ReloadActivityAsync()
    {
        if (_activityTarget is null) return;

        _activityLoading = true;
        _activityError = null;
        _activityAudit = [];
        _activityUsage = [];
        try
        {
            var auditTask = Api.GetUserAuditEventsPageAsync(_activityTarget.UserId, _activityTarget.TenantId, _activityDays, _activitySearch, _activityPage, ActivityPageSize);
            var usageTask = Api.GetUserUsageAsync(_activityTarget.UserId, _activityTarget.TenantId, _activityDays);
            await Task.WhenAll(auditTask, usageTask);
            var auditPage = await auditTask;
            _activityAudit = auditPage.Items;
            _activityTotalCount = auditPage.TotalCount;
            _activityUsage = await usageTask;
        }
        catch (Exception ex)
        {
            _activityError = $"Failed to load member activity: {ex.Message}";
        }
        finally
        {
            _activityLoading = false;
        }
    }

    private void CloseActivity() => _activityTarget = null;

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatUtc(DateTime? value) => value is { } utc ? $"{utc:yyyy-MM-dd HH:mm:ss} UTC" : "—";

