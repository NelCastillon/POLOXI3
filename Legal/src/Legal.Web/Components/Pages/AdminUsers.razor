    private async Task SearchMembersAsync() { _memberPage = 1; await LoadAsync(); }
    private async Task ChangeMemberPageSizeAsync() { _memberPage = 1; await LoadAsync(); }
    private async Task PreviousMemberPageAsync() { if (_memberPage > 1) { _memberPage--; await LoadAsync(); } }
    private async Task NextMemberPageAsync() { if (_memberPage < MemberPageCount) { _memberPage++; await LoadAsync(); } }
    private async Task ResetAndReloadActivityAsync() { _activityPage = 1; await ReloadActivityAsync(); }
    private async Task SearchActivityAsync() { _activityPage = 1; await ReloadActivityAsync(); }
    private async Task PreviousActivityPageAsync() { if (_activityPage > 1) { _activityPage--; await ReloadActivityAsync(); } }
    private async Task NextActivityPageAsync() { if (_activityPage < ActivityPageCount) { _activityPage++; await ReloadActivityAsync(); } }

    private static string ResultSummary(int page, int pageSize, int totalCount) => totalCount == 0
        ? "No results"
        : $"Showing {((page - 1) * pageSize) + 1}–{Math.Min(page * pageSize, totalCount)} of {totalCount}";

