@page "/admin/users"
@using Legal.Application.Features.Saas
@inject ApiClient Api

<LegalWorkspace>
<div class="intel-page">
    <header class="intel-header">
        <div>
            <span>Administration · Members</span>
            <h1>User Management</h1>
            <p>Manage members of your organization. Invite or create users, assign a role, and activate, suspend, or remove access. You may grant only the tenant roles Owner, Admin, Member, and Viewer.</p>
        </div>
        <div class="um-header-actions">
            <button class="um-btn um-btn-primary" @onclick="() => OpenForm(false)"><i class="bi bi-person-plus"></i> Add member</button>
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_error</div>
    }

    @if (_loading)
    {
        <div class="intel-state">Loading members…</div>
    }
    else
    {
        <section class="intel-kpis">
            <article class="intel-kpi-link @(_statusFilter is null ? "intel-kpi-active" : null)" role="button" tabindex="0"
                     title="Show all members" @onclick="() => SetStatus(null)">
                <span>All members</span><strong>@_members.Count</strong>
            </article>
            <article class="intel-kpi-link @(_statusFilter == "Active" ? "intel-kpi-active" : null)" role="button" tabindex="0"
                     title="Show active members" @onclick="@(() => SetStatus("Active"))">
                <span>Active</span><strong>@_members.Count(m => m.StatusCode == "Active")</strong>
            </article>
            <article class="intel-kpi-link @(_statusFilter == "Suspended" ? "intel-kpi-active" : null)" role="button" tabindex="0"
                     title="Show suspended members" @onclick="@(() => SetStatus("Suspended"))">
                <span>Suspended</span><strong>@_members.Count(m => m.StatusCode == "Suspended")</strong>
            </article>
            <article class="intel-kpi-link @(_statusFilter == "Disabled" ? "intel-kpi-active" : null)" role="button" tabindex="0"
                     title="Show disabled members" @onclick="@(() => SetStatus("Disabled"))">
                <span>Disabled</span><strong>@_members.Count(m => m.StatusCode == "Disabled")</strong>
            </article>
        </section>

        @if (_filtered.Count == 0)
        {
            <div class="intel-state">No members match this view.</div>
        }
        else
        {
            <section class="intel-panel">
                <table class="um-table">
                    <thead>
                        <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _filtered)
                        {
                            <tr>
                                <td>@($"{m.FirstName} {m.LastName}".Trim())</td>
                                <td>@m.Email @if (!m.EmailConfirmed) { <span class="um-tag">unverified</span> }</td>
                                <td>
                                    <select class="form-control um-input-sm" value="@m.RoleCode" @onchange="@(e => ChangeRole(m, e))" disabled="@(m.RoleCode == "SUPERADMIN")">
                                        @foreach (var r in _roles)
                                        {
                                            <option value="@r.Code">@r.DisplayName</option>
                                        }
                                        @if (m.RoleCode == "SUPERADMIN")
                                        {
                                            <option value="SUPERADMIN">Super Admin</option>
                                        }
                                    </select>
                                </td>
                                <td><AppStatusBadge Status="@m.StatusCode" /></td>
                                <td>@m.JoinedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="um-row-actions">
                                    @if (m.StatusCode == "Active")
                                    {
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Suspend" @onclick="@(() => ChangeStatus(m, "Suspended"))" disabled="@(m.RoleCode == "SUPERADMIN")"><i class="bi bi-pause-circle"></i></button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Disable" @onclick="@(() => ChangeStatus(m, "Disabled"))" disabled="@(m.RoleCode == "SUPERADMIN")"><i class="bi bi-slash-circle"></i></button>
                                    }
                                    else
                                    {
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Activate" @onclick="@(() => ChangeStatus(m, "Active"))"><i class="bi bi-play-circle"></i></button>
                                    }
                                    <button class="um-btn um-btn-ghost um-btn-sm" title="Remove" @onclick="() => AskRemove(m)" disabled="@(m.RoleCode == "SUPERADMIN")"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        <section class="intel-panel" style="margin-top:1.25rem;">
            <div class="um-panel-head" style="display:flex;align-items:center;gap:.75rem;">
                <div>
                    <h2 style="margin:0;">Pending invitations</h2>
                    <p style="margin:.15rem 0 0;color:var(--intel-muted,#6b7280);">Invitations awaiting acceptance. Resend to issue a fresh link, or revoke to cancel access.</p>
                </div>
                <button class="um-btn um-btn-primary ms-auto" @onclick="OpenInvite"><i class="bi bi-envelope-plus"></i> Invite by email</button>
            </div>

            @if (_invitations.Count == 0)
            {
                <div class="intel-state">No invitations yet.</div>
            }
            else
            {
                <table class="um-table">
                    <thead>
                        <tr><th>Email</th><th>Role</th><th>Status</th><th>Expires</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in _invitations)
                        {
                            <tr>
                                <td>@inv.Email</td>
                                <td>@inv.RoleName</td>
                                <td><AppStatusBadge Status="@inv.StatusCode" /></td>
                                <td>@inv.ExpiresAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="um-row-actions">
                                    @if (inv.StatusCode is "Pending" or "Expired")
                                    {
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Resend" @onclick="@(() => ResendInvite(inv))" disabled="@_saving"><i class="bi bi-arrow-repeat"></i></button>
                                    }
                                    @if (inv.StatusCode == "Pending")
                                    {
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Revoke" @onclick="@(() => AskRevoke(inv))" disabled="@_saving"><i class="bi bi-x-circle"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>


@if (_showForm)
{
    <div class="um-modal-backdrop">
        <div class="um-modal">
            <div class="um-modal-header">
                <i class="bi bi-person-plus"></i>
                <span>Add member</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SubmitForm">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Provisioning</span>
                            <select class="form-control" @bind="_form.Mode">
                                <option value="Invite">Invite by email (user verifies)</option>
                                <option value="Create">Create with temporary password</option>
                            </select>
                        </label>
                        <label class="um-field">
                            <span class="um-field-label">First name</span>
                            <InputText class="form-control" @bind-Value="_form.FirstName" placeholder="e.g. Jordan" />
                            <ValidationMessage For="() => _form.FirstName" class="text-danger" />
                        </label>
                        <label class="um-field">
                            <span class="um-field-label">Last name</span>
                            <InputText class="form-control" @bind-Value="_form.LastName" placeholder="e.g. Rivera" />
                            <ValidationMessage For="() => _form.LastName" class="text-danger" />
                        </label>
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Email</span>
                            <InputText class="form-control" @bind-Value="_form.Email" placeholder="name@company.com" />
                            <ValidationMessage For="() => _form.Email" class="text-danger" />
                        </label>
                        <label class="um-field">
                            <span class="um-field-label">Role</span>
                            <InputSelect class="form-control" @bind-Value="_form.RoleCode">
                                @foreach (var r in _roles)
                                {
                                    <option value="@r.Code">@r.DisplayName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.RoleCode" class="text-danger" />
                        </label>
                        @if (_form.Mode == "Create")
                        {
                            <label class="um-field">
                                <span class="um-field-label">Temporary password</span>
                                <InputText type="password" class="form-control" @bind-Value="_form.TemporaryPassword" placeholder="Minimum 8 characters" />
                                <ValidationMessage For="() => _form.TemporaryPassword" class="text-danger" />
                            </label>
                        }
                    </div>
                    @if (_formError is not null)
                    {
                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@_formError</div>
                    }
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_removeTarget is not null)
{
    <div class="um-modal-backdrop">
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-exclamation-triangle"></i></div>
            <h3>Remove member?</h3>
            <p>Remove <strong>@_removeTarget.Email</strong> from this organization? Their access will be revoked. This does not delete their account.</p>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _removeTarget = null">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ConfirmRemove" disabled="@_saving">Remove</button>
            </div>
        </div>
    </div>
}

@if (_showInvite)
{
    <div class="um-modal-backdrop">
        <div class="um-modal">
            <div class="um-modal-header">
                <i class="bi bi-envelope-plus"></i>
                <span>Invite by email</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showInvite = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_inviteForm" OnValidSubmit="SubmitInvite">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Email</span>
                            <InputText class="form-control" @bind-Value="_inviteForm.Email" placeholder="name@company.com" />
                            <ValidationMessage For="() => _inviteForm.Email" class="text-danger" />
                        </label>
                        <label class="um-field um-field--full">
                            <span class="um-field-label">Role</span>
                            <InputSelect class="form-control" @bind-Value="_inviteForm.RoleCode">
                                @foreach (var r in _roles)
                                {
                                    <option value="@r.Code">@r.DisplayName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _inviteForm.RoleCode" class="text-danger" />
                        </label>
                    </div>
                    @if (_inviteError is not null)
                    {
                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@_inviteError</div>
                    }
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showInvite = false">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Sending…" : "Send invitation")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_revokeTarget is not null)
{
    <div class="um-modal-backdrop">
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-exclamation-triangle"></i></div>
            <h3>Revoke invitation?</h3>
            <p>Revoke the invitation for <strong>@_revokeTarget.Email</strong>? The existing link will stop working immediately.</p>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _revokeTarget = null">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ConfirmRevoke" disabled="@_saving">Revoke</button>
            </div>
        </div>
    </div>
}
</LegalWorkspace>

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _formError;
    private string? _statusFilter;
    private bool _showForm;
    private ManagedMemberDto? _removeTarget;
    private IReadOnlyList<ManagedMemberDto> _members = [];
    private IReadOnlyList<AssignableRoleDto> _roles = [];
    private readonly MemberForm _form = new();

    private bool _showInvite;
    private string? _inviteError;
    private TenantInvitationDto? _revokeTarget;
    private IReadOnlyList<TenantInvitationDto> _invitations = [];
    private readonly InviteForm _inviteForm = new();

    private IReadOnlyList<ManagedMemberDto> _filtered =>
        _statusFilter is null ? _members : _members.Where(m => m.StatusCode == _statusFilter).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _roles = await Api.GetTenantAssignableRolesAsync();
            _members = await Api.GetTenantMembersAsync();
            _invitations = await Api.GetTenantInvitationsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load members: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetStatus(string? status) => _statusFilter = status;

    private void OpenForm(bool _)
    {
        _formError = null;
        _form.Reset(_roles.FirstOrDefault()?.Code ?? "MEMBER");
        _showForm = true;
    }

    private async Task SubmitForm()
    {
        _saving = true;
        _formError = null;
        try
        {
            if (_form.Mode == "Create")
                await Api.CreateTenantMemberAsync(new CreateMemberRequest(Guid.Empty, _form.Email.Trim(), _form.FirstName.Trim(), _form.LastName.Trim(), _form.RoleCode, _form.TemporaryPassword?.Trim() ?? string.Empty));
            else
                await Api.InviteTenantMemberAsync(new InviteMemberRequest(Guid.Empty, _form.Email.Trim(), _form.FirstName.Trim(), _form.LastName.Trim(), _form.RoleCode));
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ChangeRole(ManagedMemberDto member, ChangeEventArgs e)
    {
        var roleCode = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(roleCode) || roleCode == member.RoleCode) return;
        try
        {
            await Api.ChangeTenantMemberRoleAsync(new ChangeMemberRoleRequest(member.MembershipId, roleCode));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to change role: {ex.Message}";
        }
    }

    private async Task ChangeStatus(ManagedMemberDto member, string status)
    {
        try
        {
            await Api.ChangeTenantMemberStatusAsync(new ChangeMemberStatusRequest(member.MembershipId, status));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to change status: {ex.Message}";
        }
    }

    private void AskRemove(ManagedMemberDto member) => _removeTarget = member;

    private async Task ConfirmRemove()
    {
        if (_removeTarget is null) return;
        _saving = true;
        try
        {
            await Api.RemoveTenantMemberAsync(_removeTarget.MembershipId);
            _removeTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to remove member: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenInvite()
    {
        _inviteError = null;
        _inviteForm.Reset(_roles.FirstOrDefault()?.Code ?? "MEMBER");
        _showInvite = true;
    }

    private async Task SubmitInvite()
    {
        _saving = true;
        _inviteError = null;
        try
        {
            await Api.CreateTenantInvitationAsync(new CreateInvitationRequest(Guid.Empty, _inviteForm.Email.Trim(), _inviteForm.RoleCode));
            _showInvite = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _inviteError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResendInvite(TenantInvitationDto inv)
    {
        _saving = true;
        _error = null;
        try
        {
            await Api.ResendTenantInvitationAsync(inv.InvitationId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to resend invitation: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void AskRevoke(TenantInvitationDto inv) => _revokeTarget = inv;

    private async Task ConfirmRevoke()
    {
        if (_revokeTarget is null) return;
        _saving = true;
        _error = null;
        try
        {
            await Api.RevokeTenantInvitationAsync(_revokeTarget.InvitationId);
            _revokeTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to revoke invitation: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class InviteForm
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress, System.ComponentModel.DataAnnotations.StringLength(256)]
        public string Email { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required]
        public string RoleCode { get; set; } = "MEMBER";

        public void Reset(string roleCode)
        {
            Email = string.Empty;
            RoleCode = roleCode;
        }
    }

    private sealed class MemberForm
    {
        public string Mode { get; set; } = "Invite";
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(100)]
        public string FirstName { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(100)]
        public string LastName { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress, System.ComponentModel.DataAnnotations.StringLength(256)]
        public string Email { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required]
        public string RoleCode { get; set; } = "MEMBER";
        [System.ComponentModel.DataAnnotations.StringLength(128, MinimumLength = 8)]
        public string? TemporaryPassword { get; set; }

        public void Reset(string roleCode)
        {
            Mode = "Invite";
            FirstName = LastName = Email = string.Empty;
            RoleCode = roleCode;
            TemporaryPassword = null;
        }
    }
}
