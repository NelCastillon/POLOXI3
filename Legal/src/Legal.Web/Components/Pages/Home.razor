@page "/"
@page "/portal"
@inject NavigationManager Navigation
@code{
    protected override void OnInitialized()
    {
        var target = Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        // Root lands on the Clio integration front door; /portal keeps its matters redirect.
        Navigation.NavigateTo(string.IsNullOrEmpty(target) ? "/integrations/clio" : "/legal/matters");
    }
}
