</LegalWorkspace>

@code {
    private bool _loading;
    private bool _saving;
    private string? _loadError;
    private string? _toast;
    private bool _toastError;

    private IReadOnlyList<DecisionDomainPackDto> _packs = [];
    private string? _selectedCode;
    private DecisionDomainPackDto? _selected;

    private string _activeTab = "dimensions";

    private readonly (string Key, string Title, string Singular, string Icon)[] _tabsMeta =
    [
        ("dimensions", "Dimensions", "Dimension", "bi-diagram-2"),
        ("evidencetypes", "Evidence Types", "Evidence Type", "bi-journal-text"),
        ("verificationprofiles", "Verification Profiles", "Verification Profile", "bi-shield-check"),
        ("mattertypes", "Matter Types", "Matter Type", "bi-folder2"),
        ("concepts", "Concepts", "Concept", "bi-lightbulb"),
        ("conceptrelations", "Concept Relations", "Concept Relation", "bi-share"),
        ("outcomecandidates", "Outcome Candidates", "Outcome Candidate", "bi-flag"),
    ];
    private IEnumerable<(string Key, string Title, string Singular, string Icon)> _tabs => _tabsMeta;

    private string CurrentTabSingular => _tabsMeta.First(t => t.Key == _activeTab).Singular;
    private string CurrentTabIcon => _tabsMeta.First(t => t.Key == _activeTab).Icon;

    // Form models
    private readonly PackForm _packForm = new();
    private bool _showPackForm;

    private bool _showRowForm;
    private bool _rowIsEdit;
    private object _rowModel = new DimensionForm();

    private DeletePrompt? _deletePrompt;

    // ── Jurisdiction Rules view (migration 0464; advisory reference catalog) ──
    private string _view = "packs";
    private IReadOnlyList<DecisionJurisdictionRuleDto> _jurisdictionRules = [];
    private bool _jurisdictionsLoaded;
    private readonly JurisdictionForm _jForm = new();
    private bool _showJurisdictionForm;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _packs = (await Api.GetLegalDecisionDomainPacksAsync()).ToList();
            if (_selectedCode is not null)
                _selected = _packs.FirstOrDefault(p => p.PackCode == _selectedCode)
                            ?? await Api.GetLegalDecisionDomainPackAsync(_selectedCode);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load domain packs: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadSelectedAsync()
    {
        if (_selectedCode is null) { _selected = null; return; }
        try { _selected = await Api.GetLegalDecisionDomainPackAsync(_selectedCode); }
        catch (Exception ex) { _loadError = $"Failed to load pack '{_selectedCode}': {ex.Message}"; }
    }

    private async Task OnPackChanged(ChangeEventArgs e)
    {
        _selectedCode = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();
        await ReloadSelectedAsync();
    }

    private void SetTab(string key) => _activeTab = key;

    private int TabCount(string key) => _selected is null ? 0 : key switch
    {
        "dimensions" => _selected.Dimensions.Count,
        "evidencetypes" => _selected.EvidenceTypes.Count,
        "verificationprofiles" => _selected.VerificationProfiles.Count,
        "mattertypes" => _selected.MatterTypes.Count,
        "concepts" => _selected.Concepts.Count,
        "conceptrelations" => _selected.ConceptRelations.Count,
        "outcomecandidates" => _selected.OutcomeCandidates.Count,
        _ => 0,
    };

    private void ShowToast(string message, bool isError)
    {
        _toast = message;
        _toastError = isError;
        _ = Task.Delay(4000).ContinueWith(_ => InvokeAsync(() => { _toast = null; StateHasChanged(); }));
    }

    // ── Jurisdiction Rules view ──
    private static string Truncate(string? value, int max)
        => string.IsNullOrEmpty(value) ? "" : value.Length <= max ? value : value[..max] + "…";

    private async Task SetView(string view)
    {
        _view = view;
        if (view == "jurisdictions" && !_jurisdictionsLoaded)
            await LoadJurisdictionRulesAsync();
    }

    private async Task LoadJurisdictionRulesAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _jurisdictionRules = (await Api.GetLegalDecisionJurisdictionRulesAsync()).ToList();
            _jurisdictionsLoaded = true;
        }
        catch (Exception ex) { _loadError = $"Failed to load jurisdiction rules: {ex.Message}"; }
        finally { _loading = false; }
    }

    private void OpenCreateJurisdiction()
    {
        _jForm.Reset(isEdit: false);
        _showJurisdictionForm = true;
    }

    private void OpenEditJurisdiction(DecisionJurisdictionRuleDto j)
    {
        _jForm.Load(j);
        _showJurisdictionForm = true;
    }

    private async Task SaveJurisdictionAsync()
    {
        _saving = true;
        try
        {
            await Api.SaveLegalDecisionJurisdictionRuleAsync(new SaveDecisionJurisdictionRuleRequest(
                _jForm.JurisdictionCode.Trim(), _jForm.JurisdictionName.Trim(),
                _jForm.PersonalInjuryLimitationYears, _jForm.MedicalMalpracticeLimitationYears, _jForm.WrongfulDeathLimitationYears,
                _jForm.DiscoveryRuleNote, _jForm.MinorsTollingNote, _jForm.NegligenceRegimeCode.Trim(), _jForm.NegligenceRegimeNote,
                _jForm.JointSeveralLiabilityNote, _jForm.DramShopNote, _jForm.GovernmentClaimNoticeNote,
                _jForm.NonEconomicDamagesCapNote, _jForm.PunitiveDamagesStandardNote, _jForm.MedicalMalpracticeNote,
                _jForm.SourceNote, _jForm.EffectiveDate, _jForm.IsAdvisoryOnly, _jForm.SortOrder, _jForm.IsActive));
            _showJurisdictionForm = false;
            await LoadJurisdictionRulesAsync();
            ShowToast("Jurisdiction override saved.", false);
        }
        catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", true); }
        finally { _saving = false; }
    }

    private void AskDeleteJurisdiction(DecisionJurisdictionRuleDto j) => _deletePrompt = new DeletePrompt(
        "Delete Jurisdiction Override",
        $"Delete tenant override for '{j.JurisdictionName}' ({j.JurisdictionCode})? Global default rules cannot be deleted. This action cannot be undone.",
        async () =>
        {
            await Api.DeleteLegalDecisionJurisdictionRuleAsync(j.PracticeAreaCode, j.JurisdictionCode);
            await LoadJurisdictionRulesAsync();
        });

    // ── Pack CRUD ──
    private void OpenCreatePack()
    {
        _packForm.Reset(isEdit: false);
        _showPackForm = true;
    }

    private void OpenEditPack(DecisionDomainPackDto pack)
    {
        _packForm.PackCode = pack.PackCode;
        _packForm.PracticeAreaCode = pack.PracticeAreaCode;
        _packForm.Name = pack.Name;
        _packForm.Description = pack.Description;
        _packForm.SortOrder = 0;
        _packForm.IsActive = true;
        _packForm.IsEdit = true;
        _showPackForm = true;
    }

    private async Task SavePackAsync()
    {
        _saving = true;
        try
        {
            await Api.SaveLegalDecisionDomainPackAsync(new SaveDomainPackRequest(
                _packForm.PackCode.Trim(), _packForm.PracticeAreaCode.Trim(), _packForm.Name.Trim(),
                _packForm.Description, _packForm.SortOrder, _packForm.IsActive));
            _showPackForm = false;
            _selectedCode = _packForm.PackCode.Trim();
            await LoadAsync();
            await ReloadSelectedAsync();
            ShowToast("Domain pack saved.", false);
        }
        catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", true); }
        finally { _saving = false; }
    }

    private void AskDeletePack(DecisionDomainPackDto pack) => _deletePrompt = new DeletePrompt(
        "Delete Domain Pack",
        $"Delete tenant pack '{pack.Name}' ({pack.PackCode})? Global seed packs cannot be deleted. This action cannot be undone.",
        async () =>
        {
            await Api.DeleteLegalDecisionDomainPackAsync(pack.PackCode);
            _selectedCode = null; _selected = null;
            await LoadAsync();
        });

    // ── Row CRUD ──
    private void OpenCreateRow()
    {
        _rowIsEdit = false;
        _rowModel = NewRowModel();
        _showRowForm = true;
    }

    private object NewRowModel() => _activeTab switch
    {
        "dimensions" => new DimensionForm(),
        "evidencetypes" => new EvidenceTypeForm(),
        "verificationprofiles" => new VerificationProfileForm(),
        "mattertypes" => new MatterTypeForm(),
        "concepts" => new ConceptForm(),
        "conceptrelations" => new ConceptRelationForm(),
        "outcomecandidates" => new OutcomeCandidateForm(),
        _ => new DimensionForm(),
    };

    private void OpenRowEdit(object model) { _rowModel = model; _rowIsEdit = true; _showRowForm = true; }

    private void EditDimension(DecisionDomainPackDimensionDto d) => OpenRowEdit(new DimensionForm
    { DimensionCode = d.DimensionCode, Name = d.Name, Description = d.Description, PoloxiImportanceScore = d.PoloxiImportanceScore, IsActive = true });

    private void EditEvidenceType(DecisionDomainPackEvidenceTypeDto ev) => OpenRowEdit(new EvidenceTypeForm
    { EvidenceTypeCode = ev.EvidenceTypeCode, Name = ev.Name, DimensionCode = ev.DimensionCode, Description = ev.Description, PoloxiImportanceScore = ev.PoloxiImportanceScore, IsActive = true });

    private void EditVerificationProfile(DecisionDomainPackVerificationProfileDto vp) => OpenRowEdit(new VerificationProfileForm
    { ProfileCode = vp.ProfileCode, Name = vp.Name, EvidenceTypeCode = vp.EvidenceTypeCode, Description = vp.Description, IsActive = true });

    private void EditMatterType(DecisionDomainPackMatterTypeDto mt) => OpenRowEdit(new MatterTypeForm
    { MatterTypeCode = mt.SubtypeCode, Name = mt.Name, Description = mt.Description, IsActive = true });

    private void EditConcept(DecisionDomainConceptDto c) => OpenRowEdit(new ConceptForm
    {
        ConceptCode = c.ConceptCode, DimensionCode = c.DimensionCode, Name = c.Name, Description = c.Description,
        ConceptKindCode = c.ConceptKindCode, SourceClassCode = c.SourceClassCode, VerificationProfileCode = c.VerificationProfileCode,
        JurisdictionCode = c.JurisdictionCode, MatterTypeCode = c.MatterTypeCode, IsRequiredCoverage = c.IsRequiredCoverage,
        IsFallbackEligible = c.IsFallbackEligible, SortOrder = c.SortOrder, IsActive = true
    });

    private void EditConceptRelation(DecisionDomainConceptRelationDto r) => OpenRowEdit(new ConceptRelationForm
    {
        SourceConceptCode = r.SourceConceptCode, TargetConceptCode = r.TargetConceptCode, RelationTypeCode = r.RelationTypeCode,
        ConstraintCode = r.ConstraintCode, Description = r.Description, JurisdictionCode = r.JurisdictionCode,
        MatterTypeCode = r.MatterTypeCode, IsHardConstraint = r.IsHardConstraint, SortOrder = r.SortOrder, IsActive = true
    });

    private void EditOutcomeCandidate(DecisionDomainPackOutcomeCandidateDto o) => OpenRowEdit(new OutcomeCandidateForm
    {
        OutcomeCode = o.OutcomeCode, Name = o.Name, Description = o.Description, RoleCode = o.RoleCode,
        RequiresVerification = o.RequiresVerification, MatterTypeCode = o.MatterTypeCode, SortOrder = o.SortOrder,
        RequiresFactualPredicate = o.RequiresFactualPredicate, FactualPredicateKeywords = o.FactualPredicateKeywords, ArchetypeCode = o.ArchetypeCode, IsActive = true
    });

    private async Task SaveRowAsync()
    {
        if (_selectedCode is null) return;
        _saving = true;
        try
        {
            switch (_rowModel)
            {
                case DimensionForm f:
                    await Api.SaveLegalDecisionDomainPackDimensionAsync(_selectedCode, new SaveDomainPackDimensionRequest(f.DimensionCode.Trim(), f.Name.Trim(), f.Description, f.SortOrder, f.IsActive, f.PoloxiImportanceScore));
                    break;
                case EvidenceTypeForm f:
                    await Api.SaveLegalDecisionDomainPackEvidenceTypeAsync(_selectedCode, new SaveDomainPackEvidenceTypeRequest(f.EvidenceTypeCode.Trim(), f.Name.Trim(), f.DimensionCode, f.Description, f.SortOrder, f.IsActive, f.PoloxiImportanceScore));
                    break;
                case VerificationProfileForm f:
                    await Api.SaveLegalDecisionDomainPackVerificationProfileAsync(_selectedCode, new SaveDomainPackVerificationProfileRequest(f.ProfileCode.Trim(), f.Name.Trim(), f.EvidenceTypeCode, f.Description, f.SortOrder, f.IsActive));
                    break;
                case MatterTypeForm f:
                    await Api.SaveLegalDecisionDomainPackMatterTypeAsync(_selectedCode, new SaveDomainPackMatterTypeRequest(f.MatterTypeCode.Trim(), f.Name.Trim(), f.Description, f.SortOrder, f.IsActive));
                    break;
                case ConceptForm f:
                    await Api.SaveLegalDecisionDomainPackConceptAsync(_selectedCode, new SaveDomainPackConceptRequest(f.ConceptCode.Trim(), f.DimensionCode.Trim(), f.Name.Trim(), f.Description, f.ConceptKindCode.Trim(), f.SourceClassCode.Trim(), f.VerificationProfileCode, f.JurisdictionCode, f.MatterTypeCode, f.IsRequiredCoverage, f.IsFallbackEligible, f.SortOrder, f.IsActive));
                    break;
                case ConceptRelationForm f:
                    await Api.SaveLegalDecisionDomainPackConceptRelationAsync(_selectedCode, new SaveDomainPackConceptRelationRequest(f.SourceConceptCode.Trim(), f.TargetConceptCode.Trim(), f.RelationTypeCode.Trim(), f.ConstraintCode, f.Description, f.JurisdictionCode, f.MatterTypeCode, f.IsHardConstraint, f.SortOrder, f.IsActive));
                    break;
                case OutcomeCandidateForm f:
                    await Api.SaveLegalDecisionDomainPackOutcomeCandidateAsync(_selectedCode, new SaveDomainPackOutcomeCandidateRequest(f.OutcomeCode.Trim(), f.Name.Trim(), f.Description, f.RoleCode.Trim(), f.RequiresVerification, f.MatterTypeCode, f.SortOrder, f.RequiresFactualPredicate, f.FactualPredicateKeywords, f.IsActive, f.ArchetypeCode));
                    break;
            }
            _showRowForm = false;
            await ReloadSelectedAsync();
            ShowToast($"{CurrentTabSingular} saved.", false);
        }
        catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", true); }
        finally { _saving = false; }
    }

    private void AskDeleteRow(string title, string label, Func<Task> deleteAction) =>
        _deletePrompt = new DeletePrompt($"Delete {title}", $"Delete '{label}'? This action cannot be undone.",
            async () => { await deleteAction(); await ReloadSelectedAsync(); });

    private void AskDeleteDimension(DecisionDomainPackDimensionDto d) =>
        AskDeleteRow("Dimension", d.DimensionCode, () => Api.DeleteLegalDecisionDomainPackDimensionAsync(_selectedCode!, d.DimensionCode));

    private void AskDeleteEvidenceType(DecisionDomainPackEvidenceTypeDto ev) =>
        AskDeleteRow("Evidence Type", ev.EvidenceTypeCode, () => Api.DeleteLegalDecisionDomainPackEvidenceTypeAsync(_selectedCode!, ev.EvidenceTypeCode));

    private void AskDeleteVerificationProfile(DecisionDomainPackVerificationProfileDto vp) =>
        AskDeleteRow("Verification Profile", vp.ProfileCode, () => Api.DeleteLegalDecisionDomainPackVerificationProfileAsync(_selectedCode!, vp.ProfileCode));

    private void AskDeleteMatterType(DecisionDomainPackMatterTypeDto mt) =>
        AskDeleteRow("Matter Type", mt.SubtypeCode, () => Api.DeleteLegalDecisionDomainPackMatterTypeAsync(_selectedCode!, mt.SubtypeCode));

    private void AskDeleteConcept(DecisionDomainConceptDto c) =>
        AskDeleteRow("Concept", c.ConceptCode, () => Api.DeleteLegalDecisionDomainPackConceptAsync(_selectedCode!, c.ConceptCode));

    private void AskDeleteConceptRelation(DecisionDomainConceptRelationDto r) =>
        AskDeleteRow("Concept Relation", $"{r.SourceConceptCode} → {r.TargetConceptCode}", () => Api.DeleteLegalDecisionDomainPackConceptRelationAsync(_selectedCode!, r.SourceConceptCode, r.TargetConceptCode, r.RelationTypeCode));

    private void AskDeleteOutcomeCandidate(DecisionDomainPackOutcomeCandidateDto o) =>
        AskDeleteRow("Outcome Candidate", o.OutcomeCode, () => Api.DeleteLegalDecisionDomainPackOutcomeCandidateAsync(_selectedCode!, o.OutcomeCode));

    private async Task ConfirmDeleteAsync()
    {
        if (_deletePrompt is null) return;
        _saving = true;
        try
        {
            await _deletePrompt.Action();
            _deletePrompt = null;
            ShowToast("Deleted.", false);
        }
        catch (Exception ex) { ShowToast($"Delete failed: {ex.Message}", true); }
        finally { _saving = false; }
    }

    private sealed record DeletePrompt(string Title, string Message, Func<Task> Action);

    // ── Form model classes with validation ──
    private sealed class PackForm
    {
        public bool IsEdit { get; set; }
        [Required, StringLength(60)] public string PackCode { get; set; } = "";
        [Required, StringLength(60)] public string PracticeAreaCode { get; set; } = "";
        [Required, StringLength(200)] public string Name { get; set; } = "";
        [StringLength(2000)] public string? Description { get; set; }
        [Range(0, 100000)] public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
        public void Reset(bool isEdit) { IsEdit = isEdit; PackCode = ""; PracticeAreaCode = ""; Name = ""; Description = null; SortOrder = 0; IsActive = true; }
    }

    private sealed class JurisdictionForm
    {
        public bool IsEdit { get; set; }
        [Required, StringLength(10)] public string JurisdictionCode { get; set; } = "";
        [Required, StringLength(120)] public string JurisdictionName { get; set; } = "";
        [Range(0, 100)] public decimal? PersonalInjuryLimitationYears { get; set; }
        [Range(0, 100)] public decimal? MedicalMalpracticeLimitationYears { get; set; }
        [Range(0, 100)] public decimal? WrongfulDeathLimitationYears { get; set; }
        [StringLength(600)] public string? DiscoveryRuleNote { get; set; }
        [StringLength(600)] public string? MinorsTollingNote { get; set; }
        [Required, StringLength(40)] public string NegligenceRegimeCode { get; set; } = "MODIFIED_51";
        [StringLength(600)] public string? NegligenceRegimeNote { get; set; }
        [StringLength(600)] public string? JointSeveralLiabilityNote { get; set; }
        [StringLength(600)] public string? DramShopNote { get; set; }
        [StringLength(600)] public string? GovernmentClaimNoticeNote { get; set; }
        [StringLength(800)] public string? NonEconomicDamagesCapNote { get; set; }
        [StringLength(800)] public string? PunitiveDamagesStandardNote { get; set; }
        [StringLength(800)] public string? MedicalMalpracticeNote { get; set; }
