@page "/admin/domainpacks"
@using System.ComponentModel.DataAnnotations
@using Legal.Application.Features.Intelligence.Decision
@inject ApiClient Api

<LegalWorkspace>
<div class="intel-page">
    <header class="intel-header">
        <div>
            <span>Administration · Domain Packs</span>
            <h1>Domain Pack Management</h1>
            <p>Manage practice-area Domain Packs and their domain semantics — dimensions, evidence types, verification profiles, matter types, concepts, concept relations, and outcome candidates. Edits are tenant-scoped; global seed packs stay read-only.</p>
        </div>
        <div class="um-header-actions">
            @if (_view == "packs")
            {
                <button class="um-btn um-btn-primary" @onclick="OpenCreatePack"><i class="bi bi-box-seam"></i> Add pack</button>
                <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
            }
            else
            {
                <button class="um-btn um-btn-primary" @onclick="OpenCreateJurisdiction"><i class="bi bi-geo-alt"></i> Add jurisdiction override</button>
                <button class="um-btn um-btn-ghost" @onclick="LoadJurisdictionRulesAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
            }
        </div>
    </header>

    <nav class="intel-kpis" style="margin-bottom:1rem;">
        <article class="intel-kpi-link @(_view == "packs" ? "intel-kpi-active" : null)" role="button" tabindex="0"
                 title="Domain Packs" @onclick="@(() => SetView("packs"))">
            <span>Domain Packs</span><strong>@_packs.Count</strong>
        </article>
        <article class="intel-kpi-link @(_view == "jurisdictions" ? "intel-kpi-active" : null)" role="button" tabindex="0"
                 title="Personal Injury Jurisdiction Rules" @onclick="@(() => SetView("jurisdictions"))">
            <span>Jurisdiction Rules</span><strong>@_jurisdictionRules.Count</strong>
        </article>
    </nav>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
    }

    @if (_loading)
    {
        <div class="intel-state">Loading…</div>
    }
    else if (_view == "jurisdictions")
    {
        <section class="intel-panel">
            <p class="intel-note">Commonly-cited, DB-backed personal-injury rules per US state and DC — statute of limitations, comparative-fault regime, damages caps, and more. Rows are <strong>advisory only</strong> and not legal advice; verify independently. Global defaults are read-only; use <em>Add jurisdiction override</em> to create a tenant-specific override.</p>
            <table class="um-table">
                <thead><tr><th>Jurisdiction</th><th>PI SOL</th><th>MedMal SOL</th><th>WD SOL</th><th>Fault Regime</th><th>Non-Econ Cap</th><th>Scope</th><th></th></tr></thead>
                <tbody>
                    @foreach (var j in _jurisdictionRules)
                    {
                        <tr class="um-row-clickable" @onclick="() => OpenEditJurisdiction(j)">
                            <td>@j.JurisdictionName (@j.JurisdictionCode)</td>
                            <td>@(j.PersonalInjuryLimitationYears?.ToString("0.#") ?? "—")</td>
                            <td>@(j.MedicalMalpracticeLimitationYears?.ToString("0.#") ?? "—")</td>
                            <td>@(j.WrongfulDeathLimitationYears?.ToString("0.#") ?? "—")</td>
                            <td>@j.NegligenceRegimeCode</td>
                            <td title="@j.NonEconomicDamagesCapNote">@(string.IsNullOrWhiteSpace(j.NonEconomicDamagesCapNote) ? "—" : Truncate(j.NonEconomicDamagesCapNote, 40))</td>
                            <td>@(j.IsTenantOverride ? "Tenant override" : "Global default")</td>
                            <td>
                                @if (j.IsTenantOverride)
                                {
                                    <button class="um-btn um-btn-ghost um-btn-sm" title="Delete override" @onclick="() => AskDeleteJurisdiction(j)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
    else
    {
        <section class="intel-panel">
            <div class="um-form-grid">
                <label>Domain Pack
                    <select class="um-input" @onchange="OnPackChanged">
                        <option value="">Select a pack…</option>
                        @foreach (var p in _packs)
                        {
                            <option value="@p.PackCode" selected="@(p.PackCode == _selectedCode)">@p.Name (@p.PackCode) · @p.PracticeAreaCode</option>
                        }
                    </select>
                </label>
                @if (_selected is not null)
                {
                    <div class="um-inline">
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditPack(_selected)"><i class="bi bi-pencil"></i> Edit pack</button>
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => AskDeletePack(_selected)"><i class="bi bi-trash"></i> Delete pack</button>
                    </div>
                }
            </div>
        </section>

        @if (_selected is not null)
        {
            <section class="intel-kpis">
                @foreach (var t in _tabs)
                {
                    <article class="intel-kpi-link @(_activeTab == t.Key ? "intel-kpi-active" : null)" role="button" tabindex="0"
                             title="@t.Title" @onclick="() => SetTab(t.Key)">
                        <span>@t.Title</span><strong>@TabCount(t.Key)</strong>
                    </article>
                }
            </section>

            <section class="intel-panel">
                <div class="um-header-actions" style="margin-bottom:.75rem;">
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreateRow"><i class="bi bi-plus-lg"></i> Add @CurrentTabSingular</button>
                </div>

                @if (_activeTab == "dimensions")
                {
                    <table class="um-table">
                        <thead><tr><th>Code</th><th>Name</th><th>Description</th><th>Importance</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var d in _selected.Dimensions)
                            {
                                <tr class="um-row-clickable" @onclick="() => EditDimension(d)">
                                    <td>@d.DimensionCode</td><td>@d.Name</td><td>@d.Description</td>
                                    <td>@(d.PoloxiImportanceScore?.ToString("0.00") ?? "—")</td>
                                    <td><button class="um-btn um-btn-ghost um-btn-sm" title="Delete" @onclick="() => AskDeleteDimension(d)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_activeTab == "evidencetypes")
                {
                    <table class="um-table">
                        <thead><tr><th>Code</th><th>Name</th><th>Dimension</th><th>Description</th><th>Importance</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var ev in _selected.EvidenceTypes)
                            {
                                <tr class="um-row-clickable" @onclick="() => EditEvidenceType(ev)">
                                    <td>@ev.EvidenceTypeCode</td><td>@ev.Name</td><td>@ev.DimensionCode</td><td>@ev.Description</td>
                                    <td>@(ev.PoloxiImportanceScore?.ToString("0.00") ?? "—")</td>
                                    <td><button class="um-btn um-btn-ghost um-btn-sm" title="Delete" @onclick="() => AskDeleteEvidenceType(ev)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_activeTab == "verificationprofiles")
                {
                    <table class="um-table">
                        <thead><tr><th>Code</th><th>Name</th><th>Evidence Type</th><th>Description</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var vp in _selected.VerificationProfiles)
                            {
                                <tr class="um-row-clickable" @onclick="() => EditVerificationProfile(vp)">
                                    <td>@vp.ProfileCode</td><td>@vp.Name</td><td>@vp.EvidenceTypeCode</td><td>@vp.Description</td>
                                    <td><button class="um-btn um-btn-ghost um-btn-sm" title="Delete" @onclick="() => AskDeleteVerificationProfile(vp)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_activeTab == "mattertypes")
                {
                    <table class="um-table">
                        <thead><tr><th>Code</th><th>Name</th><th>Description</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var mt in _selected.MatterTypes)
                            {
                                <tr class="um-row-clickable" @onclick="() => EditMatterType(mt)">
                                    <td>@mt.SubtypeCode</td><td>@mt.Name</td><td>@mt.Description</td>
                                    <td><button class="um-btn um-btn-ghost um-btn-sm" title="Delete" @onclick="() => AskDeleteMatterType(mt)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_activeTab == "concepts")
                {
                    <table class="um-table">
                        <thead><tr><th>Code</th><th>Dimension</th><th>Name</th><th>Kind</th><th>Source</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in _selected.Concepts)
                            {
                                <tr class="um-row-clickable" @onclick="() => EditConcept(c)">
                                    <td>@c.ConceptCode</td><td>@c.DimensionCode</td><td>@c.Name</td><td>@c.ConceptKindCode</td><td>@c.SourceClassCode</td>
                                    <td><button class="um-btn um-btn-ghost um-btn-sm" title="Delete" @onclick="() => AskDeleteConcept(c)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_activeTab == "conceptrelations")
                {
                    <table class="um-table">
                        <thead><tr><th>Source</th><th>Target</th><th>Relation</th><th>Constraint</th><th>Hard</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in _selected.ConceptRelations)
                            {
                                <tr class="um-row-clickable" @onclick="() => EditConceptRelation(r)">
                                    <td>@r.SourceConceptCode</td><td>@r.TargetConceptCode</td><td>@r.RelationTypeCode</td><td>@r.ConstraintCode</td><td>@(r.IsHardConstraint ? "Yes" : "No")</td>
                                    <td><button class="um-btn um-btn-ghost um-btn-sm" title="Delete" @onclick="() => AskDeleteConceptRelation(r)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_activeTab == "outcomecandidates")
                {
                    <table class="um-table">
                        <thead><tr><th>Code</th><th>Name</th><th>Role</th><th>Verify</th><th>Matter Type</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var o in _selected.OutcomeCandidates)
                            {
                                <tr class="um-row-clickable" @onclick="() => EditOutcomeCandidate(o)">
                                    <td>@o.OutcomeCode</td><td>@o.Name</td><td>@o.RoleCode</td><td>@(o.RequiresVerification ? "Yes" : "No")</td><td>@o.MatterTypeCode</td>
                                    <td><button class="um-btn um-btn-ghost um-btn-sm" title="Delete" @onclick="() => AskDeleteOutcomeCandidate(o)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
    }
</div>

@* ── Pack create/edit modal ── *@
@if (_showPackForm)
{
    <div class="um-modal-backdrop">
        <EditForm Model="_packForm" OnValidSubmit="SavePackAsync" class="um-modal">
            <DataAnnotationsValidator />
            <div class="um-modal-header">
                <i class="bi bi-box-seam"></i>
                <span>@(_packForm.IsEdit ? "Edit Domain Pack" : "Add Domain Pack")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showPackForm = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body"><div class="um-form-grid">
                <label>Pack Code
                    <InputText @bind-Value="_packForm.PackCode" class="um-input" disabled="@_packForm.IsEdit" />
                    <ValidationMessage For="() => _packForm.PackCode" class="text-danger" />
                </label>
                <label>Practice Area Code
                    <InputText @bind-Value="_packForm.PracticeAreaCode" class="um-input" />
                    <ValidationMessage For="() => _packForm.PracticeAreaCode" class="text-danger" />
                </label>
                <label>Name
                    <InputText @bind-Value="_packForm.Name" class="um-input" />
                    <ValidationMessage For="() => _packForm.Name" class="text-danger" />
                </label>
                <label>Description
                    <InputTextArea @bind-Value="_packForm.Description" class="um-input" />
                    <ValidationMessage For="() => _packForm.Description" class="text-danger" />
                </label>
                <label>Sort Order
                    <InputNumber @bind-Value="_packForm.SortOrder" class="um-input" />
                    <ValidationMessage For="() => _packForm.SortOrder" class="text-danger" />
                </label>
                <label class="um-check"><InputCheckbox @bind-Value="_packForm.IsActive" /> Active</label>
            </div></div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showPackForm = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
            </div>
        </EditForm>
    </div>
}

@* ── Child row create/edit modal ── *@
@if (_showRowForm)
{
    <div class="um-modal-backdrop">
        <EditForm Model="_rowModel" OnValidSubmit="SaveRowAsync" class="um-modal">
            <DataAnnotationsValidator />
            <div class="um-modal-header">
                <i class="bi @CurrentTabIcon"></i>
                <span>@(_rowIsEdit ? "Edit" : "Add") @CurrentTabSingular</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showRowForm = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body"><div class="um-form-grid">
                @if (_rowModel is DimensionForm df)
                {
                    <label>Dimension Code<InputText @bind-Value="df.DimensionCode" class="um-input" disabled="@_rowIsEdit" /><ValidationMessage For="() => df.DimensionCode" class="text-danger" /></label>
                    <label>Name<InputText @bind-Value="df.Name" class="um-input" /><ValidationMessage For="() => df.Name" class="text-danger" /></label>
                    <label>Description<InputTextArea @bind-Value="df.Description" class="um-input" /><ValidationMessage For="() => df.Description" class="text-danger" /></label>
                    <label>Sort Order<InputNumber @bind-Value="df.SortOrder" class="um-input" /><ValidationMessage For="() => df.SortOrder" class="text-danger" /></label>
                    <label>POLOXI Importance (0.00–1.00)<InputNumber @bind-Value="df.PoloxiImportanceScore" step="0.01" class="um-input" /><ValidationMessage For="() => df.PoloxiImportanceScore" class="text-danger" /></label>
                    <label class="um-check"><InputCheckbox @bind-Value="df.IsActive" /> Active</label>
                }
                else if (_rowModel is EvidenceTypeForm ef)
                {
                    <label>Evidence Type Code<InputText @bind-Value="ef.EvidenceTypeCode" class="um-input" disabled="@_rowIsEdit" /><ValidationMessage For="() => ef.EvidenceTypeCode" class="text-danger" /></label>
                    <label>Name<InputText @bind-Value="ef.Name" class="um-input" /><ValidationMessage For="() => ef.Name" class="text-danger" /></label>
                    <label>Dimension Code
                        <InputSelect @bind-Value="ef.DimensionCode" class="um-input">
                            <option value="">— none —</option>
                            @foreach (var d in _selected!.Dimensions) { <option value="@d.DimensionCode">@d.Name (@d.DimensionCode)</option> }
                        </InputSelect>
                        <ValidationMessage For="() => ef.DimensionCode" class="text-danger" />
                    </label>
                    <label>Description<InputTextArea @bind-Value="ef.Description" class="um-input" /><ValidationMessage For="() => ef.Description" class="text-danger" /></label>
                    <label>Sort Order<InputNumber @bind-Value="ef.SortOrder" class="um-input" /><ValidationMessage For="() => ef.SortOrder" class="text-danger" /></label>
                    <label>POLOXI Importance (0.00–1.00)<InputNumber @bind-Value="ef.PoloxiImportanceScore" step="0.01" class="um-input" /><ValidationMessage For="() => ef.PoloxiImportanceScore" class="text-danger" /></label>
                    <label class="um-check"><InputCheckbox @bind-Value="ef.IsActive" /> Active</label>
                }
                else if (_rowModel is VerificationProfileForm vf)
                {
                    <label>Profile Code<InputText @bind-Value="vf.ProfileCode" class="um-input" disabled="@_rowIsEdit" /><ValidationMessage For="() => vf.ProfileCode" class="text-danger" /></label>
                    <label>Name<InputText @bind-Value="vf.Name" class="um-input" /><ValidationMessage For="() => vf.Name" class="text-danger" /></label>
                    <label>Evidence Type Code
                        <InputSelect @bind-Value="vf.EvidenceTypeCode" class="um-input">
                            <option value="">— none —</option>
                            @foreach (var ev in _selected!.EvidenceTypes) { <option value="@ev.EvidenceTypeCode">@ev.Name (@ev.EvidenceTypeCode)</option> }
                        </InputSelect>
                        <ValidationMessage For="() => vf.EvidenceTypeCode" class="text-danger" />
                    </label>
                    <label>Description<InputTextArea @bind-Value="vf.Description" class="um-input" /><ValidationMessage For="() => vf.Description" class="text-danger" /></label>
                    <label>Sort Order<InputNumber @bind-Value="vf.SortOrder" class="um-input" /><ValidationMessage For="() => vf.SortOrder" class="text-danger" /></label>
                    <label class="um-check"><InputCheckbox @bind-Value="vf.IsActive" /> Active</label>
                }
                else if (_rowModel is MatterTypeForm mf)
                {
                    <label>Matter Type Code<InputText @bind-Value="mf.MatterTypeCode" class="um-input" disabled="@_rowIsEdit" /><ValidationMessage For="() => mf.MatterTypeCode" class="text-danger" /></label>
                    <label>Name<InputText @bind-Value="mf.Name" class="um-input" /><ValidationMessage For="() => mf.Name" class="text-danger" /></label>
                    <label>Description<InputTextArea @bind-Value="mf.Description" class="um-input" /><ValidationMessage For="() => mf.Description" class="text-danger" /></label>
                    <label>Sort Order<InputNumber @bind-Value="mf.SortOrder" class="um-input" /><ValidationMessage For="() => mf.SortOrder" class="text-danger" /></label>
                    <label class="um-check"><InputCheckbox @bind-Value="mf.IsActive" /> Active</label>
                }
                else if (_rowModel is ConceptForm cf)
                {
                    <label>Concept Code<InputText @bind-Value="cf.ConceptCode" class="um-input" disabled="@_rowIsEdit" /><ValidationMessage For="() => cf.ConceptCode" class="text-danger" /></label>
                    <label>Dimension Code
                        <InputSelect @bind-Value="cf.DimensionCode" class="um-input">
                            <option value="">Select…</option>
                            @foreach (var d in _selected!.Dimensions) { <option value="@d.DimensionCode">@d.Name (@d.DimensionCode)</option> }
                        </InputSelect>
                        <ValidationMessage For="() => cf.DimensionCode" class="text-danger" />
                    </label>
                    <label>Name<InputText @bind-Value="cf.Name" class="um-input" /><ValidationMessage For="() => cf.Name" class="text-danger" /></label>
                    <label>Description<InputTextArea @bind-Value="cf.Description" class="um-input" /><ValidationMessage For="() => cf.Description" class="text-danger" /></label>
                    <label>Concept Kind Code<InputText @bind-Value="cf.ConceptKindCode" class="um-input" /><ValidationMessage For="() => cf.ConceptKindCode" class="text-danger" /></label>
                    <label>Source Class Code<InputText @bind-Value="cf.SourceClassCode" class="um-input" /><ValidationMessage For="() => cf.SourceClassCode" class="text-danger" /></label>
                    <label>Verification Profile Code
                        <InputSelect @bind-Value="cf.VerificationProfileCode" class="um-input">
                            <option value="">— none —</option>
                            @foreach (var vp in _selected!.VerificationProfiles) { <option value="@vp.ProfileCode">@vp.Name (@vp.ProfileCode)</option> }
                        </InputSelect>
                        <ValidationMessage For="() => cf.VerificationProfileCode" class="text-danger" />
                    </label>
                    <label>Jurisdiction Code<InputText @bind-Value="cf.JurisdictionCode" class="um-input" /><ValidationMessage For="() => cf.JurisdictionCode" class="text-danger" /></label>
                    <label>Matter Type Code
                        <InputSelect @bind-Value="cf.MatterTypeCode" class="um-input">
                            <option value="">— none —</option>
                            @foreach (var mt in _selected!.MatterTypes) { <option value="@mt.SubtypeCode">@mt.Name (@mt.SubtypeCode)</option> }
                        </InputSelect>
                        <ValidationMessage For="() => cf.MatterTypeCode" class="text-danger" />
                    </label>
                    <label class="um-check"><InputCheckbox @bind-Value="cf.IsRequiredCoverage" /> Required coverage</label>
                    <label class="um-check"><InputCheckbox @bind-Value="cf.IsFallbackEligible" /> Fallback eligible</label>
                    <label>Sort Order<InputNumber @bind-Value="cf.SortOrder" class="um-input" /><ValidationMessage For="() => cf.SortOrder" class="text-danger" /></label>
                    <label class="um-check"><InputCheckbox @bind-Value="cf.IsActive" /> Active</label>
                }
                else if (_rowModel is ConceptRelationForm rf)
                {
                    <label>Source Concept Code
                        <InputSelect @bind-Value="rf.SourceConceptCode" class="um-input">
                            <option value="">Select…</option>
                            @foreach (var c in _selected!.Concepts) { <option value="@c.ConceptCode">@c.Name (@c.ConceptCode)</option> }
                        </InputSelect>
                        <ValidationMessage For="() => rf.SourceConceptCode" class="text-danger" />
                    </label>
                    <label>Target Concept Code
                        <InputSelect @bind-Value="rf.TargetConceptCode" class="um-input">
                            <option value="">Select…</option>
                            @foreach (var c in _selected!.Concepts) { <option value="@c.ConceptCode">@c.Name (@c.ConceptCode)</option> }
                        </InputSelect>
                        <ValidationMessage For="() => rf.TargetConceptCode" class="text-danger" />
                    </label>
                    <label>Relation Type Code<InputText @bind-Value="rf.RelationTypeCode" class="um-input" /><ValidationMessage For="() => rf.RelationTypeCode" class="text-danger" /></label>
                    <label>Constraint Code<InputText @bind-Value="rf.ConstraintCode" class="um-input" /><ValidationMessage For="() => rf.ConstraintCode" class="text-danger" /></label>
                    <label>Description<InputTextArea @bind-Value="rf.Description" class="um-input" /><ValidationMessage For="() => rf.Description" class="text-danger" /></label>
                    <label>Jurisdiction Code<InputText @bind-Value="rf.JurisdictionCode" class="um-input" /><ValidationMessage For="() => rf.JurisdictionCode" class="text-danger" /></label>
                    <label>Matter Type Code<InputText @bind-Value="rf.MatterTypeCode" class="um-input" /><ValidationMessage For="() => rf.MatterTypeCode" class="text-danger" /></label>
                    <label class="um-check"><InputCheckbox @bind-Value="rf.IsHardConstraint" /> Hard constraint</label>
                    <label>Sort Order<InputNumber @bind-Value="rf.SortOrder" class="um-input" /><ValidationMessage For="() => rf.SortOrder" class="text-danger" /></label>
                    <label class="um-check"><InputCheckbox @bind-Value="rf.IsActive" /> Active</label>
                }
                else if (_rowModel is OutcomeCandidateForm of)
                {
                    <label>Outcome Code<InputText @bind-Value="of.OutcomeCode" class="um-input" disabled="@_rowIsEdit" /><ValidationMessage For="() => of.OutcomeCode" class="text-danger" /></label>
                    <label>Name<InputText @bind-Value="of.Name" class="um-input" /><ValidationMessage For="() => of.Name" class="text-danger" /></label>
                    <label>Description<InputTextArea @bind-Value="of.Description" class="um-input" /><ValidationMessage For="() => of.Description" class="text-danger" /></label>
                    <label>Role Code
                        <InputSelect @bind-Value="of.RoleCode" class="um-input">
                            <option value="PATHWAY">PATHWAY</option>
                            <option value="ASSERTED_HISTORICAL">ASSERTED_HISTORICAL</option>
                        </InputSelect>
                        <ValidationMessage For="() => of.RoleCode" class="text-danger" />
                    </label>
                    <label class="um-check"><InputCheckbox @bind-Value="of.RequiresVerification" /> Requires verification</label>
                    <label>Matter Type Code
                        <InputSelect @bind-Value="of.MatterTypeCode" class="um-input">
                            <option value="">— none —</option>
                            @foreach (var mt in _selected!.MatterTypes) { <option value="@mt.SubtypeCode">@mt.Name (@mt.SubtypeCode)</option> }
                        </InputSelect>
                        <ValidationMessage For="() => of.MatterTypeCode" class="text-danger" />
                    </label>
                    <label class="um-check"><InputCheckbox @bind-Value="of.RequiresFactualPredicate" /> Requires factual predicate</label>
                    <label>Factual Predicate Keywords<InputTextArea @bind-Value="of.FactualPredicateKeywords" class="um-input" /><ValidationMessage For="() => of.FactualPredicateKeywords" class="text-danger" /></label>
                    <label>Disposition Archetype
                        <InputSelect @bind-Value="of.ArchetypeCode" class="um-input">
                            <option value="">— none (keyword fallback) —</option>
                            <option value="PLAINTIFF_MERITS">PLAINTIFF_MERITS (conjunctive — all elements required)</option>
                            <option value="DEFENSE_MERITS">DEFENSE_MERITS (disjunctive — any element failure wins)</option>
                            <option value="SETTLEMENT">SETTLEMENT (tension — peaks on mixed elements)</option>
                            <option value="NEUTRAL">NEUTRAL (membership-weighted average)</option>
                        </InputSelect>
                        <ValidationMessage For="() => of.ArchetypeCode" class="text-danger" />
                    </label>
                    <label>Sort Order<InputNumber @bind-Value="of.SortOrder" class="um-input" /><ValidationMessage For="() => of.SortOrder" class="text-danger" /></label>
                    <label class="um-check"><InputCheckbox @bind-Value="of.IsActive" /> Active</label>
