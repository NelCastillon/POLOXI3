@page "/legal/matters"
@using System.ComponentModel.DataAnnotations
@using Legal.Application.Features.Intelligence.Decision
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Navigation

<LegalWorkspace>
    <div class="matters-page">
        <header class="matters-hero">
            <div class="matters-hero-icon"><i class="bi bi-folder2-open"></i></div>
            <div class="matters-hero-copy">
                <span>POLOXI Legal Decision Intelligence — matter command center</span>
                <h1>Matters</h1>
                <p>Every matter groups the decisions POLOXI has reasoned about — the current best outcome, its readiness, and what could still change it. Open a matter to see its decision cockpit, or start a new decision.</p>
            </div>
            <div class="matters-hero-actions">
                <button class="um-btn um-btn-light um-btn-sm" @onclick="LoadAsync" disabled="@_loading" title="Refresh">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
                <button class="um-btn um-btn-primary" @onclick="OpenCreate">
                    <i class="bi bi-plus-lg"></i> New matter
                </button>
            </div>
        </header>

        <section class="matters-toolbar" aria-label="Filter matters">
            <div class="matters-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input class="matters-search-input" placeholder="Search matters by title, type, jurisdiction, or posture" @bind="_search" @bind:event="oninput" />
            </div>
        </section>

        <section class="pc-kpi-strip" aria-label="Matter summary">
            <button type="button" class="pc-kpi-card @(_activeFilter == "ALL" ? "pc-kpi-card--active" : null)" @onclick='() => SetFilter("ALL")' title="All matters">
                <span class="pc-kpi-label">All matters</span>
                <span class="pc-kpi-value">@_matters.Count</span>
            </button>
            <button type="button" class="pc-kpi-card @(_activeFilter == "OPEN" ? "pc-kpi-card--active" : null)" @onclick='() => SetFilter("OPEN")' title="Open matters">
                <span class="pc-kpi-label">Open</span>
                <span class="pc-kpi-value">@_matters.Count(m => string.Equals(m.StatusCode, "OPEN", StringComparison.OrdinalIgnoreCase))</span>
            </button>
            <button type="button" class="pc-kpi-card @(_activeFilter == "DECIDED" ? "pc-kpi-card--active" : null)" @onclick='() => SetFilter("DECIDED")' title="Matters with a decision on record">
                <span class="pc-kpi-label">Decided</span>
                <span class="pc-kpi-value">@_matters.Count(m => m.LatestSessionId is not null)</span>
            </button>
            <button type="button" class="pc-kpi-card pc-kpi-card--danger @(_activeFilter == "ATRISK" ? "pc-kpi-card--active" : null)" @onclick='() => SetFilter("ATRISK")' title="Matters with critical flip points that could overturn the current outcome">
                <span class="pc-kpi-label">At risk</span>
                <span class="pc-kpi-value">@_matters.Count(m => m.CriticalFlipPointCount > 0)</span>
            </button>
        </section>

        @if (_loadError is not null)
        {
            <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
        }

        @if (_loading)
        {
            <div class="matters-loading" role="status" aria-live="polite">
                <i class="bi bi-hourglass-split"></i> Loading matters…
            </div>
        }
        else if (Filtered.Count == 0)
        {
            <div class="matters-empty">
                <i class="bi bi-inboxes"></i>
                <h3>No matters yet</h3>
                <p>Create a matter to start grouping decisions, or run an ad-hoc decision from the cockpit.</p>
                <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New matter</button>
            </div>
        }
        else
        {
            <div class="matters-grid">
                @foreach (var m in Filtered)
                {
                    <article class="matter-card" role="button" tabindex="0"
                             @onclick="() => OpenMatter(m)"
                             @onkeydown="@(e => OnCardKey(e, m))">
                        <header class="matter-card-head">
                            <span class="matter-card-status matter-status-@(m.StatusCode.ToLowerInvariant())">@m.StatusCode</span>
                            @if (m.CriticalFlipPointCount > 0)
                            {
                                <span class="matter-card-risk" title="@m.CriticalFlipPointCount critical flip point(s) could overturn the current outcome">
                                    <i class="bi bi-exclamation-octagon-fill"></i> @m.CriticalFlipPointCount at risk
                                </span>
                            }
                        </header>
                        <h2 class="matter-card-title">@m.Title</h2>
                        <div class="matter-card-tags">
                            @if (!string.IsNullOrWhiteSpace(m.MatterTypeCode))
                            {
                                <span class="matter-tag"><i class="bi bi-tag"></i> @m.MatterTypeCode</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.Jurisdiction))
                            {
                                <span class="matter-tag"><i class="bi bi-geo-alt"></i> @m.Jurisdiction</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.Posture))
                            {
                                <span class="matter-tag"><i class="bi bi-diagram-2"></i> @m.Posture</span>
                            }
                        </div>
                        <div class="matter-card-decision">
                            @if (m.LatestSessionId is not null)
                            {
                                <span class="matter-card-decision-label">Current best decision</span>
                                <strong class="matter-card-outcome">@(string.IsNullOrWhiteSpace(m.CurrentOutcome) ? "—" : m.CurrentOutcome)</strong>
                                @if (!string.IsNullOrWhiteSpace(m.DecisionStatusCode))
                                {
                                    <span class="matter-card-decision-status">@m.DecisionStatusCode</span>
                                }
                            }
                            else
                            {
                                <span class="matter-card-decision-label matter-card-nodecision"><i class="bi bi-hourglass"></i> No decision yet</span>
                            }
                        </div>
                        <footer class="matter-card-foot">
                            <span title="Last decided"><i class="bi bi-clock-history"></i> @(m.LastDecidedUtc?.ToLocalTime().ToString("g") ?? "Never")</span>
                            <span class="matter-card-open">Open <i class="bi bi-arrow-right-short"></i></span>
                        </footer>
                    </article>
                }
            </div>
        }
    </div>

    @if (_showCreate)
    {
        <div class="um-modal-backdrop" @onclick="() => _showCreate = false">
            <div class="um-modal" @onclick:stopPropagation="true">
                <div class="um-modal-header">
                    <i class="bi bi-folder-plus"></i>
                    <span>New matter</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showCreate = false"><i class="bi bi-x-lg"></i></button>
                </div>
                <EditForm Model="_form" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator />
                    <div class="um-modal-body">
                        <div class="um-form-grid">
                            <label class="um-field">
                                <span class="um-field-label">Title</span>
                                <InputText class="form-control" @bind-Value="_form.Title" placeholder="e.g. Acme v. Globex — Summary Judgment" />
                                <ValidationMessage For="() => _form.Title" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Matter type</span>
                                <InputText class="form-control" list="matter-type-options" @bind-Value="_form.MatterTypeCode" placeholder="Select or type a matter type" autocomplete="off" />
                                <datalist id="matter-type-options">
                                    @foreach (var v in _facets.MatterTypeCodes)
                                    {
                                        <option value="@v" />
                                    }
                                </datalist>
                                <ValidationMessage For="() => _form.MatterTypeCode" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Jurisdiction</span>
                                <InputText class="form-control" list="matter-jurisdiction-options" @bind-Value="_form.Jurisdiction" placeholder="Select or type a jurisdiction" autocomplete="off" />
                                <datalist id="matter-jurisdiction-options">
                                    @foreach (var v in _facets.Jurisdictions)
                                    {
                                        <option value="@v" />
                                    }
                                </datalist>
                                <ValidationMessage For="() => _form.Jurisdiction" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Posture</span>
                                <InputText class="form-control" list="matter-posture-options" @bind-Value="_form.Posture" placeholder="Select or type a posture" autocomplete="off" />
                                <datalist id="matter-posture-options">
                                    @foreach (var v in _facets.Postures)
                                    {
                                        <option value="@v" />
                                    }
                                </datalist>
                                <ValidationMessage For="() => _form.Posture" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Subtype</span>
                                <InputText class="form-control" list="matter-subtype-options" @bind-Value="_form.Subtype" placeholder="Select or type a subtype" autocomplete="off" />
                                <datalist id="matter-subtype-options">
                                    @foreach (var v in _facets.Subtypes)
                                    {
                                        <option value="@v" />
                                    }
                                </datalist>
                                <ValidationMessage For="() => _form.Subtype" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Court system</span>
                                <InputText class="form-control" list="matter-courtsystem-options" @bind-Value="_form.CourtSystem" placeholder="Select or type a court system" autocomplete="off" />
                                <datalist id="matter-courtsystem-options">
                                    @foreach (var v in _facets.CourtSystems)
                                    {
                                        <option value="@v" />
                                    }
                                </datalist>
                                <ValidationMessage For="() => _form.CourtSystem" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">State</span>
                                <InputText class="form-control" list="matter-state-options" @bind-Value="_form.State" placeholder="Select or type a state" autocomplete="off" />
                                <datalist id="matter-state-options">
                                    @foreach (var v in _facets.States)
                                    {
                                        <option value="@v" />
                                    }
                                </datalist>
                                <ValidationMessage For="() => _form.State" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Court level</span>
                                <InputText class="form-control" list="matter-courtlevel-options" @bind-Value="_form.CourtLevel" placeholder="Select or type a court level" autocomplete="off" />
                                <datalist id="matter-courtlevel-options">
                                    @foreach (var v in _facets.CourtLevels)
                                    {
                                        <option value="@v" />
                                    }
                                </datalist>
                                <ValidationMessage For="() => _form.CourtLevel" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">County</span>
                                <InputText class="form-control" @bind-Value="_form.County" placeholder="e.g. Los Angeles County" autocomplete="off" />
                                <ValidationMessage For="() => _form.County" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Governing law</span>
                                <InputText class="form-control" list="matter-governinglaw-options" @bind-Value="_form.GoverningLaw" placeholder="Select or type governing law" autocomplete="off" />
                                <datalist id="matter-governinglaw-options">
                                    @foreach (var v in _facets.GoverningLaws)
                                    {
                                        <option value="@v" />
                                    }
                                </datalist>
                                <ValidationMessage For="() => _form.GoverningLaw" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Moving party</span>
                                <InputText class="form-control" @bind-Value="_form.MovingParty" placeholder="Party bringing the motion" autocomplete="off" />
                                <ValidationMessage For="() => _form.MovingParty" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Responding party</span>
                                <InputText class="form-control" @bind-Value="_form.RespondingParty" placeholder="Party opposing the motion" autocomplete="off" />
                                <ValidationMessage For="() => _form.RespondingParty" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Motion target</span>
                                <InputText class="form-control" @bind-Value="_form.MotionTarget" placeholder="What the motion targets (e.g. contract claim)" autocomplete="off" />
                                <ValidationMessage For="() => _form.MotionTarget" class="text-danger" />
                            </label>
                            <label class="um-field">
                                <span class="um-field-label">Requested disposition</span>
                                <InputText class="form-control" @bind-Value="_form.RequestedDisposition" placeholder="Relief requested (e.g. judgment without trial)" autocomplete="off" />
                                <ValidationMessage For="() => _form.RequestedDisposition" class="text-danger" />
                            </label>
                            <label class="um-field um-field-wide um-field--full">
                                <span class="um-field-label">Description</span>
                                <InputTextArea class="form-control" rows="3" @bind-Value="_form.Description" placeholder="Optional context for this matter" />
                                <ValidationMessage For="() => _form.Description" class="text-danger" />
                            </label>
                        </div>
                        @if (_createError is not null)
                        {
                            <div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@_createError</div>
                        }
                    </div>
                    <div class="um-modal-footer">
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showCreate = false">Cancel</button>
                        <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">
                            <i class="bi bi-check-lg"></i> @(_saving ? "Creating…" : "Create matter")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</LegalWorkspace>

@code {
    private bool _loading = true;
    private bool _showCreate;
    private bool _saving;
    private string? _loadError;
    private string? _createError;
    private string _search = string.Empty;
    private string _activeFilter = "ALL";
    private IReadOnlyCollection<DecisionMatterDto> _matters = [];
    private DecisionMatterFacetsDto _facets = new([], [], []);
    private MatterForm _form = new();

    private IReadOnlyList<DecisionMatterDto> Filtered
    {
        get
        {
            IEnumerable<DecisionMatterDto> q = _matters;
            q = _activeFilter switch
            {
                "OPEN" => q.Where(m => string.Equals(m.StatusCode, "OPEN", StringComparison.OrdinalIgnoreCase)),
                "DECIDED" => q.Where(m => m.LatestSessionId is not null),
                "ATRISK" => q.Where(m => m.CriticalFlipPointCount > 0),
                _ => q
            };
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(m =>
                    (m.Title?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.MatterTypeCode?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Jurisdiction?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Posture?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return q.OrderByDescending(m => m.CreatedDateUtc).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Intelligence", "/intelligence"), new("Matters", "/legal/matters"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            _matters = await Api.GetLegalDecisionMattersAsync();
            _facets = await Api.GetLegalDecisionMatterFacetsAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load matters: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void SetFilter(string filter) => _activeFilter = filter;

    private void OpenCreate()
    {
        _form = new MatterForm();
        _createError = null;
        _showCreate = true;
    }

    private void OpenMatter(DecisionMatterDto m) => Navigation.NavigateTo($"/legal/matters/{m.DecisionMatterId}");

    private void OnCardKey(KeyboardEventArgs e, DecisionMatterDto m)
    {
        if (e.Key is "Enter" or " ")
            OpenMatter(m);
    }

    private async Task CreateAsync()
    {
        _saving = true;
        _createError = null;
        StateHasChanged();
        try
        {
            var request = new DecisionMatterCreateRequest(
                _form.Title.Trim(),
                string.IsNullOrWhiteSpace(_form.MatterTypeCode) ? null : _form.MatterTypeCode.Trim(),
                string.IsNullOrWhiteSpace(_form.Jurisdiction) ? null : _form.Jurisdiction.Trim(),
                string.IsNullOrWhiteSpace(_form.Posture) ? null : _form.Posture.Trim(),
                string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim())
            {
                Subtype = string.IsNullOrWhiteSpace(_form.Subtype) ? null : _form.Subtype.Trim(),
                CourtSystem = string.IsNullOrWhiteSpace(_form.CourtSystem) ? null : _form.CourtSystem.Trim(),
                State = string.IsNullOrWhiteSpace(_form.State) ? null : _form.State.Trim(),
                CourtLevel = string.IsNullOrWhiteSpace(_form.CourtLevel) ? null : _form.CourtLevel.Trim(),
                County = string.IsNullOrWhiteSpace(_form.County) ? null : _form.County.Trim(),
                GoverningLaw = string.IsNullOrWhiteSpace(_form.GoverningLaw) ? null : _form.GoverningLaw.Trim(),
                MovingParty = string.IsNullOrWhiteSpace(_form.MovingParty) ? null : _form.MovingParty.Trim(),
                RespondingParty = string.IsNullOrWhiteSpace(_form.RespondingParty) ? null : _form.RespondingParty.Trim(),
                MotionTarget = string.IsNullOrWhiteSpace(_form.MotionTarget) ? null : _form.MotionTarget.Trim(),
                RequestedDisposition = string.IsNullOrWhiteSpace(_form.RequestedDisposition) ? null : _form.RequestedDisposition.Trim()
            };
            var id = await Api.CreateLegalDecisionMatterAsync(request);
            _showCreate = false;
            if (id != Guid.Empty)
                Navigation.NavigateTo($"/legal/matters/{id}");
            else
                await LoadAsync();
        }
        catch (Exception ex)
        {
            _createError = $"Create failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private sealed class MatterForm
    {
        [Required, StringLength(300, MinimumLength = 2)]
        public string Title { get; set; } = string.Empty;

        [StringLength(80)]
        public string? MatterTypeCode { get; set; }

        [StringLength(120)]
        public string? Jurisdiction { get; set; }

        [StringLength(200)]
        public string? Posture { get; set; }

        [StringLength(120)]
        public string? Subtype { get; set; }

        [StringLength(120)]
        public string? CourtSystem { get; set; }

        [StringLength(120)]
        public string? State { get; set; }

        [StringLength(120)]
        public string? CourtLevel { get; set; }

        [StringLength(120)]
        public string? County { get; set; }

        [StringLength(120)]
        public string? GoverningLaw { get; set; }

        [StringLength(200)]
        public string? MovingParty { get; set; }

        [StringLength(200)]
        public string? RespondingParty { get; set; }

        [StringLength(300)]
        public string? MotionTarget { get; set; }

        [StringLength(300)]
        public string? RequestedDisposition { get; set; }

        [StringLength(4000)]
        public string? Description { get; set; }
    }
}
