@page "/integrations/clio"
@using Legal.Web.Services.Clio
@inject ClioTokenStore ClioTokens
@inject IClioReadOnlyClient ClioClient
@inject ClioMatterMap ClioMatters
@inject ApiClient Api
@inject NavigationManager Navigation
@inject ILogger<ClioIntegration> Logger

<PageTitle>Clio Integration</PageTitle>

<div class="enterprise-page">
    <div class="pc-header">
        <div>
            <h1 class="pc-title"><i class="bi bi-plug"></i> Clio Integration</h1>
            <p class="pc-subtitle">Connect Judz to your Clio Manage account using read-only OAuth access.</p>
        </div>
    </div>

    @if (_connectedJustNow)
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle"></i> Connected to Clio successfully.
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert" style="border-left: 4px solid #dc3545;">
            <i class="bi bi-exclamation-triangle"></i> Clio connection error: @_error
        </div>
    }

    <div class="pc-card" style="max-width: 720px;">
        @if (ClioTokens.IsConnected)
        {
            <p><strong>Status:</strong> <span class="text-success">Connected</span></p>
            <div class="d-flex gap-2">
                <button type="button" class="um-btn um-btn-primary" @onclick="DiscoverAsync" disabled="@_loading">
                    <i class="bi bi-search"></i> @(_loading ? "Discovering…" : "Discover Sapini Matter")
                </button>
                <form method="post" action="/integrations/clio/disconnect">
                    <button type="submit" class="um-btn um-btn-secondary">
                        <i class="bi bi-x-circle"></i> Disconnect
                    </button>
                </form>
            </div>
        }
        else
        {
            <p><strong>Status:</strong> <span class="text-muted">Not connected</span></p>
            <a class="um-btn um-btn-primary" href="/integrations/clio/connect">
                <i class="bi bi-box-arrow-in-right"></i> Connect Clio
            </a>
        }
    </div>

    @if (!string.IsNullOrEmpty(_discoveryError))
    {
        <div class="alert alert-danger mt-3" role="alert" style="border-left: 4px solid #dc3545;">
            <i class="bi bi-exclamation-triangle"></i> @_discoveryError
        </div>
    }

    @if (_discovery is not null)
    {
        var m = _discovery.Matter;
        <div class="pc-card mt-3" style="max-width: 720px;">
            <h2 class="pc-title" style="font-size:1.1rem;">Sapini Matter</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Matter</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(m.Description) ? m.DisplayNumber : m.Description)</dd>

                <dt class="col-sm-4">Matter ID</dt>
                <dd class="col-sm-8">@m.Id</dd>

                <dt class="col-sm-4">Display Number</dt>
                <dd class="col-sm-8">@m.DisplayNumber</dd>

                <dt class="col-sm-4">Practice Area</dt>
                <dd class="col-sm-8">@(m.PracticeArea ?? "—")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@(m.Status ?? "—")</dd>

                <dt class="col-sm-4">Documents discovered</dt>
                <dd class="col-sm-8">@_discovery.Documents.Count</dd>

                <dt class="col-sm-4">Contacts discovered</dt>
                <dd class="col-sm-8">@_discovery.Contacts.Count</dd>
            </dl>

            <div class="mt-3">
                <button type="button" class="um-btn um-btn-primary" @onclick="IngestAllAsync" disabled="@(_ingesting || _discovery.Documents.Count == 0)">
                    <i class="bi bi-cloud-arrow-down"></i>
                    @if (_ingesting)
                    {
                        <text>Syncing… (@_ingestDone/@_discovery.Documents.Count)</text>
                    }
                    else if (ClioMatters.TryGet(_discovery.Matter.Id, out _))
                    {
                        <text>Re-sync into Judz</text>
                    }
                    else
                    {
                        <text>Ingest / Sync into Judz</text>
                    }
                </button>
                @if (ClioMatters.TryGet(_discovery.Matter.Id, out var mappedMatterId))
                {
                    <div class="text-muted mt-2">
                        <i class="bi bi-link-45deg"></i>
                        Linked to Judz matter <a href="/legal/matters/@mappedMatterId">@mappedMatterId</a>.
                    </div>
                }
            </div>
        </div>

        @if (_discovery.CustomFields.Count > 0)
        {
            <div class="pc-card mt-3" style="max-width: 720px;">
                <h2 class="pc-title" style="font-size:1.1rem;">Clio Custom Fields</h2>
                <dl class="row mb-0">
                    @foreach (var f in _discovery.CustomFields)
                    {
                        <dt class="col-sm-5">@f.Name</dt>
                        <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(f.Value) ? "—" : f.Value)</dd>
                    }
                </dl>
            </div>
        }

        @if (!string.IsNullOrEmpty(_ingestError))
        {
            <div class="alert alert-danger mt-3" role="alert" style="border-left: 4px solid #dc3545;">
                <i class="bi bi-exclamation-triangle"></i> @_ingestError
            </div>
        }

        @if (_ingestResult is not null)
        {
            <div class="alert alert-success mt-3" role="alert">
                <i class="bi bi-check-circle"></i>
                Ingested @_ingestResult.Succeeded of @_ingestResult.Total documents into Judz matter.
                @if (_ingestResult.Failed > 0)
                {
                    <text> @_ingestResult.Failed failed.</text>
                }
            </div>
            <div class="mt-2" style="display:flex;gap:8px;flex-wrap:wrap;">
                <a class="um-btn um-btn-primary" href="/legal/casecommandcenter?matterId=@_ingestResult.MatterId">
                    <i class="bi bi-columns-gap"></i> Open Case Command Center
                </a>
                <a class="um-btn um-btn-secondary" href="/legal/personalinjury_decision2?matterId=@_ingestResult.MatterId">
                    <i class="bi bi-diagram-3"></i> Open Full Decision Analysis
                </a>
            </div>
            @if (_ingestResult.Failures.Count > 0)
            {
                <div class="pc-card mt-3">
                    <h2 class="pc-title" style="font-size:1.1rem;">Ingest Failures</h2>
                    <ul class="mb-0">
                        @foreach (var f in _ingestResult.Failures)
                        {
                            <li>@f</li>
                        }
                    </ul>
                </div>
            }
        }

        <div class="pc-card mt-3">
            <h2 class="pc-title" style="font-size:1.1rem;">Document Inventory</h2>
            @if (_discovery.Documents.Count == 0)
            {
                <p class="text-muted mb-0">No documents discovered for this matter.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Filename</th>
                            <th>Clio Document ID</th>
                            <th>Folder / Category</th>
                            <th>Latest Version</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in _discovery.Documents)
                        {
                            <tr>
                                <td>@(doc.Name ?? "—")</td>
                                <td>@doc.Id</td>
                                <td>@(doc.Folder ?? doc.Category ?? "—")</td>
                                <td>@(doc.LatestVersion ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>

@code {
    private bool _connectedJustNow;
    private string? _error;
    private bool _loading;
    private string? _discoveryError;
    private ClioSapiniDiscovery? _discovery;

    private bool _ingesting;
    private int _ingestDone;
    private string? _ingestError;
    private IngestSummary? _ingestResult;

    private sealed record IngestSummary(Guid MatterId, int Total, int Succeeded, int Failed, IReadOnlyList<string> Failures);

    // ── Clio → Judz field mapping ──────────────────────────────────────────────

    // Role tokens that positively identify the client / adverse party in Clio
    // relationship or contact-type values. Anything ambiguous is left for Decision2.
    private static readonly string[] ClientRoleTokens = ["client"];
    private static readonly string[] AdverseRoleTokens =
        ["defendant", "adverse", "opposing", "respondent", "third party", "tortfeasor"];

    // Clio custom-field names that map cleanly onto a structured Judz field.
    private const string AccidentLocationField = "Accident Location";

    private static (string? MovingParty, string? RespondingParty) MapParties(ClioSapiniDiscovery d)
    {
        // Moving party: the contact Clio flags as the client (by client id or by a client role).
        var clientContact = d.Contacts.FirstOrDefault(c =>
            (d.Matter.ClientId is { } cid && c.Id == cid)
            || HasToken(c.Relationship, ClientRoleTokens)
            || HasToken(c.Type, ClientRoleTokens));

        var movingParty = clientContact?.Name;
        if (string.IsNullOrWhiteSpace(movingParty))
            movingParty = d.Matter.ClientName; // fall back to the matter's client name only.

        // Responding party: only when a contact role explicitly marks the adverse side.
        var adverseContact = d.Contacts.FirstOrDefault(c =>
            HasToken(c.Relationship, AdverseRoleTokens) || HasToken(c.Type, AdverseRoleTokens));

        return (Trim(movingParty, 200), Trim(adverseContact?.Name, 200));
    }

    private static string? MapJurisdiction(ClioSapiniDiscovery d)
    {
        var loc = d.CustomFields
            .FirstOrDefault(f => string.Equals(f.Name, AccidentLocationField, StringComparison.OrdinalIgnoreCase));
        return Trim(loc?.Value, 120);
    }

    // Composes every Clio custom field and all contacts (with their Clio roles) into a
    // readable intake block stored in the matter Description. Nothing is discarded.
    private static string BuildClioIntakeSummary(ClioSapiniDiscovery d)
    {
        var m = d.Matter;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("── Clio Intake Summary ──");
        sb.AppendLine($"Source: Clio Manage matter {m.DisplayNumber} (Clio id {m.Id}).");
        if (!string.IsNullOrWhiteSpace(m.Status)) sb.AppendLine($"Clio status: {m.Status}");
        sb.AppendLine();

        if (d.CustomFields.Count > 0)
        {
            sb.AppendLine("Custom fields:");
            foreach (var f in d.CustomFields)
                sb.AppendLine($"  • {f.Name}: {(string.IsNullOrWhiteSpace(f.Value) ? "—" : f.Value)}");
            sb.AppendLine();
        }

        if (d.Contacts.Count > 0)
        {
            sb.AppendLine("Contacts:");
            foreach (var c in d.Contacts)
            {
                var role = !string.IsNullOrWhiteSpace(c.Relationship) ? c.Relationship
                    : !string.IsNullOrWhiteSpace(c.Type) ? c.Type : "unspecified role";
                sb.AppendLine($"  • {c.Name ?? $"Contact {c.Id}"} ({role})");
            }
        }

        var summary = sb.ToString().TrimEnd();
        return summary.Length > 4000 ? summary[..4000] : summary;
    }

    private static bool HasToken(string? value, string[] tokens) =>
        !string.IsNullOrWhiteSpace(value)
        && tokens.Any(t => value!.Contains(t, StringComparison.OrdinalIgnoreCase));

    private static string? Trim(string? value, int max) =>
        string.IsNullOrWhiteSpace(value) ? null : (value!.Length > max ? value[..max] : value);

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _connectedJustNow = query.TryGetValue("connected", out var connected) && connected == "1";
        if (query.TryGetValue("error", out var error))
            _error = error.ToString();
    }

    private async Task DiscoverAsync()
    {
        _loading = true;
        _discoveryError = null;
        _discovery = null;
        try
        {
            _discovery = await ClioClient.DiscoverSapiniAsync();
        }
        catch (ClioReadException ex)
        {
            // Never log the token; surface only the actionable message.
            _discoveryError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during Clio Sapini discovery.");
            _discoveryError = $"Discovery failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task IngestAllAsync()
    {
        if (_discovery is null || _discovery.Documents.Count == 0)
            return;

        _ingesting = true;
        _ingestError = null;
        _ingestResult = null;
        _ingestDone = 0;
        var failures = new List<string>();
        var succeeded = 0;

        try
        {
            // Auto-create a new Judz matter for the Sapini case on first run; reuse the same
            // matter on subsequent runs so the demo stays idempotent at the matter level.
            var m = _discovery.Matter;
            Guid matterId;
            if (ClioMatters.TryGet(m.Id, out var existingMatterId))
            {
                // Idempotent short-circuit: this Clio matter was already ingested in this
                // session, so skip re-downloading/re-uploading every document (hackathon scope)
                // and hand straight off to the Command Center with the existing Judz matter.
                matterId = existingMatterId;
                _ingestResult = new IngestSummary(matterId, _discovery.Documents.Count, 0, 0, Array.Empty<string>());
                Navigation.NavigateTo($"/legal/casecommandcenter?matterId={matterId}");
                return;
            }
            else
            {
                var title = string.IsNullOrWhiteSpace(m.Description) ? m.DisplayNumber : m.Description!;
                if (string.IsNullOrWhiteSpace(title))
                    title = $"Clio Matter {m.Id}";

                // Map the Clio client contact to MovingParty only when the relationship/role
                // identifies that contact as the client; never infer the opposing party from order.
                var (movingParty, respondingParty) = MapParties(_discovery);
                var intakeSummary = BuildClioIntakeSummary(_discovery);

                var createRequest = new Legal.Application.Features.Intelligence.Decision.DecisionMatterCreateRequest(
                    title.Length > 300 ? title[..300] : title,
                    "Personal Injury",
                    MapJurisdiction(_discovery),
                    null,
                    intakeSummary)
                {
                    PracticeAreaCode = m.PracticeArea,
                    MovingParty = movingParty,
                    RespondingParty = respondingParty
                };

                matterId = await Api.CreateLegalDecisionMatterAsync(createRequest);
                if (matterId == Guid.Empty)
                    throw new InvalidOperationException("The Judz matter could not be created.");

                ClioMatters.Set(m.Id, matterId);
            }

            foreach (var doc in _discovery.Documents)
            {
                try
                {
                    var content = await ClioClient.DownloadDocumentAsync(doc.Id);
                    var fileName = string.IsNullOrWhiteSpace(doc.Name) ? $"clio-document-{doc.Id}" : doc.Name!;
                    // Deterministic idempotency key so a retried ingest does not duplicate evidence.
                    await Api.UploadLegalMatterDocumentBytesAsync(
                        matterId,
                        content.Content,
                        fileName,
                        content.ContentType ?? "application/octet-stream",
                        idempotencyKey: $"clio-doc-{doc.Id}");
                    succeeded++;
                }
                catch (Exception ex)
                {
                    failures.Add($"{doc.Name ?? doc.Id.ToString()}: {ex.Message}");
                }
                finally
                {
                    _ingestDone++;
                    StateHasChanged();
                }
            }

            _ingestResult = new IngestSummary(matterId, _discovery.Documents.Count, succeeded, failures.Count, failures);

            // Hand off into the enterprise Case Command Center (the front door) with the matter
            // loaded. The Command Center links onward to the full Decision2/POLOXI analysis. If some
            // documents failed, stay here so they can review the failures and open it manually.
            if (failures.Count == 0 && succeeded > 0)
                Navigation.NavigateTo($"/legal/casecommandcenter?matterId={matterId}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Clio ingest into Judz failed.");
            _ingestError = $"Ingest failed: {ex.Message}";
        }
        finally
        {
            _ingesting = false;
        }
    }
}
