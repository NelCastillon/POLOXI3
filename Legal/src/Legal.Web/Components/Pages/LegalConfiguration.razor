@page "/legal/configuration"
@using Legal.Application.Features.Intelligence
@using Legal.Application.Features.Intelligence.Decision
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<LegalWorkspace>
<div class="intel-page">
<header class="intel-header">
    <div><span>Control plane</span><h1>AI Configuration Center</h1><p>Effective provider capabilities, model deployments, routing, limits, and human-review controls from the database.</p></div>
    <div class="intel-header-actions">
        <div class="intel-search"><i class="bi bi-search"></i><input type="search" placeholder="Search settings, providers, models, prompts…" value="@_search" @oninput="OnSearchInput" aria-label="Search configuration" />@if(!string.IsNullOrWhiteSpace(_search)){<button type="button" class="intel-search-clear" title="Clear search" @onclick="ClearSearch"><i class="bi bi-x-lg"></i></button>}</div>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </div>
</header>
@if(_loading){<div class="intel-state">Loading AI configuration...</div>}
else
{
    @if(_error is not null){<div class="intel-error">@_error</div>}
    <section class="intel-kpis">
        <article class="intel-kpi-link @(_focusSection=="providers"?"intel-kpi-active":null)" role="button" tabindex="0" title="Go to provider registry" @onclick="@(()=>FocusSectionAsync("providers"))"><span>Providers</span><strong>@_providers.Count(x=>x.IsActive)</strong></article>
        <article class="intel-kpi-link @(_focusSection=="models"?"intel-kpi-active":null)" role="button" tabindex="0" title="Go to model deployments" @onclick="@(()=>FocusSectionAsync("models"))"><span>Models</span><strong>@_models.Count(x=>x.IsActive)</strong></article>
        <article class="intel-kpi-link @(_focusSection=="policies"?"intel-kpi-active":null)" role="button" tabindex="0" title="Go to feature policies" @onclick="@(()=>FocusSectionAsync("policies"))"><span>Feature policies</span><strong>@_policies.Count</strong></article>
        <article class="intel-kpi-link @(_focusSection=="prompts"?"intel-kpi-active":null)" role="button" tabindex="0" title="Go to prompt registry" @onclick="@(()=>FocusSectionAsync("prompts"))"><span>Prompt versions</span><strong>@_prompts.Count</strong></article>
        <article class="intel-kpi-link @(_focusSection=="decision-prompts"?"intel-kpi-active":null)" role="button" tabindex="0" title="Go to POLOXI decision prompts" @onclick="@(()=>FocusSectionAsync("decision-prompts"))"><span>Decision prompts</span><strong>@_decisionPrompts.Count(x=>x.IsActive)</strong></article>
        <article class="intel-kpi-link @(_focusSection=="decision-routes"?"intel-kpi-active":null)" role="button" tabindex="0" title="Go to POLOXI decision model routes" @onclick="@(()=>FocusSectionAsync("decision-routes"))"><span>Decision routes</span><strong>@_decisionRoutes.Count</strong></article>
        <article class="intel-kpi-link @(_focusSection=="legal-grounding"?"intel-kpi-active":null)" role="button" tabindex="0" title="Go to legal grounding settings" @onclick="@(()=>FocusSectionAsync("legal-grounding"))"><span>Legal grounding</span><strong>@_legalSettings.Count</strong></article>
        <article class="intel-kpi-link @(_focusSection=="epistemic"?"intel-kpi-active":null)" role="button" tabindex="0" title="Go to epistemic authority settings" @onclick="@(()=>FocusSectionAsync("epistemic"))"><span>Epistemic authority</span><strong>@_epistemicSettings.Count</strong></article>
    </section>

    @if(!string.IsNullOrWhiteSpace(_search) && !HasAnySearchResult)
    {
        <div class="intel-state">No configuration entries match &ldquo;@_search&rdquo;.</div>
    }

    @if(SectionVisible("decision routes","POLOXI decision model routes") && _decisionRoutes.Any(r=>MatchRoute(r)))
    {
    <section id="intel-section-decision-routes" class="intel-panel @(_focusSection=="decision-routes"?"intel-panel-focus":null)">
        <div class="intel-toolbar"><h2>POLOXI decision model routes</h2><span>DB-backed task policy</span></div>
        @if(_decisionRoutes.Count==0){<div class="intel-state">No POLOXI decision model routes are configured.</div>}
        @foreach(var route in _decisionRoutes.Where(MatchRoute).OrderBy(r=>r.FeatureCode).ThenBy(r=>r.Priority))
        {
            <div class="intel-row">
                <div><strong>@route.FeatureCode</strong><small>@route.ModelCode · @route.DeploymentName</small><span>@route.MaxOutputTokens.ToString("N0") output tokens · @route.TimeoutSeconds seconds · temperature @route.Temperature</span></div>
                <div>
                    <AppStatusBadge Status="@(route.ModelCode.Contains("astra",StringComparison.OrdinalIgnoreCase)?"ASTRA":"MINI")" />
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditDecisionRoute(route)">Edit</button>
                </div>
            </div>
        }
    </section>
    }

    @if(SectionVisible("providers provider registry","Provider registry") && _providers.Any(MatchProvider))
    {
    <section id="intel-section-providers" class="intel-panel @(_focusSection=="providers"?"intel-panel-focus":null)">
        <div class="intel-toolbar"><h2>Provider registry</h2><button class="um-btn um-btn-primary um-btn-sm" @onclick="NewProvider">Add provider</button></div>
        @if(_providers.Count==0){<div class="intel-state">No provider records are configured.</div>}
        @foreach(var provider in _providers.Where(MatchProvider))
        {
            <div class="intel-row">
                <div><strong>@provider.DisplayName</strong><small>@provider.ProviderCode · @provider.ProviderTypeCode</small></div>
                <div>
                    <span>@(provider.SupportsChat?"Chat ":"")@(provider.SupportsEmbeddings?"Embeddings ":"")@(provider.SupportsVision?"Vision":"")</span>
                    <AppStatusBadge Status="@(provider.IsActive?"ACTIVE":"INACTIVE")" />
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditProvider(provider)">Edit</button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="()=>DeleteProviderAsync(provider)">Delete</button>
                </div>
            </div>
        }
    </section>
    }

    @if(SectionVisible("models model deployments","Model deployments") && _models.Any(MatchModel))
    {
    <section id="intel-section-models" class="intel-panel @(_focusSection=="models"?"intel-panel-focus":null)">
        <div class="intel-toolbar"><h2>Model deployments</h2><button class="um-btn um-btn-primary um-btn-sm" @onclick="NewModel">Add model deployment</button></div>
        @if(_models.Count==0){<div class="intel-state">No model deployments exist. Add deployment records before enabling feature policies.</div>}
        @foreach(var model in _models.Where(MatchModel))
        {
            <div class="intel-row">
                <div><strong>@model.DeploymentName</strong><small>@model.ProviderCode · @model.ModelFamily · @model.CapabilityCode</small></div>
                <div>
                    <span>@model.ContextWindowTokens.ToString("N0") context · @model.MaximumOutputTokens.ToString("N0") output</span>
                    <AppStatusBadge Status="@(model.IsActive?"ACTIVE":"INACTIVE")" />
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditModel(model)">Edit</button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="()=>DeleteModelAsync(model)">Delete</button>
                </div>
            </div>
        }
    </section>
    }

    @if(SectionVisible("feature policies","Feature policies") && _policies.Any(MatchPolicy))
    {
    <section id="intel-section-policies" class="intel-panel @(_focusSection=="policies"?"intel-panel-focus":null)">
        <div class="intel-toolbar"><h2>Feature policies</h2><button class="um-btn um-btn-primary um-btn-sm" @onclick="NewPolicy">Add feature policy</button></div>
        @if(_policies.Count==0){<div class="intel-state">No tenant feature policies are configured. AI features remain unavailable until explicitly enabled.</div>}
        @foreach(var policy in _policies.Where(MatchPolicy))
        {
            <div class="intel-row">
                <div><strong>@policy.FeatureCode</strong><small>@policy.ModuleCode · temperature @policy.Temperature · timeout @policy.TimeoutSeconds seconds</small><span>@policy.MaximumInputTokens.ToString("N0") input / @policy.MaximumOutputTokens.ToString("N0") output tokens · minimum confidence @policy.MinimumConfidence.ToString("P0")</span></div>
                <div>
                    <AppStatusBadge Status="@(policy.IsEnabled?"ENABLED":"DISABLED")" />
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditPolicy(policy)">Edit</button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="()=>DeletePolicyAsync(policy)">Delete</button>
                </div>
            </div>
        }
    </section>
    }

    @if(SectionVisible("prompt registry","Prompt registry") && _prompts.Any(MatchPrompt))
    {
    <section id="intel-section-prompts" class="intel-panel @(_focusSection=="prompts"?"intel-panel-focus":null)">
        <div class="intel-toolbar"><h2>Prompt registry</h2><button class="um-btn um-btn-primary um-btn-sm" @onclick="NewPrompt">Add prompt version</button></div>
        <div class="intel-state">Prompts are grouped by module and listed in the order the engine executes them.</div>
        @if(_prompts.Count==0){<div class="intel-state">No prompt definitions are configured.</div>}
        @foreach(var group in _prompts.Where(MatchPrompt).GroupBy(p=>PromptMeta(p.PromptCode).Category).OrderBy(g=>g.Min(p=>PromptMeta(p.PromptCode).Order)))
        {
            <h3 class="intel-prompt-group">@group.Key</h3>
            @foreach(var prompt in group.OrderBy(p=>PromptMeta(p.PromptCode).Order).ThenBy(p=>p.PromptCode).ThenBy(p=>p.VersionLabel))
            {
                <div class="intel-row">
                    <div><strong>@prompt.DisplayName</strong><small>@prompt.PromptCode · @prompt.VersionLabel · @prompt.CapabilityCode</small><span>@(prompt.TenantId.HasValue?"Tenant":"Platform") prompt definition · @PromptMeta(prompt.PromptCode).Description</span></div>
                    <div>
                        <AppStatusBadge Status="@prompt.StatusCode" />
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditPrompt(prompt)">Edit</button>
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>NewPromptVersion(prompt)">New version</button>
                        <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="()=>DeletePromptAsync(prompt)">Delete</button>
                    </div>
                </div>
            }
        }
    </section>
    }

    @if(SectionVisible("POLOXI decision prompts preflight gate clarification","POLOXI decision prompts") && (_decisionSettings.Any(MatchDecisionSetting) || _decisionPrompts.Any(MatchDecisionPrompt)))
    {
    <section id="intel-section-decision-prompts" class="intel-panel @(_focusSection=="decision-prompts"?"intel-panel-focus":null)">
        <div class="intel-toolbar"><h2>POLOXI decision prompts</h2></div>
        <div class="intel-state">Database-backed runtime prompts used by candidate discovery, dependency graphs, verification, answers, and Research Need semantic decomposition.</div>
        <div class="intel-note">
            <strong>Clarification preflight gate</strong> &mdash; an optional early completeness check that runs <em>before</em> the expensive discovery, dependency-graph, and verification pipeline. When an essential decision-contract input is missing, POLOXI asks the attorney one targeted clarification up front instead of paying for the full run only to end in <code>CLARIFICATION_REQUIRED</code>. It never replaces the dynamic clarification logic that appears after candidate competition. These values are stored in <code>POLOXI.Legal_DecisionSetting</code> &mdash; edit and save them below.
        </div>
        @if(_decisionSettings.Count==0){<div class="intel-state">No POLOXI decision settings are configured. Run the latest database migrations to seed the preflight gate keys.</div>}
        @foreach(var setting in _decisionSettings.Where(MatchDecisionSetting))
        {
            <div class="intel-row">
                <div><strong>@ShortDecisionKey(setting.SettingKey)</strong><small>@setting.SettingKey &middot; @setting.DataTypeCode</small><span>@setting.Description</span></div>
                <div>
                    <span>@setting.SettingValue</span>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditDecisionSetting(setting)">Edit</button>
                </div>
            </div>
        }
        @if(_decisionPrompts.Count==0){<div class="intel-state">No POLOXI decision prompts are configured.</div>}
        @foreach(var prompt in _decisionPrompts.Where(MatchDecisionPrompt).OrderBy(p=>p.StageCode).ThenBy(p=>p.PromptCode))
        {
            <div class="intel-row">
                <div><strong>@prompt.PromptCode</strong><small>@prompt.StageCode · POLOXI.Legal_DecisionPrompt</small><span>Last updated @(prompt.ModifiedDateUtc??prompt.CreatedDateUtc).ToString("u")</span></div>
                <div>
                    <AppStatusBadge Status="@(prompt.IsActive?"ACTIVE":"INACTIVE")" />
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditDecisionPrompt(prompt)">Edit</button>
                </div>
            </div>
        }
    </section>
    }

    @if(SectionVisible("legal grounding settings courtlistener govinfo ecfr","Legal grounding settings") && _legalSettings.Any(MatchLegalSetting))
    {
    <section id="intel-section-legal-grounding" class="intel-panel @(_focusSection=="legal-grounding"?"intel-panel-focus":null)">
        <div class="intel-toolbar"><h2>Legal grounding settings</h2><button class="um-btn um-btn-primary um-btn-sm" @onclick="NewLegalSetting">Add setting</button></div>
        <div class="intel-note">CourtListener, GovInfo, and eCFR grounding values used when the Legal search context is selected. Encrypted API keys are masked.</div>
        @if(_legalSettings.Count==0){<div class="intel-state">No legal grounding settings are configured.</div>}
        @foreach(var setting in _legalSettings.Where(MatchLegalSetting))
        {
            <div class="intel-row">
                <div><strong>@ShortLegalKey(setting.SettingKey)</strong><small>@setting.SettingKey · @setting.DataTypeCode</small><span>@setting.Description</span></div>
                <div>
                    <span>@(setting.IsEncrypted&&!string.IsNullOrEmpty(setting.SettingValue)?"********":setting.SettingValue)</span>
                    @if(setting.IsEncrypted){<AppStatusBadge Status="ENCRYPTED" />}
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditLegalSetting(setting)">Edit</button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="()=>DeleteLegalSettingAsync(setting)">Delete</button>
                </div>
            </div>
        }
    </section>
    }

    @if(SectionVisible("epistemic authority settings","Epistemic authority settings") && _epistemicSettings.Any(MatchEpistemicSetting))
    {
    <section id="intel-section-epistemic" class="intel-panel @(_focusSection=="epistemic"?"intel-panel-focus":null)">
        <div class="intel-toolbar"><h2>Epistemic authority settings</h2></div>
        <div class="intel-note">POLOXI Epistemic Authority (EA) feature flags, override mode, and thresholds. Values resolve tenant override → platform default → code default and take effect on the next decision. Editing here saves a tenant override for your tenant.</div>
        @if(_epistemicSettings.Count==0){<div class="intel-state">No epistemic authority settings are configured.</div>}
        @foreach(var setting in _epistemicSettings.Where(MatchEpistemicSetting))
        {
            <div class="intel-row">
                <div><strong>@ShortEpistemicKey(setting.SettingKey)</strong><small>@setting.SettingKey · @setting.DataTypeCode · platform default @setting.PlatformValue</small><span>@setting.Description</span></div>
                <div>
                    <span>@setting.EffectiveValue</span>
                    @if(setting.HasTenantOverride){<AppStatusBadge Status="TENANT" />}
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditEpistemicSetting(setting)">Edit</button>
                </div>
            </div>
        }
    </section>
    }

    @if(SectionVisible("search result display pipeline diagnostics showpipeline","Search result display"))
    {
    <section id="intel-section-search-display" class="intel-panel @(_focusSection=="search-display"?"intel-panel-focus":null)">
        <div class="intel-toolbar"><h2>Search result display</h2></div>
        <div class="intel-note">Controls what optional diagnostics appear on the Wide search result page (/legal/search).</div>
        <div class="intel-row">
            <div>
                <strong>Show End-to-end POLOXI pipeline</strong>
                <small>Intelligence.SearchWide.ShowPipeline · Boolean</small>
                <span>When enabled, the search result page displays the End-to-end POLOXI pipeline diagnostics section. Defaults to off.</span>
            </div>
            <div>
                <label class="intel-toggle"><input type="checkbox" @bind="_showPipeline" /><span></span><strong>Show pipeline section</strong></label>
                <button class="um-btn um-btn-primary um-btn-sm" @onclick="SaveShowPipelineAsync" disabled="@_saving">Save</button>
            </div>
        </div>
    </section>
    }
}
@if(_editingDecisionPrompt)
{
    <div class="um-modal-backdrop"><div class="um-modal">
        <div class="um-modal-header"><i class="bi bi-diagram-3"></i><span>Edit POLOXI decision prompt</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="()=>_editingDecisionPrompt=false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_decisionPromptForm" OnValidSubmit="SaveDecisionPromptAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="intel-field"><label>Prompt code</label><InputText @bind-Value="_decisionPromptForm.PromptCode" disabled /></div>
                <div class="intel-field"><label>Stage</label><InputText @bind-Value="_decisionPromptForm.StageCode" /><ValidationMessage For="() => _decisionPromptForm.StageCode" class="text-danger" /></div>
                <div class="intel-field"><label><InputCheckbox @bind-Value="_decisionPromptForm.IsActive" /> Active</label></div>
                <div class="intel-field" style="grid-column:1/-1"><label>System prompt</label><InputTextArea @bind-Value="_decisionPromptForm.SystemPrompt" /><ValidationMessage For="() => _decisionPromptForm.SystemPrompt" class="text-danger" /></div>
                <div class="intel-field" style="grid-column:1/-1"><label>User prompt template</label><InputTextArea @bind-Value="_decisionPromptForm.UserPromptTemplate" /><ValidationMessage For="() => _decisionPromptForm.UserPromptTemplate" class="text-danger" /></div>
                <div class="intel-field" style="grid-column:1/-1"><label>Output schema JSON</label><InputTextArea @bind-Value="_decisionPromptForm.OutputSchemaJson" /></div>
            </div></div>
            <div class="um-modal-footer">
                @if(_error is not null){<span class="intel-error">@_error</span>}
                <button type="button" class="um-btn um-btn-ghost" @onclick="()=>_editingDecisionPrompt=false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save decision prompt</button>
            </div>
        </EditForm>
    </div></div>
}

@if(_editingDecisionRoute)
{
    <div class="um-modal-backdrop"><div class="um-modal">
        <div class="um-modal-header"><i class="bi bi-signpost-split"></i><span>Edit POLOXI decision model route</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="()=>_editingDecisionRoute=false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_decisionRouteForm" OnValidSubmit="SaveDecisionRouteAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="intel-field"><label>Feature code</label><InputText @bind-Value="_decisionRouteForm.FeatureCode" disabled /></div>
                <div class="intel-field"><label>Provider type</label><InputText @bind-Value="_decisionRouteForm.ProviderTypeCode" /><ValidationMessage For="() => _decisionRouteForm.ProviderTypeCode" class="text-danger" /></div>
                <div class="intel-field"><label>Model code</label><InputText @bind-Value="_decisionRouteForm.ModelCode" /><ValidationMessage For="() => _decisionRouteForm.ModelCode" class="text-danger" /></div>
                <div class="intel-field"><label>Deployment name</label><InputText @bind-Value="_decisionRouteForm.DeploymentName" /><ValidationMessage For="() => _decisionRouteForm.DeploymentName" class="text-danger" /></div>
                <div class="intel-field" style="grid-column:1/-1"><label>Endpoint reference</label><InputText @bind-Value="_decisionRouteForm.EndpointReference" /><ValidationMessage For="() => _decisionRouteForm.EndpointReference" class="text-danger" /></div>
                <div class="intel-field" style="grid-column:1/-1"><label>Credential reference</label><InputText @bind-Value="_decisionRouteForm.CredentialReference" /><ValidationMessage For="() => _decisionRouteForm.CredentialReference" class="text-danger" /></div>
                <div class="intel-field"><label>API version</label><InputText @bind-Value="_decisionRouteForm.ApiVersion" /><ValidationMessage For="() => _decisionRouteForm.ApiVersion" class="text-danger" /></div>
                <div class="intel-field"><label>Timeout (seconds)</label><InputNumber @bind-Value="_decisionRouteForm.TimeoutSeconds" /><ValidationMessage For="() => _decisionRouteForm.TimeoutSeconds" class="text-danger" /></div>
                <div class="intel-field"><label>Max output tokens</label><InputNumber @bind-Value="_decisionRouteForm.MaxOutputTokens" /><ValidationMessage For="() => _decisionRouteForm.MaxOutputTokens" class="text-danger" /></div>
                <div class="intel-field"><label>Temperature</label><InputNumber @bind-Value="_decisionRouteForm.Temperature" /><ValidationMessage For="() => _decisionRouteForm.Temperature" class="text-danger" /></div>
                <div class="intel-field"><label>Priority</label><InputNumber @bind-Value="_decisionRouteForm.Priority" /><ValidationMessage For="() => _decisionRouteForm.Priority" class="text-danger" /></div>
                <div class="intel-field"><label><InputCheckbox @bind-Value="_decisionRouteForm.IsActive" /> Active</label></div>
            </div></div>
            <div class="um-modal-footer">
                @if(_error is not null){<span class="intel-error">@_error</span>}
                <button type="button" class="um-btn um-btn-ghost" @onclick="()=>_editingDecisionRoute=false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save decision route</button>
            </div>
        </EditForm>
    </div></div>
}

@if(_editingProvider)
{
    <div class="um-modal-backdrop"><div class="um-modal">
        <div class="um-modal-header"><i class="bi bi-plugin"></i><span>@(_providerForm.RowVersion is null?"Add provider":"Edit provider")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="()=>_editingProvider=false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_providerForm" OnValidSubmit="SaveProviderAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <ValidationSummary />
                <div class="um-form-grid">
                    <div class="intel-field"><label>Provider code</label><InputText @bind-Value="_providerForm.ProviderCode" disabled="@(_providerForm.RowVersion is not null)" /></div>
                    <div class="intel-field"><label>Display name</label><InputText @bind-Value="_providerForm.DisplayName" /></div>
                    <div class="intel-field"><label>Provider type</label><InputText @bind-Value="_providerForm.ProviderTypeCode" /></div>
                    <div class="intel-field"><label>Priority</label><InputNumber @bind-Value="_providerForm.Priority" /></div>
                    <div class="intel-field">
                        <label><InputCheckbox @bind-Value="_providerForm.SupportsChat" /> Chat</label>
                        <label><InputCheckbox @bind-Value="_providerForm.SupportsEmbeddings" /> Embeddings</label>
                        <label><InputCheckbox @bind-Value="_providerForm.SupportsVision" /> Vision</label>
                        <label><InputCheckbox @bind-Value="_providerForm.SupportsStructuredOutput" /> Structured output</label>
                        <label><InputCheckbox @bind-Value="_providerForm.IsActive" /> Active</label>
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                @if(_error is not null){<span class="intel-error">@_error</span>}
                <button type="button" class="um-btn um-btn-ghost" @onclick="()=>_editingProvider=false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save provider</button>
            </div>
        </EditForm>
    </div></div>
}

@if(_editingModel)
{
    <div class="um-modal-backdrop"><div class="um-modal">
        <div class="um-modal-header"><i class="bi bi-cpu"></i><span>@(_modelForm.RowVersion is null?"Add model deployment":"Edit model deployment")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="()=>_editingModel=false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_modelForm" OnValidSubmit="SaveModelAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <ValidationSummary />
                <div class="um-form-grid">
                    <div class="intel-field"><label>Provider</label><InputSelect @bind-Value="_modelForm.ProviderId"><option value="">Select provider</option>@foreach(var provider in _providers){<option value="@provider.ProviderId">@provider.DisplayName</option>}</InputSelect></div>
                    <div class="intel-field"><label>Model code</label><InputText @bind-Value="_modelForm.ModelCode" disabled="@(_modelForm.RowVersion is not null)" /></div>
                    <div class="intel-field"><label>Deployment name</label><InputText @bind-Value="_modelForm.DeploymentName" /></div>
                    <div class="intel-field"><label>Model family</label><InputText @bind-Value="_modelForm.ModelFamily" /></div>
                    <div class="intel-field"><label>Capability</label><InputSelect @bind-Value="_modelForm.CapabilityCode"><option value="CHAT">Chat</option><option value="EMBEDDING">Embedding</option><option value="VISION">Vision</option></InputSelect></div>
                    <div class="intel-field"><label>Currency</label><InputText @bind-Value="_modelForm.CurrencyCode" /></div>
                    <div class="intel-field"><label>Context window tokens</label><InputNumber @bind-Value="_modelForm.ContextWindowTokens" /></div>
                    <div class="intel-field"><label>Maximum output tokens</label><InputNumber @bind-Value="_modelForm.MaximumOutputTokens" /></div>
