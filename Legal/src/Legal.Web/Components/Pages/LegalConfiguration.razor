@code{
private readonly List<AiProviderDto> _providers=[];
private readonly List<AiModelDeploymentDto> _models=[];
private readonly List<AiFeaturePolicyDto> _policies=[];
private readonly List<IntelligencePromptDefinitionDto> _prompts=[];
private readonly List<DecisionPromptConfigurationDto> _decisionPrompts=[];
private readonly List<DecisionSettingDto> _decisionSettings=[];
private readonly List<DecisionModelRouteDto> _decisionRoutes=[];
private readonly List<IntelligenceCapabilityDto> _capabilities=[];
private readonly List<LegalGroundingSettingDto> _legalSettings=[];
private readonly List<EpistemicSettingDto> _epistemicSettings=[];
private bool _showPipeline;
private bool _loading=true,_editing,_editingPrompt,_editingDecisionPrompt,_editingDecisionRoute,_editingProvider,_editingModel,_saving;
private bool _editingLegalSetting;
private bool _editingEpistemicSetting;
private bool _editingDecisionSetting;
private string? _error;
private string? _focusSection;
private string _search=string.Empty;
private PolicyForm _form=new();
private PromptForm _promptForm=new();
private DecisionPromptForm _decisionPromptForm=new();
private DecisionRouteForm _decisionRouteForm=new();
private ProviderForm _providerForm=new();
private ModelForm _modelForm=new();
private LegalSettingForm _legalForm=new();
private EpistemicSettingForm _epistemicForm=new();
private DecisionSettingForm _decisionForm=new();
private ConfirmRequest? _confirm;
private TaskCompletionSource<bool>? _confirmSource;

protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Configuration","/intelligence/configuration"));await LoadAsync();}

private async Task LoadAsync()
{
    _loading=true;_error=null;
    try
    {
        var providers=Api.GetIntelligenceProvidersAsync();
        var models=Api.GetIntelligenceModelsAsync();
        var policies=Api.GetIntelligenceFeaturePoliciesAsync();
        var prompts=Api.GetIntelligencePromptDefinitionsAsync();
        var decisionPrompts=Api.GetDecisionPromptConfigurationsAsync();
        var decisionRoutes=Api.GetDecisionModelRoutesAsync();
        var platform=Api.GetIntelligencePlatformAsync();
        await Task.WhenAll(providers,models,policies,prompts,decisionPrompts,decisionRoutes,platform);
        _providers.Clear();_providers.AddRange(await providers);
        _models.Clear();_models.AddRange(await models);
        _policies.Clear();_policies.AddRange(await policies);
        _prompts.Clear();_prompts.AddRange(await prompts);
        _decisionPrompts.Clear();_decisionPrompts.AddRange(await decisionPrompts);
        _decisionRoutes.Clear();_decisionRoutes.AddRange(await decisionRoutes);
        _decisionSettings.Clear();_decisionSettings.AddRange(await Api.GetDecisionSettingsAsync("Decision.Preflight."));
        _capabilities.Clear();_capabilities.AddRange((await platform)?.Pillars.SelectMany(x=>x.Capabilities)??[]);
        _legalSettings.Clear();_legalSettings.AddRange(await Api.GetLegalGroundingSettingsAsync());
        _epistemicSettings.Clear();_epistemicSettings.AddRange(await Api.GetEpistemicSettingsAsync());
        _showPipeline=await Api.GetShowPipelineAsync();
    }
    catch(Exception ex){_error=ex.Message;}
    finally{_loading=false;}
}

private void EditDecisionPrompt(DecisionPromptConfigurationDto item){_error=null;_decisionPromptForm=DecisionPromptForm.From(item);_editingDecisionPrompt=true;}
private async Task SaveDecisionPromptAsync()
{
    if(!await ConfirmUpdateAsync($"POLOXI decision prompt '{_decisionPromptForm.PromptCode}'"))return;
    _saving=true;_error=null;
    try
    {
        var request=new SaveDecisionPromptConfigurationRequest(_decisionPromptForm.PromptCode,_decisionPromptForm.StageCode,_decisionPromptForm.SystemPrompt,_decisionPromptForm.UserPromptTemplate,string.IsNullOrWhiteSpace(_decisionPromptForm.OutputSchemaJson)?null:_decisionPromptForm.OutputSchemaJson,_decisionPromptForm.IsActive);
        await Api.SaveDecisionPromptConfigurationAsync(_decisionPromptForm.PromptCode,request);
        _editingDecisionPrompt=false;await LoadAsync();
    }
    catch(Exception ex){_error=$"Save failed: {ex.Message}";}
    finally{_saving=false;}
}

private sealed class DecisionPromptForm
{
    [Required,StringLength(120)]public string PromptCode{get;set;}="";
    [Required,StringLength(60)]public string StageCode{get;set;}="";
    [Required]public string SystemPrompt{get;set;}="";
    [Required]public string UserPromptTemplate{get;set;}="";
    public string? OutputSchemaJson{get;set;}
    public bool IsActive{get;set;}=true;
    public static DecisionPromptForm From(DecisionPromptConfigurationDto item)=>new(){PromptCode=item.PromptCode,StageCode=item.StageCode,SystemPrompt=item.SystemPrompt,UserPromptTemplate=item.UserPromptTemplate,OutputSchemaJson=item.OutputSchemaJson,IsActive=item.IsActive};
}

private void EditDecisionRoute(DecisionModelRouteDto item){_error=null;_decisionRouteForm=DecisionRouteForm.From(item);_editingDecisionRoute=true;}
private async Task SaveDecisionRouteAsync()
{
    if(!await ConfirmUpdateAsync($"POLOXI decision model route '{_decisionRouteForm.FeatureCode}'"))return;
    _saving=true;_error=null;
    try
    {
        var request=new SaveDecisionModelRouteRequest(_decisionRouteForm.FeatureCode,_decisionRouteForm.ProviderTypeCode,_decisionRouteForm.ModelCode,_decisionRouteForm.DeploymentName,_decisionRouteForm.EndpointReference,string.IsNullOrWhiteSpace(_decisionRouteForm.CredentialReference)?null:_decisionRouteForm.CredentialReference,_decisionRouteForm.ApiVersion,_decisionRouteForm.TimeoutSeconds,_decisionRouteForm.MaxOutputTokens,_decisionRouteForm.Temperature,_decisionRouteForm.Priority,_decisionRouteForm.IsActive);
        await Api.SaveDecisionModelRouteAsync(_decisionRouteForm.FeatureCode,request);
        _editingDecisionRoute=false;await LoadAsync();
    }
    catch(Exception ex){_error=$"Save failed: {ex.Message}";}
    finally{_saving=false;}
}

private sealed class DecisionRouteForm
{
    [Required,StringLength(120)]public string FeatureCode{get;set;}="";
    [Required,StringLength(60)]public string ProviderTypeCode{get;set;}="";
    [Required,StringLength(100)]public string ModelCode{get;set;}="";
    [Required,StringLength(100)]public string DeploymentName{get;set;}="";
    [Required,StringLength(400)]public string EndpointReference{get;set;}="";
    [StringLength(400)]public string? CredentialReference{get;set;}
    [Required,StringLength(40)]public string ApiVersion{get;set;}="";
    [Range(1,3600)]public int TimeoutSeconds{get;set;}=120;
    [Range(1,100000000)]public int MaxOutputTokens{get;set;}=8000;
    [Range(0,2)]public decimal Temperature{get;set;}=0.20m;
    [Range(0,100000)]public int Priority{get;set;}=100;
    public bool IsActive{get;set;}=true;
    public static DecisionRouteForm From(DecisionModelRouteDto item)=>new(){FeatureCode=item.FeatureCode,ProviderTypeCode=item.ProviderTypeCode,ModelCode=item.ModelCode,DeploymentName=item.DeploymentName,EndpointReference=item.EndpointReference,CredentialReference=item.CredentialReference,ApiVersion=item.ApiVersion,TimeoutSeconds=item.TimeoutSeconds,MaxOutputTokens=item.MaxOutputTokens,Temperature=item.Temperature,Priority=item.Priority,IsActive=true};
}

private async Task SaveShowPipelineAsync()
{
    try{await Api.SaveShowPipelineAsync(_showPipeline);}
    catch(Exception ex){_error=ex.Message;}
}

private void NewProvider(){_error=null;_providerForm=new();_editingProvider=true;}
private void OnSearchInput(ChangeEventArgs e){_search=e.Value?.ToString()??string.Empty;}
private void ClearSearch(){_search=string.Empty;}
private bool HasAnySearchResult =>
    _decisionRoutes.Any(MatchRoute) || _providers.Any(MatchProvider) || _models.Any(MatchModel)
    || _policies.Any(MatchPolicy) || _prompts.Any(MatchPrompt) || _decisionSettings.Any(MatchDecisionSetting)
    || _decisionPrompts.Any(MatchDecisionPrompt) || _legalSettings.Any(MatchLegalSetting)
    || _epistemicSettings.Any(MatchEpistemicSetting)
    || SectionVisible("search result display pipeline diagnostics showpipeline","Search result display");
private bool Contains(string? value)=>!string.IsNullOrEmpty(value)&&value.Contains(_search,StringComparison.OrdinalIgnoreCase);
private bool SectionVisible(string sectionKeywords,string title)=>string.IsNullOrWhiteSpace(_search)||Contains(title)||Contains(sectionKeywords);
private bool MatchAny(params string?[] fields)=>string.IsNullOrWhiteSpace(_search)||fields.Any(Contains);
private bool MatchRoute(DecisionModelRouteDto r)=>MatchAny(r.FeatureCode,r.ModelCode,r.DeploymentName);
private bool MatchProvider(AiProviderDto p)=>MatchAny(p.DisplayName,p.ProviderCode,p.ProviderTypeCode);
private bool MatchModel(AiModelDeploymentDto m)=>MatchAny(m.DeploymentName,m.ProviderCode,m.ModelFamily,m.CapabilityCode);
private bool MatchPolicy(AiFeaturePolicyDto p)=>MatchAny(p.FeatureCode,p.ModuleCode);
private bool MatchPrompt(IntelligencePromptDefinitionDto p)=>MatchAny(p.DisplayName,p.PromptCode,p.VersionLabel,p.CapabilityCode,PromptMeta(p.PromptCode).Category);
private bool MatchDecisionSetting(DecisionSettingDto s)=>MatchAny(s.SettingKey,s.DataTypeCode,s.Description,s.SettingValue);
private bool MatchDecisionPrompt(DecisionPromptConfigurationDto p)=>MatchAny(p.PromptCode,p.StageCode);
private bool MatchLegalSetting(LegalGroundingSettingDto s)=>MatchAny(s.SettingKey,s.DataTypeCode,s.Description);
private bool MatchEpistemicSetting(EpistemicSettingDto s)=>MatchAny(s.SettingKey,s.DataTypeCode,s.Description);
private async Task FocusSectionAsync(string section)
{
    _focusSection=section;
    await Js.InvokeVoidAsync("amsScrollToElement",$"intel-section-{section}");
}
private Task<bool> ConfirmDeleteAsync(string description)=>ShowConfirmAsync(new("Confirm deletion",$"You are about to permanently delete {description}.","This action cannot be undone. Dependent configuration may stop resolving until a replacement is created.","Delete",true));
private Task<bool> ConfirmUpdateAsync(string description)=>ShowConfirmAsync(new("Confirm changes",$"Save changes to {description}?","The updated configuration takes effect immediately for all users of this tenant.","Save changes",false));
private Task<bool> ShowConfirmAsync(ConfirmRequest request)
{
    _confirmSource?.TrySetResult(false);
    _confirm=request;
    _confirmSource=new(TaskCreationOptions.RunContinuationsAsynchronously);
    StateHasChanged();
    return _confirmSource.Task;
}
private void ResolveConfirm(bool result){_confirm=null;_confirmSource?.TrySetResult(result);_confirmSource=null;}
private sealed record ConfirmRequest(string Title,string Message,string? Detail,string ConfirmLabel,bool IsDestructive);
private async Task DeleteProviderAsync(AiProviderDto item)
{
    if(!await ConfirmDeleteAsync($"provider '{item.DisplayName}'"))return;
    _saving=true;_error=null;
    try{await Api.DeleteIntelligenceProviderAsync(item.ProviderCode);await LoadAsync();}
    catch(Exception ex){_error=ex.Message;}
    finally{_saving=false;}
}
private async Task DeleteModelAsync(AiModelDeploymentDto item)
{
    if(!await ConfirmDeleteAsync($"model deployment '{item.DeploymentName}'"))return;
    _saving=true;_error=null;
    try{await Api.DeleteIntelligenceModelDeploymentAsync(item.ModelCode);await LoadAsync();}
    catch(Exception ex){_error=ex.Message;}
    finally{_saving=false;}
}
private async Task DeletePolicyAsync(AiFeaturePolicyDto item)
{
    if(!await ConfirmDeleteAsync($"feature policy '{item.FeatureCode}'"))return;
    _saving=true;_error=null;
