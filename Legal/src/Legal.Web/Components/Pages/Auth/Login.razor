@page "/login"
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation
@attribute [AllowAnonymous]

<PageTitle>Sign in to Judz.ai</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand">
            <img src="image/JudzLogo.png" alt="judz.ai" class="auth-logo" />
            <span class="auth-word"><strong>judz<span>.ai</span></strong><small>EARLY ACCESS</small></span>
        </div>
        <h1 class="auth-title">Sign in</h1>
        <p class="auth-subtitle">Welcome back. Sign in to your Judz.ai workspace.</p>

        @if (_verifiedBanner)
        {
            <div class="auth-note" role="status"><i class="bi bi-check-circle"></i> Email verified. You can now sign in.</div>
        }
        @if (_error is not null)
        {
            <div class="auth-alert" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill"></i> <span>@_error</span></div>
        }

        <form method="post" action="/auth/login" class="auth-form">
            <AntiforgeryToken />
            <div class="auth-field">
                <label>Email</label>
                <input name="email" value="@_email" class="auth-input@(_error is not null ? " invalid" : null)" type="email" autocomplete="email" required />
            </div>
            <div class="auth-field">
                <label>Password</label>
                <input name="password" class="auth-input@(_error is not null ? " invalid" : null)" type="password" autocomplete="current-password" required />
            </div>
            <button type="submit" class="auth-btn">Sign in</button>
        </form>

        <p class="auth-foot">
            <a href="/forgot-password">Forgot password?</a>
            <span class="auth-sep">•</span>
            New here? <a href="/signup">Create an account</a>
        </p>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private bool _verifiedBanner;
    private string? _error;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("email", out var email) && !string.IsNullOrWhiteSpace(email))
            _email = email!;
        _verifiedBanner = query.TryGetValue("verified", out var v) && v == "1";
        if (query.TryGetValue("error", out var err) && !string.IsNullOrWhiteSpace(err))
            _error = err!;
    }
}
