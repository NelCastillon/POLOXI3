@page "/reset-password"
@attribute [AllowAnonymous]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Set a new password</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand">
            <img src="image/JudzLogo.png" alt="judz.ai" class="auth-logo" />
            <span class="auth-word"><strong>judz<span>.ai</span></strong><small>EARLY ACCESS</small></span>
        </div>
        <h1 class="auth-title">Set a new password</h1>
        <p class="auth-subtitle">Choose a new password for your Judz.ai account.</p>

        @if (_error is not null)
        {
            <div class="auth-alert" role="alert"><i class="bi bi-exclamation-triangle"></i> @_error</div>
        }
        @if (_missingToken)
        {
            <div class="auth-alert" role="alert"><i class="bi bi-exclamation-triangle"></i> This reset link is invalid or incomplete. Request a new one.</div>
        }

        <EditForm Model="_form" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            @if (string.IsNullOrWhiteSpace(_prefilledEmail))
            {
                <div class="auth-field">
                    <label>Email</label>
                    <InputText @bind-Value="_form.Email" class="auth-input" type="email" autocomplete="email" />
                    <ValidationMessage For="() => _form.Email" class="text-danger" />
                </div>
            }
            <div class="auth-field">
                <label>New password</label>
                <InputText @bind-Value="_form.NewPassword" class="auth-input" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _form.NewPassword" class="text-danger" />
            </div>
            <div class="auth-field">
                <label>Confirm password</label>
                <InputText @bind-Value="_form.ConfirmPassword" class="auth-input" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _form.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="auth-btn" disabled="@(_busy || _missingToken)">
                @(_busy ? "Updating…" : "Update password")
            </button>
        </EditForm>

        <p class="auth-foot"><a href="/login">Back to sign in</a></p>
    </div>
</div>

@code {
    private readonly ResetForm _form = new();
    private bool _busy;
    private bool _missingToken;
    private string? _error;
    private string? _prefilledEmail;
    private string _token = string.Empty;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("email", out var email) && !string.IsNullOrWhiteSpace(email))
        {
            _prefilledEmail = email!;
            _form.Email = email!;
        }
        if (query.TryGetValue("token", out var token) && !string.IsNullOrWhiteSpace(token))
            _token = token!;
        _missingToken = string.IsNullOrWhiteSpace(_token);
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.ResetPasswordAsync(new ResetPasswordRequest(_form.Email, _token, _form.NewPassword));
            if (!result.Succeeded)
            {
                _error = result.Message;
                return;
            }
            Navigation.NavigateTo($"/login?email={Uri.EscapeDataString(_form.Email)}");
        }
        catch (Exception ex)
        {
            _error = $"Reset failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ResetForm
    {
        [Required, EmailAddress, StringLength(256)]
        public string Email { get; set; } = string.Empty;

        [Required, StringLength(128, MinimumLength = 8)]
        public string NewPassword { get; set; } = string.Empty;

        [Required, Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
