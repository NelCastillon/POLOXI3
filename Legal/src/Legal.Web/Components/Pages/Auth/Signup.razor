@page "/signup"
@attribute [AllowAnonymous]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Create your Judz.ai account</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand">
            <img src="image/JudzLogo.png" alt="judz.ai" class="auth-logo" />
            <span class="auth-word"><strong>judz<span>.ai</span></strong><small>EARLY ACCESS</small></span>
        </div>
        <h1 class="auth-title">Create your account</h1>
        <p class="auth-subtitle">Start your Judz.ai Early Access workspace. We'll email you a 6-digit code to verify your address.</p>

        @if (_error is not null)
        {
            <div class="auth-alert" role="alert"><i class="bi bi-exclamation-triangle"></i> @_error</div>
        }

        @if (_agreementsError is not null)
        {
            <div class="auth-alert" role="alert"><i class="bi bi-exclamation-triangle"></i> @_agreementsError</div>
        }

        @if (_agreementsError is not null)
        {
            <div class="auth-alert" role="alert"><i class="bi bi-exclamation-triangle"></i> @_agreementsError</div>
        }

        <EditForm Model="_form" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <div class="auth-row">
                <div class="auth-field">
                    <label>First name</label>
                    <InputText @bind-Value="_form.FirstName" class="auth-input" autocomplete="given-name" />
                </div>
                <div class="auth-field">
                    <label>Last name</label>
                    <InputText @bind-Value="_form.LastName" class="auth-input" autocomplete="family-name" />
                </div>
            </div>
            <div class="auth-field">
                <label>Work email</label>
                <InputText @bind-Value="_form.Email" class="auth-input" type="email" autocomplete="email" />
                <ValidationMessage For="() => _form.Email" class="text-danger" />
            </div>
            <div class="auth-field">
                <label>Password</label>
                <InputText @bind-Value="_form.Password" class="auth-input" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _form.Password" class="text-danger" />
            </div>
            <div class="auth-consent">
                <div class="auth-consent-label">
                    <InputCheckbox id="accepted-agreements"
                                   @bind-Value="_form.AcceptedAgreements"
                                   class="auth-consent-check"
                                   disabled="@(_busy || !AgreementsAvailable)"
                                   aria-labelledby="agreement-consent-text" />
                    <span id="agreement-consent-text">
                        I have read and agree to the
                        <button type="button" class="auth-document-button" @onclick="() => OpenAgreement(AgreementType.TermsOfService)" disabled="@(!AgreementsAvailable)">@AgreementTitle(AgreementType.TermsOfService, "Terms of Service")</button>
                        and
                        <button type="button" class="auth-document-button" @onclick="() => OpenAgreement(AgreementType.PrivacyPolicy)" disabled="@(!AgreementsAvailable)">@AgreementTitle(AgreementType.PrivacyPolicy, "Privacy Policy")</button>.
                    </span>
                </div>
                <ValidationMessage For="() => _form.AcceptedAgreements" class="text-danger" />
            </div>
            <button type="submit" class="auth-btn" disabled="@(_busy || !_form.AcceptedAgreements || !AgreementsAvailable)">
                @(_busy ? "Creating account…" : "Create account")
            </button>
        </EditForm>

        <p class="auth-foot">Already have an account? <a href="/login">Sign in</a></p>
    </div>
</div>

@if (_selectedAgreement is not null)
{
    <div class="um-modal-backdrop auth-legal-backdrop" role="presentation" @onclick="CloseAgreement">
        <section class="um-modal auth-legal-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="legal-agreement-title"
                 @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <span id="legal-agreement-title">@_selectedAgreement.Title</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseAgreement" aria-label="Close">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="um-modal-body auth-legal-body">
                <p class="auth-legal-meta">Version @_selectedAgreement.Version · Effective @_selectedAgreement.EffectiveAtUtc.ToString("MMMM d, yyyy")</p>
                <pre>@_selectedAgreement.Body</pre>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-primary" @onclick="CloseAgreement">Close</button>
            </div>
        </section>
    </div>
}

@code {
    private readonly SignupForm _form = new();
    private bool _busy;
    private string? _error;
    private string? _agreementsError;
    private IReadOnlyList<LegalAgreementDto> _agreements = [];
    private LegalAgreementDto? _selectedAgreement;

    private bool AgreementsAvailable => FindAgreement(AgreementType.TermsOfService) is not null
        && FindAgreement(AgreementType.PrivacyPolicy) is not null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _agreements = await Api.GetActiveAgreementsAsync();
            if (!AgreementsAvailable)
                _agreementsError = "The Terms of Service and Privacy Policy are temporarily unavailable. Account creation is disabled.";
        }
        catch (Exception ex)
        {
            _agreementsError = $"Failed to load legal agreements: {ex.Message}";
        }
    }

    private LegalAgreementDto? FindAgreement(string agreementType)
        => _agreements.FirstOrDefault(agreement =>
            string.Equals(agreement.AgreementType, agreementType, StringComparison.OrdinalIgnoreCase));

    private string AgreementTitle(string agreementType, string fallback)
        => FindAgreement(agreementType)?.Title ?? fallback;

    private void OpenAgreement(string agreementType)
        => _selectedAgreement = FindAgreement(agreementType);

    private void CloseAgreement()
        => _selectedAgreement = null;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.SignupAsync(new SignupRequest(_form.FirstName, _form.LastName, _form.Email, _form.Password, _form.AcceptedAgreements));
            if (!result.Succeeded)
            {
                _error = result.Message;
                return;
            }
            Navigation.NavigateTo($"/verify-email?email={Uri.EscapeDataString(_form.Email)}");
        }
        catch (Exception ex)
        {
            _error = $"Signup failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class SignupForm
    {
        [Required, StringLength(100)]
        public string FirstName { get; set; } = string.Empty;

        [Required, StringLength(100)]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256)]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(128, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters.")]
        public string Password { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the Terms of Service and Privacy Policy.")]
        public bool AcceptedAgreements { get; set; }
    }
}
