@page "/forgot-password"
@attribute [AllowAnonymous]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Reset your password</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand">
            <img src="image/JudzLogo.png" alt="judz.ai" class="auth-logo" />
            <span class="auth-word"><strong>judz<span>.ai</span></strong><small>EARLY ACCESS</small></span>
        </div>
        <h1 class="auth-title">Forgot your password?</h1>
        <p class="auth-subtitle">Enter your email and we'll send a link to reset your password.</p>

        @if (_error is not null)
        {
            <div class="auth-alert" role="alert"><i class="bi bi-exclamation-triangle"></i> @_error</div>
        }
        @if (_info is not null)
        {
            <div class="auth-note" role="status"><i class="bi bi-info-circle"></i> @_info</div>
        }

        <EditForm Model="_form" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <div class="auth-field">
                <label>Email</label>
                <InputText @bind-Value="_form.Email" class="auth-input" type="email" autocomplete="email" />
                <ValidationMessage For="() => _form.Email" class="text-danger" />
            </div>
            <button type="submit" class="auth-btn" disabled="@_busy">
                @(_busy ? "Sending…" : "Send reset link")
            </button>
        </EditForm>

        <p class="auth-foot"><a href="/login">Back to sign in</a></p>
    </div>
</div>

@code {
    private readonly ForgotForm _form = new();
    private bool _busy;
    private string? _error;
    private string? _info;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        _info = null;
        try
        {
            var result = await Api.ForgotPasswordAsync(new ForgotPasswordRequest(_form.Email));
            _info = result.Message ?? "If the email exists, a password reset link has been sent.";
        }
        catch (Exception ex)
        {
            _error = $"Request failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ForgotForm
    {
        [Required, EmailAddress, StringLength(256)]
        public string Email { get; set; } = string.Empty;
    }
}
