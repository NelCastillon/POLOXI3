@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages

                                    <div class="hi-workspace">
                                        <div class="di-head">
                                            <div class="di-head-icon"><i class="bi bi-people"></i></div>
                                            <div class="di-head-body">
                                                <span>Attorney Decision Input</span>
                                                <h4>Human Intelligence</h4>
                                                <p class="dfi-panel-sub">Authorized attorneys contribute structured professional judgment — inclusion, placement, relative value and rationale — directly into the decision model. POLOXI remains the single authoritative evaluator.</p>
                                            </div>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm di-refresh" @onclick="Owner.LoadHumanIntelligenceAsync" disabled="@Owner._humanIntelLoading" title="Reload human intelligence">
                                                <i class="bi @(Owner._humanIntelLoading ? "bi-arrow-repeat di-spin" : "bi-arrow-clockwise")"></i>
                                            </button>
                                            @if (Owner._humanIntel is { AttorneyDecisionInputEnabled: true })
                                            {
                                                <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="Owner.OpenAddPropositionAsync" title="Add a candidate, factor or proposition to the decision model">
                                                    <i class="bi bi-plus-lg"></i><span>Add Proposition</span>
                                                         </button>
                                                     }
                                                 </div>

                                                <AttorneyPropositionWorkspace Candidates="Owner.ApwCandidates"
                                                                              TreeColumnsOverride="Owner.ApwTreeColumns"
                                                                              @bind-SelectedCandidateId="Owner._apwSelectedCandidateId"
                                                                              PreviewHandler="Owner.ApwPreviewAsync"
                                                                              ApplyHandler="Owner.ApwApplyAsync"
                                                                              UndoHandler="Owner.ApwUndoAsync" />

                                                @if (Owner._humanIntelError is not null)
                                                {
                                                    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@Owner._humanIntelError</div>
                                                }
                                        else if (Owner._humanIntelLoading && Owner._humanIntel is null)
                                        {
                                            <div class="di-empty"><i class="bi bi-hourglass-split"></i><p>Loading human intelligence…</p></div>
                                        }
                                        else if (Owner._humanIntel is { AttorneyDecisionInputEnabled: false })
                                        {
                                            <div class="di-empty">
                                                <i class="bi bi-lock"></i>
                                                <p>Attorney Decision Input is not enabled for this workspace. Enable <code>AttorneyDecisionInput.Enabled</code> in decision settings to contribute and view attorney decision nodes.</p>
                                            </div>
                                        }
                                        else if (Owner._humanIntel is null || Owner._humanIntel.NodeCount == 0)
                                        {
                                            <div class="di-empty">
                                                <i class="bi bi-person-plus"></i>
                                                <p>No attorney decision input yet for this matter. When authorized attorneys add candidates, factors or propositions to the decision model, their assessments and approvals will appear here.</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="di-kpis">
                                                <div class="di-kpi"><span class="di-kpi-val">@Owner._humanIntel.NodeCount</span><span class="di-kpi-lbl">Decision nodes</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@Owner._humanIntel.AttorneyCount</span><span class="di-kpi-lbl">Attorneys</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@Owner._humanIntel.AssessmentCount</span><span class="di-kpi-lbl">Assessments</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@Owner._humanIntel.ApprovedAssessmentCount</span><span class="di-kpi-lbl">Approved</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@Owner._humanIntel.OpenChallengeCount</span><span class="di-kpi-lbl">Open challenges</span></div>
                                            </div>

                                            <div class="di-grid">
                                                <div class="di-col">
                                                    <h5 class="di-col-title"><i class="bi bi-diagram-3"></i> Decision model hierarchy</h5>
                                                    @foreach (var node in Owner.HiNodes)
                                                    {
                                                        <button type="button" class="di-doc @(Owner._hiSelectedNodeId == node.DecisionNodeId ? "di-doc--active" : "")"
                                                                style="padding-left:@(8 + Math.Max(0, node.NodeLevel - 1) * 14)px"
                                                                @onclick="() => Owner._hiSelectedNodeId = node.DecisionNodeId">
                                                            <div class="di-doc-main">
                                                                <span class="di-pill di-pill-@LegalPersonalInjuryDecision2.HiKindTone(node.NodeKindCode)">L@node.NodeLevel</span>
                                                                <span class="di-doc-name" title="@node.NodeText">@node.NodeText</span>
                                                            </div>
                                                            <div class="di-doc-meta">
                                                                <span class="di-tag">@node.OriginCode</span>
                                                                @if (node.ApprovedAssessment is { } approved)
                                                                {
                                                                    <span class="di-doc-count" title="Approved matter assessment">@approved.ConfirmedValue.ToString("0.##")</span>
                                                                }
                                                                else if (node.Assessments.Count > 0)
                                                                {
                                                                    <span class="di-doc-count" title="Attorney assessments">@node.Assessments.Count</span>
                                                                }
                                                            </div>
                                                        </button>
                                                    }
                                                </div>

                                                <div class="di-col">
                                                    @if (Owner.HiSelectedNode is { } sel)
                                                    {
                                                        <h5 class="di-col-title"><i class="bi bi-card-list"></i> Selected node</h5>
                                                        <div class="dfi-panel-card">
                                                            <p class="di-prop-text">@sel.NodeText</p>
                                                            <ul class="dfi-list">
                                                                <li>Kind <span class="dfi-pill">@sel.NodeKindCode (L@sel.NodeLevel)</span></li>
                                                                <li>Origin <span class="dfi-pill">@sel.OriginCode</span></li>
                                                                <li>Structural <span class="dfi-pill">@sel.StructuralStateCode</span></li>
                                                                <li>Evidence <span class="dfi-pill">@sel.EvidenceStateCode</span></li>
                                                                <li>Authority <span class="dfi-pill">@sel.AuthorityStateCode</span></li>
                                                                <li>Final evaluated POLOXI value <span class="dfi-pill">@(sel.EvaluatedValue?.ToString("0.##") ?? "Pending")</span></li>
                                                                @if (sel.ApprovedAssessment is { } ap)
                                                                {
                                                                    <li>Approved matter assessment <span class="dfi-pill">@ap.ConfirmedValue.ToString("0.##") · @ap.ApprovedByDisplayName</span></li>
                                                                }
                                                            </ul>
                                                        </div>

                                                        <h5 class="di-col-title"><i class="bi bi-people"></i> Attorney assessments</h5>
                                                        @if (Owner._humanIntel is { AttorneyDecisionInputEnabled: true })
                                                        {
                                                            <div class="adi-node-actions">
                                                                <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="Owner.OpenAssessForm" disabled="@Owner._hiNodeBusy"><i class="bi bi-pencil-square"></i> Add assessment</button>
                                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="Owner.OpenRepositionForm" disabled="@Owner._hiNodeBusy"><i class="bi bi-arrows-move"></i> Reposition</button>
                                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="Owner.OpenChallengeForm" disabled="@Owner._hiNodeBusy"><i class="bi bi-flag"></i> Raise challenge</button>
                                                            </div>
                                                            @if (Owner._hiNodeError is not null)
                                                            {
                                                                <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@Owner._hiNodeError</div>
                                                            }
                                                            else if (Owner._hiNodeNotice is not null)
                                                            {
                                                                <div class="alert alert-success">@Owner._hiNodeNotice</div>
                                                            }
                                                            @if (Owner._showAssessForm)
                                                            {
                                                                <div class="dfi-panel-card">
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Relative assessment (@Owner._assessValue.ToString("0.#"))</label>
                                                                        <input type="range" min="0" max="100" step="1" @bind="Owner._assessValue" @bind:event="oninput" />
                                                                    </div>
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Rationale (optional)</label>
                                                                        <textarea class="form-control" rows="2" @bind="Owner._assessRationale" placeholder="Basis for your professional judgment."></textarea>
                                                                    </div>
                                                                    <div class="um-modal-footer">
                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => Owner._showAssessForm = false" disabled="@Owner._hiNodeBusy">Cancel</button>
                                                                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="Owner.SubmitAssessmentAsync" disabled="@Owner._hiNodeBusy">@(Owner._hiNodeBusy ? "Saving…" : "Submit assessment")</button>
                                                                    </div>
                                                                </div>
                                                            }
                                                            @if (Owner._showChallengeForm)
                                                            {
                                                                <div class="dfi-panel-card">
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Challenge type</label>
                                                                        <select class="form-select" @bind="Owner._challengeType">
                                                                            @foreach (var ct in LegalPersonalInjuryDecision2.HiChallengeTypes)
                                                                            {
                                                                                <option value="@ct">@ct</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Challenge detail</label>
                                                                        <textarea class="form-control" rows="2" @bind="Owner._challengeText" placeholder="Describe the structural, placement, duplicate or premise concern."></textarea>
                                                                    </div>
                                                                    <div class="um-modal-footer">
                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => Owner._showChallengeForm = false" disabled="@Owner._hiNodeBusy">Cancel</button>
                                                                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="Owner.SubmitChallengeAsync" disabled="@Owner._hiNodeBusy">@(Owner._hiNodeBusy ? "Saving…" : "Raise challenge")</button>
                                                                    </div>
                                                                </div>
                                                            }
                                                            @if (Owner._showRepositionForm)
                                                            {
                                                                <div class="dfi-panel-card">
                                                                    <p class="adi-disclosure"><i class="bi bi-info-circle"></i> Repositioning records a new node version and a DecisionDelta. It updates relative placement — not an evidence score.</p>
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Relative value (@Owner._repositionValue.ToString("0.#"))</label>
                                                                        <input type="range" min="0" max="100" step="1" @bind="Owner._repositionValue" @bind:event="oninput" />
                                                                    </div>
                                                                    <div class="adi-field adi-field--full">
                                                                        <label>Rationale (optional)</label>
                                                                        <textarea class="form-control" rows="2" @bind="Owner._repositionRationale" placeholder="Why the placement is changing."></textarea>
                                                                    </div>
                                                                    <div class="um-modal-footer">
                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => Owner._showRepositionForm = false" disabled="@Owner._hiNodeBusy">Cancel</button>
                                                                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="Owner.RepositionNodeAsync" disabled="@Owner._hiNodeBusy">@(Owner._hiNodeBusy ? "Saving…" : "Reposition node")</button>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                        @if (sel.Assessments.Count == 0)
                                                        {
                                                            <p class="dfi-empty">No attorney assessments recorded for this node yet.</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="dfi-table-wrap">
                                                                <table class="dfi-table">
                                                                    <thead>
                                                                        <tr><th>Attorney</th><th>Role</th><th>Assessment</th><th>Rationale</th><th>Status</th><th>Date</th><th></th></tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var a in sel.Assessments)
                                                                        {
                                                                            <tr>
                                                                                <td>@(string.IsNullOrWhiteSpace(a.AttorneyDisplayName) ? "—" : a.AttorneyDisplayName)</td>
                                                                                <td>@(a.AttorneyRole ?? "—")</td>
                                                                                <td>@a.ConfirmedValue.ToString("0.##")</td>
                                                                                <td>@(string.IsNullOrWhiteSpace(a.Rationale) ? "—" : a.Rationale)</td>
                                                                                <td><span class="dfi-pill">@a.StatusCode</span></td>
                                                                                <td>@a.CreatedDateUtc.ToString("yyyy-MM-dd")</td>
                                                                                <td>
                                                                                    @if (Owner._humanIntel is { AttorneyDecisionInputEnabled: true } && (sel.ApprovedAssessment is null || sel.ApprovedAssessment.AssessmentId != a.AssessmentId))
                                                                                    {
                                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => Owner.ApproveAssessmentAsync(a.AssessmentId)" disabled="@Owner._hiNodeBusy" title="Approve as the active matter assessment"><i class="bi bi-check2-circle"></i> Approve</button>
                                                                                    }
                                                                                    else if (sel.ApprovedAssessment is { } sa && sa.AssessmentId == a.AssessmentId)
                                                                                    {
                                                                                        <span class="dfi-pill">Approved</span>
                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                            <p class="dfi-prototype-note">Multiple attorneys may independently assess one canonical node. Assessments are never automatically averaged; only a single governance-approved matter assessment is eligible for authoritative POLOXI scoring.</p>
                                                        }
                                                    }
                                                                     else
                                                                     {
                                                                         <div class="di-empty"><i class="bi bi-hand-index"></i><p>Select a decision node to review its attorney assessments and approval status.</p></div>
                                                                     }
                                                                 </div>
                                                             </div>
                                                        }
                                                    </div>

                                                    @if (Owner._adiShowWizard)
                                                    {
                                                        <div class="um-modal-backdrop" @onclick="Owner.CloseAddProposition">
                                                            <div class="um-modal um-modal--xl" @onclick:stopPropagation="true">
                                                                <div class="um-modal-header">
                                                                    <i class="bi bi-plus-square"></i>
                                                                    <span>Add Proposition — Attorney Decision Input</span>
                                                                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="Owner.CloseAddProposition"><i class="bi bi-x-lg"></i></button>
                                                                </div>
                                                                <div class="um-modal-body adi-editor">
                                                                    <div class="adi-editor-col adi-editor-left">
                                                                        <div class="adi-panel-num">1</div>
                                                                        <div class="adi-panel-head">
                                                                            <h5>Decision Model Hierarchy</h5>
                                                                            <div class="adi-tree-tabs" role="tablist">
                                                                                @foreach (var v in new[] { "Hierarchy", "List View", "Search" })
                                                                                {
                                                                                    <button type="button" class="adi-tree-tab @(Owner._adiTreeView == v ? "adi-tree-tab--active" : "")" @onclick="() => Owner._adiTreeView = v">@v</button>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                        @if (Owner._adiTreeView == "Search")
                                                                        {
                                                                            <div class="adi-tree-search">
                                                                                <i class="bi bi-search"></i>
                                                                                <input type="text" placeholder="Search nodes…" @bind="Owner._adiTreeSearch" @bind:event="oninput" />
                                                                            </div>
                                                                        }
                                                                        <div class="adi-tree">
                                                                            @if (Owner._adiTreeView == "Hierarchy")
                                                                            {
                                                                                @if (!Owner.AdiHasLiveHierarchy)
                                                                                {
                                                                                    <p class="adi-tree-empty">No decision hierarchy yet. Run a decision analysis so the hierarchy (L1/L2/L3…) is available for placement.</p>
                                                                                }
                                                                                @foreach (var root in Owner.AdiBranchRoots)
                                                                                {
                                                                                    var rootCollapsed = Owner.AdiBranchCollapsed(root.WideBranchId);
                                                                                    <div class="adi-tree-group">
                                                                                        <button type="button" class="adi-tree-row adi-tree-row--candidate @(Owner._adiBranchId == root.WideBranchId ? "adi-tree-row--active" : "")"
                                                                                                @onclick="() => Owner.AdiSelectBranch(root.WideBranchId)">
                                                                                            <span class="adi-tree-caret" @onclick:stopPropagation="true" @onclick="() => Owner.AdiToggleBranch(root.WideBranchId)">
                                                                                                <i class="bi @(rootCollapsed ? "bi-chevron-right" : "bi-chevron-down")"></i>
                                                                                            </span>
                                                                                            <span class="adi-tree-code">@LegalPersonalInjuryDecision2.AdiBranchCode(root)</span>
                                                                                            <span class="adi-tree-text" title="@root.Interpretation">@root.DisplayName</span>
                                                                                            <span class="adi-tree-lvl">L1</span>
                                                                                        </button>
                                                                                        @if (!rootCollapsed)
                                                                                        {
                                                                                            @Owner.AdiBranchTree(root.WideBranchId, 1)
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                @foreach (var node in Owner.AdiFlatNodes)
                                                                                {
                                                                                    var nScore = LegalPersonalInjuryDecision2.AdiNodeScore(node);
                                                                                    <button type="button" class="adi-tree-row adi-tree-flat @(Owner._hiSelectedNodeId == node.DecisionNodeId ? "adi-tree-row--active" : "")"
                                                                                            @onclick="() => Owner._hiSelectedNodeId = node.DecisionNodeId">
                                                                                        <span class="adi-tree-lvl">L@node.NodeLevel</span>
                                                                                        <span class="adi-tree-text" title="@node.NodeText">@node.NodeText</span>
                                                                                        <span class="adi-score adi-score--@LegalPersonalInjuryDecision2.AdiScoreTone(nScore)">@(nScore?.ToString("0") ?? "—")</span>
                                                                                    </button>
                                                                                }
                                                                                @if (Owner.AdiFlatNodes.Count == 0)
                                                                                {
                                                                                    <p class="adi-tree-empty">No matching nodes.</p>
                                                                                }
                                                                            }
                                                                        </div>
                                                                    </div>

                                                                    <div class="adi-editor-col adi-editor-mid">
                                                                    <div class="adi-steps">
                                                                        @foreach (var (idx, label) in LegalPersonalInjuryDecision2.AdiSteps.Select((l, i) => (i + 1, l)))
                                                                        {
                                                                            <div class="adi-step @(Owner._adiStep == idx ? "adi-step--active" : Owner._adiStep > idx ? "adi-step--done" : "")">
                                                                                <span class="adi-step-num">@idx</span><span class="adi-step-lbl">@label</span>
                                                                            </div>
                                                                        }
                                                                    </div>

                                                                    @if (Owner._adiError is not null)
                                                                    {
                                                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@Owner._adiError</div>
                                                                    }

                                                                    @switch (Owner._adiStep)
                                                                    {
                                                                        case 1:
                                                                            <div class="um-form-grid">
                                                                                <div class="adi-field">
                                                                                    <label>Proposition type</label>
                                                                                    <div class="adi-type-row">
                                                                                        @foreach (var (kind, lvl, lbl) in LegalPersonalInjuryDecision2.AdiTypeOptions)
                                                                                        {
                                                                                            <button type="button" class="adi-type @(Owner._adiKind == kind && Owner._adiLevel == lvl ? "adi-type--active" : "")" @onclick="() => Owner.SelectAdiType(kind, lvl)">@lbl</button>
                                                                                        }
                                                                                    </div>
                                                                                </div>
                                                                                <div class="adi-field">
                                                                                    <label>Owning candidate (L1 scope)</label>
                                                                                    <select class="form-select" @bind="Owner._adiCandidateNodeId">
                                                                                        <option value="">— Select candidate —</option>
                                                                                        @foreach (var c in Owner.HiNodes.Where(n => n.NodeLevel == 1))
                                                                                        {
                                                                                            <option value="@c.DecisionNodeId">@c.NodeText</option>
                                                                                        }
                                                                                    </select>
                                                                                </div>
                                                                                <div class="adi-field">
                                                                                    <label>Parent node (placement)</label>
                                                                                    <select class="form-select" @bind="Owner._adiParentNodeId">
                                                                                        <option value="">— Top of candidate —</option>
                                                                                        @foreach (var p in Owner.HiNodes.Where(n => n.NodeLevel == Owner._adiLevel - 1))
                                                                                        {
                                                                                            <option value="@p.DecisionNodeId">L@p.NodeLevel · @p.NodeText</option>
                                                                                        }
                                                                                    </select>
                                                                                </div>
                                                                                <div class="adi-field adi-field--full">
                                                                                    <label>Proposition text</label>
                                                                                    <textarea class="form-control" rows="3" maxlength="500" @bind="Owner._adiText" placeholder="State the proposition as a single, independently evaluable assertion."></textarea>
                                                                                </div>
                                                                                <div class="adi-field adi-field--full">
                                                                                    <label>Rationale (optional)</label>
                                                                                    <textarea class="form-control" rows="2" @bind="Owner._adiRationale" placeholder="Why it matters, or why an existing node/relationship is disputed."></textarea>
                                                                                </div>
                                                                            </div>
                                                                            @if (Owner._adiDraft is { } draft)
                                                                            {
                                                                                <div class="adi-checks">
                                                                                    <span class="adi-check adi-check--@(draft.AtomicityDisposition == "Atomic" ? "ok" : draft.AtomicityDisposition == "NotApplicable" ? "muted" : "warn")"><i class="bi bi-diagram-3"></i> Atomicity: @draft.AtomicityDisposition</span>
                                                                                    <span class="adi-check adi-check--@(draft.ParentFidelity == "Good" ? "ok" : "warn")"><i class="bi bi-signpost"></i> Parent fit: @draft.ParentFidelity</span>
                                                                                    <span class="adi-check adi-check--@(draft.PossibleDuplicates.Count == 0 ? "ok" : "warn")"><i class="bi bi-files"></i> Duplicates: @(draft.PossibleDuplicates.Count == 0 ? "None found" : $"{draft.PossibleDuplicates.Count} possible")</span>
                                                                                    <span class="adi-check adi-check--muted"><i class="bi bi-bank"></i> @draft.LegalContextSummary</span>
                                                                                </div>
                                                                            }
                                                                            break;

                                                                        case 2:
                                                                            <p class="adi-disclosure"><i class="bi bi-info-circle"></i> @(Owner._adiPlacement?.Disclosure ?? "Set a relative value based on your professional judgment. This is not an evidence score.")</p>
                                                                            <div class="adi-placement">
                                                                                <div class="adi-neighbor">
                                                                                    <span class="adi-neighbor-lbl">Previous</span>
                                                                                    <span class="adi-neighbor-txt">@(Owner._adiPlacement?.PreviousSiblingText ?? "—")</span>
                                                                                    <span class="adi-neighbor-val">@(Owner._adiPlacement?.PreviousSiblingValue?.ToString("0.#") ?? "—")</span>
                                                                                </div>
                                                                                <div class="adi-slider">
                                                                                    <div class="adi-slider-val">@Owner._adiConfirmedValue.ToString("0.#")</div>
                                                                                    <input type="range" min="@((double)(Owner._adiPlacement?.LowerBound ?? 0))" max="@((double)(Owner._adiPlacement?.UpperBound ?? 100))" step="1" @bind="Owner._adiConfirmedValue" @bind:event="oninput" />
                                                                                    @if (Owner._adiPlacement is { SuggestedMidpoint: { } mid })
                                                                                    {
                                                                                        <label class="adi-midpoint"><input type="checkbox" checked="@Owner._adiUseMidpoint" @onchange="e => Owner.ApplyMidpoint((bool)e.Value!)" /> Use midpoint (@mid.ToString("0.#"))</label>
                                                                                    }
                                                                                </div>
                                                                                <div class="adi-neighbor">
                                                                                    <span class="adi-neighbor-lbl">Next</span>
                                                                                    <span class="adi-neighbor-txt">@(Owner._adiPlacement?.NextSiblingText ?? "—")</span>
                                                                                    <span class="adi-neighbor-val">@(Owner._adiPlacement?.NextSiblingValue?.ToString("0.#") ?? "—")</span>
                                                                                </div>
                                                                            </div>
                                                                            break;

                                                                        case 3:
                                                                            @if (Owner._adiPreview is { } pv)
                                                                            {
                                                                                <div class="adi-preview">
                                                                                    <div class="adi-preview-scores">
                                                                                        <div class="adi-score"><span class="adi-score-lbl">Current</span><span class="adi-score-val">@pv.CurrentCandidateScore.ToString("0.#")</span></div>
                                                                                        <i class="bi bi-arrow-right"></i>
                                                                                        <div class="adi-score"><span class="adi-score-lbl">Projected</span><span class="adi-score-val">@pv.ProjectedCandidateScore.ToString("0.#")</span><span class="adi-score-delta @(pv.CandidateScoreDelta >= 0 ? "adi-up" : "adi-down")">@pv.CandidateScoreDelta.ToString("+0.#;-0.#;0")</span></div>
                                                                                    </div>
                                                                                    <ul class="dfi-list">
                                                                                        <li>Uncertainty ? <span class="dfi-pill">+@pv.UncertaintyDelta.ToString("0.####")</span></li>
                                                                                        <li>Information Value <span class="dfi-pill">@pv.InformationValueBand</span></li>
                                                                                        <li>Decision Frontier <span class="dfi-pill">@(pv.FrontierChanged ? "May change" : "Unchanged")</span></li>
                                                                                        <li>Readiness <span class="dfi-pill">@(pv.ReadinessBefore ?? "—") ? @(pv.ReadinessAfter ?? "—")</span></li>
                                                                                        <li>Affected path <span class="dfi-pill">@string.Join(" ? ", pv.AffectedPath)</span></li>
                                                                                    </ul>
                                                                                    @if (pv.ScoreProjectionAdvisory)
                                                                                    {
                                                                                        <p class="adi-disclosure"><i class="bi bi-info-circle"></i> @pv.ExplanationSummary</p>
                                                                                    }
                                                                                    @if (pv.IntegrityFindings.Count > 0)
                                                                                    {
                                                                                        <div class="adi-findings">@foreach (var f in pv.IntegrityFindings){<span class="adi-finding">@f</span>}</div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="di-empty"><i class="bi bi-hourglass-split"></i><p>Preparing preview…</p></div>
                                                                            }
                                                                            break;

                                                                        case 4:
                                                                            <div class="um-form-grid">
                                                                                <div class="adi-field adi-field--full">
                                                                                    <label>Proposition</label>
                                                                                    <p class="di-prop-text">@Owner._adiText</p>
                                                                                </div>
                                                                                <div class="adi-field"><label>Relative assessment</label><p class="di-prop-text">@Owner._adiConfirmedValue.ToString("0.#")</p></div>
                                                                                <div class="adi-field"><label>Method</label><p class="di-prop-text">@(Owner._adiPlacement?.MethodCode ?? "BoundedEntry")</p></div>
                                                                                                <div class="adi-field adi-field--full">
                                                                                                    <label class="adi-checkbox"><input type="checkbox" @bind="Owner._adiRequestApproval" /> Request approval as the Approved Matter Assessment (governance permitting)</label>
                                                                                                </div>
                                                                                            </div>
                                                                                            break;
                                                                                    }
                                                                                    </div>

                                                                                    <div class="adi-editor-col adi-editor-right">
                                                                                        <div class="adi-side-card">
                                                                                            <div class="adi-side-head"><span>Candidate Overview</span></div>
                                                                                            @if (Owner.HiNodes.FirstOrDefault(n => n.DecisionNodeId == Owner._adiCandidateNodeId) is { } ov)
                                                                                            {
                                                                                                var ovScore = LegalPersonalInjuryDecision2.AdiNodeScore(ov);
                                                                                                <div class="adi-gauge">
                                                                                                    <div class="adi-gauge-ring adi-gauge-ring--@LegalPersonalInjuryDecision2.AdiScoreTone(ovScore)">
                                                                                                        <span class="adi-gauge-val">@(ovScore?.ToString("0") ?? "—")</span>
                                                                                                    </div>
                                                                                                    <span class="adi-gauge-lbl">POLOXI Decision Score</span>
                                                                                                </div>
                                                                                                <ul class="adi-side-list">
                                                                                                    <li><span>Candidate</span><strong>@Owner.AdiCandidateCode(ov.DecisionNodeId)</strong></li>
                                                                                                    <li><span>Evidence state</span><strong>@ov.EvidenceStateCode</strong></li>
                                                                                                    <li><span>Authority state</span><strong>@ov.AuthorityStateCode</strong></li>
                                                                                                    <li><span>Structural</span><strong>@ov.StructuralStateCode</strong></li>
                                                                                                </ul>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <p class="adi-side-empty">Select a candidate in the hierarchy to view its overview.</p>
                                                                                            }
                                                                                        </div>

                                                                                        <div class="adi-side-card">
                                                                                            <div class="adi-side-head"><span>Preview Impact (Real-time Simulation)</span></div>
                                                                                            @if (Owner._adiPreview is { } pvr)
                                                                                            {
                                                                                                <div class="adi-side-scores">
                                                                                                    <div class="adi-side-score"><span>Current</span><strong>@pvr.CurrentCandidateScore.ToString("0.#")</strong></div>
                                                                                                    <i class="bi bi-arrow-right"></i>
                                                                                                    <div class="adi-side-score">
                                                                                                        <span>Projected</span>
                                                                                                        <strong>@pvr.ProjectedCandidateScore.ToString("0.#")
                                                                                                            <span class="adi-side-delta @(pvr.CandidateScoreDelta >= 0 ? "adi-up" : "adi-down")">@pvr.CandidateScoreDelta.ToString("+0.#;-0.#;0")</span>
                                                                                                        </strong>
                                                                                                    </div>
                                                                                                </div>
                                                                                                <p class="adi-side-why">@pvr.ExplanationSummary</p>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <p class="adi-side-empty">Advance to Preview Impact to simulate how this proposition changes the decision.</p>
                                                                                            }
                                                                                        </div>

                                                                                        <div class="adi-side-card">
                                                                                            <div class="adi-side-head"><span>Selected Node Details (Preview)</span></div>
                                                                                            @if (Owner.HiSelectedNode is { } selr)
                                                                                            {
                                                                                                <p class="adi-side-nodetext">@selr.NodeText</p>
                                                                                                <ul class="adi-side-list">
                                                                                                    <li><span>Kind</span><strong>@selr.NodeKindCode (L@selr.NodeLevel)</strong></li>
                                                                                                    <li><span>Status</span><strong>@selr.StructuralStateCode</strong></li>
                                                                                                    <li><span>Evidence</span><strong>@selr.EvidenceStateCode</strong></li>
                                                                                                    <li><span>Final evaluated</span><strong>@(selr.EvaluatedValue?.ToString("0.##") ?? "Pending")</strong></li>
                                                                                                </ul>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <p class="adi-side-empty">Select a node to preview its authoritative details.</p>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                <div class="um-modal-footer">
                                                                    @if (Owner._adiStep > 1)
                                                                    {
                                                                        <button type="button" class="um-btn um-btn-ghost" @onclick="Owner.AdiBack" disabled="@Owner._adiBusy"><i class="bi bi-arrow-left"></i> Back</button>
                                                                    }
                                                                    @if (Owner._adiStep < 4)
                                                                    {
                                                                        <button type="button" class="um-btn um-btn-primary" @onclick="Owner.AdiNext" disabled="@(Owner._adiBusy || !Owner.AdiCanAdvance)">
                                                                            @(Owner._adiBusy ? "Working…" : Owner.AdiStep == 3 ? "Confirm" : "Next") <i class="bi bi-arrow-right"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="um-btn um-btn-primary" @onclick="Owner.AdiCommitAsync" disabled="@Owner._adiBusy">
                                                                            <i class="bi bi-check-lg"></i> @(Owner._adiBusy ? "Committing…" : "Add to Decision Model")
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

@code {
    [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;
}