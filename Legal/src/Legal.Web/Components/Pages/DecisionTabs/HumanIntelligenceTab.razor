@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages
@using Legal.Web.Components.Shared

@* ── Human Intelligence tab: Atomic Proposition workspace ──
   The prior attorney-decision-node workspace has been replaced with the matter
   Atomic Proposition editor (the Add Atomic Proposition pop up) so attorneys manage
   atomic propositions and attach document evidence directly from this tab. *@

@if (Owner.MatterId is { } matterId && matterId != Guid.Empty)
{
    <div class="hi-workspace">
        <MatterAtomicPropositionEditor MatterId="matterId" OnRescoreRequested="Owner.ReRunDecisionFromHumanIntelligenceAsync" />
    </div>
}
else
{
    <div class="di-empty">
        <i class="bi bi-diagram-3"></i>
        <p>Select a matter to add and manage atomic propositions.</p>
    </div>
}

@code {
    [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;
}
