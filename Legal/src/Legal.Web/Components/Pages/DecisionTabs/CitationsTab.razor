@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages
@inject ApiClient Api
@inject NavigationManager Navigation

@* ── Citations tab. A consolidated, filterable view of every legal-authority citation
     proposed or verified for this matter's latest decision session. Reuses the same
     DaAuthorities pool and verification semantics as the Legal Authority tab;
     it never changes verification state. ── *@

@{
    var authorities = CitationTableAuthorities;
    var distinct = authorities
        .Where(a => !string.IsNullOrWhiteSpace(a.Name))
        .GroupBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
        .Select(g => g.First())
        .OrderBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    var verifiedCount = distinct.Count(a => IsVerified(a.VerificationStatus));
    var unverifiedCount = distinct.Length - verifiedCount;
    var filtered = _filter switch
    {
        "VERIFIED" => distinct.Where(a => IsVerified(a.VerificationStatus)).ToArray(),
        "UNVERIFIED" => distinct.Where(a => !IsVerified(a.VerificationStatus)).ToArray(),
        _ => distinct
    };
    if (!string.IsNullOrWhiteSpace(_search))
    {
        filtered = filtered
            .Where(a => a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                     || (a.Kind?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                     || (a.Relevance?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToArray();
    }
}

<div class="cit-root">
    <div class="cit-topbar">
        <div class="cit-topbar-title">
            <span class="cit-topbar-icon"><i class="bi bi-quote" aria-hidden="true"></i></span>
            <div>
                <h4>Citations &mdash; Legal Authority References</h4>
                <p class="dfi-panel-sub">Every distinct legal authority citation proposed or verified for this matter's latest decision session. Citations are AI-proposed leads marked <strong>Unverified</strong> unless a retrieved external source matched their identity, in which case they are marked <strong>Verified</strong>. Recognizing a citation is never treated as verification &mdash; Unverified reflects retrieval/configuration state, not bad law. Each links to an external lookup for independent review.</p>
            </div>
        </div>
    </div>

    @if (distinct.Length == 0)
    {
        <div class="dfi-panel-card">
            <p class="dfi-panel-sub">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                No legal authority citations were proposed or retrieved for this session. If citations never appear, the AI legal-authority proposal pass is disabled (config <code>Intelligence.SearchWide.EnableLegalAuthorityProposal</code>) or the decision did not run in the Legal context. Verified status additionally requires an enabled external-grounding provider.
            </p>
        </div>
    }
    else
    {
        <div class="cit-kpi-strip">
            <button type="button" class="cit-kpi @(_filter == "ALL" ? "cit-kpi--active" : null)" @onclick='() => _filter = "ALL"' title="Show all citations">
                <span class="cit-kpi-label">All citations</span>
                <span class="cit-kpi-value">@distinct.Length</span>
            </button>
            <button type="button" class="cit-kpi cit-kpi--ok @(_filter == "VERIFIED" ? "cit-kpi--active" : null)" @onclick='() => _filter = "VERIFIED"' title="Identity-matched against a retrieved source">
                <span class="cit-kpi-label">Verified</span>
                <span class="cit-kpi-value">@verifiedCount</span>
            </button>
            <button type="button" class="cit-kpi cit-kpi--warn @(_filter == "UNVERIFIED" ? "cit-kpi--active" : null)" @onclick='() => _filter = "UNVERIFIED"' title="AI-proposed leads not yet identity-verified">
                <span class="cit-kpi-label">Unverified</span>
                <span class="cit-kpi-value">@unverifiedCount</span>
            </button>
        </div>

        <div class="cit-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" class="cit-search-input" placeholder="Search citations by name, kind, or relevance&hellip;" @bind="_search" @bind:event="oninput" />
        </div>

        <div class="dfi-panel-card">
            @if (filtered.Length == 0)
            {
                <p class="dfi-panel-sub">No citations match the current filter.</p>
            }
            else
            {
                <table class="table table-sm cit-table">
                    <thead>
                        <tr><th>Citation</th><th>Kind</th><th>Relevance</th><th>Verification</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in filtered)
                        {
                            <tr>
                                <td>
                                    @{ var cLink = ResolveCitationLink(c.Name); }
                                    <button type="button" class="cit-link cit-link--btn" @onclick="() => OpenCitationViewer(c)" title="View the matter passages mapped to this citation">
                                        <i class="bi bi-quote" aria-hidden="true"></i> @c.Name
                                    </button>
                                    @if (cLink.IsRetrieved)
                                    {
                                        <a href="@cLink.Url" target="_blank" rel="noopener noreferrer" class="um-badge um-badge-success cit-source-badge" title="Open the retrieved source for this citation"><i class="bi bi-box-arrow-up-right"></i> Source</a>
                                    }
                                    else
                                    {
                                        <a href="@cLink.Url" target="_blank" rel="noopener noreferrer" class="um-badge um-badge-neutral cit-source-badge" title="No retrieved source matched; open a web lookup"><i class="bi bi-search"></i> Web search</a>
                                    }
                                </td>
                                <td><span class="cit-kind">@c.Kind</span></td>
                                <td class="cit-relevance">@c.Relevance</td>
                                <td><span class="dfi-tag dfi-tag-@(IsVerified(c.VerificationStatus) ? "ok" : "warn")">@c.VerificationStatus</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @* ── Deep Citations: build a legal prompt from the box below and run it through the same
         /legal/search "Legal" pipeline (CourtListener/GovInfo grounding), then render the
         attorney-ready legal answer result right here under the Citations content. ── *@
    <section class="cit-deep">
        <div class="cit-deep-head">
            <span class="cit-topbar-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
            <div>
                <h4>Deep Citations</h4>
                <p class="dfi-panel-sub">Describe what you need and run a grounded legal-authority search for this matter. The prompt is sent through the same POLOXI <strong>Legal</strong> search pipeline used on <code>/legal/search</code>, using the model you select below. Results appear underneath.</p>
            </div>
        </div>

        <div class="cit-deep-controls">
            <textarea class="cit-deep-input"
                      rows="3"
                      placeholder="Add context for the citation search (e.g. jurisdiction, claim type, key facts)…"
                      @bind="_deepText"
                      @bind:event="oninput"
                      disabled="@_deepLoading"></textarea>

            <div class="cit-deep-actions">
                <label class="cit-deep-model" title="Choose the language model used for this search. Auto lets the platform route to the best available model.">
                    <i class="bi bi-cpu" aria-hidden="true"></i>
                    <select @bind="_deepModelCode" disabled="@_deepLoading" aria-label="Model">
                        <option value="">Auto</option>
                        @foreach (var model in _models)
                        {
                            <option value="@model.ModelCode">@model.ModelCode</option>
                        }
                    </select>
                </label>
                <button type="button" class="um-btn um-btn-primary" @onclick="RunDeepCitationsAsync" disabled="@(_deepLoading || string.IsNullOrWhiteSpace(_deepText))">
                    @if (_deepLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Running…</span>
                    }
                    else
                    {
                        <i class="bi bi-stars" aria-hidden="true"></i>
                        <span>Run Deep Citations</span>
                    }
                </button>
            </div>
        </div>

        @* ── Deep Citation History: every Deep Citation run saved for this matter, newest first,
             with its persisted enterprise Search Quality score. Click a run to reopen its full
             result below. ── *@
        @if (_deepHistory.Count > 0)
        {
            <div class="cit-deephist">
                <div class="cit-deephist-head">
                    <div class="cit-deephist-title">
                        <span class="cit-deephist-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                        <div>
                            <h5>Deep Citation History</h5>
                            <span class="cit-deephist-sub">@_deepHistory.Count citation-related @(_deepHistory.Count == 1 ? "search" : "searches") · newest first</span>
                        </div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="RefreshDeepHistoryAsync" disabled="@(_deepHistoryLoading || _deepLoading)" title="Reload Deep Citation history">
                        @if (_deepHistoryLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                        }
                        <span>Refresh</span>
                    </button>
                </div>

                <ul class="cit-deephist-list">
                    @foreach (var run in _deepHistory)
                    {
                        var isActive = _activeHistoryRunId == run.WideSearchRunResultId;
                        <li class="cit-deephist-card @(isActive ? "cit-deephist-card--active" : null)">
                            <div class="cit-deephist-card-main" @onclick="() => OpenHistoryRunAsync(run)" title="Open this Deep Citation run below">
                                <div class="cit-deephist-card-top">
                                    <span class="cit-deephist-status cit-deephist-status--@HistoryStatusClass(run.StatusCode)">@HistoryStatusLabel(run.StatusCode)</span>
                                    @if (run.QualityScore is { } quality)
                                    {
                                        var grade = string.IsNullOrWhiteSpace(run.QualityGrade) ? QualityGradeFromScore(quality) : run.QualityGrade!;
                                        <span class="cit-deephist-quality cit-deephist-quality--@grade.ToLowerInvariant()"
                                              title="Search quality grade @grade (@(QualityPercent(quality))%)">
                                            <strong>@grade</strong> @(QualityPercent(quality))%
                                        </span>
                                    }
                                    <span class="cit-deephist-when" title="@run.CreatedDateUtc.ToLocalTime().ToString("f")">@run.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</span>
                                </div>
                                <p class="cit-deephist-query">@DeepHistoryTitle(run)</p>
                                @if (!string.IsNullOrWhiteSpace(run.FinalAnswer))
                                {
                                    <p class="cit-deephist-answer">@Truncate(run.FinalAnswer!, 160)</p>
                                }
                                <div class="cit-deephist-metrics">
                                    <span title="Decision/interpretation confidence"><i class="bi bi-speedometer2"></i> @(((run.DecisionConfidence ?? run.FinalConfidence)).ToString("P0"))</span>
                                    <span title="Ranked candidates"><i class="bi bi-trophy"></i> @run.CandidateCount</span>
                                    <span title="Interpretation branches explored"><i class="bi bi-diagram-3"></i> @run.BranchCount</span>
                                    <span title="Evidence items (external + enterprise)"><i class="bi bi-link-45deg"></i> @(run.ExternalEvidenceCount + run.EnterpriseEvidenceCount)</span>
                                    <span title="LLM calls"><i class="bi bi-cpu"></i> @run.LlmCallCount</span>
                                    <span title="Duration"><i class="bi bi-stopwatch"></i> @(TimeSpan.FromMilliseconds(run.DurationMilliseconds).TotalSeconds.ToString("0.0"))s</span>
                                    @if (!string.IsNullOrWhiteSpace(run.ModelCodeUsed))
                                    {
                                        <span title="Model used"><i class="bi bi-robot"></i> @run.ModelCodeUsed</span>
                                    }
                                </div>
                            </div>
                            <div class="cit-deephist-card-actions">
                                <button type="button" class="um-btn um-btn-sm" title="Open the exact saved result below" @onclick="() => OpenHistoryRunAsync(run)" @onclick:stopPropagation="true"><i class="bi bi-box-arrow-up-right"></i> Open</button>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (_deepError is not null)
        {
            <div class="alert alert-danger" role="alert" style="border-left: 4px solid #dc3545;">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_deepError
            </div>
        }

        @if (_deepLoading)
        {
            <div class="cit-deep-loading" role="status" aria-live="polite">
                <div class="cit-deep-loading-spinner"></div>
                <div class="cit-deep-loading-text">
                    <strong>Running grounded legal-authority search…</strong>
                    <span>POLOXI is proposing candidate authorities, verifying them against configured legal sources, and composing an attorney-ready, ranked citation set. This can take a moment.</span>
                </div>
            </div>
        }

        @if (_deepResponse is { } resp)
        {
            <div class="cit-deep-results">
                @* Diagnostic: shows exactly why the medal ranking summary did or did not render. The medals bind to
                   AnswerContext.CandidateSummaries; when POLOXI answers via the fixed query contract without a
                   Candidate × Branch competition, there are no summaries to medal. ── *@
                <div class="dfi-panel-sub cit-deep-diagnostic" style="font-size:.78rem;opacity:.75;margin-bottom:.5rem;">
                    <i class="bi bi-bug" aria-hidden="true"></i>
                    Diagnostic — AnswerKind: <code>@(resp.AnswerKindCode ?? "—")</code>
                    · AnswerContext: <code>@(resp.AnswerContext is null ? "null" : "present")</code>
                    · CandidateSummaries: <code>@(resp.AnswerContext?.CandidateSummaries.Count ?? 0)</code>
                    · Candidates: <code>@resp.Candidates.Count</code>
                    · Branches: <code>@resp.Branches.Count</code>
                    @if (resp.AnswerContext is { CandidateSummaries.Count: 0 } || resp.AnswerContext is null)
                    {
                        <span> — no candidate competition produced summaries, so the medal ranking is suppressed (same gate as /legal/search).</span>
                    }
                </div>
                @if (resp.LegalAnswer is { } legalAnswer)
                {
                    <section class="poloxi-answer-card poloxi-reveal">
                        <div class="poloxi-answer-head">
                            <div>
                                <span class="poloxi-answer-kicker">Deep Citations — Legal Authority Search</span>
                                <h2>Attorney-ready citations for this matter</h2>
                            </div>
                        </div>
                        <div class="poloxi-answer-section poloxi-reveal poloxi-legal-answer">
                            <h3><i class="bi bi-briefcase"></i> Attorney-ready answer</h3>
                            <div class="poloxi-legal-block">
                                <h4>Conclusion</h4>
                                <p>@legalAnswer.Conclusion</p>
                            </div>
                            <div class="poloxi-legal-block">
                                <h4>Analysis</h4>
                                <p>@legalAnswer.Analysis</p>
                            </div>
                            @if (legalAnswer.KeyAuthorities.Count > 0)
                            {
                                <div class="poloxi-legal-block">
                                    <h4>Key Authorities</h4>
                                    @{
                                        // Resolve each authority's linked matter passage ONCE, deterministically and
                                        // DISTINCTLY: a matter passage already linked to an earlier authority is not
                                        // reused for a later one, so three authorities never collapse to the same
                                        // generic ledger line. Never fabricates — returns null when nothing specific
                                        // remains unused.
                                            var keyAuthorityList = legalAnswer.KeyAuthorities as IReadOnlyList<WideLegalAuthorityDto> ?? legalAnswer.KeyAuthorities.ToList();
                                            var linkedPassages = ResolveDistinctLinkedPassages(keyAuthorityList);
                                        }
                                        <ul class="poloxi-legal-authorities">
                                            @for (var ai = 0; ai < keyAuthorityList.Count; ai++)
                                            {
                                                var authority = keyAuthorityList[ai];
                                            var linkedPassage = linkedPassages[ai];
                                            <li>
                                                @if (!string.IsNullOrWhiteSpace(authority.Reference))
                                                {
                                                    <a href="@authority.Reference" target="_blank" rel="noopener"><strong>@authority.Name</strong></a>
                                                }
                                                else
                                                {
                                                    <strong>@authority.Name</strong>
                                                }
                                                <span> — @authority.Relevance</span>
                                                <div class="cit-passage-pair">
                                                    <div class="cit-passage cit-passage--authority">
                                                        <span class="cit-passage-label"><i class="bi bi-bank"></i> Authority passage</span>
                                                        <p>@authority.Relevance</p>
                                                    </div>
                                                    <div class="cit-passage cit-passage--matter">
                                                        <span class="cit-passage-label"><i class="bi bi-folder2-open"></i> Linked matter passage</span>
                                                        @if (!string.IsNullOrWhiteSpace(linkedPassage))
                                                        {
                                                            <p>@linkedPassage</p>
                                                        }
                                                        else
                                                        {
                                                            <p class="cit-passage-empty">No authority-specific matter passage in context.</p>
                                                        }
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            <div class="poloxi-legal-block">
                                <h4>Application</h4>
                                <p>@legalAnswer.Application</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(legalAnswer.Counterargument))
                            {
                                <div class="poloxi-legal-block">
                                    <h4>Counterargument</h4>
                                    <p>@legalAnswer.Counterargument</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(legalAnswer.RemainingUncertainty))
                            {
                                <div class="poloxi-legal-block">
                                    <h4>Remaining Uncertainty</h4>
                                    <p>@legalAnswer.RemainingUncertainty</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(legalAnswer.DecisiveMissingFact))
                            {
                                <div class="poloxi-legal-block poloxi-legal-decisive">
                                    <h4><i class="bi bi-key"></i> Decisive missing fact</h4>
                                    <p>@legalAnswer.DecisiveMissingFact</p>
                                </div>
                            }
                            <div class="poloxi-legal-block poloxi-legal-bottomline">
                                <h4>Bottom Line</h4>
                                <p>@legalAnswer.BottomLine</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(resp.FinalAnswer))
                    {
                        <div class="poloxi-answer-section poloxi-reveal poloxi-full-answer-primary">
                            <h3><i class="bi bi-card-text"></i> Full answer</h3>
                            <p>@resp.FinalAnswer</p>
                        </div>
                    }

                    @if (resp.AnswerContext is { } answerContext)
                    {
                        @if (answerContext.CandidateSummaries.Count > 0)
                        {
                            <div class="poloxi-rank-table">
                                @foreach (var (summary, index) in answerContext.CandidateSummaries.Select((item, i) => (item, i)))
                                {
                                    <div class="poloxi-rank-row poloxi-reveal" style="animation-delay:@($"{index * 70}ms")">
                                        <span class="poloxi-rank-medal @(index == 0 ? "poloxi-rank-medal--gold" : index == 1 ? "poloxi-rank-medal--silver" : index == 2 ? "poloxi-rank-medal--bronze" : null)">@(index switch { 0 => "🥇", 1 => "🥈", 2 => "🥉", _ => (index + 1).ToString() })</span>
                                        <div class="poloxi-rank-main">
                                            <strong>@summary.DisplayName</strong>
                                            @if (summary.SupportTierCode != "STRONG")
                                            {
                                                <span class="poloxi-tier-badge @(summary.SupportTierCode == "MODERATE" ? "poloxi-tier-badge--moderate" : "poloxi-tier-badge--limited")" title="@(summary.SupportTierCode == "MODERATE" ? "Moderate support — backed by fewer independent evidence signals than the top results" : "Limited support — provisional result backed by a single credible evidence signal")">@(summary.SupportTierCode == "MODERATE" ? "Moderate support" : "Limited support")</span>
                                            }
                                            @{ var hasInsights = summary.BestFor is not null || summary.PraisedFor.Count > 0 || summary.WatchOutFor.Count > 0; }
                                            @if (hasInsights)
                                            {
                                                <div class="poloxi-rank-facts">
                                                    @if (summary.BestFor is not null)
                                                    {
                                                        <span class="poloxi-fact-chip poloxi-fact-chip--bestfor">🎯 Best for: @summary.BestFor</span>
                                                    }
                                                    @if (summary.PraisedFor.Count > 0)
                                                    {
                                                        <span class="poloxi-fact-chip poloxi-fact-chip--praise">👍 Praised for: @string.Join(" · ", summary.PraisedFor)</span>
                                                    }
                                                    @if (summary.WatchOutFor.Count > 0)
                                                    {
                                                        <span class="poloxi-fact-chip poloxi-fact-chip--watch">⚠ Watch out: @string.Join(" · ", summary.WatchOutFor)</span>
                                                    }
                                                </div>
                                            }
                                            <div class="poloxi-score-track"><span class="poloxi-score-fill" style="--score:@summary.CompositeScore.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"></span></div>
                                        </div>
                                        <span class="poloxi-rank-score" title="Match score — how well this candidate fits the decision criteria relative to the alternatives">@summary.CompositeScore.ToString("P0")<small class="poloxi-rank-score-label">match</small></span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            @* Fallback ranking mirrors /legal/search: whenever the L1 Candidate × Branch
                               competition produced candidates, always show the deterministic final ranking,
                               even if the composer emitted no CandidateSummaries. *@
                            var deepRanked = DeepRankedCandidates(resp);
                            @if (deepRanked.Count > 0)
                            {
                                <div class="poloxi-grounded-branches">
                                    <small title="Deterministic final ordering from the Candidate × Branch competition — the authoritative POLOXI conclusion, never the pre-competition LLM composition.">Final POLOXI ranking (Candidate × Branch competition):</small>
                                    <ol class="poloxi-final-ranking">
                                        @foreach (var candidate in deepRanked)
                                        {
                                            <li><strong>@candidate.DisplayName</strong> <span>@candidate.CompositeScore.ToString("P0")</span></li>
                                        }
                                    </ol>
                                </div>
                            }
                        }

                        @if (answerContext.WinnerStrengths.Count > 0 && answerContext.WinnerDisplayName is not null)
                        {
                            <div class="poloxi-answer-section poloxi-reveal">
                                <h3><i class="bi bi-trophy"></i> Why @answerContext.WinnerDisplayName won</h3>
                                <div class="poloxi-dimension-bars">
                                    @foreach (var strength in answerContext.WinnerStrengths)
                                    {
                                        <div class="poloxi-dimension-bar">
                                            <span>@strength.DimensionName</span>
                                            <div class="poloxi-score-track"><span class="poloxi-score-fill" style="--score:@strength.Score.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"></span></div>
                                            <em>@strength.Score.ToString("P0")</em>
                                        </div>
                                    }
                                    @foreach (var weakness in answerContext.WinnerWeaknesses)
                                    {
                                        <div class="poloxi-dimension-bar poloxi-dimension-bar--weak">
                                            <span>@weakness.DimensionName</span>
                                            <div class="poloxi-score-track"><span class="poloxi-score-fill" style="--score:@weakness.Score.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"></span></div>
                                            <em>@weakness.Score.ToString("P0")</em>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (answerContext.CandidateContrasts.Count > 0 && answerContext.WinnerDisplayName is not null)
                        {
                            <div class="poloxi-answer-section poloxi-reveal">
                                <h3><i class="bi bi-arrow-left-right"></i> Why not the others?</h3>
                                @foreach (var contrast in answerContext.CandidateContrasts)
                                {
                                    <p class="poloxi-contrast">
                                        <strong>vs @contrast.AlternativeDisplayName (@contrast.AlternativeScore.ToString("P0"))</strong> —
                                        @if (contrast.AlternativeLeadsOn.Count > 0)
                                        {
                                            <span>competitive on @string.Join(", ", contrast.AlternativeLeadsOn.Select(d => d.ToLowerInvariant()))</span>
                                        }
                                        else
                                        {
                                            <span>close overall</span>
                                        }
                                        @if (contrast.WinnerLeadsOn.Count > 0)
                                        {
                                            <span>, but @answerContext.WinnerDisplayName led on @string.Join(", ", contrast.WinnerLeadsOn.Select(d => d.ToLowerInvariant())).</span>
                                        }
                                        else
                                        {
                                            <span>; the composite balance decided it.</span>
                                        }
                                    </p>
                                }
                            </div>
                        }
                    }
                    </section>
                }
                else if (!string.IsNullOrWhiteSpace(resp.FinalAnswer))
                {
                    @* Premium Result surface: lead with the authoritative, deterministic Candidate x Branch
                       ranking as a scannable table (rank, authority, match score bar) built from the real
                       resp.Candidates data — never fabricated — then keep the full synthesis prose below as
                       supporting detail. Falls back to prose-only when no ranked candidates exist. *@
                    var citResultRanked = DeepRankedCandidates(resp);
                    var citResultLeader = citResultRanked.Count > 0 ? citResultRanked[0] : null;
                    var citResultRunnerUp = citResultRanked.Count > 1 ? citResultRanked[1] : null;
                    var citResultMargin = citResultLeader is not null && citResultRunnerUp is not null
                        ? citResultLeader.CompositeScore - citResultRunnerUp.CompositeScore
                        : (decimal?)null;
                    <section class="poloxi-answer-card poloxi-reveal cit-result-card">
                        <div class="poloxi-answer-head cit-result-head">
                            <div>
                                <span class="poloxi-answer-kicker"><i class="bi bi-search"></i> Deep Citations — Legal Authority Search</span>
                                <h2>Result</h2>
                            </div>
                            @if (citResultLeader is not null)
                            {
                                <div class="cit-result-leaderpill" title="Highest-scoring authority in the deterministic Candidate × Branch competition">
                                    <span class="cit-result-leaderpill-label"><i class="bi bi-trophy-fill"></i> Leading authority</span>
                                    <span class="cit-result-leaderpill-name">@citResultLeader.DisplayName</span>
                                    <span class="cit-result-leaderpill-score">@citResultLeader.CompositeScore.ToString("P0")</span>
                                </div>
                            }
                        </div>

                        @if (citResultRanked.Count > 0)
                        {
                            <div class="poloxi-answer-section poloxi-reveal cit-result-section">
                                <div class="cit-result-table-head">
                                    <h3><i class="bi bi-list-ol"></i> Final authority ranking</h3>
                                    <span class="cit-result-table-sub" title="Authoritative deterministic ordering from the Candidate × Branch competition — never the pre-competition LLM composition.">Deterministic Candidate × Branch competition@(citResultMargin is { } m ? $" · {m.ToString("P1")} lead" : null)</span>
                                </div>
                                <div class="cit-result-table" role="table" aria-label="Final authority ranking">
                                    <div class="cit-result-row cit-result-row--header" role="row">
                                        <span role="columnheader" class="cit-col-rank">#</span>
                                        <span role="columnheader" class="cit-col-auth">Legal authority</span>
                                        <span role="columnheader" class="cit-col-bar">Match strength</span>
                                        <span role="columnheader" class="cit-col-score">Score</span>
                                    </div>
                                    @foreach (var (candidate, index) in citResultRanked.Select((c, i) => (c, i)))
                                    {
                                        <div class="cit-result-row poloxi-reveal @(index == 0 ? "cit-result-row--leader" : null)" role="row" style="animation-delay:@($"{index * 60}ms")">
                                            <span role="cell" class="cit-col-rank">
                                                <span class="cit-result-medal @(index == 0 ? "cit-result-medal--gold" : index == 1 ? "cit-result-medal--silver" : index == 2 ? "cit-result-medal--bronze" : null)">@(index + 1)</span>
                                            </span>
                                            <span role="cell" class="cit-col-auth">
                                                <strong>@candidate.DisplayName</strong>
                                                @if (index == 0)
                                                {
                                                    <span class="cit-result-winner-tag"><i class="bi bi-check-circle-fill"></i> POLOXI winner</span>
                                                }
                                            </span>
                                            <span role="cell" class="cit-col-bar">
                                                <span class="cit-result-track"><span class="cit-result-fill" style="width:@candidate.CompositeScore.ToString("P0", System.Globalization.CultureInfo.InvariantCulture)"></span></span>
                                            </span>
                                            <span role="cell" class="cit-col-score">@candidate.CompositeScore.ToString("P0")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="poloxi-answer-section poloxi-reveal cit-result-synthesis">
                            <h3><i class="bi bi-card-text"></i> Deliverable synthesis</h3>
                            <p class="poloxi-answer-narrative">@resp.FinalAnswer</p>
                        </div>
                    </section>
                }
                else
                {
                    <div class="dfi-panel-card">
                        <p class="dfi-panel-sub"><i class="bi bi-info-circle" aria-hidden="true"></i> The search completed but did not return an attorney-ready legal answer. Try refining the context above or selecting a different model.</p>
                    </div>
                }

                @if (resp.AmbiguityGroups.Count > 1)
                {
                    <section class="poloxi-panel poloxi-panel--embedded poloxi-reveal">
                        <div class="poloxi-panel-header">
                            <div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-diagram-2"></i></span><div><span>Ambiguity-first grouped execution</span><h2>Possible meanings and result groups</h2></div></div>
                            <span class="poloxi-status">@resp.AmbiguityGroups.Count groups</span>
                        </div>
                        <div class="poloxi-ambiguity-groups">
                            @foreach (var group in resp.AmbiguityGroups)
                            {
                                <article class="poloxi-ambiguity-group">
                                    <div class="poloxi-ambiguity-group-head">
                                        <div><span>@group.GroupCode</span><h3>@group.DisplayName</h3></div>
                                        <strong>@group.Confidence.ToString("P0")</strong>
                                    </div>
                                    @{ var breakdown = AmbiguityGroupScoreBreakdown(group); }
                                    <small class="poloxi-muted" title="POLOXI confidence formula for this group.">
                                        POLOXI confidence = 0.45 × @breakdown.InterpretationPrior.ToString("P0") + 0.55 × @breakdown.EvidenceSupport.ToString("P0") = @breakdown.PoloxiConfidence.ToString("P0")
                                    </small>
                                    <p>@group.Summary</p>
                                    <div class="poloxi-branch-level">
                                        @if (!string.IsNullOrWhiteSpace(group.AnswerKindCode))
                                        {
                                            <span class="poloxi-branch-chip"><i class="bi bi-signpost-2"></i>@group.AnswerKindCode.Replace('_', ' ')</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(group.CandidateKindCode))
                                        {
                                            <span class="poloxi-branch-chip"><i class="bi bi-ui-checks-grid"></i>@group.CandidateKindCode.Replace('_', ' ')</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(group.SafetyRiskCode) && group.SafetyRiskCode != "NONE")
                                        {
                                            <span class="poloxi-branch-chip" title="Safety-sensitive interpretation group."><i class="bi bi-shield-exclamation"></i>@(group.SafetyRiskCode == "MEDIUM" ? "POSSIBLE SAFETY RISK" : group.SafetyRiskCode)</span>
                                        }
                                        <span class="poloxi-branch-chip"><i class="bi bi-diagram-3"></i>@group.Branches.Count branch@(group.Branches.Count == 1 ? "" : "es")</span>
                                        <span class="poloxi-branch-chip"><i class="bi bi-database-check"></i>@AmbiguityGroupEvidenceCount(group) evidence</span>
                                    </div>
                                    @{ var groupResults = GroupInterpretiveResults(group); }
                                    @if (groupResults.Count > 0)
                                    {
                                        <div class="poloxi-group-results">
                                            @foreach (var result in groupResults)
                                            {
                                                <div class="poloxi-group-result-set">
                                                    @if (!string.IsNullOrWhiteSpace(result.BranchDisplayName))
                                                    {
                                                        <div class="poloxi-branch-level" title="Branch this ranked list answers">
                                                            <span class="poloxi-branch-chip"><i class="bi bi-diagram-2"></i>@result.BranchDisplayName</span>
                                                            @if (result.Confidence > 0)
                                                            {
                                                                <span class="um-badge um-badge-neutral" title="Branch confidence">@result.Confidence.ToString("P0")</span>
                                                            }
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(result.Interpretation))
                                                        {
                                                            <small class="poloxi-muted">@result.Interpretation</small>
                                                        }
                                                    }
                                                    <ol>
                                                        @foreach (var item in result.Items)
                                                        {
                                                            <li>
                                                                @{ var itemLink = ResolveCitationLink(item.Name); }
                                                                <a href="@itemLink.Url" target="_blank" rel="noopener noreferrer" title="@(itemLink.IsRetrieved ? $"Open the retrieved source for {item.Name}" : $"Search the web for {item.Name}")">@item.Name</a>
                                                                @if (itemLink.IsRetrieved)
                                                                {
                                                                    <span class="um-badge um-badge-success" title="A retrieved external source matched this citation."><i class="bi bi-link-45deg"></i> Source</span>
                                                                }
                                                                @if (item.Score.HasValue)
                                                                {
                                                                    <span class="um-badge um-badge-neutral" title="LLM-assigned strength/likelihood for this item (0-100%).">@item.Score.Value.ToString("P0")</span>
                                                                }
                                                                @foreach (var facet in item.Attributes)
                                                                {
                                                                    <span class="um-badge um-badge-info poloxi-item-attribute" title="@facet.Label">@facet.Label: @facet.Value</span>
                                                                }
                                                                <small>@item.Detail</small>
                                                            </li>
                                                        }
                                                    </ol>
                                                </div>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }

                @* ── Reasoning hierarchy + Interpretation results (mirrors /legal/search). ── *@
                @if (resp.Branches.Count > 0 || resp.ExternalReferences.Count > 0 || resp.InterpretiveResults.Count > 0)
                {
                    <div class="poloxi-layout">
                        <section class="poloxi-panel poloxi-hierarchy-panel">
                            <div class="poloxi-panel-header"><div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-diagram-3"></i></span><div><span>EPG Engine Logic Applied</span><h2>Reasoning hierarchy</h2></div></div></div>
                            <div class="poloxi-tree">
                                @foreach (var level in BranchLevels)
                                {
                                    @foreach (var branch in level)
                                    {
                                        <article class="poloxi-branch @(branch.IsEliminated ? "poloxi-branch-unsupported" : "poloxi-branch-valid")">
                                            <span class="poloxi-branch-icon"><i class="bi @(branch.IsEliminated ? "bi-slash-circle" : branch.GroundingStatusCode == "GROUNDED" ? "bi-check2-circle" : "bi-lightbulb")"></i></span>
                                            <div class="poloxi-branch-body">
                                                <strong>@BranchDisplayWithLevel(branch)</strong>
                                                <p>@branch.Interpretation</p>
                                                <small>@(branch.IsEliminated ? branch.EliminationReason : branch.GroundingStatusCode == "GROUNDED" ? $"Grounded · {branch.EvidenceCount} evidence" : "Interpretive reasoning path (not enterprise-grounded)")@(branch.StopReason is not null ? $" · {branch.StopReason}" : null)</small>
                                                @if (resp.QueryContract is { } hierarchyContract)
                                                {
                                                    var associatedContractEntries = AssociatedContractEntries(branch, hierarchyContract);
                                                    @if (associatedContractEntries.Count > 0)
                                                    {
                                                        <div class="poloxi-branch-contract" aria-label="Query contract entries associated with this hierarchy branch">
                                                            <span class="poloxi-branch-contract-title"><i class="bi bi-file-earmark-check"></i> Associated query contract</span>
                                                            @foreach (var entry in associatedContractEntries)
                                                            {
                                                                <span title="@entry.Title"><i class="bi @entry.Icon"></i>@entry.Value<em>@entry.Label</em></span>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                            <div class="poloxi-branch-meta"><span>@BranchStateLabel(branch)</span>@if (branch.SemanticTypeCode == "DIMENSION")
                                                {
                                                    <span class="um-badge um-badge-neutral" title="Jointly valid evaluation criterion — scored on importance/coverage, excluded from winner-take-all entropy.">Dimension</span>
                                                }
                                                else
                                                {
                                                    <span class="um-badge um-badge-neutral" title="Mutually exclusive competing interpretation — participates in Shannon entropy.">Alternative</span>
                                                }<small title="Interpretation prior (LLM) · Evidence support · POLOXI confidence">@(branch.PoloxiConfidence > 0 ? $"{branch.InterpretationPrior:P0} · {branch.EvidenceSupport:P0} · {branch.PoloxiConfidence:P0}" : branch.Confidence.ToString("P0"))</small></div>
                                        </article>
                                    }
                                }
                            </div>
                        </section>

                        <section class="poloxi-panel poloxi-evidence-panel">
                            <div class="poloxi-panel-header"><div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-collection"></i></span><div><span>LLM knowledge · not enterprise data</span><h2>Results &amp; references</h2></div></div></div>
                            @if (resp.Evidence.Count == 0 && resp.ExternalReferences.Count == 0 && resp.InterpretiveResults.Count == 0)
                            {
                                <div class="poloxi-empty"><i class="bi bi-lightbulb"></i><strong>No result sets returned</strong><p>The LLM did not return interpretive result sets or references for this question.</p></div>
                            }
                            @foreach (var evidence in resp.Evidence)
                            {
                                var canOpen = !string.IsNullOrWhiteSpace(evidence.NavigationRoute);
                                <article class="poloxi-evidence @(canOpen ? "poloxi-evidence-clickable" : null)" @ondblclick="() => OpenEvidence(evidence)" title="@(canOpen ? "Double-click to open the source record." : null)">
                                    <span class="poloxi-rank">@evidence.RankNumber</span>
                                    <div class="poloxi-evidence-main"><strong>@evidence.Title</strong><small>@evidence.ModuleCode · @evidence.EntityTypeCode</small><p>@evidence.Excerpt</p><div>@foreach (var branch in evidence.MatchedBranches) { <span class="um-badge um-badge-neutral">@Owner.DaBranchNameWithLevel(branch)</span> }</div></div>
                                    <div class="poloxi-score"><strong>@evidence.RelevanceScore.ToString("P0")</strong><small>Score</small></div>
                                </article>
                            }
                            @if (resp.InterpretiveResults.Count > 0)
                            {
                                <div class="poloxi-section-divider"><i class="bi bi-stars"></i><h2>Interpretation results</h2></div>
                                @if (resp.InterpretiveResults.Any(r => r.DataVolatility == "TIME_SENSITIVE" && !r.IsExternallyGrounded))
                                {
                                    <div class="alert alert-warning" role="alert" style="border-left: 4px solid #ffc107;">
                                        <i class="bi bi-clock-history"></i> Some results below depend on time-sensitive data (prices, rates, rankings). Figures may be outdated &mdash; verify against the referenced sources for current values.
                                    </div>
                                }
                                @foreach (var result in PrioritizedInterpretiveResults)
                                {
                                    <article class="poloxi-evidence">
                                        <span class="poloxi-rank"><i class="bi bi-lightbulb"></i></span>
                                        <div class="poloxi-evidence-main">
                                            <strong>@InterpretiveBranchDisplayWithLevel(result)</strong>
                                            <small>@result.Interpretation</small>
                                            @foreach (var item in result.Items)
                                            {
                                                <p>
                                                    <strong>@item.RankNumber. <a href="@WebSearchUrl(item.Name)" target="_blank" rel="noopener noreferrer" title="Search the web for @item.Name">@item.Name</a></strong>
                                                    @if (item.Score.HasValue)
                                                    {
                                                        <span class="um-badge um-badge-neutral" title="LLM-assigned strength/likelihood for this item (0-100%).">@item.Score.Value.ToString("P0")</span>
                                                    }
                                                    @foreach (var facet in item.Attributes)
                                                    {
                                                        <span class="um-badge um-badge-info poloxi-item-attribute" title="@facet.Label">@facet.Label: @facet.Value</span>
                                                    }
                                                    &mdash; @item.Detail
                                                </p>
                                            }
                                            <div>
                                                <span class="um-badge um-badge-neutral">INTERPRETIVE</span>
                                                @if (result.DataVolatility == "TIME_SENSITIVE")
                                                {
                                                    <span class="um-badge um-badge-warning" title="This result depends on facts that change over time; figures may be outdated."><i class="bi bi-clock-history"></i> TIME-SENSITIVE</span>
                                                }
                                                @if (result.IsExternallyGrounded)
                                                {
                                                    <span class="um-badge um-badge-success" title="Figures were grounded against live external sources."><i class="bi bi-globe2"></i> LIVE-GROUNDED</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="poloxi-score" title="POLOXI branch-support confidence: interpretation prior blended with evidence support."><strong>@result.Confidence.ToString("P0")</strong><small>POLOXI</small></div>
                                    </article>
                                }
                                @if (SecondaryInterpretiveResults.Count > 0)
                                {
                                    <div class="poloxi-secondary-panel">
                                        <div class="poloxi-secondary-header">
                                            <i class="bi bi-layers-half"></i>
                                            <div>
                                                <span>Not prioritized &middot; secondary analysis</span>
                                                <h3>Interpretation results for not-prioritized paths</h3>
                                                <p>These interpretation paths scored below the prioritization threshold or returned no enterprise evidence. They remain part of the answer surface for completeness and can be reactivated by supporting evidence.</p>
                                            </div>
                                            <span class="poloxi-secondary-count">@SecondaryInterpretiveResults.Count</span>
                                        </div>
                                        @foreach (var result in SecondaryInterpretiveResults)
                                        {
                                            <article class="poloxi-evidence poloxi-evidence-secondary">
                                                <span class="poloxi-rank poloxi-rank-secondary"><i class="bi bi-lightbulb"></i></span>
                                                <div class="poloxi-evidence-main">
                                                    <strong>@InterpretiveBranchDisplayWithLevel(result)</strong>
                                                    <small>@result.Interpretation</small>
                                                    @foreach (var item in result.Items)
                                                    {
                                                        <p>
                                                            <strong>@item.RankNumber. <a href="@WebSearchUrl(item.Name)" target="_blank" rel="noopener noreferrer" title="Search the web for @item.Name">@item.Name</a></strong>
                                                            @if (item.Score.HasValue)
                                                            {
                                                                <span class="um-badge um-badge-neutral" title="LLM-assigned strength/likelihood for this item (0-100%).">@item.Score.Value.ToString("P0")</span>
                                                            }
                                                            @foreach (var facet in item.Attributes)
                                                            {
                                                                <span class="um-badge um-badge-info poloxi-item-attribute" title="@facet.Label">@facet.Label: @facet.Value</span>
                                                            }
                                                            &mdash; @item.Detail
                                                        </p>
                                                    }
                                                    <div>
                                                        <span class="um-badge um-badge-neutral" title="This interpretation path was demoted to dormant/secondary — retained for completeness, not driving the primary answer.">NOT PRIORITIZED</span>
                                                        <span class="um-badge um-badge-neutral">INTERPRETIVE</span>
                                                        @if (result.DataVolatility == "TIME_SENSITIVE")
                                                        {
                                                            <span class="um-badge um-badge-warning" title="This result depends on facts that change over time; figures may be outdated."><i class="bi bi-clock-history"></i> TIME-SENSITIVE</span>
                                                        }
                                                        @if (result.IsExternallyGrounded)
                                                        {
                                                            <span class="um-badge um-badge-success" title="Figures were grounded against live external sources."><i class="bi bi-globe2"></i> LIVE-GROUNDED</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="poloxi-score" title="POLOXI branch-support confidence: interpretation prior blended with evidence support."><strong>@result.Confidence.ToString("P0")</strong><small>POLOXI</small></div>
                                            </article>
                                        }
                                    </div>
                                }
                            }
                        </section>
                    </div>
                }
            </div>
        }
    </section>

    @* ── Shared KPI strip, detailed summary, ranking comparison, and ABV (mirrors /legal/search). ── *@
    @if (_deepResponse is { } kpiResp)
    {
        @if (!string.IsNullOrWhiteSpace(kpiResp.GroundingWarning))
        {
            <div class="alert alert-danger" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
                <i class="bi bi-plug-fill me-1" aria-hidden="true"></i><strong>External grounding unavailable.</strong> @kpiResp.GroundingWarning
            </div>
        }
        <section class="poloxi-kpis poloxi-kpis--compact">
            <article><i class="bi bi-activity poloxi-kpi-icon"></i><span>Status</span><strong>@kpiResp.StatusCode</strong><small>@kpiResp.TerminationReasonCode</small></article>
            <article title="End-to-end execution time of this POLOXI run, measured by the platform from request start to final answer."><i class="bi bi-stopwatch poloxi-kpi-icon"></i><span>Execution time</span><strong>@TimeSpan.FromMilliseconds(kpiResp.DurationMilliseconds).TotalSeconds.ToString("0.0")s</strong><small>@kpiResp.DurationMilliseconds.ToString("N0") ms</small></article>
            @if (!string.IsNullOrWhiteSpace(kpiResp.AnswerKindCode))
            {
                <article title="V3.2 answer-kind-aware workflow routing: the Stage 0 classification of what the answer items ARE."><i class="bi bi-signpost-2 poloxi-kpi-icon"></i><span>Answer kind</span><strong>@kpiResp.AnswerKindCode.Replace('_', ' ')</strong><small>@(kpiResp.AnswerKindRoutingApplied ? "tuned budgets" : "full pipeline")</small></article>
            }
            @if (!string.IsNullOrWhiteSpace(kpiResp.ModelCodeUsed))
            {
                <article title="The AI model that composed the final answer, resolved by the platform router."><i class="bi bi-cpu poloxi-kpi-icon"></i><span>Model used</span><strong>@kpiResp.ModelCodeUsed</strong><small>@(string.IsNullOrWhiteSpace(_deepModelCode) ? "auto-routed" : "user-selected")@(string.IsNullOrWhiteSpace(kpiResp.ProviderCodeUsed) ? "" : $" · {kpiResp.ProviderCodeUsed}")</small></article>
            }
            <article><i class="bi bi-diagram-3 poloxi-kpi-icon"></i><span>Depth reached</span><strong>@kpiResp.DepthReached</strong><small>@kpiResp.LlmCallCount LLM calls</small></article>
            <article><i class="bi bi-signpost-split poloxi-kpi-icon"></i><span>Surviving paths</span><strong>@SurvivingBranches.Count</strong><small>@EliminatedBranches.Count pruned</small></article>
            <article><i class="bi bi-database-check poloxi-kpi-icon"></i><span>Evidence</span><strong>@(kpiResp.EnterpriseEvidenceCount + kpiResp.ExternalEvidenceCount)</strong><small>@kpiResp.ExternalEvidenceCount external &middot; @kpiResp.EnterpriseEvidenceCount enterprise</small></article>
            <article title="Hierarchy coverage: share of ALL surviving branches supported by any evidence."><i class="bi bi-bounding-box-circles poloxi-kpi-icon"></i><span>Evidence coverage</span><strong>@kpiResp.EvidenceCoverage.ToString("P0")</strong><small>hierarchy branches supported</small></article>
            <article title="Decision coverage: share of the dimensions that actually drive the final Candidate × Branch ranking that are supported by evidence."><i class="bi bi-crosshair poloxi-kpi-icon"></i><span>Decision coverage</span><strong>@kpiResp.DecisionEvidenceCoverage.ToString("P0")</strong><small>deciding dimensions supported</small></article>
            <article title="@(IsEvidenceWeightedConfidence ? "Decision evidence confidence: winner quality, winner-vs-runner-up separation, evidence confidence, ranking stability, and decision-dimension coverage." : "Interpretation confidence: no Candidate × Branch competition ran for this execution, so this value reflects POLOXI's interpretation-prior confidence and is NOT weighted by retrieved evidence.")"><i class="bi bi-shield-check poloxi-kpi-icon"></i><span>@ConfidenceLabel</span><strong>@kpiResp.FinalConfidence.ToString("P0")</strong><small>@ConfidenceCaption</small></article>
            <article title="Challenge-the-Winner (watch mode): when the leader-vs-runner-up margin is thin, one adversarial LLM assessment argues against the leader and records its verdict for audit. Diagnostic only."><i class="bi bi-lightning-charge poloxi-kpi-icon"></i><span>Winner challenge</span><strong>@(kpiResp.ChallengeOutcome is null ? "NOT FIRED" : kpiResp.ChallengeOutcome.VerdictCode.Replace('_', ' '))</strong><small>@(kpiResp.ChallengeOutcome is null ? "margin above threshold or disabled" : $"{kpiResp.ChallengeOutcome.ChallengedCandidate} vs {kpiResp.ChallengeOutcome.ChallengerCandidate} · margin {kpiResp.ChallengeOutcome.Margin:P0}")</small></article>
            @if (kpiResp.WinnerStability is { } winnerStability)
            {
                <article title="Deterministic ranking stability across information rounds."><i class="bi bi-graph-up-arrow poloxi-kpi-icon"></i><span>Ranking stability</span><strong>@winnerStability.ToString("P0")</strong><small>winner &middot; top-3 @(kpiResp.TopKStability?.ToString("P0") ?? "—")</small></article>
            }
            @if (kpiResp.InformationRounds.Count > 0)
            {
                <article title="Deterministic Shannon entropy — 0% = fully resolved, 100% = maximal uncertainty. Measured by POLOXI math, never the LLM."><i class="bi bi-thermometer-half poloxi-kpi-icon"></i><span>Uncertainty</span><strong>@kpiResp.InitialNormalizedEntropy.ToString("P0") &rarr; @kpiResp.FinalNormalizedEntropy.ToString("P0")</strong><small>@kpiResp.TotalActualInformationGain.ToString("0.###") bits gained &middot; @(kpiResp.EntropyBasisCode ?? "BRANCH") basis@(string.Equals(kpiResp.EntropyBasisCode, "CANDIDATE", StringComparison.OrdinalIgnoreCase) ? $" &middot; candidate uncertainty {CandidateUncertaintyDisplay}" : "")</small></article>
            }
        </section>

        @if (kpiResp.InformationRounds.Count > 0)
        {
            <section class="poloxi-panel">
                <div class="poloxi-panel-header"><div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-radar"></i></span><div><span>V2.2 information-directed exploration · the LLM predicts, POLOXI measures</span><h2>Information rounds</h2></div></div><span class="poloxi-status" title="Rounds executed · targets evaluated · total measured uncertainty reduction (bits)">@kpiResp.InformationRounds.Count rounds · @kpiResp.TotalActualInformationGain.ToString("0.###") bits</span></div>
                @foreach (var round in kpiResp.InformationRounds)
                {
                    <article class="poloxi-info-round">
                        <div class="poloxi-info-round-head">
                            <strong>Round @round.RoundNumber</strong>
                            <span title="Normalized uncertainty before → after this round (deterministic Shannon entropy).">@round.NormalizedEntropyBefore.ToString("P0") → @(round.NormalizedEntropyAfter?.ToString("P0") ?? "—") · @round.EntropyBasisCode</span>
                            @if (round.RawEntropyDelta is { } rawDelta)
                            {
                                <span class="um-badge um-badge-neutral" title="Raw measured entropy change (EntropyBefore − EntropyAfter) — the single measured fact for this round. Measured by POLOXI math, never the LLM.">Information change: @((rawDelta >= 0m ? "+" : "\u2212") + Math.Abs(rawDelta).ToString("0.###")) bits</span>
                                <span class="um-badge @(rawDelta > 0m ? "um-badge-success" : rawDelta < 0m ? "um-badge-warning" : "um-badge-neutral")">Outcome: @(rawDelta > 0m ? "Uncertainty reduced" : rawDelta < 0m ? "Uncertainty increased" : "No measurable change")</span>
                            }
                            else if (round.ActualInformationGain is { } gain)
                            {
                                <span class="um-badge @(gain > 0m ? "um-badge-success" : "um-badge-neutral")" title="Actual information gain measured by POLOXI after targeted retrieval — never estimated by the LLM.">@gain.ToString("0.###") bits</span>
                            }
                        </div>
                        @foreach (var target in round.Targets)
                        {
                            <div class="poloxi-info-target @(target.WasSelected ? null : "poloxi-info-target-skipped")">
                                <span class="poloxi-rank" title="@(target.WasSelected ? "Selected for targeted retrieval." : "Evaluated but not selected — kept for audit.")">@(target.SelectionRank?.ToString() ?? "–")</span>
                                <div class="poloxi-evidence-main">
                                    <strong>@target.BranchDisplayName</strong>
                                    @if (!string.IsNullOrWhiteSpace(target.EvidenceTarget))
                                    {
                                        <p>@target.EvidenceTarget</p>
                                    }
                                    <div>
                                        <span class="um-badge um-badge-neutral" title="How unresolved this interpretation dimension is (LLM categorical estimate).">Uncertainty @target.UncertaintyCode</span>
                                        <span class="um-badge um-badge-neutral" title="How likely new evidence here changes the final ranking (LLM categorical estimate).">Impact @target.RankingImpactCode</span>
                                        <span class="um-badge um-badge-neutral" title="How well evidence here separates close candidates (LLM categorical estimate).">Discrimination @target.CandidateDiscriminationCode</span>
                                    </div>
                                </div>
                                <div class="poloxi-score"><strong>@target.AdjustedInformationValue.ToString("P0")</strong><small>Info value</small></div>
                            </div>
                        }
                    </article>
                }
            </section>
        }

        @if (kpiResp.Candidates.Count > 0)
        {
            <section class="poloxi-panel">
                <div class="poloxi-panel-header"><div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-trophy"></i></span><div><h2>POLOXI Answer ranking</h2></div></div><span class="poloxi-status" title="POLOXI Journey: interpretations explored → evidence-supported → final dimensions → ranked candidates">@kpiResp.Branches.Count → @SurvivingBranches.Count → @ActiveBranchCount → @kpiResp.Candidates.Count</span></div>
                @foreach (var candidate in kpiResp.Candidates)
                {
                    <article class="poloxi-evidence @(candidate.IsConstraintViolation ? "poloxi-branch-unsupported" : null)">
                        <span class="poloxi-rank">@candidate.RankNumber</span>
                        <div class="poloxi-evidence-main">
                            <strong>@candidate.DisplayName</strong>
                            <p>@candidate.Detail</p>
                            <div>
                                @if (candidate.IsConstraintViolation)
                                {
                                    <span class="um-badge um-badge-danger" title="Failed a hard query constraint; kept visible, never hidden."><i class="bi bi-slash-circle"></i> RULED OUT</span>
                                }
                                else if (candidate.EvidenceCoverage < .5m)
                                {
                                    <span class="um-badge um-badge-warning" title="This candidate has evidence on only some interpretation dimensions; its ranking is discounted accordingly."><i class="bi bi-exclamation-triangle"></i> LOW COVERAGE @candidate.EvidenceCoverage.ToString("P0")</span>
                                }
                                @foreach (var score in candidate.BranchScores)
                                {
                                    @if (score.ChildScores.Count > 0)
                                    {
                                        <span class="um-badge um-badge-neutral" title="@RollUpTooltip(score)"><i class="bi bi-diagram-2" aria-hidden="true"></i> @score.BranchDisplayName @score.EvidenceScore.ToString("P0")</span>
                                    }
                                    else
                                    {
                                        <span class="um-badge um-badge-neutral" title="Candidate quality score for this interpretation dimension.">@score.BranchDisplayName @score.EvidenceScore.ToString("P0")</span>
                                    }
                                }
                            </div>
                            @if (candidate.BranchScores.Any(score => score.ChildScores.Count > 0))
                            {
                                <div class="poloxi-rollup">
                                    @foreach (var score in candidate.BranchScores.Where(score => score.ChildScores.Count > 0))
                                    {
                                        <small class="poloxi-rollup-line"><strong>@score.BranchDisplayName</strong> = 50% direct @((score.DirectScore ?? score.EvidenceScore).ToString("P0")) + 50% sub-criteria: @string.Join(" · ", score.ChildScores.OrderByDescending(child => child.EvidenceScore).Select(child => $"{child.BranchDisplayName} {child.EvidenceScore:P0}"))</small>
                                    }
                                </div>
                            }
                        </div>
                        <div class="poloxi-score"><strong>@candidate.QualityScore.ToString("P0")</strong><small>Quality</small></div>
                        <div class="poloxi-score" title="How well the evidence supports the quality score: independent-source diversity and dimension coverage."><strong>@candidate.EvidenceConfidence.ToString("P0")</strong><small>Evidence</small></div>
                    </article>
                }
            </section>
        }

        @ComparisonPanel
    }

    @* ── External sources, live grounding, and AI-suggested authorities (mirrors the main answer page). ── *@
    @if (Owner.DaExternalReferences.Count > 0)
    {
        <div class="poloxi-answer-section poloxi-reveal">
            <h3><i class="bi bi-globe2"></i> External sources <small class="poloxi-section-note">Real-world references · LLM knowledge (not enterprise-verified)</small></h3>
            @foreach (var reference in Owner.DaExternalReferences)
            {
                <article class="poloxi-evidence poloxi-evidence-clickable" @ondblclick="() => Owner.DaOpenExternal(reference.Url)" title="Double-click to open @reference.Url in a new tab.">
                    <span class="poloxi-rank"><i class="bi bi-globe2"></i></span>
                    <div class="poloxi-evidence-main">
                        <strong>@reference.Title</strong>
                        <small>@reference.Source</small>
                        <p>@reference.Summary</p>
                        <div><span class="um-badge um-badge-neutral">@Owner.DaBranchNameWithLevel(reference.BranchDisplayName)</span> <a href="@reference.Url" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">@reference.Url <i class="bi bi-box-arrow-up-right"></i></a></div>
                    </div>
                </article>
            }
        </div>
    }
    @if (Owner.DaExternalKnowledge.Count > 0)
    {
        <div class="poloxi-answer-section poloxi-reveal">
            <h3><i class="bi bi-broadcast"></i> Live grounding sources <small class="poloxi-section-note">Live web sources · retrieved for time-sensitive grounding</small></h3>
            @foreach (var snippet in Owner.DaExternalKnowledge)
            {
                var corpusVersionId = snippet.LegalDocumentVersionId;
                var corpusDocUrl = corpusVersionId is { } cv ? Api.LegalDocumentVersionContentUrl(cv) : null;
                <article class="poloxi-evidence poloxi-evidence-clickable" @ondblclick="() => Owner.DaOpenExternal(corpusDocUrl ?? snippet.Url)" title="@(corpusDocUrl is not null ? "Double-click to open the source document." : $"Double-click to open {snippet.Url} in a new tab.")">
                    <span class="poloxi-rank"><i class="bi bi-broadcast"></i></span>
                    <div class="poloxi-evidence-main">
                        <strong>@snippet.Title</strong>
                        <small>Retrieved @snippet.RetrievedDateUtc.ToString("yyyy-MM-dd HH:mm") UTC</small>
                        <p>@snippet.Snippet</p>
                        @if (corpusDocUrl is not null)
                        {
                            <div><span class="um-badge um-badge-neutral"><i class="bi bi-file-earmark-text"></i> MATTER DOCUMENT</span> <button type="button" class="poloxi-doc-link" @onclick="() => Owner.OpenDocumentPreview(corpusVersionId!.Value, string.IsNullOrWhiteSpace(snippet.LegalDocumentFileName) ? snippet.Title : snippet.LegalDocumentFileName)" @onclick:stopPropagation="true"><i class="bi bi-file-earmark-pdf"></i> @(string.IsNullOrWhiteSpace(snippet.LegalDocumentFileName) ? "Open document" : snippet.LegalDocumentFileName)</button></div>
                        }
                        else
                        {
                            <div><span class="um-badge um-badge-success"><i class="bi bi-globe2"></i> LIVE</span> <a href="@snippet.Url" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">@snippet.Url <i class="bi bi-box-arrow-up-right"></i></a></div>
                        }
                    </div>
                </article>
            }
        </div>
    }
    @if (Owner.DaAuthorities.Count > 0)
    {
        <div class="poloxi-answer-section poloxi-reveal poloxi-proposed-authorities">
            <h3><i class="bi bi-lightbulb"></i> AI-suggested authorities <small class="poloxi-section-note">Not evidence &middot; unverified AI leads used only to guide retrieval</small></h3>
            <p class="poloxi-proposed-caution"><i class="bi bi-exclamation-triangle"></i> These authorities were proposed by the AI model as likely-relevant leads. They are <strong>not evidence</strong> and are not enterprise-verified. A <span class="um-badge um-badge-success">Confirmed by source</span> badge means a retrieved external source matched the citation; <span class="um-badge um-badge-warning">Unconfirmed lead</span> means retrieval did not confirm it.</p>
            @foreach (var authority in Owner.DaAuthorities)
            {
                <article class="poloxi-evidence poloxi-proposed-authority">
                    <span class="poloxi-rank"><i class="bi bi-lightbulb"></i></span>
                    <div class="poloxi-evidence-main">
                        <strong>@authority.Name</strong>
                        <small>@authority.Kind</small>
                        @if (!string.IsNullOrWhiteSpace(authority.Relevance))
                        {
                            <p>@authority.Relevance</p>
                        }
                        <div>
                            @if (authority.VerificationStatus == "VERIFIED")
                            {
                                <span class="um-badge um-badge-success"><i class="bi bi-check-circle"></i> Confirmed by source</span>
                            }
                            else
                            {
                                <span class="um-badge um-badge-warning"><i class="bi bi-question-circle"></i> Unconfirmed lead</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@* ── Premium citation passage viewer. Opens when a citation name is clicked and highlights every
     matter passage (factor, admitted evidence with its matched dimensions/propositions, and live
     grounding snippet) whose text maps to the citation. Never fabricates — only passages that share
     meaningful terms with the citation are shown, each with the overlapping terms highlighted. ── *@
@if (_viewerCitation is { } vc)
{
    var matches = ExtractCitationPassages(vc);
    <div class="cit-viewer-backdrop" @onclick="CloseCitationViewer">
        <div class="cit-viewer" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header class="cit-viewer-head">
                <div class="cit-viewer-head-main">
                    <span class="cit-viewer-icon"><i class="bi bi-quote" aria-hidden="true"></i></span>
                    <div>
                        <span class="cit-viewer-kicker">Citation passage viewer</span>
                        <h3>@vc.Name</h3>
                        <div class="cit-viewer-meta">
                            @if (!string.IsNullOrWhiteSpace(vc.Kind))
                            {
                                <span class="um-badge um-badge-neutral">@vc.Kind</span>
                            }
                            <span class="um-badge @(IsVerified(vc.VerificationStatus) ? "um-badge-success" : "um-badge-warning")">
                                <i class="bi @(IsVerified(vc.VerificationStatus) ? "bi-check-circle" : "bi-question-circle")"></i> @vc.VerificationStatus
                            </span>
                            @{ var vcLink = ResolveCitationLink(vc.Name); }
                            <a href="@vcLink.Url" target="_blank" rel="noopener noreferrer" class="um-badge @(vcLink.IsRetrieved ? "um-badge-success" : "um-badge-neutral")" title="@(vcLink.IsRetrieved ? "Open the retrieved source" : "Open a web lookup")">
                                <i class="bi bi-box-arrow-up-right"></i> @(vcLink.IsRetrieved ? "Source" : "Web search")
                            </a>
                        </div>
                    </div>
                </div>
                <button type="button" class="cit-viewer-close" @onclick="CloseCitationViewer" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </header>

            <div class="cit-viewer-body">
                @if (!string.IsNullOrWhiteSpace(vc.Relevance))
                {
                    <section class="cit-viewer-section">
                        <span class="cit-viewer-section-label"><i class="bi bi-bank"></i> Why this authority matters</span>
                        <p class="cit-viewer-relevance">@vc.Relevance</p>
                    </section>
                }

                <section class="cit-viewer-section">
                    <span class="cit-viewer-section-label"><i class="bi bi-folder2-open"></i> Mapped matter passages <span class="cit-viewer-count">@matches.Count</span></span>
                    @if (matches.Count == 0)
                    {
                        <p class="cit-viewer-empty"><i class="bi bi-info-circle"></i> No matter passage in this session shares meaningful terms with this citation. Nothing is fabricated — the citation remains an external-authority lead only.</p>
                    }
                    else
                    {
                        @foreach (var m in matches)
                        {
                            <article class="cit-match cit-match--@m.Kind.ToLowerInvariant()">
                                <div class="cit-match-head">
                                    <span class="cit-match-tag"><i class="bi @m.Icon"></i> @m.KindLabel</span>
                                    <strong class="cit-match-title">@m.Title</strong>
                                </div>
                                <p class="cit-match-passage">@HighlightPassage(m.Passage, m.Terms)</p>
                                @if (m.Mappings.Count > 0)
                                {
                                    <div class="cit-match-mappings">
                                        @foreach (var map in m.Mappings)
                                        {
                                            <span class="cit-match-chip" title="Mapped @map.Kind"><i class="bi @map.Icon"></i> @map.Label</span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.NavigationRoute))
                                {
                                    <a href="@m.NavigationRoute" class="cit-match-open" @onclick:stopPropagation="true"><i class="bi bi-arrow-up-right-circle"></i> Open source record</a>
                                }
                            </article>
                        }
                    }
                </section>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;

    private string _filter = "ALL";
    private string _search = string.Empty;

    // Exact Deep Citations prompt prefix. Deep Citation runs are the only runs that start with this
    // text, so it also identifies Deep Citation runs in Search History (used by rehydration to avoid
    // adopting the Decision2 single-submit run as if it were a Deep Citation result).
    private const string DeepCitationPromptPrefix = "List top best citations for this matter case,, ";

    // Canonical Legal search context code (POLOXI.Legal_SearchContext.ContextCode). Any /legal/search run
    // executed in this context is citation/legal-authority related and surfaces in the Citations tab.
    private const string LegalContextCode = "LEGAL";

    // A run belongs in the Citations tab's Deep Citation History when it is either an explicit Deep
    // Citations run (fixed prompt prefix) OR any run executed in the Legal search context — regardless of
    // where it was generated (/legal/search or this tab). ContextCode is stamped at save time, so the
    // link is deterministic and bidirectional without matter scoping or heuristics.
    private static bool IsCitationRelatedRun(WideSearchRunSummaryDto run)
        => (run.Query is not null && run.Query.StartsWith(DeepCitationPromptPrefix, StringComparison.Ordinal))
           || string.Equals(run.ContextCode, LegalContextCode, StringComparison.OrdinalIgnoreCase);

    // ── Deep Citations state ──
    private IReadOnlyCollection<WideModelOptionDto> _models = [];
    private string _deepText = string.Empty;
    private string _deepModelCode = string.Empty;
    private bool _deepLoading;
    private string? _deepError;
    private WideSearchResponse? _deepResponse;
    private bool _modelsLoaded;

    // ── Deep Citation History state ──
    // All Deep Citation runs saved for this matter (newest first), each carrying its persisted
    // enterprise Search Quality score/grade (0475). Clicking a row rehydrates its full result below.
    private readonly List<WideSearchRunSummaryDto> _deepHistory = [];
    private bool _deepHistoryLoading;
    private Guid? _activeHistoryRunId;

    // Deterministic final ranking (mirrors /legal/search): filter constraint violations, order by rank, take 10.
    private static IReadOnlyList<WideCandidateDto> DeepRankedCandidates(WideSearchResponse resp)
        => resp.Candidates
            .Where(c => !c.IsConstraintViolation)
            .OrderBy(c => c.RankNumber)
            .Take(10)
            .ToArray();

    // Authorities powering the top Citations table. PRIORITY: the best-quality Deep Citation run for THIS
    // matter (_deepResponse, selected by RehydrateLatestDeepCitationsAsync using the best-quality rule), so
    // the table reflects the same authoritative run the Deep Citation panel shows. The Deep run exposes two
    // complementary authority surfaces — the flat ProposedLegalAuthorities list and the branch-grouped
    // InterpretiveResults ranked authorities. Prefer the flat list; when it is empty (common for Deep
    // Citation runs whose authorities live only in the ranked branches) derive a de-duplicated roster from
    // the ranked items (highest branch score wins). Fall back to the Decision2 saved-run authorities
    // (Owner.DaAuthorities) only when no Deep Citation run exists for the matter yet.
    private IReadOnlyList<WideProposedAuthorityDto> CitationTableAuthorities
    {
        get
        {
            if (_deepResponse is { } resp)
            {
                if (resp.ProposedLegalAuthorities is { Count: > 0 } flat)
                    return flat.ToArray();

                if (resp.InterpretiveResults is { Count: > 0 } ranked)
                {
                    var roster = ranked
                        .SelectMany(b => b.Items)
                        .Where(i => !string.IsNullOrWhiteSpace(i.Name))
                        .GroupBy(i => i.Name.Trim(), StringComparer.OrdinalIgnoreCase)
                        .Select(g => g.OrderByDescending(i => i.Score ?? decimal.MinValue).First())
                        .OrderByDescending(i => i.Score ?? decimal.MinValue)
                        .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
                        .Select(i => new WideProposedAuthorityDto(
                            i.Name.Trim(),
                            string.Empty,
                            i.Detail ?? string.Empty,
                            "UNVERIFIED"))
                        .ToArray();
                    if (roster.Length > 0)
                        return roster;
                }
            }

            return Owner.DaAuthorities;
        }
    }

    // ── /legal/search result-parity helpers (bound to _deepResponse) ──
    private IReadOnlyCollection<WideBranchDto> SurvivingBranches => _deepResponse?.Branches.Where(x => !x.IsEliminated).ToArray() ?? [];
    private IReadOnlyCollection<WideBranchDto> EliminatedBranches => _deepResponse?.Branches.Where(x => x.IsEliminated).ToArray() ?? [];
    private int ActiveBranchCount => SurvivingBranches.Count(x => x.BranchStateCode == "ACTIVE");

    private bool HasEnterpriseEvidence => _deepResponse?.EnterpriseEvidenceCount > 0;
    private int TotalEvidenceCount => _deepResponse is null ? 0 : _deepResponse.EnterpriseEvidenceCount + _deepResponse.ExternalEvidenceCount;
    private bool HasAnyEvidence => TotalEvidenceCount > 0;
    private bool IsEvidenceWeightedConfidence => _deepResponse?.DecisionConfidence is not null;
    private string ConfidenceLabel => IsEvidenceWeightedConfidence ? "Decision evidence confidence" : "Interpretation confidence";
    private string ConfidenceCaption => IsEvidenceWeightedConfidence ? "evidence-backed decision confidence" : "not evidence-weighted";
    private string SurvivalVerb => HasAnyEvidence ? "survived grounding" : "survived interpretive narrowing";
    private string CandidateUncertaintyDisplay => (HasAnyEvidence && IsEvidenceWeightedConfidence)
        ? _deepResponse!.FinalNormalizedEntropy.ToString("P0")
        : "NOT_APPLICABLE";

    // V2.4: the final visible ranking deterministically follows the Candidate × Branch competition.
    // No display cap — every non-violating candidate the pipeline ranked is shown.
    private IReadOnlyList<WideCandidateDto> FinalRankedCandidates => _deepResponse is null ? []
        : _deepResponse.Candidates.Where(c => !c.IsConstraintViolation).OrderBy(c => c.RankNumber).ToArray();

    private bool ShouldShowComparisonPanel => _deepResponse is not null
        && (FinalRankedCandidates.Count > 0
            || BaselineRankedCandidates.Count > 0
            || LlmRawItems.Count > 0
            || string.Equals(_deepResponse.AnswerKindCode, "ENTITY_RANKING", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_deepResponse.QueryContract?.OutputShape, "ranked_list", StringComparison.OrdinalIgnoreCase));

    // Naive baseline ranking: mention frequency first, then a PLAIN unweighted average of the per-dimension
    // scores as tie-break — never POLOXI's RankNumber.
    private IReadOnlyList<WideCandidateDto> BaselineRankedCandidates => _deepResponse is null ? []
        : _deepResponse.Candidates
            .Where(c => !c.IsConstraintViolation && c.InterpretiveSupportCount > 0)
            .OrderByDescending(c => c.InterpretiveSupportCount)
            .ThenByDescending(c => c.BranchScores.Count > 0 ? c.BranchScores.Average(s => s.EvidenceScore) : 0m)
            .ThenBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<WideInterpretiveResultItemDto> LlmRawItems => _deepResponse is null ? []
        : _deepResponse.LlmRawItems.OrderBy(x => x.RankNumber).ToArray();

    private string PoloxiUnavailableReason => _deepResponse switch
    {
        null => "no response loaded",
        { Candidates.Count: > 0 } when _deepResponse.Candidates.All(c => c.IsConstraintViolation) => "all candidate rows were ruled out by constraints or admission gates",
        { InterpretiveResults.Count: 0 } => "no interpretive ranked candidate items were returned to seed competition",
        { AnswerKindCode: not "ENTITY_RANKING" } when _deepResponse.QueryContract?.OutputShape != "ranked_list" => $"answer kind was routed as {_deepResponse.AnswerKindCode?.Replace('_', ' ') ?? "unclassified"}, so final candidate ranking was not required",
        { ExternalEvidenceCount: 0, EnterpriseEvidenceCount: 0 } => "no enterprise or external evidence was available to score candidates against branches",
        { DecisionEvidenceCoverage: 0 } => "candidate matrix did not resolve usable scored decision dimensions",
        { Candidates.Count: 0 } => "candidate normalization, matrix scoring, or LLM structured output produced no admissible candidates",
        _ => "no final non-violating candidate ranking was available"
    };

    private string BaselineUnavailableReason => _deepResponse switch
    {
        null => "no response loaded",
        { Candidates.Count: 0 } => "no normalized POLOXI candidate pool was produced",
        _ when !_deepResponse.Candidates.Any(c => !c.IsConstraintViolation) => "all candidates were ruled out before baseline ranking",
        _ when !_deepResponse.Candidates.Any(c => c.InterpretiveSupportCount > 0) => "candidate rows have no interpretive mention counts to rank by frequency",
        _ => "no baseline candidates remained after filtering"
    };

    private static string MentionBreakdown(WideCandidateDto candidate) => candidate.BranchScores.Count == 0
        ? $"Named by {candidate.InterpretiveSupportCount} interpretive dimension(s); per-dimension scores unavailable for this candidate."
        : $"Named by {candidate.InterpretiveSupportCount} interpretive dimension(s):\n" + string.Join("\n",
            candidate.BranchScores.OrderByDescending(s => s.EvidenceScore).Select(s => $"• {s.BranchDisplayName}: {s.EvidenceScore:P0} quality score"));

    private static string RollUpTooltip(WideCandidateBranchScoreDto score) =>
        $"Rolled up from progressive narrowing (50% direct + 50% sub-criteria).\nDirect judgment: {(score.DirectScore ?? score.EvidenceScore):P0}\n" + string.Join("\n",
            score.ChildScores.OrderByDescending(child => child.EvidenceScore).Select(child => $"• {child.BranchDisplayName}: {child.EvidenceScore:P0} (weight {child.Confidence:P0})"));

    // Where a raw-LLM entry landed in the POLOXI ranking (1-based), or null when POLOXI excluded it.
    private int? FindPoloxiRank(string rawName)
    {
        var rawCode = ParentheticalCode(rawName);
        var rawPrimary = PrimaryName(rawName);
        for (var index = 0; index < FinalRankedCandidates.Count; index++)
        {
            var candidate = FinalRankedCandidates[index].DisplayName;
            if (candidate.Equals(rawName, StringComparison.OrdinalIgnoreCase)) return index + 1;
            if (rawCode is not null && rawCode.Equals(ParentheticalCode(candidate), StringComparison.OrdinalIgnoreCase)) return index + 1;
            if (candidate.Contains(rawName, StringComparison.OrdinalIgnoreCase)
                || rawName.Contains(candidate, StringComparison.OrdinalIgnoreCase)) return index + 1;
            if (rawPrimary.Length >= 4 && rawPrimary.Equals(PrimaryName(candidate), StringComparison.OrdinalIgnoreCase)) return index + 1;
        }
        return null;
    }

    private static string? ParentheticalCode(string name)
    {
        var open = name.LastIndexOf('(');
        var close = name.LastIndexOf(')');
        return open >= 0 && close > open + 1 ? name[(open + 1)..close].Trim() : null;
    }

    private static string PrimaryName(string name)
    {
        var primary = name.Split(',', '(', '\u2013', '\u2014')[0].Trim();
        foreach (var suffix in new[] { " Inc.", " Inc", " Corporation", " Corp.", " Corp", " Co.", " Company", " Ltd.", " Ltd", " PLC", " LLC" })
            if (primary.EndsWith(suffix, StringComparison.OrdinalIgnoreCase)) { primary = primary[..^suffix.Length].Trim(); break; }
        return primary;
    }

