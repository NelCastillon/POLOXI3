    protected override async Task OnInitializedAsync()
    {
        if (_modelsLoaded)
            return;
        _modelsLoaded = true;

        // Default the Deep Citations context to the matter's serialized context block
        // (the same [SUPPLIED] PERSONAL INJURY CONTEXT / FACT AND EVIDENCE STATUS text shown on Overview).
        if (string.IsNullOrWhiteSpace(_deepText) && Owner.DaMatterContextText is { Length: > 0 } ctx)
            _deepText = ctx;

        try { _models = await Api.GetIntelligenceWideModelsAsync(); }
        catch { _models = []; }

        // The Deep Citations result lives in component state, so switching tabs disposes it. Rehydrate the
        // most recent saved run for THIS matter from Search History so the result persists across tab
        // switches (the run was already saved to /legal/search history, linked by MatterId).
        await RehydrateLatestDeepCitationsAsync();
    }

    // Reloads the newest citation-related run from Search History into _deepResponse so the bottom-of-tab
    // result survives navigation. Fail-soft: any error simply leaves the panel empty.
    private async Task RehydrateLatestDeepCitationsAsync()
    {
        try
        {
            // Scope history to THIS matter so a run generated for another matter (e.g. a different
            // plaintiff) can never surface in — or be auto-adopted as the "best" run for — this
            // matter's Citations tab. Without the MatterId filter, global history leaks cross-matter
            // citation runs (the root cause of unrelated authorities appearing here).
            var matterId = Owner.DaMatterId is { } mid && mid != Guid.Empty ? mid : (Guid?)null;
            var history = await Api.GetSearchRunHistoryAsync(page: 1, pageSize: 50, matterId: matterId);
            // Only adopt citation-related runs — never the Decision2 single-submit (Wide2) run, which also
            // writes history rows. Citation runs are identified by the Deep Citation prefix OR Legal context.
            var deepRuns = history.Items
                .Where(IsCitationRelatedRun)
                .OrderByDescending(item => item.CreatedDateUtc)
                .ToArray();

            _deepHistory.Clear();
            _deepHistory.AddRange(deepRuns);

            // Rehydrate the BEST run into the result panel when nothing is loaded yet, so the Deep
            // Citation surface always shows the highest-quality run (not merely the newest). "Best" is
            // the highest persisted Search Quality score, tie-broken by newest. The history list above
            // stays newest-first for scanning; only the auto-loaded result panel prefers the best run.
            if (_deepResponse is null && !_deepLoading && deepRuns.Length > 0)
            {
                var bestRun = deepRuns
                    .OrderByDescending(item => item.QualityScore ?? decimal.MinValue)
                    .ThenByDescending(item => item.CreatedDateUtc)
                    .First();
                var detail = await Api.GetSearchRunResultAsync(bestRun.WideSearchRunResultId);
                if (detail?.Response is { } response)
                {
                    _deepResponse = response;
                    _activeHistoryRunId = bestRun.WideSearchRunResultId;
                }
            }
        }
        catch
        {
            // Advisory rehydration only — never block the tab if history is unavailable.
        }
    }

    // Reload the Deep Citation history list on demand (user-triggered refresh).
    private async Task RefreshDeepHistoryAsync()
    {
        if (_deepHistoryLoading)
            return;
        _deepHistoryLoading = true;
        try
        {
            // Matter-scoped history (see RehydrateLatestDeepCitationsAsync) so the refreshed list only
            // shows citation-related runs belonging to THIS matter, matched by the shared citation
            // predicate (Deep Citation prefix OR Legal context).
            var matterId = Owner.DaMatterId is { } mid && mid != Guid.Empty ? mid : (Guid?)null;
            var history = await Api.GetSearchRunHistoryAsync(page: 1, pageSize: 50, matterId: matterId);
            var deepRuns = history.Items
                .Where(IsCitationRelatedRun)
                .OrderByDescending(item => item.CreatedDateUtc)
                .ToArray();
            _deepHistory.Clear();
            _deepHistory.AddRange(deepRuns);
        }
        catch (Exception ex)
        {
            _deepError = $"Could not refresh Deep Citation history: {ex.Message}";
        }
        finally
        {
            _deepHistoryLoading = false;
        }
    }

    // Load a previously saved Deep Citation run into the result panel below.
    private async Task OpenHistoryRunAsync(WideSearchRunSummaryDto run)
    {
        if (_deepLoading || run.WideSearchRunResultId == _activeHistoryRunId)
            return;
        _deepLoading = true;
        _deepError = null;
        try
        {
            var detail = await Api.GetSearchRunResultAsync(run.WideSearchRunResultId);
            if (detail?.Response is { } response)
            {
                _deepResponse = response;
                _activeHistoryRunId = run.WideSearchRunResultId;
            }
            else
            {
                _deepError = "This Deep Citation run could not be loaded.";
            }
        }
        catch (Exception ex)
        {
            _deepError = $"Could not open Deep Citation run: {ex.Message}";
        }
        finally
        {
            _deepLoading = false;
        }
    }

    // Display title for a saved Deep Citation run (prompt prefix stripped, trimmed to a readable length).
    private static string DeepHistoryTitle(WideSearchRunSummaryDto run)
    {
        var q = run.Query ?? string.Empty;
        if (q.StartsWith(DeepCitationPromptPrefix, StringComparison.Ordinal))
            q = q[DeepCitationPromptPrefix.Length..].Trim();
        if (string.IsNullOrWhiteSpace(q))
            return "Deep Citation search";
        return q.Length > 160 ? q[..160].TrimEnd() + "…" : q;
    }

    // Quality percent for the chip. QualityScore is persisted as a 0–1 fraction (identical to the
    // /legal/search Search History badge), so render it as score × 100.
    private static int QualityPercent(decimal score) => (int)Math.Round(score * 100m);
    private static string QualityGradeFromScore(decimal score) => score switch
    {
        >= 0.90m => "A",
        >= 0.80m => "B",
        >= 0.70m => "C",
        >= 0.60m => "D",
        _ => "F"
    };

    // Status label/class for the history card (mirrors /legal/search Search History).
    private static string HistoryStatusLabel(string? statusCode) => statusCode switch
    {
        null or "" => "Completed",
        "USER_CLARIFICATION_REQUIRED" => "Clarification",
        _ => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(statusCode.Replace('_', ' ').ToLowerInvariant()),
    };

    private static string HistoryStatusClass(string? statusCode) => statusCode switch
    {
        "USER_CLARIFICATION_REQUIRED" => "clarify",
        "FAILED" or "ERROR" => "failed",
        "CANCELLED" => "cancelled",
        _ => "ok",
    };

    private static string Truncate(string value, int max)
        => value.Length <= max ? value : value[..max].TrimEnd() + "…";


    // Build the prompt from the box above, run it through the same POLOXI "Legal" search pipeline used by
    // /legal/search (CourtListener/GovInfo grounding) with the chosen model, and render the result below.
    private async Task RunDeepCitationsAsync()
    {
        var context = _deepText?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(context) || _deepLoading)
            return;

        const string promptPrefix = DeepCitationPromptPrefix;
        const int maxPromptLength = 4000;
        // The API caps Query at 4000 chars. Trim the context so prefix + context never exceeds it.
        var budget = maxPromptLength - promptPrefix.Length;
        if (context.Length > budget)
            context = context[..budget];
        var prompt = promptPrefix + context;

        _deepLoading = true;
        _deepError = null;
        _deepResponse = null;
        try
        {
            _deepResponse = await Api.IntelligentSearchWideDynamicAsync(
                new(Guid.Empty, Guid.Empty, prompt, 50, Guid.NewGuid().ToString("N"))
                {
                    ModelCode = string.IsNullOrWhiteSpace(_deepModelCode) ? "gpt-4.1-mini" : _deepModelCode,
                    ContextCode = "LEGAL",
                    ConversationId = Guid.NewGuid(),
                    // Link this Deep Citations run to the current matter so the saved /legal/search run
                    // history row relates back to this Matter instead of being an ad-hoc search.
                    MatterId = Owner.DaMatterId is { } dcMatterId && dcMatterId != Guid.Empty ? dcMatterId : null
                });
        }
        catch (Exception ex)
        {
            _deepError = $"Deep Citations search failed: {ex.Message}";
        }
        finally
        {
            _deepLoading = false;
        }

        // Refresh the history so the newly-saved run (with its persisted quality score) appears
        // and is marked active. Fail-soft: run display already succeeded above.
        if (_deepResponse is not null)
        {
            await RefreshDeepHistoryAsync();
            _activeHistoryRunId = _deepHistory.Count > 0 ? _deepHistory[0].WideSearchRunResultId : null;
        }
    }

    private static bool IsVerified(string? status)
        => string.Equals(status, "VERIFIED", StringComparison.OrdinalIgnoreCase);

    private static string CitationSearchUrl(string authorityName)
        => LegalPersonalInjuryDecision2.OvCitationSearchUrl(authorityName);

    private static string WebSearchUrl(string name)
        => $"https://www.google.com/search?q={Uri.EscapeDataString(name ?? string.Empty)}";

    // Resolves the actual source-site URL for a citation name by matching it against the real URLs
    // retrieved by the Deep/Wide pipeline (external references, live grounding snippets) and the
    // matter's existing external sources. Returns the retrieved URL plus IsRetrieved=true when a
    // real source matched; otherwise falls back to a web-search lookup with IsRetrieved=false so the
    // UI can label it honestly. Never fabricates: only URLs that are present on retrieved sources are
    // treated as actual sources.
    private (string Url, bool IsRetrieved) ResolveCitationLink(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return (WebSearchUrl(name ?? string.Empty), false);

        var terms = Tokenize(name);

        string? bestUrl = null;
        var bestScore = 0;

        void Consider(string? title, string? url)
        {
            if (string.IsNullOrWhiteSpace(url) || !IsHttpUrl(url))
                return;
            var haystack = $"{title} {url}";
            var score = Overlap(terms, Tokenize(haystack));
            // A citation name embedded verbatim in the title/url is a strong match even when the
            // tokenizer drops short/stop words, so treat a substring hit as a baseline score of 1.
            if (score == 0 && !string.IsNullOrWhiteSpace(title) &&
                title.Contains(name, StringComparison.OrdinalIgnoreCase))
                score = 1;
            if (score > bestScore)
            {
                bestScore = score;
                bestUrl = url;
            }
        }

        if (_deepResponse is not null)
        {
            foreach (var reference in _deepResponse.ExternalReferences)
                Consider(reference.Title, reference.Url);
            foreach (var snippet in _deepResponse.ExternalKnowledge)
                Consider(snippet.Title, snippet.Url);
        }

        foreach (var reference in Owner.DaExternalReferences)
            Consider(reference.Title, reference.Url);
        foreach (var snippet in Owner.DaExternalKnowledge)
            Consider(snippet.Title, snippet.Url);

        // Require at least one shared meaningful term (or a verbatim substring hit) so an unrelated
        // source is never presented as the citation's actual site.
        return bestScore >= 1 && bestUrl is not null
            ? (bestUrl, true)
            : (CitationSearchUrl(name), false);
    }

    private static bool IsHttpUrl(string? url)
        => !string.IsNullOrWhiteSpace(url)
           && Uri.TryCreate(url, UriKind.Absolute, out var uri)
           && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    // Deterministic matter-passage fallback. When the Legal Answer Composer did not quote a linked
    // matter passage for an authority, surface the best-matching passage that already exists on this
    // matter — a factor (name/requirement/actual value) or an admitted-evidence excerpt — chosen by
    // token overlap with the authority's name + relevance. Never fabricates: returns null when no
    // candidate shares meaningful terms with the authority.
    private string? MatchMatterPassage(WideLegalAuthorityDto authority)
        => MatchMatterPassage(authority, null);

    // Resolves a DISTINCT linked matter passage for every authority in order. The composer-produced
    // passage is preferred when present; otherwise a deterministic token-overlap match is used. A passage
    // already assigned to an earlier authority is excluded from later matches, so three authorities that
    // share generic terms ("premises", "liability") no longer collapse onto the same ledger line.
    private IReadOnlyList<string?> ResolveDistinctLinkedPassages(IReadOnlyList<WideLegalAuthorityDto> authorities)
    {
        var resolved = new string?[authorities.Count];
        var used = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        for (var i = 0; i < authorities.Count; i++)
        {
            var authority = authorities[i];
            string? passage = !string.IsNullOrWhiteSpace(authority.LinkedMatterPassage)
                ? authority.LinkedMatterPassage!.Trim()
                : MatchMatterPassage(authority, used);
            if (!string.IsNullOrWhiteSpace(passage) && !used.Add(passage))
            {
                // A composer-supplied passage duplicates an earlier one — try a distinct deterministic
                // match instead so the card is not an exact repeat.
                var alternative = MatchMatterPassage(authority, used);
                passage = !string.IsNullOrWhiteSpace(alternative) ? alternative : null;
                if (!string.IsNullOrWhiteSpace(passage))
                    used.Add(passage);
            }
            resolved[i] = passage;
        }
        return resolved;
    }

    private string? MatchMatterPassage(WideLegalAuthorityDto authority, HashSet<string>? exclude)
    {
        var query = $"{authority.Name} {authority.Relevance}";
        var queryTerms = Tokenize(query);
        if (queryTerms.Count == 0)
            return null;

        string? bestPassage = null;
        var bestScore = 0;

        foreach (var factor in Owner.DaFactors)
        {
            var passage = BuildFactorPassage(factor);
            if (string.IsNullOrWhiteSpace(passage))
                continue;
            if (exclude is not null && exclude.Contains(passage))
                continue;
            var score = Overlap(queryTerms, Tokenize(passage));
            if (score > bestScore)
            {
                bestScore = score;
                bestPassage = passage;
            }
        }

        foreach (var snippet in Owner.DaExternalKnowledge)
        {
            var passage = string.IsNullOrWhiteSpace(snippet.Snippet) ? snippet.Title : snippet.Snippet;
            if (string.IsNullOrWhiteSpace(passage))
                continue;
            if (exclude is not null && exclude.Contains(passage))
                continue;
            var score = Overlap(queryTerms, Tokenize(passage));
            if (score > bestScore)
            {
                bestScore = score;
                bestPassage = passage;
            }
        }

        // Require at least two shared meaningful terms so a weak/incidental overlap never fabricates a link.
        return bestScore >= 2 ? bestPassage : null;
    }

    private static string? BuildFactorPassage(WideFactorDto factor)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(factor.FactorName)) parts.Add(factor.FactorName);
        if (!string.IsNullOrWhiteSpace(factor.ActualValue)) parts.Add(factor.ActualValue!);
        else if (!string.IsNullOrWhiteSpace(factor.Requirement)) parts.Add(factor.Requirement);
        return parts.Count == 0 ? null : string.Join(" — ", parts);
    }

    // ── Premium citation passage viewer ──
    private WideProposedAuthorityDto? _viewerCitation;

    private void OpenCitationViewer(WideProposedAuthorityDto citation) => _viewerCitation = citation;
    private void CloseCitationViewer() => _viewerCitation = null;

    private sealed record CitationMappingChip(string Kind, string Icon, string Label);

    private sealed record CitationPassageMatch(
        string Kind,
        string KindLabel,
        string Icon,
        string Title,
        string Passage,
        IReadOnlyList<string> Terms,
        IReadOnlyList<CitationMappingChip> Mappings,
        string? NavigationRoute,
        int Score);

    // Extracts every matter passage whose text maps to this citation and records which decision
    // dimensions/propositions (via matched branches) and evidence/factor records back it. Deterministic
    // and non-fabricating: only passages sharing >= 2 meaningful terms with the citation name + relevance
    // are returned, ordered by overlap strength.
    private IReadOnlyList<CitationPassageMatch> ExtractCitationPassages(WideProposedAuthorityDto citation)
    {
        var queryTerms = Tokenize($"{citation.Name} {citation.Relevance}");
        if (queryTerms.Count == 0)
            return [];

        var matches = new List<CitationPassageMatch>();

        // Factors (matter requirements and their actual values).
        foreach (var factor in Owner.DaFactors)
        {
            var passage = BuildFactorPassage(factor);
            if (string.IsNullOrWhiteSpace(passage))
                continue;
            var hits = MatchingTerms(queryTerms, passage);
            if (hits.Count < 2)
                continue;
            var chips = new List<CitationMappingChip>
            {
                new("factor", "bi-diagram-3", string.IsNullOrWhiteSpace(factor.FactorType) ? "Factor" : factor.FactorType)
            };
            if (!string.IsNullOrWhiteSpace(factor.Availability))
                chips.Add(new("availability", "bi-clipboard-check", factor.Availability));
            matches.Add(new("factor", "Matter factor", "bi-diagram-3-fill",
                string.IsNullOrWhiteSpace(factor.FactorName) ? "Factor" : factor.FactorName,
                passage, hits, chips, factor.SourceLocation, hits.Count));
        }

        // Admitted evidence (with its matched decision dimensions / propositions via MatchedBranches).
        foreach (var ev in Owner.DaEvidence)
        {
            var passage = string.IsNullOrWhiteSpace(ev.Excerpt) ? ev.Title : ev.Excerpt;
            if (string.IsNullOrWhiteSpace(passage))
                continue;
            var hits = MatchingTerms(queryTerms, $"{ev.Title} {ev.Excerpt}");
            if (hits.Count < 2)
                continue;
            var chips = new List<CitationMappingChip>();
            if (!string.IsNullOrWhiteSpace(ev.ModuleCode))
                chips.Add(new("module", "bi-collection", ev.ModuleCode));
            foreach (var branch in ev.MatchedBranches.Where(b => !string.IsNullOrWhiteSpace(b)).Take(4))
                chips.Add(new("dimension", "bi-signpost-split", NormalizeBranchKey(branch)));
            matches.Add(new("evidence", "Admitted evidence", "bi-shield-check",
                string.IsNullOrWhiteSpace(ev.Title) ? "Evidence" : ev.Title,
                passage!, hits, chips, ev.NavigationRoute, hits.Count + 1));
        }

        // Live grounding snippets retrieved for this matter.
        foreach (var snippet in Owner.DaExternalKnowledge)
        {
            var passage = string.IsNullOrWhiteSpace(snippet.Snippet) ? snippet.Title : snippet.Snippet;
            if (string.IsNullOrWhiteSpace(passage))
                continue;
            var hits = MatchingTerms(queryTerms, $"{snippet.Title} {snippet.Snippet}");
            if (hits.Count < 2)
                continue;
            matches.Add(new("grounding", "Live grounding", "bi-broadcast",
                string.IsNullOrWhiteSpace(snippet.Title) ? "Source" : snippet.Title,
                passage!, hits, [], snippet.Url, hits.Count));
        }

        return matches
            .OrderByDescending(m => m.Score)
            .ThenBy(m => m.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    // Returns the distinct meaningful terms that the passage shares with the query, preserving order.
    private static List<string> MatchingTerms(List<string> queryTerms, string passage)
    {
        var passageSet = new HashSet<string>(Tokenize(passage), StringComparer.OrdinalIgnoreCase);
        return queryTerms
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(passageSet.Contains)
            .ToList();
    }

    // Wraps each overlapping term in the passage with a highlight span. HTML-encodes the passage first
    // so no raw matter text can inject markup; only the <mark> wrappers we add are rendered.
    private static MarkupString HighlightPassage(string passage, IReadOnlyList<string> terms)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(passage ?? string.Empty);
        if (terms.Count == 0)
            return (MarkupString)encoded;

        var pattern = string.Join("|", terms
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(System.Text.RegularExpressions.Regex.Escape));
        if (pattern.Length == 0)
            return (MarkupString)encoded;

        var highlighted = System.Text.RegularExpressions.Regex.Replace(
            encoded,
            $@"\b({pattern})\b",
            "<mark class=\"cit-hl\">$1</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);
        return (MarkupString)highlighted;
    }

    private static readonly HashSet<string> PassageStopWords = new(StringComparer.OrdinalIgnoreCase)
    {
        "the","and","for","with","that","this","from","under","over","into","upon","when","whether",
        "california","authority","case","claim","law","legal","matter","must","should","may","not",
        "per","its","are","was","were","has","have","had","a","an","of","to","in","on","or","by","is"
    };

    private static List<string> Tokenize(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return [];
        var terms = new List<string>();
        foreach (var raw in text.Split(new[] { ' ', ',', '.', ';', ':', '/', '(', ')', '-', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var term = raw.Trim().ToLowerInvariant();
            if (term.Length < 4 || PassageStopWords.Contains(term))
                continue;
            terms.Add(term);
        }
        return terms;
    }

    private static int Overlap(List<string> a, List<string> b)
    {
        if (a.Count == 0 || b.Count == 0)
            return 0;
        var set = new HashSet<string>(b, StringComparer.OrdinalIgnoreCase);
        return a.Distinct(StringComparer.OrdinalIgnoreCase).Count(set.Contains);
    }

    private static readonly System.Text.RegularExpressions.Regex BranchLevelBracketPrefixPattern =
        new(@"^\[\s*L(?:\d+|N)\s*\]\s*", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);
    private static readonly System.Text.RegularExpressions.Regex BranchConfidenceSuffixPattern =
        new(@"\s*\(\s*\d{1,3}\s*%\s*\)\s*$", System.Text.RegularExpressions.RegexOptions.CultureInvariant);
    private static readonly System.Text.RegularExpressions.Regex BranchLevelWordPrefixPattern =
        new(@"^L\d+\s*[·\-]\s*", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    private static string NormalizeBranchKey(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
            return string.Empty;
        var stripped = BranchLevelBracketPrefixPattern.Replace(displayName.Trim(), string.Empty);
        stripped = BranchConfidenceSuffixPattern.Replace(stripped, string.Empty);
        stripped = BranchLevelWordPrefixPattern.Replace(stripped, string.Empty);
        return stripped.Trim();
    }

    private IReadOnlyCollection<WideInterpretiveResultDto> GroupInterpretiveResults(WideAmbiguityGroupDto group)
    {
        var groupKeys = group.Branches.Count > 0
            ? group.Branches.Select(branch => NormalizeBranchKey(branch.DisplayName))
                .Where(key => key.Length > 0)
                .ToHashSet(StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        groupKeys.Add(NormalizeBranchKey(group.DisplayName));

        bool InGroup(WideInterpretiveResultDto result) => groupKeys.Contains(NormalizeBranchKey(result.BranchDisplayName));

        var scoped = group.InterpretiveResults.Where(InGroup).ToArray();
        if (scoped.Length > 0)
            return scoped;

        var all = _deepResponse?.InterpretiveResults ?? [];
        var matched = all.Where(InGroup).ToArray();
        if (matched.Length > 0)
            return matched;

        return group.InterpretiveResults;
    }

    private (decimal InterpretationPrior, decimal EvidenceSupport, decimal PoloxiConfidence) AmbiguityGroupScoreBreakdown(WideAmbiguityGroupDto group)
    {
        if (group.InterpretationPrior > 0 || group.EvidenceSupport > 0 || group.PoloxiConfidence > 0)
            return (group.InterpretationPrior, group.EvidenceSupport, group.PoloxiConfidence > 0 ? group.PoloxiConfidence : group.Confidence);
        var root = _deepResponse?.Branches.FirstOrDefault(branch => branch.WideBranchId == group.RootWideBranchId)
            ?? _deepResponse?.Branches.FirstOrDefault(branch => branch.LevelNumber == 1 && branch.DisplayName.Equals(group.DisplayName, StringComparison.OrdinalIgnoreCase));
        return root is null ? (0m, 0m, group.Confidence) : (root.InterpretationPrior, root.EvidenceSupport, root.PoloxiConfidence > 0 ? root.PoloxiConfidence : group.Confidence);
    }

    private static int AmbiguityGroupEvidenceCount(WideAmbiguityGroupDto group)
    {
        var enterprise = group.Evidence
            .Select(e => $"ENT:{e.EntityTypeCode}:{e.EntityId}")
            .Where(key => !string.IsNullOrWhiteSpace(key));

        var external = group.ExternalKnowledge
            .Select(k => k.LegalDocumentVersionId is { } v
                ? $"DOC:{v}"
                : !string.IsNullOrWhiteSpace(k.Url) ? $"URL:{k.Url}" : $"TTL:{k.Title}")
            .Where(key => !string.IsNullOrWhiteSpace(key));

        return enterprise.Concat(external).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    }

    // ── Reasoning hierarchy + Interpretation results helpers (mirrors /legal/search). ──
    private IEnumerable<IGrouping<int, WideBranchDto>> BranchLevels
        => (_deepResponse?.Branches ?? []).OrderBy(x => x.SortOrder).GroupBy(x => x.LevelNumber).OrderBy(group => group.Key);

    private IReadOnlyCollection<WideInterpretiveResultDto> PrioritizedInterpretiveResults
        => _deepResponse?.InterpretiveResults.Where(x => x.BranchStateCode != "DORMANT").ToArray() ?? [];
    private IReadOnlyCollection<WideInterpretiveResultDto> SecondaryInterpretiveResults
        => _deepResponse?.InterpretiveResults.Where(x => x.BranchStateCode == "DORMANT").ToArray() ?? [];

    private void OpenEvidence(PoloxiEvidenceDto evidence)
    {
        if (!string.IsNullOrWhiteSpace(evidence.NavigationRoute)) Navigation.NavigateTo(evidence.NavigationRoute);
    }

    private static string BranchStateLabel(WideBranchDto branch) => branch.BranchStateCode switch
    {
        "PRUNED" => "RULED OUT",
        "DORMANT" => "NOT PRIORITIZED",
        "SECONDARY" => "ALSO RELEVANT",
        _ => branch.IsEliminated ? "RULED OUT" : branch.GroundingStatusCode
    };

    private static readonly System.Text.RegularExpressions.Regex BranchLevelPrefixPattern =
        new(@"^L\d+\s*(?:·|-|:)?\s+", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);
    private static string LevelPrefix(int levelNumber) => levelNumber > 0 ? $"L{levelNumber}" : "LN";
    private static string StripExistingLevelPrefix(string displayName) => string.IsNullOrWhiteSpace(displayName) ? displayName : BranchLevelPrefixPattern.Replace(displayName.Trim(), string.Empty);
    private static string BranchDisplayWithLevel(WideBranchDto branch) => $"{LevelPrefix(branch.LevelNumber)} · {StripExistingLevelPrefix(branch.DisplayName)}";
    private string InterpretiveBranchDisplayWithLevel(WideInterpretiveResultDto result) => $"{LevelPrefix(result.LevelNumber)} · {StripExistingLevelPrefix(result.BranchDisplayName)}";

    private static readonly HashSet<string> ContractAssociationStopwords = new(StringComparer.OrdinalIgnoreCase)
    {
        "a","an","and","are","as","at","be","best","by","criteria","criterion","for","from","in","is","of","on","or","places","ranking","the","to","used","with"
    };
    private sealed record BranchContractEntry(string Value, string Label, string Icon, string Title);
    private static IReadOnlyCollection<BranchContractEntry> AssociatedContractEntries(WideBranchDto branch, WideQueryContract contract)
    {
        var branchTokens = ContractAssociationTokens($"{branch.DisplayName} {branch.Interpretation}");
        if (branchTokens.Count == 0) return [];
        var entries = new List<BranchContractEntry>();
        Add(contract.TargetObject ?? contract.EntityType, "UNIT", "bi-bullseye", "Comparison unit fixed by the query contract.");
        Add(contract.GeographicConstraint, "FIXED", "bi-geo-alt", "Geographic scope fixed by the query contract.");
        foreach (var constraint in contract.HardConstraints) Add(constraint, "FIXED", "bi-lock", "Hard constraint fixed by the query contract.");
        Add(contract.RankingConcept, "RANKING", "bi-sliders", "Evaluative concept this branch helps operationalize.");
        foreach (var concept in contract.AmbiguousConcepts) Add(concept, "AMBIGUOUS", "bi-question-circle", "Ambiguous concept this branch helps disambiguate.");
        return entries;

        void Add(string? value, string label, string icon, string title)
        {
            if (string.IsNullOrWhiteSpace(value)) return;
            var entryTokens = ContractAssociationTokens(value);
            if (entryTokens.Count == 0 || !entryTokens.Overlaps(branchTokens)) return;
            entries.Add(new(value.Trim(), label, icon, title));
        }
    }
    private static HashSet<string> ContractAssociationTokens(string value) => System.Text.RegularExpressions.Regex.Matches(value, @"[\p{L}\p{N}]+")
        .Select(match => match.Value.ToLowerInvariant())
        .Where(token => token.Length > 2 && !ContractAssociationStopwords.Contains(token))
        .Select(token => token.Length > 4 && token.EndsWith('s') ? token[..^1] : token)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
}
