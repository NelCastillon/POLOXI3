@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages
@using Legal.Application.Features.Intelligence.Decision

                                    <div class="di-workspace">
                                    <div class="di-head">
                                        <div class="di-head-icon"><i class="bi bi-file-earmark-text"></i></div>
                                        <div class="di-head-body">
                                            <span>Decision-aware document intelligence</span>
                                            <h4>Source-traceable evidence &amp; supported facts</h4>
                                            <p class="dfi-panel-sub">Every extracted assertion is linked to the originating document, page, and passage — and to the fact propositions it supports or contradicts.</p>
                                        </div>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm di-refresh" @onclick="Owner.LoadEvidenceGraphAsync" disabled="@Owner._evidenceGraphLoading" title="Reload document intelligence">
                                            <i class="bi @(Owner._evidenceGraphLoading ? "bi-arrow-repeat di-spin" : "bi-arrow-clockwise")"></i>
                                        </button>
                                        <label class="um-btn um-btn-primary um-btn-sm di-upload @(Owner._uploading ? "disabled" : "")" title="Upload one or more documents for real extraction (Blob storage + SHA-256 + Azure Document Intelligence)">
                                            <i class="bi @(Owner._uploading ? "bi-hourglass-split di-spin" : "bi-cloud-arrow-up")"></i>
                                            <span>@(Owner._uploading ? (Owner._uploadTotal > 1 ? $"Analyzing {Owner._uploadIndex}/{Owner._uploadTotal}…" : "Analyzing…") : "Upload documents")</span>
                                            <InputFile OnChange="Owner.UploadDocumentAsync" disabled="@Owner._uploading" multiple accept=".pdf,.docx,.txt,.png,.jpg,.jpeg,.tif,.tiff" style="display:none;" />
                                        </label>
                                    </div>

                                    <details class="di-evidence-context" style="margin:.5rem 0 .75rem;border:1px solid var(--um-border,#e2e8f0);border-radius:8px;padding:.5rem .75rem;">
                                        <summary style="cursor:pointer;font-weight:600;font-size:.85rem;"><i class="bi bi-fingerprint"></i> Evidence context (optional) — applied to the next upload as legal provenance</summary>
                                        <div class="um-form-grid" style="margin-top:.5rem;">
                                            <div class="um-field">
                                                <label>Source type</label>
                                                <select class="form-select form-select-sm" @bind="Owner._evSourceType">
                                                    @foreach (var st in LegalPersonalInjuryDecision2.EvidenceSourceTypes)
                                                    {
                                                        <option value="@st">@st</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="um-field"><label>Custodian</label><input class="form-control form-control-sm" @bind="Owner._evCustodian" placeholder="e.g. Jane Smith" /></div>
                                            <div class="um-field"><label>Produced by</label><input class="form-control form-control-sm" @bind="Owner._evProducedBy" placeholder="e.g. Plaintiff" /></div>
                                            <div class="um-field"><label>Production ID</label><input class="form-control form-control-sm" @bind="Owner._evProductionId" placeholder="e.g. PROD-001" /></div>
                                            <div class="um-field"><label>Bates start</label><input class="form-control form-control-sm" @bind="Owner._evBatesStart" placeholder="e.g. P000123" /></div>
                                            <div class="um-field"><label>Bates end</label><input class="form-control form-control-sm" @bind="Owner._evBatesEnd" placeholder="e.g. P000140" /></div>
                                        </div>
                                        <p style="font-size:.75rem;color:var(--um-text-muted,#64748b);margin:.4rem 0 0;">Physical bytes are deduplicated; this provenance is preserved as a distinct evidence occurrence. Leave blank to upload as a standalone occurrence.</p>
                                    </details>

                                    @if (Owner._error is not null)
                                    {
                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@Owner._error</div>
                                    }

                                    @if (Owner._evidenceGraphError is not null)
                                    {
                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@Owner._evidenceGraphError</div>
                                    }
                                    else if (Owner._evidenceGraphLoading && Owner._evidenceGraph is null)
                                    {
                                        <div class="di-empty"><i class="bi bi-hourglass-split"></i><p>Loading document intelligence…</p></div>
                                    }
                                    else if (Owner._evidenceGraph is null || (Owner._evidenceGraph.Evidence.Count == 0 && Owner._evidenceGraph.Propositions.Count == 0))
                                    {
                                        <div class="di-empty">
                                            <i class="bi bi-inbox"></i>
                                            <p>No analyzed documents yet for this matter. Upload documents in the matter corpus and the extracted evidence graph will appear here.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="di-kpis">
                                            <div class="di-kpi"><span class="di-kpi-val">@Owner._evidenceGraph.DocumentCount</span><span class="di-kpi-lbl">Documents</span></div>
                                            <div class="di-kpi"><span class="di-kpi-val">@Owner._evidenceGraph.Evidence.Count</span><span class="di-kpi-lbl">Evidence items</span></div>
                                            <div class="di-kpi"><span class="di-kpi-val">@Owner._evidenceGraph.Propositions.Count</span><span class="di-kpi-lbl">Fact propositions</span></div>
                                                <div class="di-kpi"><span class="di-kpi-val">@Owner._evidenceGraph.Propositions.Count(p => p.IsDecisionAuthoritative)</span><span class="di-kpi-lbl">Decision-authoritative</span></div>
                                            </div>

                                            <div class="di-subtabs" role="tablist" aria-label="Document Intelligence views">
                                                @foreach (var st in LegalPersonalInjuryDecision2.DiSubTabs)
                                                {
                                                    <button type="button" role="tab"
                                                            class="di-subtab @(Owner._diSubTab == st ? "di-subtab--active" : "")"
                                                            aria-selected="@(Owner._diSubTab == st ? "true" : "false")"
                                                            @onclick="() => Owner._diSubTab = st">
                                                        <i class="bi @LegalPersonalInjuryDecision2.DiSubTabIcon(st)"></i>
                                                        <span>@st</span>
                                                    </button>
                                                }
                                            </div>

                                            @switch (Owner._diSubTab)
                                            {
                                                case "Document Review":
                                            <div class="di-grid">
                                            <div class="di-col">
                                                <h5 class="di-col-title"><i class="bi bi-folder2-open"></i> Documents</h5>
                                                <button type="button" class="di-doc @(Owner._diSelectedDocumentId is null ? "di-doc--active" : "")" @onclick="() => Owner._diSelectedDocumentId = null">
                                                    <div class="di-doc-main"><i class="bi bi-collection"></i><span>All documents</span></div>
                                                    <span class="di-doc-count">@Owner._evidenceGraph.Evidence.Count</span>
                                                </button>
                                                @foreach (var doc in Owner._documents)
                                                {
                                                    <button type="button" class="di-doc @(Owner._diSelectedDocumentId == doc.LegalDocumentId ? "di-doc--active" : "")" @onclick="() => Owner._diSelectedDocumentId = doc.LegalDocumentId">
                                                        <div class="di-doc-main">
                                                            <i class="bi bi-file-earmark-text"></i>
                                                            <span class="di-doc-name" title="@doc.FileName">@doc.FileName</span>
                                                        </div>
                                                        <div class="di-doc-meta">
                                                            @if (!string.IsNullOrWhiteSpace(doc.DocumentTypeCode))
                                                            {
                                                                <span class="di-tag">@doc.DocumentTypeCode.Replace('_', ' ')</span>
                                                            }
                                                            <span class="di-doc-count">@Owner.DiEvidenceCountFor(doc.LegalDocumentId)</span>
                                                        </div>
                                                        @{
                                                            var latestVersion = doc.Versions.OrderByDescending(v => v.VersionNumber).FirstOrDefault();
                                                        }
                                                        @if (latestVersion is not null)
                                                        {
                                                            <div class="di-doc-provenance" title="@($"SHA-256 {latestVersion.Sha256Hash}\nStored at {latestVersion.StorageReference}")">
                                                                <span class="di-prov-badge @LegalPersonalInjuryDecision2.DiProcessingBadgeClass(latestVersion.ProcessingStatusCode)">
                                                                    <i class="bi bi-cpu"></i> @latestVersion.ProcessingStatusCode.Replace('_', ' ')
                                                                </span>
                                                                @if (!string.IsNullOrWhiteSpace(latestVersion.ExtractionModelCode))
                                                                {
                                                                    <span class="di-prov-model">
                                                                        @latestVersion.ExtractionModelCode@(string.IsNullOrWhiteSpace(latestVersion.ExtractionModelVersion) ? "" : $" · {latestVersion.ExtractionModelVersion}")
                                                                    </span>
                                                                }
                                                                <span class="di-prov-hash"><i class="bi bi-fingerprint"></i> @LegalPersonalInjuryDecision2.DiShortHash(latestVersion.Sha256Hash)</span>
                                                            </div>
                                                        }
                                                    </button>
                                                }
                                            </div>

                                            <div class="di-col">
                                                <h5 class="di-col-title"><i class="bi bi-chat-square-quote"></i> Extracted evidence <small>@(Owner._diSelectedDocumentId is null ? "(all)" : "(filtered)")</small></h5>
                                                @if (!Owner.DiVisibleEvidence.Any())
                                                {
                                                    <div class="di-empty di-empty--sm"><i class="bi bi-search"></i><p>No evidence for the selected document.</p></div>
                                                }
                                                else
                                                {
                                                    @foreach (var ev in Owner.DiVisibleEvidence)
                                                    {
                                                        <div class="di-evidence @(LegalPersonalInjuryDecision2.DiIsExcludedEvidence(ev.EvidenceStateCode) ? "di-evidence--excluded" : "")">
                                                           <div class="di-evidence-top">
                                                               <span class="di-dim">@ev.DimensionCode.Replace('_', ' ')</span>
                                                               <span class="di-pill @LegalPersonalInjuryDecision2.DiEvidenceStateToneClass(ev.EvidenceStateCode)" title="@(LegalPersonalInjuryDecision2.DiIsExcludedEvidence(ev.EvidenceStateCode) ? "Excluded: source passage lacks a traceable source span, so this assertion is not admissible as decision evidence." : "Evidence admission state")">@ev.EvidenceStateCode</span>
                                                               @if (ev.Confidence is { } c)
                                                               {
                                                                   <span class="di-conf" title="Extraction confidence">@c.ToString("P0")</span>
                                                               }
                                                           </div>
                                                           <p class="di-evidence-summary">@ev.Summary</p>
                                                           @if (LegalPersonalInjuryDecision2.DiIsExcludedEvidence(ev.EvidenceStateCode))
                                                           {
                                                                   <p class="di-evidence-exclusion"><i class="bi bi-exclamation-triangle"></i> Not admitted — no traceable source span to ground this assertion.</p>
                                                               }
                                                                @if (!string.IsNullOrWhiteSpace(ev.PassageText))
                                                                {
                                                                    <blockquote class="di-passage" title="@ev.PassageText">“@LegalPersonalInjuryDecision2.DiPassageSnippet(Owner.DiCleanedPassage(ev), Owner.DiEvidenceSnippetFocus(ev))”</blockquote>
                                                                }
                                                                <div class="di-cite">
                                                                    <i class="bi bi-file-earmark-text"></i>
                                                                    <span class="di-cite-doc" title="@ev.DocumentFileName">@ev.DocumentFileName</span>
                                                                    <span class="di-cite-loc">v@(ev.DocumentVersionNumber)@(ev.PageNumber is { } pg ? $" · p.{pg}" : "")@(string.IsNullOrWhiteSpace(ev.SectionPath) ? "" : $" · {ev.SectionPath}")</span>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>

                                            <div class="di-col">
                                                <h5 class="di-col-title"><i class="bi bi-diagram-3"></i> Supported facts</h5>
                                                @if (Owner._evidenceGraph.Propositions.Count == 0)
                                                {
                                                    <div class="di-empty di-empty--sm"><i class="bi bi-diagram-3"></i><p>No fact propositions derived yet.</p></div>
                                                }
                                                else
                                                {
                                                    @foreach (var prop in Owner._evidenceGraph.Propositions)
                                                    {
                                                        <div class="di-prop @(prop.IsDecisionAuthoritative ? "di-prop--authoritative" : "")">
                                                            <div class="di-prop-top">
                                                                <span class="di-pill di-pill--state">@prop.FactStateCode</span>
                                                                @if (prop.IsDecisionAuthoritative)
                                                                {
                                                                    <span class="di-pill di-pill--auth"><i class="bi bi-shield-check"></i> Authoritative</span>
                                                                }
                                                                @if (prop.Confidence is { } pc)
                                                                {
                                                                    <span class="di-conf">@pc.ToString("P0")</span>
                                                                }
                                                            </div>
                                                            <p class="di-prop-text">@prop.PropositionText</p>
                                                            @if (prop.Support.Count > 0)
                                                            {
                                                                <div class="di-support">
                                                                    @foreach (var sup in prop.Support)
                                                                    {
                                                                        <span class="di-pill @LegalPersonalInjuryDecision2.DiRelationToneClass(sup.RelationshipTypeCode)" title="@sup.AssessmentReason">@sup.RelationshipTypeCode</span>
                                                                    }
                                                                </div>
                                                            }
                                                                                </div>
                                                                            }
                                                                        }
                                                                    </div>
                                                                </div>
                                                                        break;

                                                                    case "Atomic Propositions":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-diagram-3"></i> Atomic propositions</h5>
                                                                            <p class="di-analysis-sub">Fact propositions derived from this matter's corpus, with structural state, decision authority and proof support. POLOXI remains the single authoritative evaluator; retrieval rank is never shown as evidence support.</p>
                                                                        </div>
                                                                        <span class="di-analysis-count">@Owner._evidenceGraph.Propositions.Count proposition(s) · @Owner._evidenceGraph.Propositions.Count(p => p.IsDecisionAuthoritative) authoritative</span>
                                                                    </div>
                                                                    @if (Owner._evidenceGraph.Propositions.Count == 0)
                                                                    {
                                                                        <div class="di-empty di-empty--sm"><i class="bi bi-diagram-3"></i><p>No atomic propositions derived yet for this matter. Upload and analyze documents in the matter corpus to populate the proposition graph.</p></div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead>
                                                                                    <tr><th>Proposition</th><th>State</th><th>Origin</th><th>Authority</th><th>Confidence</th><th>Support</th></tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var prop in Owner._evidenceGraph.Propositions)
                                                                                    {
                                                                                        <tr class="@(Owner._diSelectedPropositionId == prop.LegalFactPropositionId ? "di-row--active" : "")"
                                                                                            @onclick="() => Owner._diSelectedPropositionId = prop.LegalFactPropositionId" style="cursor:pointer;">
                                                                                            <td>@prop.PropositionText</td>
                                                                                            <td><span class="di-pill di-pill--state">@prop.FactStateCode</span></td>
                                                                                            <td><span class="di-tag">@prop.GenerationOriginCode.Replace('_', ' ')</span></td>
                                                                                            <td>
                                                                                                @if (prop.IsDecisionAuthoritative)
                                                                                                {
                                                                                                    <span class="di-pill di-pill--auth"><i class="bi bi-shield-check"></i> Authoritative</span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <span class="di-pill">Advisory</span>
                                                                                                }
                                                                                            </td>
                                                                                            <td>@(prop.Confidence is { } pc ? pc.ToString("P0") : "—")</td>
                                                                                            <td>@prop.Support.Count edge(s)</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                        break;

                                                                    case "Evidence Bindings":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-link-45deg"></i> Evidence bindings</h5>
                                                                            <p class="di-analysis-sub">Each binding links an extracted evidence item to the proposition it supports, contradicts, qualifies or contextualizes. Supporting, contradicting and insufficient evidence are shown simultaneously — contradiction is never hidden behind a count.</p>
                                                                        </div>
                                                                        <span class="di-analysis-count">@Owner.DiBindingEdges.Count binding(s)</span>
                                                                    </div>
                                                                    @if (Owner.DiBindingEdges.Count == 0)
                                                                    {
                                                                        <div class="di-empty di-empty--sm"><i class="bi bi-link-45deg"></i><p>No proposition–evidence bindings yet. Bindings appear here once extracted assertions are aligned to fact propositions.</p></div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead>
                                                                                   <tr><th>Evidence (wired from)</th><th>Relation</th><th>Proposition (wired to)</th><th>Anchored quote</th><th>Source</th></tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var edge in Owner.DiBindingEdges)
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@(string.IsNullOrWhiteSpace(edge.EvidenceSummary) ? "—" : edge.EvidenceSummary)</td>
                                                                                            <td><span class="di-pill @LegalPersonalInjuryDecision2.DiRelationToneClass(edge.RelationshipTypeCode)">@edge.RelationshipTypeCode.Replace('_', ' ')</span></td>
                                                                                            <td>@edge.PropositionText</td>
                                                                                            <td>
                                                                                                @if (string.IsNullOrWhiteSpace(edge.AnchorQuote))
                                                                                                {
                                                                                                    <span class="di-cite-loc">—</span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <span class="di-anchor-quote">“@edge.AnchorQuote”</span>
                                                                                                    <span class="di-pill @LegalPersonalInjuryDecision2.DiAnchorToneClass(edge.AnchorVerificationStateCode)">@((edge.AnchorVerificationStateCode ?? "UNVERIFIED").Replace('_', ' '))</span>
                                                                                                }
                                                                                            </td>
                                                                                            <td class="di-cite-loc">@(string.IsNullOrWhiteSpace(edge.SourceReference) ? "—" : edge.SourceReference)</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                        <p class="dfi-prototype-note">Retrieval rank ≠ evidence relation ≠ POLOXI decision effect. Embedding finds, alignment verifies, POLOXI decides.</p>
                                                                    }
                                                                </div>
                                                                        break;

                                                                    case "Passage Analysis":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-chat-square-quote"></i> Passage analysis @(Owner._diSelectedDocumentId is null ? "(all documents)" : "(selected document)")</h5>
                                                                            <p class="di-analysis-sub">Exact quotes with immutable source coordinates (document version, page, section). Select a document in the Document Review tab to scope this view.</p>
                                                                        </div>
                                                                        <span class="di-analysis-count">@Owner.DiVisibleEvidence.Count() passage(s)</span>
                                                                    </div>
                                                                    @if (!Owner.DiVisibleEvidence.Any())
                                                                    {
                                                                        <div class="di-empty di-empty--sm"><i class="bi bi-search"></i><p>No analyzed passages for the current selection.</p></div>
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var ev in Owner.DiVisibleEvidence)
                                                                        {
                                                                            <div class="di-evidence @(LegalPersonalInjuryDecision2.DiIsExcludedEvidence(ev.EvidenceStateCode) ? "di-evidence--excluded" : "")">
                                                                                <div class="di-evidence-top">
                                                                                    <span class="di-dim">@ev.DimensionCode.Replace('_', ' ')</span>
                                                                                    <span class="di-pill @LegalPersonalInjuryDecision2.DiEvidenceStateToneClass(ev.EvidenceStateCode)">@ev.EvidenceStateCode</span>
                                                                                    @if (ev.Confidence is { } c)
                                                                                    {
                                                                                        <span class="di-conf" title="Extraction confidence">@c.ToString("P0")</span>
                                                                                    }
                                                                                </div>
                                                                                <p class="di-evidence-summary">@ev.Summary</p>
                                                                                @if (!string.IsNullOrWhiteSpace(ev.PassageText))
                                                                                {
                                                                                    <blockquote class="di-passage">“@ev.PassageText”</blockquote>
                                                                                }
                                                                                <div class="di-cite">
                                                                                    <i class="bi bi-file-earmark-text"></i>
                                                                                    <span class="di-cite-doc" title="@ev.DocumentFileName">@ev.DocumentFileName</span>
                                                                                    <span class="di-cite-loc">v@(ev.DocumentVersionNumber)@(ev.PageNumber is { } pg ? $" · p.{pg}" : "")@(string.IsNullOrWhiteSpace(ev.SectionPath) ? "" : $" · {ev.SectionPath}")</span>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                                        break;

                                                                    case "Impact on Decisions":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-signpost-split"></i> Impact on decisions</h5>
                                                                            <p class="di-analysis-sub">How admitted evidence bears on the authoritative decision. This is the current authoritative snapshot — not a preview. Detailed before/after deltas are available on the Decision Change Intelligence (DCI) tab.</p>
                                                                        </div>
                                                                        <span class="di-analysis-badge"><i class="bi bi-shield-lock"></i> Authoritative snapshot</span>
                                                                    </div>
                                                                     <div class="di-kpis">
                                                                        <div class="di-kpi"><span class="di-kpi-val">@Owner._evidenceGraph.Propositions.Count(p => p.IsDecisionAuthoritative)</span><span class="di-kpi-lbl">Decision-authoritative facts</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@Owner.DiContradictionCount</span><span class="di-kpi-lbl">Contradiction edges</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@Owner.DiSupportCount</span><span class="di-kpi-lbl">Supporting edges</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@Owner.DiInsufficientCount</span><span class="di-kpi-lbl">Insufficient edges</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@Owner._evidenceGraph.Propositions.Count(p => p.Support.Count == 0)</span><span class="di-kpi-lbl">Facts without support</span></div>
                                                                    </div>
                                                                    @if (Owner._evidenceGraph.Propositions.Count(p => p.IsDecisionAuthoritative) == 0)
                                                                    {
                                                                        @if (Owner.DiInsufficientCount > 0)
                                                                        {
                                                                            <div class="di-empty di-empty--sm"><i class="bi bi-signpost"></i><p>@Owner.DiInsufficientCount binding(s) are wired but currently <strong>insufficient</strong> — the evidence is not yet span-anchored/admitted, so no fact is decision-authoritative. Re-run activation after upload so admitted evidence can support or contradict a proposition.</p></div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="di-empty di-empty--sm"><i class="bi bi-signpost"></i><p>No decision-authoritative facts yet. Once evidence is admitted and POLOXI re-evaluates, decision impact appears here.</p></div>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead>
                                                                                    <tr><th>Authoritative fact</th><th>State</th><th>Supporting</th><th>Contradicting</th></tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var prop in Owner._evidenceGraph.Propositions.Where(p => p.IsDecisionAuthoritative))
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@prop.PropositionText</td>
                                                                                            <td><span class="di-pill di-pill--state">@prop.FactStateCode</span></td>
                                                                                            <td>@prop.Support.Count(s => LegalPersonalInjuryDecision2.DiIsSupportRelation(s.RelationshipTypeCode))</td>
                                                                                            <td>@prop.Support.Count(s => LegalPersonalInjuryDecision2.DiIsContradictRelation(s.RelationshipTypeCode))</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                        break;
                                                                    case "Evidence Provenance":
                                                                <div class="di-analysis">
                                                                    <div class="di-analysis-head">
                                                                        <div>
                                                                            <h5 class="di-col-title"><i class="bi bi-fingerprint"></i> Evidence provenance &amp; upload dashboard</h5>
                                                                            <p class="di-analysis-sub">Physical content is deduplicated by SHA-256, but every legal provenance occurrence (custodian, production, Bates range) is preserved. The same bytes arriving from two productions remain two admissible occurrences. Batch reports are immutable.</p>
                                                                        </div>
                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="Owner.LoadProvenanceAsync" disabled="@Owner._provenanceLoading" title="Reload evidence provenance">
                                                                            <i class="bi @(Owner._provenanceLoading ? "bi-arrow-repeat di-spin" : "bi-arrow-clockwise")"></i>
                                                                        </button>
                                                                    </div>
                                                                    @if (Owner._provenanceError is not null)
                                                                    {
                                                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@Owner._provenanceError</div>
                                                                    }
                                                                    <div class="di-kpis">
                                                                        <div class="di-kpi"><span class="di-kpi-val">@Owner._uploadBatches.Count</span><span class="di-kpi-lbl">Upload batches</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@Owner._evidenceOccurrences.Count</span><span class="di-kpi-lbl">Evidence occurrences</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@Owner._evidenceOccurrences.Count(o => o.ContentReused)</span><span class="di-kpi-lbl">Content reused (deduped)</span></div>
                                                                        <div class="di-kpi"><span class="di-kpi-val">@Owner._evidenceOccurrences.Select(o => o.Sha256Hash).Distinct().Count()</span><span class="di-kpi-lbl">Distinct physical objects</span></div>
                                                                    </div>
                                                                    @if (Owner._uploadBatches.Count > 0)
                                                                    {
                                                                        <h6 class="di-col-title" style="margin-top:.75rem;"><i class="bi bi-stack"></i> Upload batches</h6>
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead><tr><th>Batch</th><th>Source</th><th>Discovered</th><th>Accepted</th><th>Duplicates</th><th>Occurrences</th><th>Reused</th></tr></thead>
                                                                                <tbody>
                                                                                    @foreach (var batch in Owner._uploadBatches)
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@batch.BatchNumber</td>
                                                                                            <td><span class="di-pill di-pill--state">@(batch.SourceTypeCode ?? "USER_UPLOAD")</span></td>
                                                                                            <td>@batch.FilesDiscovered</td>
                                                                                            <td>@batch.FilesAccepted</td>
                                                                                            <td>@batch.ExactContentDuplicates</td>
                                                                                            <td>@batch.NewEvidenceOccurrences</td>
                                                                                            <td>@batch.ProcessingReused</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    }
                                                                    @if (Owner._evidenceOccurrences.Count > 0)
                                                                    {
                                                                        <h6 class="di-col-title" style="margin-top:.75rem;"><i class="bi bi-fingerprint"></i> Evidence occurrences</h6>
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead><tr><th>File</th><th>Source</th><th>Custodian</th><th>Production</th><th>Bates</th><th>Confidentiality</th><th>Privilege</th><th>Family</th><th>SHA-256</th><th>Content</th></tr></thead>
                                                                                <tbody>
                                                                                    @foreach (var occ in Owner._evidenceOccurrences)
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@occ.FileName</td>
                                                                                            <td><span class="di-pill di-pill--state">@occ.SourceTypeCode</span></td>
                                                                                            <td>@(occ.Custodian ?? "—")</td>
                                                                                            <td>@(occ.ProductionId ?? "—")</td>
                                                                                            <td>@(string.IsNullOrWhiteSpace(occ.BatesStart) ? "—" : $"{occ.BatesStart}–{occ.BatesEnd}")</td>
                                                                                            <td>@(occ.ConfidentialityCode ?? "—")</td>
                                                                                            <td>@(occ.PrivilegeCode ?? "—")</td>
                                                                                            <td>@(occ.LegalDocumentFamilyId is null ? "—" : $"D{occ.FamilyDepth}·#{occ.FamilyOrdinal}")</td>
                                                                                            <td><code style="font-size:.72rem;">@(occ.Sha256Hash.Length > 12 ? occ.Sha256Hash[..12] : occ.Sha256Hash)…</code></td>
                                                                                            <td>@(occ.ContentReused ? "Reused" : "New")</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="di-empty di-empty--sm"><i class="bi bi-fingerprint"></i><p>No evidence occurrences yet. Set the evidence context above, then upload documents — each upload records a provenance occurrence even when identical bytes already exist.</p></div>
                                                                    }
                                                                    @if (Owner._evidenceLineage.Count > 0)
                                                                    {
                                                                        <h6 class="di-col-title" style="margin-top:.75rem;"><i class="bi bi-diagram-3"></i> Evidence lineage <span class="di-pill di-pill--muted" title="Independent-source identity: DERIVATIVE members quote/restate the ORIGINAL and add no independent evidentiary weight.">advisory</span></h6>
                                                                        <div class="dfi-table-wrap">
                                                                            <table class="dfi-table">
                                                                                <thead><tr><th>Lineage</th><th>Independence basis</th><th>Origin</th><th>Members (role)</th></tr></thead>
                                                                                <tbody>
                                                                                    @foreach (var grp in Owner._evidenceLineage)
                                                                                    {
                                                                                        <tr>
                                                                                            <td>@(grp.LineageLabel ?? "—")</td>
                                                                                            <td><span class="di-pill di-pill--state">@grp.IndependenceBasisCode</span></td>
                                                                                            <td>@(grp.OriginDescription ?? "—")</td>
                                                                                            <td>@(grp.Members.Count == 0 ? "—" : string.Join(", ", grp.Members.Select(m => $"{m.FileName ?? "occurrence"} ({m.RoleCode})")))</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                                            </table>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                                        break;
                                                                                    case "Document Cleanup":
                                                                                <div class="di-analysis">
                                                                                    <div class="di-analysis-head">
                                                                                        <div>
                                                                                            <h5 class="di-col-title"><i class="bi bi-trash3"></i> Document cleanup &amp; recompute</h5>
                                                                                            <p class="di-analysis-sub">Permanently remove supporting documents and every derived passage, evidence item, proposition support, source anchor and provenance occurrence for this matter. Removing documents automatically recomputes all associated scoring, evidence/proposition states, decision authority and statuses. This cannot be undone.</p>
                                                                                        </div>
                                                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="Owner.LoadEvidenceGraphAsync" disabled="@Owner._cleanupBusy" title="Reload documents">
                                                                                            <i class="bi bi-arrow-clockwise"></i>
                                                                                        </button>
                                                                                    </div>
                                                                                    @if (Owner._cleanupError is not null)
                                                                                    {
                                                                                        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@Owner._cleanupError</div>
                                                                                    }
                                                                                    @if (Owner._cleanupResult is not null)
                                                                                    {
                                                                                        <div class="alert alert-success d-flex align-items-start gap-2">
                                                                                            <i class="bi bi-check-circle-fill"></i>
                                                                                            <div>
                                                                                                <strong>Cleanup complete — scoring recomputed.</strong>
                                                                                                <div>
                                                                                                    Removed @Owner._cleanupResult.Purge.DocumentsRemoved document(s), @Owner._cleanupResult.Purge.DocumentVersionsRemoved version(s), @Owner._cleanupResult.Purge.PassagesRemoved passage(s),
                                                                                                    @Owner._cleanupResult.Purge.EvidenceItemsRemoved evidence item(s), @Owner._cleanupResult.Purge.PropositionsRemoved proposition(s),
                                                                                                    @Owner._cleanupResult.Purge.PropositionSupportsRemoved support edge(s), @Owner._cleanupResult.Purge.SourceAssertionsRemoved source anchor(s),
                                                                                                    @Owner._cleanupResult.Purge.EvidenceOccurrencesRemoved occurrence(s)@(Owner._cleanupResult.Purge.UploadBatchesRemoved > 0 ? $", {Owner._cleanupResult.Purge.UploadBatchesRemoved} upload batch(es)" : string.Empty).
                                                                                                </div>
                                                                                            </div>
                                                                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => Owner._cleanupResult = null" title="Dismiss"><i class="bi bi-x-lg"></i></button>
                                                                                        </div>
                                                                                    }
                                                                                    @if (Owner._documents.Count == 0)
                                                                                    {
                                                                                        <div class="di-empty"><i class="bi bi-inbox"></i> No supporting documents for this matter.</div>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <div class="di-cleanup-actions" style="display:flex;gap:.5rem;align-items:center;margin:.5rem 0;flex-wrap:wrap;">
                                                                                            <button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick="Owner.ConfirmRemoveSelectedDocuments"
                                                                                                    disabled="@(Owner._cleanupBusy || Owner._selectedCleanupDocumentIds.Count == 0)">
                                                                                                <i class="bi bi-trash"></i> Remove selected (@Owner._selectedCleanupDocumentIds.Count)
                                                                                            </button>
                                                                                            <button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick="Owner.ConfirmRemoveAllDocuments" disabled="@Owner._cleanupBusy">
                                                                                                <i class="bi bi-trash3-fill"></i> Remove all documents
                                                                                            </button>
                                                                                            @if (Owner._cleanupBusy)
                                                                                            {
                                                                                                <span class="di-pill di-pill--muted"><i class="bi bi-arrow-repeat di-spin"></i> Recomputing…</span>
                                                                                            }
                                                                                        </div>
                                                                                        <div class="dfi-table-wrap">
                                                                                            <table class="dfi-table">
                                                                                                <thead><tr>
                                                                                                    <th style="width:2.5rem;">
                                                                                                        <input type="checkbox" title="Select all"
                                                                                                               checked="@(Owner._selectedCleanupDocumentIds.Count == Owner._documents.Count && Owner._documents.Count > 0)"
                                                                                                               @onchange="Owner.ToggleSelectAllCleanupDocuments" />
                                                                                                    </th>
                                                                                                    <th>Document</th><th>Type</th><th>Status</th><th>Versions</th><th style="width:6rem;"></th>
                                                                                                </tr></thead>
                                                                                                <tbody>
                                                                                                    @foreach (var doc in Owner._documents)
                                                                                                    {
                                                                                                        <tr>
                                                                                                            <td>
                                                                                                                <input type="checkbox"
                                                                                                                       checked="@Owner._selectedCleanupDocumentIds.Contains(doc.LegalDocumentId)"
                                                                                                                       @onchange="e => Owner.ToggleCleanupDocument(doc.LegalDocumentId, e)" />
                                                                                                            </td>
                                                                                                            <td>@doc.FileName</td>
                                                                                                            <td>@(doc.DocumentTypeCode ?? "—")</td>
                                                                                                            <td><span class="di-pill di-pill--state">@doc.StatusCode</span></td>
                                                                                                            <td>@doc.Versions.Count</td>
                                                                                                            <td>
                                                                                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Remove this document"
                                                                                                                        @onclick="() => Owner.ConfirmRemoveSingleDocument(doc)" disabled="@Owner._cleanupBusy">
                                                                                                                    <i class="bi bi-trash text-danger"></i>
                                                                                                                </button>
                                                                                                            </td>
                                                                                                        </tr>
                                                                                                    }
                                                                                                </tbody>
                                                                                            </table>
                                                                                        </div>
                                                                                                                                                                         }
                                                                                                                                                                     </div>
                                                                                                                                                                             break;
                                                                                                                                                                     }
                                                                                                                                                                 }
                                                                                                                                                                                         </div>

                                                                                    @code {
                                                                                        [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;
                                                                                    }

