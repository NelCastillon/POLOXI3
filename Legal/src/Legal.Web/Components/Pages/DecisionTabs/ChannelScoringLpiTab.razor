@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages

@{
    var model = Owner._channelScoring;
}
<div class="dci-root">
    <div class="dci-topbar">
        <div class="dci-topbar-title">
            <span class="dci-topbar-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
            <div>
                <div class="dci-topbar-heading">
                    <h4>Channel Scoring (LPI) &mdash; How Channels Affected the Outcome</h4>
                    <span class="dci-badge dci-badge--live"><span class="dci-live-dot" aria-hidden="true"></span> POLOXI</span>
                </div>
                <p class="dfi-panel-sub">Every verified channel contribution is converted into a bounded, signed <strong>&delta;</strong> and folded into the latest decision session's POLOXI candidate competition. Channels never score candidates themselves &mdash; POLOXI owns the composite score, margin and winner. This is a read-only trace of the exact math that was applied.</p>
            </div>
        </div>
    </div>

    @if (Owner._channelScoringLoading)
    {
        <div class="dfi-panel-card"><p class="dfi-panel-sub">Loading channel scoring trace&hellip;</p></div>
    }
    else if (Owner._channelScoringError is not null)
    {
        <div class="dfi-panel-card"><div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@Owner._channelScoringError</div></div>
    }
    else if (model is null || model.TotalContributions == 0)
    {
        var trace = Owner._scoringTrace;
        if (trace is null || !trace.HasTrace)
        {
            <div class="dfi-panel-card">
                <p class="dfi-panel-sub">No channel contributions have been folded into this matter's latest decision session yet. When a channel (Document Evidence, Legal Authority, Human Intelligence, &hellip;) produces a verified contribution with authoritative lineage, its scoring trace appears here.</p>
            </div>
        }
        else
        {
            <div class="dfi-panel-card" style="margin-bottom:14px;">
                <p class="dfi-panel-sub" style="margin-bottom:10px;">No per-channel &delta; has been folded into a decision session yet, so the trace below reflects POLOXI's latest full scoring run for this matter &mdash; the hierarchy levels, named branches/candidates and the exact persisted values that produced the outcome.</p>
                <div style="display:flex; gap:18px; flex-wrap:wrap;">
                    <div><span class="dfi-panel-sub">Scored candidates</span><div style="font-size:1.25rem; font-weight:600;">@trace.CandidateCount</div></div>
                    <div><span class="dfi-panel-sub">Levels reached</span><div style="font-size:1.25rem; font-weight:600;">@trace.Levels.Count (depth @trace.DepthReached)</div></div>
                    <div><span class="dfi-panel-sub">Evidence coverage</span><div style="font-size:1.25rem; font-weight:600;">@trace.EvidenceCoverage.ToString("P0")</div></div>
                    <div><span class="dfi-panel-sub">Final confidence</span><div style="font-size:1.25rem; font-weight:600; color:#198754;">@trace.FinalConfidence.ToString("0.###")</div></div>
                </div>
            </div>

            <div class="dfi-panel-card" style="margin-bottom:14px;">
                <h5 style="margin-bottom:8px;"><i class="bi bi-calculator" aria-hidden="true"></i> Scoring formula &amp; values</h5>
                <ul style="margin:0 0 10px 0; padding-left:18px;">
                    <li><code>@trace.Formula.BranchConfidenceFormula</code></li>
                    <li><code>@trace.Formula.CandidateBranchFormula</code></li>
                    <li><code>@trace.Formula.CompositeFormula</code></li>
                </ul>
                <ul style="margin:0; padding-left:18px;" class="dfi-panel-sub">
                    @foreach (var note in trace.Formula.Notes)
                    {
                        <li>@note</li>
                    }
                </ul>
            </div>

            @foreach (var level in trace.Levels)
            {
                <div class="dfi-panel-card" style="margin-bottom:14px;">
                    <h5 style="margin-bottom:8px;"><i class="bi bi-diagram-3" aria-hidden="true"></i> L@(level.LevelNumber) &mdash; @level.Branches.Count branch(es)</h5>
                    <table class="table table-sm" style="margin:0;">
                        <thead>
                            <tr>
                                <th>Branch (name)</th>
                                <th>Role</th>
                                <th style="text-align:right;">Evidence support</th>
                                <th style="text-align:right;">POLOXI confidence</th>
                                <th style="text-align:right;">Confidence</th>
                                <th style="text-align:right;">Evidence</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in level.Branches)
                            {
                                <tr style="@(b.IsEliminated ? "opacity:0.55;" : "")">
                                    <td>@b.DisplayName</td>
                                    <td>@b.BranchRoleCode</td>
                                    <td style="text-align:right;">@b.EvidenceSupport.ToString("0.###")</td>
                                    <td style="text-align:right; font-weight:600;">@b.PoloxiConfidence.ToString("0.###")</td>
                                    <td style="text-align:right;">@b.Confidence.ToString("0.###")</td>
                                    <td style="text-align:right;">@b.EvidenceCount</td>
                                    <td>@(b.IsEliminated ? $"Eliminated{(string.IsNullOrWhiteSpace(b.EliminationReason) ? "" : $": {b.EliminationReason}")}" : b.GroundingStatusCode)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (trace.Candidates.Count > 0)
            {
                <div class="dfi-panel-card">
                    <h5 style="margin-bottom:8px;"><i class="bi bi-trophy" aria-hidden="true"></i> Competed candidates (names &amp; composite values)</h5>
                    <table class="table table-sm" style="margin:0;">
                        <thead>
                            <tr>
                                <th style="text-align:right;">Rank</th>
                                <th>Candidate (name)</th>
                                <th style="text-align:right;">Composite</th>
                                <th>Competes on (branch = evidence score)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cand in trace.Candidates.Take(12))
                            {
                                <tr>
                                    <td style="text-align:right;">@cand.RankNumber</td>
                                    <td>@cand.DisplayName @if (cand.IsConstraintViolation) {<span class="dci-badge" style="color:#dc3545;">constraint</span>}</td>
                                    <td style="text-align:right; font-weight:600;">@cand.CompositeScore.ToString("0.###")</td>
                                    <td class="dfi-panel-sub">@string.Join(" � ", cand.BranchScores.Take(4).Select(s => $"{s.BranchDisplayName} = {s.EvidenceScore:0.###}"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="dfi-panel-sub" style="margin-top:6px;">POLOXI Core alone owns the composite score, margin and winner. Values above are read directly from the persisted Wide execution @(trace.WideExecutionId.ToString()[..8]).</p>
                </div>
            }
        }
    }
    else
    {
        <div class="dfi-panel-card" style="margin-bottom:14px;">
            <div style="display:flex; gap:18px; flex-wrap:wrap;">
                <div><span class="dfi-panel-sub">Contributions</span><div style="font-size:1.25rem; font-weight:600;">@model.TotalContributions</div></div>
                <div><span class="dfi-panel-sub">Applied to scoring</span><div style="font-size:1.25rem; font-weight:600; color:#198754;">@model.EffectiveContributions</div></div>
                <div><span class="dfi-panel-sub">No effect</span><div style="font-size:1.25rem; font-weight:600; color:#6c757d;">@model.NoEffectContributions</div></div>
            </div>
        </div>

        <div class="dfi-panel-card" style="margin-bottom:14px;">
            <h5 style="margin-bottom:8px;"><i class="bi bi-calculator" aria-hidden="true"></i> Scoring formula &amp; values</h5>
            <ul style="margin:0 0 10px 0; padding-left:18px;">
                <li><code>@model.Formula.SupportFormula</code></li>
                <li><code>@model.Formula.QualifiedSupportFormula</code></li>
                <li><code>@model.Formula.ContradictionFormula</code></li>
                <li><code>@model.Formula.PlacementFormula</code></li>
            </ul>
            <p class="dfi-panel-sub" style="margin-bottom:4px;"><strong>Gating rules</strong> (why a contribution does or does not move scoring):</p>
            <ul style="margin:0; padding-left:18px;" class="dfi-panel-sub">
                @foreach (var rule in model.Formula.GatingRules)
                {
                    <li>@rule</li>
                }
            </ul>
        </div>

        @if (model.DimensionAggregates.Count > 0)
        {
            <div class="dfi-panel-card" style="margin-bottom:14px;">
                <h5 style="margin-bottom:8px;"><i class="bi bi-sliders" aria-hidden="true"></i> Net push per POLOXI dimension</h5>
                <table class="table table-sm" style="margin:0;">
                    <thead>
                        <tr><th>Dimension</th><th style="text-align:right;">Contributions</th><th style="text-align:right;">+ d</th><th style="text-align:right;">- d</th><th style="text-align:right;">Net d</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var agg in model.DimensionAggregates)
                        {
                            <tr>
                                <td><strong>@agg.Dimension</strong></td>
                                <td style="text-align:right;">@agg.ContributionCount</td>
                                <td style="text-align:right; color:#198754;">@agg.PositiveDelta.ToString("+0.###;-0.###;0")</td>
                                <td style="text-align:right; color:#dc3545;">@agg.NegativeDelta.ToString("+0.###;-0.###;0")</td>
                                <td style="text-align:right; font-weight:600; color:@(agg.NetDelta >= 0 ? "#198754" : "#dc3545")">@agg.NetDelta.ToString("+0.###;-0.###;0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="dfi-panel-sub" style="margin-top:6px;">These signed inputs land on the named POLOXI dimension; POLOXI Core alone decides their effect on the final candidate composite score and ranking.</p>
            </div>
        }

        <div class="dfi-panel-card">
            <h5 style="margin-bottom:8px;"><i class="bi bi-list-columns-reverse" aria-hidden="true"></i> Contribution trace</h5>
            <table class="table table-sm" style="margin:0;">
                <thead>
                    <tr>
                        <th>Channel</th>
                        <th>Relation</th>
                        <th>Verification</th>
                        <th>Dimension</th>
                        <th>Formula applied</th>
                        <th style="text-align:right;">d</th>
                        <th>Effect on scoring</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in model.Contributions)
                    {
                        var applied = row.AppliedDelta != 0.0;
                        <tr style="@(applied ? "" : "opacity:0.7;")">
                            <td><strong>@row.ChannelType</strong>@if (row.SourceLabel is not null){<div class="dfi-panel-sub" style="font-size:0.78rem;">@row.SourceLabel</div>}</td>
                            <td>@row.Relation</td>
                            <td>
                                <span class="badge @(row.VerificationState == "Verified" ? "bg-success" : "bg-secondary")">@row.VerificationState</span>
                            </td>
                            <td>@(row.TargetDimension ?? "�")</td>
                            <td><code style="font-size:0.78rem;">@row.FormulaApplied</code></td>
                            <td style="text-align:right; font-weight:600; color:@(row.AppliedDelta > 0 ? "#198754" : row.AppliedDelta < 0 ? "#dc3545" : "#6c757d")">@row.AppliedDelta.ToString("+0.###;-0.###;0")</td>
                            <td>
                                <span class="badge @(applied ? "bg-primary" : "bg-light text-dark")">@row.Effect</span>
                                <div class="dfi-panel-sub" style="font-size:0.8rem; margin-top:2px;">@row.EffectExplanation</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;
}
