@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages

                                @if (Owner.OvOutcomes.Count > 0)
                                {
                                    <div class="ov-landscape">
                                        @{ var ovLeader = Owner.OvOutcomes[0]; }

                                        @* -- Decision KPI strip ----------------------------------------- *@
                                        @* -- Decision Status trust strip -------------------------------------------- *@
                                        <div class="ov-status">
                                            <div class="ov-status-lead">
                                                <span class="ov-status-state ov-status-state--@Owner.OvDecisionStateTone">@Owner.OvDecisionStateLabel.ToUpperInvariant()</span>
                                                @if (Owner.OvCompetitionValid)
                                                {
                                                    <span class="ov-status-headline">C@(ovLeader.Index) @ovLeader.Title leads at @ovLeader.SupportPct% support</span>
                                                }
                                                else
                                                {
                                                    <span class="ov-status-headline">@Owner.OvOutcomes.Count proposed outcome(s) &mdash; competition not executed, no leader established</span>
                                                }
                                            </div>
                                            <div class="ov-status-chips">
                                                @foreach (var chip in Owner.OvDecisionStatusChips)
                                                {
                                                    <div class="ov-status-chip ov-status-chip--@chip.Tone" title="@chip.Tooltip">
                                                        <span class="ov-status-chip-val">@chip.Value</span>
                                                        <span class="ov-status-chip-lbl">@chip.Label</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="ov-outcomes-head">
                                            <div>
                                                <h4 class="ov-section-title">Decision Outcomes</h4>
                                                <p class="ov-section-sub">The most supportable outcomes for the current matter, generated and compared in a single analysis.</p>
                                            </div>
                                            <div class="ov-viewtoggle" role="tablist" aria-label="Comparison view">
                                                @foreach (var view in LegalPersonalInjuryDecision2.OvComparisonViews)
                                                {
                                                    var icon = view switch { "Cards" => "bi-grid-3x3-gap", "Table" => "bi-table", _ => "bi-graph-up" };
                                                    <button type="button" role="tab"
                                                            class="ov-viewtoggle-btn @(Owner._ovComparisonView == view ? "ov-viewtoggle-btn--active" : "")"
                                                            @onclick="() => Owner.SetOverviewView(view)">
                                                        <i class="bi @icon" aria-hidden="true"></i> @view
                                                    </button>
                                                }
                                                </div>
                                            </div>

                                            @if (Owner._ovComparisonView == "Cards")
                                            {
                                                <div class="ov-cards">
                                                    @foreach (var o in Owner.OvFilteredOutcomes)
                                                    {
                                                    var showLeader = o.IsLeader && Owner.OvCompetitionValid;
                                                    var cardAssessment = Owner.OvCandidateAssessments.FirstOrDefault(x => x.Index == o.Index);
                                                    <div class="ov-card ov-card--@(showLeader ? "leader" : "compete") ov-card--c@(o.Index)">
                                                        <div class="ov-card-top">
                                                            <span class="ov-card-code">C@(o.Index)</span>
                                                            <span class="ov-card-flag ov-card-flag--@(showLeader ? "leader" : "compete")">
                                                                @if (showLeader)
                                                                {
                                                                    <i class="bi bi-trophy" aria-hidden="true"></i>
                                                                }
                                                                @(showLeader ? "Current Leader" : (Owner.OvCompetitionValid ? "Competing Outcome" : "Proposed Outcome"))
                                                            </span>
                                                            @if (Owner.OvCompetitionValid)
                                                            {
                                                                <span class="ov-card-support">@o.SupportPct% support</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="ov-card-support ov-card-support--advisory" title="Dependency-establishment support — no Candidate × Branch competition ran for this matter.">@o.SupportPct% support</span>
                                                            }
                                                        </div>
                                                        <div class="ov-card-track"><div class="ov-card-fill" style="width:@(o.SupportPct)%"></div></div>
                                                        <p class="ov-card-scoreformula" title="How this outcome's score and rank were computed.">@o.ScoreFormulaFor(Owner.OvCompetitionValid)</p>
                                                        @if (Owner.OvCompetitionValid && o.EvidenceCoverage <= 0m)
                                                        {
                                                            <p class="ov-card-unverified" title="POLOXI competed this outcome across the matter's reasoning dimensions, but no retrieved evidence supports it yet.">
                                                                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> 0% evidence coverage &middot; UNVERIFIED &mdash; scored on reasoning dimensions only, not an evidence-grounded determination.
                                                            </p>
                                                        }
                                                        <h5 class="ov-card-title">@o.Title</h5>
                                                        @{
                                                            var lifecycleClass = $"ov-card-lifecycle ov-card-lifecycle--{o.Lifecycle.Tone}" + (o.Lifecycle.IsHistorical ? " ov-card-lifecycle--historical" : string.Empty);
                                                            var lifecycleTitle = o.Lifecycle.IsHistorical
                                                                ? "A recorded/historical status that must be independently verified before it can be treated as an established resolution. Shown separately from prospective competing outcomes."
                                                                : "A prospective resolution the matter could reach; its assessment is pending.";
                                                        }
                                                        <div class="@lifecycleClass" title="@lifecycleTitle">
                                                            <i class="bi @(o.Lifecycle.IsHistorical ? "bi-clock-history" : "bi-signpost-2")" aria-hidden="true"></i>
                                                            <span>@o.Lifecycle.Label</span>
                                                        </div>
                                                        @if (Owner._useDomainPack)
                                                        {
                                                            <div class="ov-card-packmap" title="Advisory Domain Pack mapping — the canonical pack outcome this LLM outcome maps to. Presentation only; it does not score, rank, or select.">
                                                                <span class="ov-card-packmap-lbl"><i class="bi bi-diagram-3" aria-hidden="true"></i> Domain Pack outcome</span>
                                                                @if (o.MappedOutcomes.Count > 0)
                                                                {
                                                                    <span class="ov-card-packmap-vals">
                                                                        @foreach (var m in o.MappedOutcomes)
                                                                        {
                                                                            <span class="ov-card-packmap-val">@m.Code &middot; @m.Name</span>
                                                                        }
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="ov-card-packmap-none">No canonical Domain Pack outcome</span>
                                                                }
                                                            </div>
                                                        }
                                                        <p class="ov-card-detail">@o.CardText</p>
                                                        @if (o.FullNarrative.Count > 0)
                                                        {
                                                            <div class="ov-card-fullnarrative">
                                                                @foreach (var section in o.FullNarrative)
                                                                {
                                                                    <div class="ov-card-fullnarrative-section">
                                                                        <span class="ov-card-fullnarrative-label">@section.Label</span>
                                                                        <p class="ov-card-fullnarrative-text">@section.Text</p>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        <div class="ov-card-tags">
                                                            @foreach (var tag in o.Tags)
                                                            {
                                                                <span class="ov-tag ov-tag--@tag.Tone">@tag.Label</span>
                                                            }
                                                        </div>
                                                         <ul class="ov-card-metrics">
                                                            <li class="ov-metric-click @(Owner._ovKpiFilter == "support" ? "ov-metric-click--active" : "")" @onclick='() => Owner.SetOvKpiFilter("support")' title="Filter outcomes that earned relative support"><span class="ov-metric-ic"><i class="bi bi-graph-up-arrow"></i></span><span class="ov-metric-lbl">Relative support</span><span class="ov-metric-val">@(Owner.OvCompetitionValid ? $"{o.SupportPct}%" : "—")</span></li>
                                                            <li class="ov-metric-click @(Owner._ovKpiFilter == "coverage" ? "ov-metric-click--active" : "")" @onclick='() => Owner.SetOvKpiFilter("coverage")' title="Filter outcomes with evidence coverage"><span class="ov-metric-ic"><i class="bi bi-shield-check"></i></span><span class="ov-metric-lbl">Evidence coverage</span><span class="ov-metric-val">@(Owner.OvCompetitionValid ? $"{o.EvidenceCoveragePct}%" : "—")</span></li>
                                                            <li class="ov-metric-click @(Owner._ovKpiFilter == "interpretive" ? "ov-metric-click--active" : "")" @onclick='() => Owner.SetOvKpiFilter("interpretive")' title="Filter outcomes named by interpretive dimensions"><span class="ov-metric-ic"><i class="bi bi-chat-square-quote"></i></span><span class="ov-metric-lbl">Interpretive support</span><span class="ov-metric-val">@(o.InterpretiveSupport > 0 ? o.InterpretiveSupport.ToString() : "—")</span></li>
                                                            <li class="ov-metric-click @(Owner._ovKpiFilter == "branches" ? "ov-metric-click--active" : "")" @onclick='() => Owner.SetOvKpiFilter("branches")' title="Filter outcomes scored across decision branches"><span class="ov-metric-ic"><i class="bi bi-diagram-3"></i></span><span class="ov-metric-lbl">Branches scored</span><span class="ov-metric-val">@(o.BranchWinCount > 0 ? o.BranchWinCount.ToString() : "—")</span></li>
                                                        </ul>
                                                        @if (cardAssessment is not null)
                                                        {
                                                            var cardExpanded = Owner.IsAssessmentExpanded(o.Index);
                                                            <div class="ov-card-assess">
                                                                <button type="button" class="ov-card-assess-toggle" @onclick="() => Owner.ToggleAssessment(o.Index)" aria-expanded="@cardExpanded">
                                                                    <i class="bi bi-clipboard-data" aria-hidden="true"></i>
                                                                    <span>Candidate Assessment</span>
                                                                    <i class="bi @(cardExpanded ? "bi-chevron-up" : "bi-chevron-down") ov-card-assess-chev" aria-hidden="true"></i>
                                                                </button>
                                                                @if (cardExpanded)
                                                                {
                                                                    <div class="ov-assess-detail">
                                                                        <div class="ov-assess-facets">
                                                                            @foreach (var f in cardAssessment.Facets.Where(f => f.Key != "interpretation"))
                                                                            {
                                                                                <div class="ov-assess-facet">
                                                                                    <div class="ov-assess-facet-head">
                                                                                        <i class="bi @f.Icon" aria-hidden="true"></i>
                                                                                        <span class="ov-assess-facet-label">@f.Label</span>
                                                                                    </div>
                                                                                    <p class="ov-assess-facet-summary">@f.Summary</p>
                                                                                    @if (f.Items.Count > 0)
                                                                                    {
                                                                                        <ul class="ov-assess-facet-items">
                                                                                            @foreach (var item in f.Items)
                                                                                            {
                                                                                                <li>@item</li>
                                                                                            }
                                                                                        </ul>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                        @if (cardAssessment.Interpretations.Count > 0)
                                                                        {
                                                                            <div class="ov-assess-lineage">
                                                                                <h6 class="ov-assess-lineage-title"><i class="bi bi-list-nested" aria-hidden="true"></i> Original branch interpretations</h6>
                                                                                @foreach (var seg in cardAssessment.Interpretations)
                                                                                {
                                                                                    <div class="ov-assess-lineage-seg">
                                                                                        @if (!string.IsNullOrWhiteSpace(seg.Label))
                                                                                        {
                                                                                            <span class="ov-assess-lineage-label">@seg.Label</span>
                                                                                        }
                                                                                        <p class="ov-assess-lineage-text">@seg.Text</p>
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                        @if (cardAssessment.Citations.Count > 0)
                                                                        {
                                                                            <div class="ov-assess-citations">
                                                                                <h6 class="ov-assess-citations-title"><i class="bi bi-bank" aria-hidden="true"></i> Legal authority citations</h6>
                                                                                <ul class="ov-assess-citations-list">
                                                                                    @foreach (var c in cardAssessment.Citations)
                                                                                    {
                                                                                        <li class="ov-assess-citation">
                                                                                            <a href="@c.SearchUrl" target="_blank" rel="noopener noreferrer" class="ov-assess-citation-link" title="Look up this authority">
                                                                                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> @c.Name
                                                                                            </a>
                                                                                            <span class="ov-assess-citation-kind">@c.Kind</span>
                                                                                            <span class="dfi-tag dfi-tag-@(string.Equals(c.VerificationStatus, "VERIFIED", StringComparison.OrdinalIgnoreCase) ? "ok" : "warn")">@c.VerificationStatus</span>
                                                                                        </li>
                                                                                    }
                                                                                </ul>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        <button type="button" class="ov-card-cta ov-card-cta--@((o.IsLeader && Owner.OvCompetitionValid) ? "leader" : "compete")" @onclick="() => Owner.OpenCandidateAnalysis(o.Index)">View full analysis ?</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (Owner._ovComparisonView == "Table")
                                        {
                                            <div class="ov-table-wrap">
                                                <table class="ov-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Metric</th>
                                                            @foreach (var o in Owner.OvOutcomes)
                                                            {
                                                                        <th>C@(o.Index) · @o.Title</th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <tr>
                                                                        <td>Overall support</td>
                                                                        @foreach (var o in Owner.OvOutcomes)
                                                                        {
                                                                            <td>
                                                                                @if (Owner.OvCompetitionValid)
                                                                                {
                                                                                    <div class="ov-table-bar"><div class="ov-table-bar-fill ov-card--c@(o.Index)" style="width:@(o.SupportPct)%"></div></div>
                                                                                    <span class="ov-table-bar-val">@o.SupportPct%</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="ov-table-bar"><div class="ov-table-bar-fill ov-card--c@(o.Index)" style="width:@(o.SupportPct)%"></div></div>
                                                                                    <span class="ov-table-bar-val ov-card-support--advisory" title="Dependency-establishment support — no Candidate × Branch competition ran for this matter.">@o.SupportPct%</span>
                                                                                }
                                                                            </td>
                                                                        }
                                                                    </tr>
                                                        <tr>
                                                            <td>Legal viability</td>
                                                            @foreach (var o in Owner.OvOutcomes)
                                                            {
                                                                <td><span class="dfi-pill dfi-pill-@o.ViabilityTone">@o.ViabilityLabel</span></td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td title="Share of decision-factor axes scored. NOT verified-evidence coverage.">Scored-axis coverage</td>
                                                            @foreach (var o in Owner.OvOutcomes)
                                                            {
                                                                <td>@o.EvidenceCoveragePct%</td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td>Interpretive support</td>
                                                            @foreach (var o in Owner.OvOutcomes)
                                                            {
                                                                <td>@o.InterpretiveSupport</td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td>Branches scored</td>
                                                            @foreach (var o in Owner.OvOutcomes)
                                                            {
                                                                <td>@o.BranchWinCount</td>
                                                            }
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ov-graph-panel">
                                                @if (Owner.OvComparisonDimensions.Count >= 3)
                                                {
                                                    <div class="ov-radar">
                                                        <svg viewBox="0 0 200 200" class="ov-radar-svg" role="img" aria-label="Outcome profile across key dimensions">
                                                            @for (var ring = 1; ring <= 4; ring++)
                                                            {
                                                                <circle cx="100" cy="100" r="@(12 + ring * 19)" class="ov-radar-grid" />
                                                            }
                                                            @{ var dims = Owner.OvComparisonDimensions; }
                                                            @for (var di = 0; di < dims.Count; di++)
                                                            {
                                                                var end = Owner.OvRadarAxisLabelPoint(di, dims.Count);
                                                                <line x1="100" y1="100" x2="@end.X.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y2="@end.Y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" class="ov-radar-axis" />
                                                            }
                                                            @foreach (var o in Owner.OvOutcomes)
                                                            {
                                                                <polygon points="@Owner.OvRadarPolygon(o)" class="ov-radar-poly" style="stroke:@Owner.OvOutcomeColor(o.Index - 1);fill:@Owner.OvOutcomeColor(o.Index - 1)" />
                                                            }
                                                        </svg>
                                                        <div class="ov-radar-axislabels">
                                                            @{ var ds = Owner.OvComparisonDimensions; }
                                                            @for (var di = 0; di < ds.Count; di++)
                                                            {
                                                                var p = Owner.OvRadarAxisLabelPoint(di, ds.Count);
                                                                var lx = (p.X / 200d) * 100d;
                                                                var ly = (p.Y / 200d) * 100d;
                                                                <span class="ov-radar-axislabel" style="left:@lx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%;top:@ly.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%">@ds[di]</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <ul class="ov-graph-legend">
                                                        @foreach (var o in Owner.OvOutcomes)
                                                        {
                                                            <li><span class="ov-legend-dot" style="background:@Owner.OvOutcomeColor(o.Index - 1)"></span>C@(o.Index) @o.Title</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p class="dfi-empty">Not enough scored dimensions to render a comparison graph for this execution.</p>
                                                }
                                                </div>
                                            }

                                            @* -- Ambiguity-first grouped execution (moved above Matter Analysis) -- *@
                                            @Owner.AmbiguityGroupsPanel

                                            @* -- Matter Analysis (reuses the candidate assessment) -------------- *@
                                            @if (Owner.OvMatterAnalysisAvailable)
                                            {
                                                <div class="ov-panel ov-panel--matteranalysis">
                                                    <div class="ov-panel-head">
                                                        <h5 class="ov-panel-title"><i class="bi bi-journal-text" aria-hidden="true"></i> Matter Analysis</h5>
                                                        <button type="button" class="ov-insights-link" @onclick="() => Owner.ToggleMatterAnalysis()">@(Owner.OvMatterAnalysisExpanded ? "Hide detail" : "Show detail")</button>
                                                    </div>
                                                    <p class="ov-summary-text">@Owner.OvMatterAnalysisSummary</p>
                                                    @if (Owner.OvMatterAnalysisExpanded)
                                                    {
                                                        <div class="ov-matter-sections">
                                                            @foreach (var s in Owner.OvMatterAnalysisSections)
                                                            {
                                                                <div class="ov-matter-section">
                                                                    <div class="ov-matter-section-head">
                                                                        <i class="bi @s.Icon" aria-hidden="true"></i>
                                                                        <span class="ov-matter-section-title">@s.Title</span>
                                                                    </div>
                                                                    <p class="ov-matter-section-lead">@s.Lead</p>
                                                                    @if (s.Points.Count > 0)
                                                                    {
                                                                        <ul class="ov-matter-section-points">
                                                                            @foreach (var p in s.Points)
                                                                            {
                                                                                <li>@p</li>
                                                                            }
                                                                        </ul>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <div class="ov-bottom-grid">
                                                <div class="ov-panel ov-panel--comparison">
                                                <h5 class="ov-panel-title">Outcome comparison</h5>
                                                <p class="ov-panel-sub">Relative support, risk, and key metrics across outcomes.</p>
                                                <div class="ov-table-wrap">
                                                    <table class="ov-table ov-table--compact">
                                                        <thead>
                                                            <tr>
                                                                <th>Metric</th>
                                                                @foreach (var o in Owner.OvOutcomes)
                                                                {
                                                                    <th>C@(o.Index)</th>
                                                                }
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td>Overall support</td>
                                                                @foreach (var o in Owner.OvOutcomes)
                                                                {
                                                                    <td>
                                                                        @if (Owner.OvCompetitionValid)
                                                                        {
                                                                            <div class="ov-table-bar"><div class="ov-table-bar-fill ov-card--c@(o.Index)" style="width:@(o.SupportPct)%"></div></div>
                                                                            <span class="ov-table-bar-val">@o.SupportPct%</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="ov-table-bar"><div class="ov-table-bar-fill ov-card--c@(o.Index)" style="width:@(o.SupportPct)%"></div></div>
                                                                            <span class="ov-table-bar-val ov-card-support--advisory" title="Dependency-establishment support — no Candidate × Branch competition ran for this matter.">@o.SupportPct%</span>
                                                                        }
                                                                    </td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Legal viability</td>
                                                                @foreach (var o in Owner.OvOutcomes)
                                                                {
                                                                    <td><span class="dfi-pill dfi-pill-@o.ViabilityTone">@o.ViabilityLabel</span></td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Estimated time to resolution</td>
                                                                @foreach (var o in Owner.OvOutcomes)
                                                                {
                                                                    <td>@(string.IsNullOrWhiteSpace(o.EstimatedResolutionLabel) ? "\u2014" : o.EstimatedResolutionLabel)</td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Estimated cost</td>
                                                                @foreach (var o in Owner.OvOutcomes)
                                                                {
                                                                    <td>@(string.IsNullOrWhiteSpace(o.EstimatedCostBand) ? "\u2014" : o.EstimatedCostBand)</td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Critical dependencies</td>
                                                                @foreach (var o in Owner.OvOutcomes)
                                                                {
                                                                    <td>@o.CriticalDependencies</td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Missing evidence</td>
                                                                @foreach (var o in Owner.OvOutcomes)
                                                                {
                                                                    <td class="@(o.MissingEvidence > 0 ? "ov-table-warn" : "")">@o.MissingEvidence</td>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <td>Risk of adverse outcome</td>
                                                                @foreach (var o in Owner.OvOutcomes)
                                                                {
                                                                    <td class="@(o.MainVulnerabilities > 0 ? "ov-table-danger" : "")">@(o.MainVulnerabilities == 0 ? "Lower" : o.MainVulnerabilities >= 3 ? "Higher" : "Moderate")</td>
                                                                }
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <div class="ov-panel ov-panel--profile">
                                                <h5 class="ov-panel-title">Outcome profile</h5>
                                                <p class="ov-panel-sub">Comparative view across key dimensions.</p>
                                                @if (Owner.OvComparisonDimensions.Count >= 3)
                                                {
                                                    <div class="ov-radar ov-radar--mini">
                                                        <svg viewBox="0 0 200 200" class="ov-radar-svg" role="img" aria-label="Outcome profile radar">
                                                            @for (var ring = 1; ring <= 4; ring++)
                                                            {
                                                                <circle cx="100" cy="100" r="@(12 + ring * 19)" class="ov-radar-grid" />
                                                            }
                                                            @{ var mdims = Owner.OvComparisonDimensions; }
                                                            @for (var di = 0; di < mdims.Count; di++)
                                                            {
                                                                var end = Owner.OvRadarAxisLabelPoint(di, mdims.Count);
                                                                <line x1="100" y1="100" x2="@end.X.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y2="@end.Y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" class="ov-radar-axis" />
                                                            }
                                                            @foreach (var o in Owner.OvOutcomes)
                                                            {
                                                                <polygon points="@Owner.OvRadarPolygon(o)" class="ov-radar-poly" style="stroke:@Owner.OvOutcomeColor(o.Index - 1);fill:@Owner.OvOutcomeColor(o.Index - 1)" />
                                                            }
                                                        </svg>
                                                    </div>
                                                    <ul class="ov-graph-legend">
                                                        @foreach (var o in Owner.OvOutcomes)
                                                        {
                                                            <li><span class="ov-legend-dot" style="background:@Owner.OvOutcomeColor(o.Index - 1)"></span>C@(o.Index) @o.Title</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p class="dfi-empty">Not enough scored dimensions to render the profile.</p>
                                                }
                                            </div>

                                            <div class="ov-panel ov-panel--insights">
                                                <div class="ov-insights-head">
                                                    <h5 class="ov-panel-title">Key insights</h5>
                                                    <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Readiness"'>View all insights ?</button>
                                                </div>
                                                @if (Owner.OvKeyInsights.Count > 0)
                                                {
                                                    <ul class="ov-insights-list">
                                                        @foreach (var insight in Owner.OvKeyInsights)
                                                        {
                                                            var icon = insight.Tone switch { "ok" => "bi-lightbulb", "warn" => "bi-exclamation-triangle", _ => "bi-info-circle" };
                                                            <li class="ov-insight ov-insight--@insight.Tone">
                                                                <span class="ov-insight-ic"><i class="bi @icon"></i></span>
                                                                <span class="ov-insight-text">@insight.Text</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No insights are available for this execution yet.</p>
                                                        }
                                                    </div>
                                                </div>

                                                @* -- Why It Leads · What Could Flip It · What To Resolve Next -------- *@
                                                @if (Owner.FinalRankedCandidates.Count > 0)
                                                {
                                                    <div class="ov-intel-grid ov-intel-grid--single dfi-landscapes">
                                                        <DecisionLandscapesPanel Contracts="Owner._decisionContracts" Candidates="Owner.FinalRankedCandidates" ExampleLabel="@Owner.DfiMatterTitle" />
                                                    </div>
                                                }

                                                <div class="ov-intel-grid ov-intel-grid--three ov-decision-row">
                                                    <div class="ov-panel ov-panel--why">
                                                        <div class="ov-panel-head">
                                                            @if (Owner.OvCompetitionValid)
                                                            {
                                                                <h5 class="ov-panel-title"><i class="bi bi-trophy" aria-hidden="true"></i> Why C@(ovLeader.Index) Leads</h5>
                                                            }
                                                            else
                                                            {
                                                                <h5 class="ov-panel-title"><i class="bi bi-list-check" aria-hidden="true"></i> C@(ovLeader.Index) &mdash; Proposed supporting factors</h5>
                                                            }
                                                            <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Competition"'>Evidence ?</button>
                                                        </div>
                                                        @if (Owner.OvWhyItLeads.Count > 0)
                                                        {
                                                            <ul class="ov-factor-list">
                                                                @foreach (var f in Owner.OvWhyItLeads)
                                                                {
                                                                    <li class="ov-factor">
                                                                        <span class="ov-factor-name">@f.Name</span>
                                                                        <span class="ov-factor-track"><span class="ov-factor-fill ov-factor-fill--@f.Tone" style="width:@f.Pct%"></span></span>
                                                                        <span class="ov-factor-pct">@f.Pct%</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">The leading outcome has no scored supporting dimensions yet.</p>
                                                        }
                                                    </div>

                                                    <div class="ov-panel ov-panel--flip">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-shuffle" aria-hidden="true"></i> What Could Flip It</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Decision Analysis"'>Flip points ?</button>
                                                        </div>
                                                        @if (Owner.OvWhatCouldFlipIt.Count > 0)
                                                        {
                                                            <ul class="ov-flip-list">
                                                                @foreach (var fp in Owner.OvWhatCouldFlipIt)
                                                                {
                                                                    <li class="ov-flip">
                                                                        <span class="ov-flip-ic ov-flip-ic--@fp.Tone"><i class="bi bi-exclamation-triangle"></i></span>
                                                                        <span class="ov-flip-name">@fp.Name</span>
                                                                        <span class="ov-flip-state ov-flip-state--@fp.Tone">@fp.StateLabel</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No contradicted or unresolved factors could currently flip the decision.</p>
                                                        }
                                                    </div>

                                                    <div class="ov-panel ov-panel--resolve">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-flag" aria-hidden="true"></i> What To Resolve Next</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Continuous Decision Calibration (CDC)"'>All actions ?</button>
                                                        </div>
                                                        @if (Owner.OvResolutionCalculated)
                                                        {
                                                            <div class="dfi-table-wrap">
                                                                <table class="dfi-table nba-grid">
                                                                    <thead>
                                                                        <tr>
                                                                            <th style="width:3rem;">#</th>
                                                                            <th>Resolution Target</th>
                                                                            <th style="width:6rem;">IV</th>
                                                                            <th style="width:6rem;">ADV</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @{ var wtrnRank = (Owner.WtrnPage - 1) * LegalPersonalInjuryDecision2.WtrnPageSize; }
                                                                        @foreach (var t in Owner.WtrnPagedTargets)
                                                                        {
                                                                            wtrnRank++;
                                                                            <tr>
                                                                                <td><span class="ov-action-rank">@wtrnRank</span></td>
                                                                                <td>
                                                                                    <span class="ov-action-title">@t.ResolutionQuestion</span>
                                                                                    @if (t.HierarchyPath.Count > 0)
                                                                                    {
                                                                                        <span class="ov-action-path">@string.Join(" ? ", t.HierarchyPath.Select(n => n.Label))</span>
                                                                                    }
                                                                                    @if (!string.IsNullOrWhiteSpace(t.MissingInformation))
                                                                                    {
                                                                                        <span class="ov-action-ctx">@t.MissingInformation</span>
                                                                                    }
                                                                                </td>
                                                                                <td>@(t.InformationValue.HasValue ? t.InformationValue.Value.ToString("0.00") : "—")</td>
                                                                                <td>@(t.LegalAdv.HasValue ? t.LegalAdv.Value.ToString("0.00") : "—")</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                            @if (Owner.WtrnPageCount > 1)
                                                            {
                                                                <div class="nba-pager">
                                                                    <button type="button" class="nba-pager-btn" disabled="@(Owner.WtrnPage <= 1)" @onclick="() => Owner.WtrnGoToPage(Owner.WtrnPage - 1)">
                                                                        <i class="bi bi-chevron-left" aria-hidden="true"></i> Prev
                                                                    </button>
                                                                    <span class="nba-pager-info">Page @Owner.WtrnPage of @Owner.WtrnPageCount · @Owner.OvResolutionTargets.Count targets</span>
                                                                    <button type="button" class="nba-pager-btn" disabled="@(Owner.WtrnPage >= Owner.WtrnPageCount)" @onclick="() => Owner.WtrnGoToPage(Owner.WtrnPage + 1)">
                                                                        Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                                                    </button>
                                                                </div>
                                                            }
                                                        }
                                                                                else
                                                                                {
                                                                                    <p class="dfi-empty">@Owner.OvResolutionStateText</p>
                                                                                }
                                                                            </div>
                                                                        </div>

                                                                        @* -- Decision Structure (CHR/APR) · Latest Intelligence (HRR/AER) ---- *@
                                                <div class="ov-intel-grid ov-intel-grid--two">
                                                    <div class="ov-panel ov-panel--structure">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-diagram-3" aria-hidden="true"></i> Decision Structure (CHR / APR)</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Hierarchy"'>Explore hierarchy ?</button>
                                                        </div>
                                                        <div class="ov-struct-stats">
                                                            <div class="ov-struct-stat">
                                                                <span class="ov-struct-val">@Owner.OvHierarchyNodeCount</span>
                                                                <span class="ov-struct-lbl">Hierarchy nodes (CHR)</span>
                                                            </div>
                                                            <div class="ov-struct-stat">
                                                                <span class="ov-struct-val">@Owner.OvAprResolvedCount / @Owner.OvAprTotalCount</span>
                                                                <span class="ov-struct-lbl">Atomic propositions resolved (APR)</span>
                                                            </div>
                                                            <div class="ov-struct-stat">
                                                                <span class="ov-struct-val">@Owner.OvAprResolvedPct%</span>
                                                                <span class="ov-struct-lbl">APR resolution</span>
                                                            </div>
                                                        </div>
                                                        <div class="ov-struct-track"><div class="ov-struct-fill" style="width:@Owner.OvAprResolvedPct%"></div></div>
                                                    </div>

                                                    <div class="ov-panel ov-panel--intel">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-activity" aria-hidden="true"></i> Latest Intelligence (HRR / AER)</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Decision Change Intelligence (DCI)"'>Full DCI trace ?</button>
                                                        </div>
                                                        @if (Owner.OvLatestIntelligence is { } li)
                                                        {
                                                            <div class="ov-intel-lineage">
                                                                <span class="ov-intel-node">@li.Factor</span>
                                                                <i class="bi bi-arrow-down ov-intel-arrow"></i>
                                                                <span class="ov-intel-edge">HRR ? AER</span>
                                                                <i class="bi bi-arrow-down ov-intel-arrow"></i>
                                                                <span class="ov-intel-outcome ov-intel-outcome--@li.ImpactTone">@li.Impact impact · @li.LinkedCandidates</span>
                                                            </div>
                                                            <p class="ov-intel-reason">@li.Reason</p>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No decision-affecting intelligence has been recorded for this matter yet.</p>
                                                        }
                                                    </div>
                                                </div>

                                                @* -- Document Intelligence ------------------------------------------ *@
                                                <div class="ov-panel ov-panel--docintel">
                                                    <div class="ov-panel-head">
                                                        <h5 class="ov-panel-title"><i class="bi bi-files" aria-hidden="true"></i> Document Intelligence</h5>
                                                        <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Documents"'>Open document intelligence ?</button>
                                                    </div>
                                                    @if (Owner.OvDocumentIntelligence.Count > 0)
                                                    {
                                                        <div class="ov-docintel-stats">
                                                            @foreach (var s in Owner.OvDocumentIntelligence)
                                                            {
                                                                <div class="ov-docintel-stat">
                                                                    <span class="ov-docintel-val">@s.Value</span>
                                                                    <span class="ov-docintel-lbl">@s.Label</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <p class="dfi-empty">Document intelligence has not been projected for this matter yet.</p>
                                                    }
                                                </div>

                                                @* -- Decision Confidence · Key Factors · Next Best Actions --------- *@
                                                <div class="ov-intel-grid ov-intel-grid--three">
                                                    <div class="ov-panel ov-panel--confidence">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Decision Confidence</h5>
                                                            <span class="dfi-pill dfi-pill-@Owner.OvConfidenceTone">H = @Owner.OvEntropy.ToString("0.00")</span>
                                                        </div>
                                                        <div class="ov-confidence-body">
                                                            <div class="ov-donut" style="--ov-donut:@Owner.OvConfidencePct%">
                                                                <div class="ov-donut-hole">
                                                                    <span class="ov-donut-val">@Owner.OvConfidenceLabel</span>
                                                                    <span class="ov-donut-sub">Confidence</span>
                                                                </div>
                                                            </div>
                                                            <ul class="ov-confidence-legend">
                                                                @foreach (var o in Owner.OvOutcomes)
                                                                {
                                                                    <li>
                                                                        <span class="ov-legend-dot" style="background:@Owner.OvOutcomeColor(o.Index - 1)"></span>
                                                                        <span class="ov-legend-name">C@(o.Index) @o.Title</span>
                                                                        @if (Owner.OvCompetitionValid)
                                                                        {
                                                                            <span class="ov-legend-pct">@o.SupportPct%</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="ov-legend-pct ov-card-support--advisory" title="Advisory LLM score only — not a POLOXI competition result.">—</span>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                        <p class="ov-panel-foot">Confidence reflects winner separation, evidence grounding, and ranking stability. Additional evidence could materially change the outcome.</p>
                                                    </div>

                                                    <div class="ov-panel ov-panel--factors">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Key Factors Impacting Outcomes</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Decision Analysis"'>View all ?</button>
                                                        </div>
                                                        @if (Owner.OvKeyFactors.Count > 0)
                                                        {
                                                            <ul class="ov-factor-list">
                                                                @foreach (var f in Owner.OvKeyFactors)
                                                                {
                                                                    <li class="ov-factor">
                                                                        <span class="ov-factor-name">@f.Name</span>
                                                                        <span class="ov-factor-track"><span class="ov-factor-fill ov-factor-fill--@f.Tone" style="width:@f.Pct%"></span></span>
                                                                        <span class="ov-factor-pct">@f.Pct%</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No scored decision factors are available for this execution yet.</p>
                                                        }
                                                    </div>

                                                    <div class="ov-panel ov-panel--actions">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Next Best Actions</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Continuous Decision Calibration (CDC)"'>View all ?</button>
                                                        </div>
                                                        @if (Owner.OvNextBestActions.Count > 0)
                                                        {
                                                            <div class="dfi-table-wrap">
                                                                <table class="dfi-table nba-grid">
                                                                    <thead>
                                                                        <tr>
                                                                            <th style="width:3rem;">#</th>
                                                                            <th>Action</th>
                                                                            <th style="width:9rem;">Impact</th>
                                                                            <th style="width:6rem;">ADV</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @{ var nbaRank = (Owner.NbaPage - 1) * LegalPersonalInjuryDecision2.NbaPageSize; }
                                                                        @foreach (var a in Owner.NbaPagedActions)
                                                                        {
                                                                            nbaRank++;
                                                                            <tr>
                                                                                <td><span class="ov-action-rank">@nbaRank</span></td>
                                                                                <td>
                                                                                    <span class="ov-action-title">@a.Title</span>
                                                                                    @if (a.HierarchyPath.Count > 0)
                                                                                    {
                                                                                        <span class="ov-action-path">@string.Join(" ? ", a.HierarchyPath)</span>
                                                                                    }
                                                                                    @if (!string.IsNullOrWhiteSpace(a.Context))
                                                                                    {
                                                                                        <span class="ov-action-ctx">@a.Context</span>
                                                                                    }
                                                                                </td>
                                                                                <td><span class="ov-impact ov-impact--@a.ImpactTone">@a.ImpactLabel</span></td>
                                                                                <td><span class="ov-adv">ADV @a.Adv.ToString("0.00")</span></td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                            @if (Owner.NbaPageCount > 1)
                                                            {
                                                                <div class="nba-pager">
                                                                    <button type="button" class="nba-pager-btn" disabled="@(Owner.NbaPage <= 1)" @onclick="() => Owner.NbaGoToPage(Owner.NbaPage - 1)">
                                                                        <i class="bi bi-chevron-left" aria-hidden="true"></i> Prev
                                                                    </button>
                                                                    <span class="nba-pager-info">Page @Owner.NbaPage of @Owner.NbaPageCount · @Owner.OvNextBestActions.Count actions</span>
                                                                    <button type="button" class="nba-pager-btn" disabled="@(Owner.NbaPage >= Owner.NbaPageCount)" @onclick="() => Owner.NbaGoToPage(Owner.NbaPage + 1)">
                                                                        Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                                                    </button>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">@Owner.OvNextBestActionsEmptyText</p>
                                                        }
                                                                            </div>
                                                                        </div>

                                                                        @* -- Matter Snapshot · Progress to Decision Readiness ------------- *@
                                                <div class="ov-intel-grid ov-intel-grid--two">
                                                    <div class="ov-panel ov-panel--matter">
                                                        <h5 class="ov-panel-title">Matter Snapshot</h5>
                                                        <dl class="ov-snapshot">
                                                            @foreach (var s in Owner.OvMatterSnapshot)
                                                            {
                                                                <div class="ov-snapshot-item">
                                                                    <dt><i class="bi @s.Icon" aria-hidden="true"></i> @s.Label</dt>
                                                                    <dd>@(string.IsNullOrWhiteSpace(s.Value) ? "—" : s.Value)</dd>
                                                                </div>
                                                            }
                                                        </dl>
                                                    </div>

                                                    <div class="ov-panel ov-panel--readiness">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Progress to Decision Readiness</h5>
                                                            <span class="ov-readiness-pct">@Owner.OvReadinessPct%</span>
                                                        </div>
                                                        <div class="ov-readiness-track"><div class="ov-readiness-fill ov-readiness-fill--@Owner.DfiReadinessTone" style="width:@Owner.OvReadinessPct%"></div></div>
                                                        <ul class="ov-readiness-steps">
                                                            @foreach (var step in Owner.OvReadinessSteps)
                                                            {
                                                                <li class="ov-rstep ov-rstep--@step.Tone">
                                                                    <span class="ov-rstep-ic"><i class="bi @(step.Tone == "ok" ? "bi-check-circle-fill" : "bi-clock")"></i></span>
                                                                    <span class="ov-rstep-lbl">@step.Label</span>
                                                                                    <span class="ov-rstep-val">@step.Value</span>
                                                                                </li>
                                                                            }
                                                                        </ul>
                                                                        @if (Owner.OvReadinessBlockers.Count > 0)
                                                                        {
                                                                            <div class="ov-blockers">
                                                                                <span class="ov-blockers-title"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Blockers</span>
                                                                                <ul class="ov-blockers-list">
                                                                                    @foreach (var b in Owner.OvReadinessBlockers)
                                                                                    {
                                                                                        <li>@b</li>
                                                                                    }
                                                                                </ul>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                </div>

                                                @* -- Recent Activity · Analyst Summary ---------------------------- *@
                                                <div class="ov-intel-grid ov-intel-grid--two">
                                                    <div class="ov-panel ov-panel--activity">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title">Recent Activity</h5>
                                                            <button type="button" class="ov-insights-link" @onclick='() => Owner._dfiTab = "Decision Change Intelligence (DCI)"'>View all ?</button>
                                                        </div>
                                                        @if (Owner.CdcRecentActivity.Count > 0)
                                                        {
                                                            <ul class="ov-activity-list">
                                                                @foreach (var act in Owner.CdcRecentActivity)
                                                                {
                                                                    <li class="ov-activity">
                                                                        <span class="ov-activity-ic ov-activity-ic--@act.Tone"><i class="bi bi-dot"></i></span>
                                                                        <span class="ov-activity-body">
                                                                            <span class="ov-activity-title">@act.Title</span>
                                                                            @if (!string.IsNullOrWhiteSpace(act.Detail))
                                                                            {
                                                                                <span class="ov-activity-detail">@act.Detail</span>
                                                                            }
                                                                        </span>
                                                                        <span class="ov-activity-when">@LegalPersonalInjuryDecision2.OvRelativeTime(act.When)</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        else
                                                        {
                                                            <p class="dfi-empty">No recent matter activity has been recorded yet.</p>
                                                        }
                                                    </div>

                                                    <div class="ov-panel ov-panel--summary">
                                                        <div class="ov-panel-head">
                                                            <h5 class="ov-panel-title"><i class="bi bi-stars" aria-hidden="true"></i> Decision Brief</h5>
                                                            @if (Owner.OvBriefIsLlmReasoned)
                                                            {
                                                                <span class="ov-brief-badge" title="Composed by the Candidate Landscape reasoning model during this run">
                                                                    <i class="bi bi-cpu" aria-hidden="true"></i> Model-reasoned
                                                                </span>
                                                            }
                                                        </div>
                                                        <p class="ov-summary-text">@Owner.OvExecutiveSummary</p>
                                                        @if (Owner.OvPrincipalDiscriminators.Count > 0)
                                                        {
                                                            <div class="ov-brief-discriminators">
                                                                <span class="ov-brief-discriminators-label"><i class="bi bi-signpost-split"></i> What separates the outcomes</span>
                                                                <ul class="ov-brief-discriminators-list">
                                                                    @foreach (var d in Owner.OvPrincipalDiscriminators)
                                                                    {
                                                                        <li>@d</li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                        <div class="ov-summary-chips">
                                                            @foreach (var chip in Owner.OvSummaryChips)
                                                            {
                                                                <div class="ov-summary-chip ov-summary-chip--@chip.Tone">
                                                                    <span class="ov-summary-chip-head"><i class="bi @chip.Icon"></i> @chip.Title</span>
                                                                    <span class="ov-summary-chip-text">@chip.Text</span>
                                                                </div>
                                                            }
                                                        </div>

                                                        @* ?? Attorney-ready decision: explicit readiness disclosure, never a filed conclusion ?? *@
                                                        <div class="ov-attorney @(Owner.OvAttorneyReady ? "ov-attorney--ready" : "ov-attorney--pending")">
                                                            <div class="ov-attorney-head">
                                                                <span class="ov-attorney-title"><i class="bi bi-briefcase" aria-hidden="true"></i> Attorney-ready decision</span>
                                                                <span class="ov-attorney-badge ov-attorney-badge--@(Owner.OvAttorneyReady ? "ok" : "warn")">
                                                                    @(Owner.OvAttorneyReady ? "Ready" : "Provisional")
                                                                </span>
                                                            </div>
                                                            <p class="ov-attorney-headline">@Owner.OvAttorneyReadyHeadline</p>
                                                            <ul class="ov-attorney-list">
                                                                @foreach (var d in Owner.OvAttorneyReadyDisclosures)
                                                                {
                                                                    <li class="ov-attorney-item ov-attorney-item--@d.StatusTone">
                                                                        <span class="ov-attorney-item-icon"><i class="bi @d.Icon"></i></span>
                                                                        <span class="ov-attorney-item-body">
                                                                            <span class="ov-attorney-item-head">
                                                                                <span class="ov-attorney-item-name">@d.Title</span>
                                                                                <span class="ov-attorney-item-status ov-attorney-item-status--@d.StatusTone">@d.Status</span>
                                                                            </span>
                                                                            <span class="ov-attorney-item-detail">@d.Detail</span>
                                                                        </span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>

                                                        @* ?? Attorney decision memorandum: dedicated, on-demand metered LLM call ?? *@
                                                        <div class="ov-memo">
                                                            <div class="ov-memo-head">
                                                                <span class="ov-memo-title"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Attorney decision memorandum</span>
                                                                <button type="button" class="um-btn um-btn-primary um-btn-sm"
                                                                        @onclick="Owner.GenerateDecisionMemoAsync"
                                                                        disabled="@(Owner._decisionMemoLoading || !Owner.OvCanGenerateMemo)"
                                                                        title="Generate an attorney-style memorandum from this saved analysis run (uses a metered model call)">
                                                                    @if (Owner._decisionMemoLoading)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                                        <span>Generating…</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-stars" aria-hidden="true"></i>
                                                                        <span>@(Owner._decisionMemo is null ? "Generate memo" : "Regenerate")</span>
                                                                    }
                                                                </button>
                                                            </div>
                                                            @if (Owner._decisionMemoError is not null)
                                                            {
                                                                <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@Owner._decisionMemoError</div>
                                                            }
                                                            @if (Owner._decisionMemo is { } memo)
                                                            {
                                                                <div class="ov-memo-body">
                                                                    <span class="ov-memo-flag ov-memo-flag--@(memo.AttorneyReady ? "ok" : "warn")">@(memo.AttorneyReady ? "Decision ready" : "Working memorandum — provisional")</span>
                                                                    <section class="ov-memo-section">
                                                                        <h6 class="ov-memo-h">Issue</h6>
                                                                        <p>@memo.Issue</p>
                                                                    </section>
                                                                    <section class="ov-memo-section">
                                                                        <h6 class="ov-memo-h">Short answer</h6>
                                                                        <p>@memo.ShortAnswer</p>
                                                                    </section>
                                                                    <section class="ov-memo-section">
                                                                        <h6 class="ov-memo-h">Analysis</h6>
                                                                        <p>@memo.Analysis</p>
                                                                    </section>
                                                                    <section class="ov-memo-section">
                                                                        <h6 class="ov-memo-h">Evidence &amp; authority</h6>
                                                                        <p>@memo.EvidenceAndAuthority</p>
                                                                    </section>
                                                                    @if (memo.Risks.Count > 0)
                                                                    {
                                                                        <section class="ov-memo-section">
                                                                            <h6 class="ov-memo-h">Principal risks</h6>
                                                                            <ul class="ov-memo-list">@foreach (var r in memo.Risks){<li>@r</li>}</ul>
                                                                        </section>
                                                                    }
                                                                    @if (memo.OpenItems.Count > 0)
                                                                    {
                                                                        <section class="ov-memo-section">
                                                                            <h6 class="ov-memo-h">Open items</h6>
                                                                            <ul class="ov-memo-list">@foreach (var o in memo.OpenItems){<li>@o</li>}</ul>
                                                                        </section>
                                                                    }
                                                                    @if (memo.RecommendedNextSteps.Count > 0)
                                                                    {
                                                                        <section class="ov-memo-section">
                                                                            <h6 class="ov-memo-h">Recommended next steps</h6>
                                                                            <ul class="ov-memo-list">@foreach (var s in memo.RecommendedNextSteps){<li>@s</li>}</ul>
                                                                        </section>
                                                                    }
                                                                    <p class="ov-memo-disclaimer"><i class="bi bi-info-circle" aria-hidden="true"></i> @memo.Disclaimer</p>
                                                                </div>
                                                            }
                                                            else if (Owner._decisionMemoError is null)
                                                            {
                                                                <p class="ov-memo-empty">Generate an attorney-style memorandum synthesizing this run's outcomes, evidence, authorities, and open dependencies. This is a dedicated model call and does not re-run the analysis.</p>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                @* -- Admitted evidence & Factor Inventory (same live-data panels as their dedicated tabs) -- *@
                                                <div class="ov-intel-grid ov-intel-grid--single">
                                                    <EvidenceTab Owner="Owner" />
                                                </div>
                                                <div class="ov-intel-grid ov-intel-grid--single">
                                                    @Owner.FactorChecklistPanel
                                                </div>
                                                <div class="ov-intel-grid ov-intel-grid--single">
                                                    <FactorMatrixTab Owner="Owner" />
                                                </div>
                                                                                       </div>
                                                                                   }

@code {
    [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;
}