@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages

                                        <div class="dfi-panel-card">
                                            <h4>Investigation plan</h4>
                                            <p class="dfi-panel-sub">Unresolved factors are turned into targeted investigation obligations. Resolving them is what changes support, uncertainty, and readiness.</p>
                                            @if (Owner.DfiNextRequiredWork.Count > 0)
                                            {
                                                <ol class="dcc-worklist">
                                                    @foreach (var work in Owner.DfiNextRequiredWork)
                                                    {
                                                        <li>@work</li>
                                                    }
                                                </ol>
                                            }
                                            else
                                            {
                                                <p class="dfi-empty">No open investigation obligations for the current execution.</p>
                                            }
                                            @if (Owner.DfiMissingFactorCount > 0)
                                            {
                                                <div class="dfi-dep-row">
                                                    <span>Missing factor value(s)</span>
                                                    <span class="dfi-pill dfi-pill-warn">@Owner.DfiMissingFactorCount</span>
                                                </div>
                                            }
                                        </div>

@code {
    [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;
}