@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages

                                <div class="dfi-panel-card">
                                    <h4>Factor Inventory</h4>
                                    <p class="dfi-panel-sub">Interactive dependency review · @Owner.DfiFilteredFactors.Count of @Owner.DfiFactorCount factor(s) · @Owner.DfiMissingFactorCount missing value(s).</p>
                                    <div class="dfi-review-bar">
                                        <span class="dfi-review-label">Review mode</span>
                                        @foreach (var mode in LegalPersonalInjuryDecision2.DfiFactorFilters)
                                        {
                                            <button type="button"
                                                    class="dfi-chip-btn @(Owner._dfiFactorFilter == mode ? "dfi-chip-btn--active" : "")"
                                                    @onclick="() => Owner._dfiFactorFilter = mode">@mode</button>
                                        }
                                    </div>
                                    @if (Owner.DfiFilteredFactors.Count > 0)
                                    {
                                        <div class="dfi-grid-scroll">
                                            <table class="dfi-grid">
                                                <thead>
                                                    <tr>
                                                        <th>Factor ID · L-level</th>
                                                        <th>Factor / proposition</th>
                                                        <th>Candidate</th>
                                                        <th>Relationship</th>
                                                        <th>Source</th>
                                                        <th>Actual value</th>
                                                        <th>Availability</th>
                                                        <th>Verification</th>
                                                        <th>References</th>
                                                        <th>Decision impact</th>
                                                        <th>Review status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var f in Owner.DfiFilteredFactors)
                                                    {
                                                        <tr class="@(Owner._dfiSelectedFactorId == f.FactorId ? "dfi-row--selected" : "")"
                                                            @onclick="() => Owner.OpenFactorDetail(f)"
                                                            title="Click to view all fields for this factor.">
                                                            <td class="dfi-cell-id">@f.FactorId · @f.NodeKind</td>
                                                            <td>@f.FactorName</td>
                                                            <td>@Owner.DfiFactorCandidate(f)</td>
                                                            <td><span class="dfi-badge dfi-badge-@Owner.DfiRelationTone(f)">@Owner.DfiFactorRelation(f)</span></td>
                                                            <td>@f.Source</td>
                                                            <td>@(string.IsNullOrWhiteSpace(f.ActualValue) ? "—" : f.ActualValue)</td>
                                                            <td><span class="dfi-badge dfi-badge-@(f.Availability == "AVAILABLE" ? "ok" : "warn")">@f.Availability</span></td>
                                                            <td><span class="dfi-badge dfi-badge-@(f.VerificationStatus == "VERIFIED" ? "ok" : "muted")">@f.VerificationStatus</span></td>
                                                            <td class="dfi-cell-refs" @onclick:stopPropagation="true"><FactorReferenceChips References="f.References" OnReferenceSelected="Owner.OpenReferenceDetail" /></td>
                                                            <td>@Owner.DfiFactorImpact(f)</td>
                                                            <td><span class="dfi-badge dfi-badge-muted">Pending</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <p class="dfi-prototype-note">Review controls surface provenance and validation state; they do not modify the original model output or matter data. An accepted correction creates a new authoritative decision-state version and audit entry.</p>
                                    }
                                    else
                                    {
                                        <p class="dfi-empty">No factors match this review filter for the current run.</p>
                                    }
                                </div>

@code {
    [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;
}