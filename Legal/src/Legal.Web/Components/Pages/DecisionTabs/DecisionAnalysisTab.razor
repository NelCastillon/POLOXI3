@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages

        <div class="da-root">
            @if (Owner._response is null || Owner._response.Candidates.Count == 0)
            {
                <div class="da-empty">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    <h4>No decision snapshot yet</h4>
                    <p>Run a decision analysis for this matter. Once POLOXI produces a candidate competition, this tab projects the authoritative decision snapshot — candidate headers, factor map, evidence balance, contradictions, authority map and full trace — with no fabricated values.</p>
                </div>
            }
            else
            {
                var leader = Owner.DaCandidates[0];
                var selected = Owner.DaSelectedCandidate ?? leader;
                var selectedIdx = Owner.DaSelectedCandidateIndex + 1;
                var maxScore = Math.Max(0.01m, Owner.DaCandidates.Max(c => c.CompositeScore));

                <div class="da-candstrip" role="group" aria-label="Select a candidate to inspect">
                    @for (var i = 0; i < Owner.DaCandidates.Count; i++)
                    {
                        var c = Owner.DaCandidates[i];
                        var idx = i + 1;
                        var isSel = c.WideCandidateId == selected.WideCandidateId;
                        <button type="button" class="da-cand da-cand--c@(idx) @(isSel ? "da-cand--leader" : "")"
                                aria-pressed="@(isSel ? "true" : "false")"
                                aria-label="@($"Candidate {idx}: {c.DisplayName}, POLOXI score {(c.CompositeScore * 100m).ToString("0")}{(isSel ? ", selected" : "")}")"
                                @onclick="() => Owner.DaSelectCandidate(c.WideCandidateId)">
                            <span class="da-cand-code">C@(idx)</span>
                            <span class="da-cand-name">@c.DisplayName</span>
                            <span class="da-cand-score">@((c.CompositeScore * 100m).ToString("0"))</span>
                            <span class="da-cand-track"><span class="da-cand-fill" style="width:@(((c.CompositeScore / maxScore) * 100m).ToString("0"))%"></span></span>
                        </button>
                    }
                </div>

                <div class="da-grid3">
                    @* -- Selected candidate header card -- *@
                    <div class="da-panel da-headercard">
                        <div class="da-headercard-top">
                            <span class="da-cand-code da-cand-code--lg da-cand--c@(selectedIdx)">C@(selectedIdx)</span>
                            <div>
                                <h4>@selected.DisplayName</h4>
                                <span class="da-chip da-chip--@(selected.IsConstraintViolation ? "bad" : "warn")">@Owner.DaCandidateState(selected)</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selected.Detail))
                        {
                            <p class="da-headercard-detail">@selected.Detail</p>
                        }
                        <div class="da-metricgrid">
                            <div class="da-metric"><span class="da-metric-lbl">POLOXI Decision Score</span><span class="da-metric-val">@((selected.CompositeScore * 100m).ToString("0"))</span><span class="da-metric-scope da-metric-scope--cand">C@(selectedIdx)</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Model Confidence</span><span class="da-metric-val">@selected.EvidenceConfidence.ToString("0.00")</span><span class="da-metric-scope da-metric-scope--cand">C@(selectedIdx)</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Decision Uncertainty</span><span class="da-metric-val">@Owner.DaDecisionUncertainty.ToString("0.00")</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Decision Stability</span><span class="da-metric-val da-metric-val--sm">@Owner.DaStabilityState</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Structural Coverage</span><span class="da-metric-val">@Owner.DaStructuralCoverage.ToString("P0")</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Evidence Coverage</span><span class="da-metric-val">@selected.EvidenceCoverage.ToString("P0")</span><span class="da-metric-scope da-metric-scope--cand">C@(selectedIdx)</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Authority Coverage</span><span class="da-metric-val">@Owner.DaAuthorityCoverage.ToString("P0")</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Decision Frontier</span><span class="da-metric-val">@Owner.DaFrontierDeps.Count</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Decision Readiness</span><span class="da-metric-val da-metric-val--sm">@Owner.DaReadinessState</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                        </div>
                    </div>

                    @* -- Candidate comparison (key metrics) -- *@
                    <div class="da-panel">
                        <h4 class="da-panel-title">Candidate Comparison <span class="da-panel-sub">Key metrics</span></h4>
                        <div class="da-tablewrap">
                            <table class="da-table">
                                <thead>
                                    <tr>
                                        <th>Metric</th>
                                        @for (var i = 0; i < Owner.DaCandidates.Count; i++)
                                        {
                                            <th>C@(i + 1) @Owner.DaCandidates[i].DisplayName</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td>POLOXI Score</td>@foreach (var c in Owner.DaCandidates){<td>@((c.CompositeScore * 100m).ToString("0"))</td>}</tr>
                                    <tr><td>Model Confidence</td>@foreach (var c in Owner.DaCandidates){<td>@c.EvidenceConfidence.ToString("0.00")</td>}</tr>
                                    <tr><td>Quality Score</td>@foreach (var c in Owner.DaCandidates){<td>@c.QualityScore.ToString("P0")</td>}</tr>
                                    <tr><td>Evidence Coverage</td>@foreach (var c in Owner.DaCandidates){<td>@c.EvidenceCoverage.ToString("P0")</td>}</tr>
                                    <tr><td>Support Tier</td>@foreach (var c in Owner.DaCandidates){<td>@c.SupportTierCode</td>}</tr>
                                    <tr><td>Interpretive Support</td>@foreach (var c in Owner.DaCandidates){<td>@c.InterpretiveSupportCount</td>}</tr>
                                    <tr><td>Evidence Hosts</td>@foreach (var c in Owner.DaCandidates){<td>@c.EvidenceHostSupportCount</td>}</tr>
                                    <tr><td>Decision State</td>@foreach (var c in Owner.DaCandidates){<td>@Owner.DaCandidateState(c)</td>}</tr>
                                    <tr><td>Est. Resolution</td>@foreach (var c in Owner.DaCandidates){<td>@(c.EstimatedResolutionLabel ?? "—")</td>}</tr>
                                    <tr><td>Est. Cost Band</td>@foreach (var c in Owner.DaCandidates){<td>@(c.EstimatedCostBand ?? "—")</td>}</tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* -- Decision landscape (value × likelihood) -- *@
                    <div class="da-panel">
                        <h4 class="da-panel-title">Decision Landscape</h4>
                        <div class="da-scatter">
                            <span class="da-scatter-ylbl">Higher likelihood</span>
                            <span class="da-scatter-ylbl da-scatter-ylbl--low">Lower likelihood</span>
                            <span class="da-scatter-xlbl da-scatter-xlbl--low">Lower value</span>
                            <span class="da-scatter-xlbl">Higher value</span>
                            @for (var i = 0; i < Owner.DaCandidates.Count; i++)
                            {
                                var c = Owner.DaCandidates[i];
                                var x = Math.Clamp(c.CompositeScore * 100m, 4m, 94m);
                                var y = Math.Clamp(c.EvidenceConfidence * 100m, 4m, 92m);
                                <span class="da-scatter-dot da-scatter-dot--c@(i + 1)" style="left:@x.ToString("0")%;bottom:@y.ToString("0")%"
                                      title="C@(i + 1) @c.DisplayName · score @((c.CompositeScore * 100m).ToString("0")) · confidence @c.EvidenceConfidence.ToString("0.00")">
                                    C@(i + 1)
                                </span>
                            }
                        </div>
                    </div>
                </div>

                @* -- Inner sub-tab strip -- *@
                <div class="da-subtabs" role="tablist">
                    @foreach (var st in LegalPersonalInjuryDecision2.DaSubTabs)
                    {
                        <button type="button" role="tab" aria-selected="@(Owner._daSubTab == st ? "true" : "false")" class="da-subtab @(Owner._daSubTab == st ? "da-subtab--active" : "")" @onclick="() => Owner._daSubTab = st">@st</button>
                    }
                </div>

                <div class="da-subgrid">
                    <div class="da-panel da-subbody">
                        @switch (Owner._daSubTab)
                        {
                            case "Decision Brief":
                                <h4 class="da-panel-title">Executive Summary (C1)</h4>
                                @if (!string.IsNullOrWhiteSpace(Owner._response.FinalAnswer))
                                {
                                    <p class="da-brief">@Owner._response.FinalAnswer</p>
                                }
                                else if (!string.IsNullOrWhiteSpace(leader.Detail))
                                {
                                    <p class="da-brief">@leader.Detail</p>
                                }
                                else
                                {
                                    <p class="da-empty-inline">No composed decision brief is available for this snapshot yet.</p>
                                }
                                @if (Owner.DaInventory is { BlockingObligations.Count: > 0 })
                                {
                                    <div class="da-callout da-callout--warn">
                                        <strong>Blocking obligations</strong>
                                        <ul>@foreach (var b in Owner.DaInventory.BlockingObligations){<li>@b</li>}</ul>
                                    </div>
                                }
                                break;

                            case "Factors":
                                <h4 class="da-panel-title">Material Factors (L1 / L2)</h4>
                                @if (Owner.DaParentFactors.Count == 0 && Owner.DaFactors.Count == 0)
                                {
                                    <p class="da-empty-inline">No factor inventory was produced for this snapshot.</p>
                                }
                                else
                                {
                                    <table class="da-table">
                                        <thead><tr><th>Factor</th><th>Type</th><th>State</th><th>Availability</th><th>Verification</th></tr></thead>
                                        <tbody>
                                            @foreach (var f in (Owner.DaParentFactors.Count > 0 ? Owner.DaParentFactors : Owner.DaFactors))
                                            {
                                                <tr>
                                                    <td>@f.FactorName</td>
                                                    <td>@f.FactorType</td>
                                                    <td><span class="da-chip da-chip--@LegalPersonalInjuryDecision2.DaFactorTone(f)">@LegalPersonalInjuryDecision2.DaFactorStateLabel(f)</span></td>
                                                    <td>@f.Availability</td>
                                                    <td>@f.VerificationStatus</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                break;

                            case "Propositions":
                                <h4 class="da-panel-title">Proposition Ledger (@Owner.DaAtomicFactors.Count)</h4>
                                @if (Owner.DaAtomicFactors.Count == 0)
                                {
                                    <p class="da-empty-inline">No atomic propositions were resolved for this snapshot.</p>
                                }
                                else
                                {
                                    <table class="da-table">
                                        <thead><tr><th>Proposition</th><th>State</th><th>Admission</th><th>Binding</th></tr></thead>
                                        <tbody>
                                            @foreach (var f in Owner.DaAtomicFactors)
                                            {
                                                <tr class="da-row-click" @onclick="() => Owner.DaSelectFactor(f.FactorId)">
                                                    <td>@f.FactorName</td>
                                                    <td><span class="da-chip da-chip--@LegalPersonalInjuryDecision2.DaFactorTone(f)">@LegalPersonalInjuryDecision2.DaFactorStateLabel(f)</span></td>
                                                    <td>@f.EvidenceAdmissionState</td>
                                                    <td>@f.BindingAdmissibility</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                break;

                            case "Evidence":
                                <h4 class="da-panel-title">Evidence Balance (@Owner.DaEvidence.Count)</h4>
                                @if (Owner.DaEvidence.Count == 0)
                                {
                                    <p class="da-empty-inline">No evidence items were admitted for this snapshot.</p>
                                }
                                else
                                {
                                    <table class="da-table">
                                        <thead><tr><th>Source</th><th>Module</th><th>Relevance</th><th>Rank</th></tr></thead>
                                        <tbody>
                                            @foreach (var e in Owner.DaEvidence.Take(40))
                                            {
                                                <tr>
                                                    <td>@e.Title</td>
                                                    <td>@e.ModuleCode</td>
                                                    <td>@e.RelevanceScore.ToString("P0")</td>
                                                    <td>@e.RankNumber</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                break;

                            case "Contradictions":
                                <h4 class="da-panel-title">Contradiction Intelligence (@Owner.DaContradictedFactors.Count)</h4>
                                @if (Owner.DaContradictedFactors.Count == 0)
                                {
                                    <p class="da-empty-inline">No contradicted propositions were detected in this snapshot.</p>
                                }
                                else
                                {
                                    <ul class="da-contra">
                                        @foreach (var f in Owner.DaContradictedFactors)
                                        {
                                            <li>
                                                <strong>@f.FactorName</strong>
                                                <div class="da-contra-conflicts">
                                                    @foreach (var conflict in f.Contradictions)
                                                    {
                                                        <span class="da-chip da-chip--bad">@conflict</span>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                                break;

                            case "Authority":
                                <h4 class="da-panel-title">Authority Map (@Owner.DaAuthorities.Count)</h4>
                                @if (Owner.DaAuthorities.Count == 0)
                                {
                                    <p class="da-empty-inline">No legal authorities were proposed for this snapshot.</p>
                                }
                                else
                                {
                                    <table class="da-table">
                                        <thead><tr><th>Authority</th><th>Kind</th><th>Relevance</th><th>Verification</th></tr></thead>
                                        <tbody>
                                            @foreach (var a in Owner.DaAuthorities)
                                            {
                                                <tr>
                                                    <td>@a.Name</td>
                                                    <td>@a.Kind</td>
                                                    <td>@a.Relevance</td>
                                                    <td><span class="da-chip da-chip--@(string.Equals(a.VerificationStatus, "VERIFIED", StringComparison.OrdinalIgnoreCase) ? "ok" : "muted")">@a.VerificationStatus</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                break;

                            case "Frontier & Gaps":
                                <h4 class="da-panel-title">Decision Frontier (@Owner.DaFrontierDeps.Count)</h4>
                                @if (Owner.DaFrontierDeps.Count == 0)
                                {
                                    <p class="da-empty-inline">No unresolved decision-frontier dependencies remain for this snapshot.</p>
                                }
                                else
                                {
                                    <ul class="da-frontier">
                                        @foreach (var d in Owner.DaFrontierDeps)
                                        {
                                            <li>
                                                <div><strong>@d.Proposition</strong><span class="da-chip da-chip--warn">@d.VerificationState</span></div>
                                                @if (!string.IsNullOrWhiteSpace(d.UnresolvedInformation))
                                                {
                                                    <p class="da-frontier-un">@d.UnresolvedInformation</p>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                break;

                            case "Attorney Input":
                                <h4 class="da-panel-title">Attorney Decision Input</h4>
                                <p class="da-empty-inline">Attorney assessments for this snapshot are surfaced on the Human Intelligence tab. When authorized attorneys assess these candidates, factors and propositions, their approved matter assessments appear here.</p>
                                break;

                            default:
                                <h4 class="da-panel-title">@Owner._daSubTab</h4>
                                <p class="da-empty-inline">This projection reads directly from the authoritative decision snapshot. Backed data for this view is populated as the Decision Proof Ledger substrate is produced for the current matter — no values are shown until they trace to real snapshot state.</p>
                                break;
                        }
                    </div>

                    @* -- Selected proposition drawer -- *@
                    <div class="da-panel da-drawer">
                        <h4 class="da-panel-title">Selected Proposition</h4>
                        @if (Owner.DaSelectedFactor is { } sf)
                        {
                            <div class="da-drawer-head">
                                <span class="da-chip da-chip--@LegalPersonalInjuryDecision2.DaFactorTone(sf)">@LegalPersonalInjuryDecision2.DaFactorStateLabel(sf)</span>
                                <strong>@sf.FactorName</strong>
                            </div>
                            <dl class="da-drawer-dl">
                                <dt>Factor type</dt><dd>@sf.FactorType</dd>
                                <dt>Source</dt><dd>@sf.Source</dd>
                                <dt>Actual value</dt><dd>@(sf.ActualValue ?? "—")</dd>
                                <dt>Availability</dt><dd>@sf.Availability</dd>
                                <dt>Verification</dt><dd>@sf.VerificationStatus</dd>
                                <dt>Admission state</dt><dd>@sf.EvidenceAdmissionState</dd>
                                <dt>Binding</dt><dd>@sf.BindingAdmissibility</dd>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(sf.VerificationObligation))
                            {
                                <div class="da-callout da-callout--warn"><strong>Verification obligation</strong><p>@sf.VerificationObligation</p></div>
                            }
                            @if (sf.Contradictions.Count > 0)
                            {
                                <div class="da-callout da-callout--bad">
                                    <strong>Contradictions</strong>
                                    <ul>@foreach (var conflict in sf.Contradictions){<li>@conflict</li>}</ul>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(sf.MissingInformation))
                            {
                                <div class="da-callout"><strong>Missing information</strong><p>@sf.MissingInformation</p></div>
                            }
                        }
                        else
                        {
                            <p class="da-empty-inline">Select a proposition to trace its evidence, verification and candidate impact.</p>
                        }
                    </div>
                </div>

                @* -- Snapshot provenance / staleness -- *@
                <div class="da-provenance">
                    <span><i class="bi bi-hash" aria-hidden="true"></i> Snapshot @Owner._response.WideExecutionId.ToString("N").Substring(0, 8)</span>
                    <span><i class="bi bi-diagram-2" aria-hidden="true"></i> Depth @Owner._response.DepthReached</span>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> @(Owner._response.AnswerVerificationCode ?? "—")</span>
                    <span><i class="bi bi-clock" aria-hidden="true"></i> @Owner._response.DurationMilliseconds ms</span>
                    <span class="da-provenance-note">Every value on this tab projects the authoritative POLOXI decision snapshot — no independent scoring.</span>
                </div>
            }
        </div>

@code {
    [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;
}