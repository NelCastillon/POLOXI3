@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages
@using Legal.Web.Services
@using Legal.Application.Features.Intelligence.Citator
@inject ApiClient Api

@{
        var authorities = Owner.DaAuthorities;
        var contributions = Owner.LegalAuthorityContributions;
        var authorityReview = Owner._legalAuthorityReviewItems
            .Where(i => string.Equals(i.AssertionTypeCode, "LegalAuthority", StringComparison.OrdinalIgnoreCase)
                     || string.Equals(i.RetrievalModeCode, "AuthorityDirected", StringComparison.OrdinalIgnoreCase))
            .ToArray();
        var reviewItems = authorityReview.Length > 0 ? authorityReview : Owner._legalAuthorityReviewItems;
        var model = Owner._channelScoring;
        var verifiedCount = authorities.Count(a => string.Equals(a.VerificationStatus, "VERIFIED", StringComparison.OrdinalIgnoreCase));
        var distinctCitations = authorities
            .Where(a => !string.IsNullOrWhiteSpace(a.Name))
            .GroupBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();
}

        <div class="dci-root">
            <div class="dci-topbar">
                <div class="dci-topbar-title">
                    <span class="dci-topbar-icon"><i class="bi bi-bank" aria-hidden="true"></i></span>
                    <div>
                        <div class="dci-topbar-heading">
                            <h4>Legal Authority &mdash; Grounded Channel Workspace</h4>
                            <span class="dci-badge dci-badge--live"><span class="dci-live-dot" aria-hidden="true"></span> POLOXI</span>
                        </div>
                        <p class="dfi-panel-sub">The Legal Authority channel consumes only <strong>verified</strong> legal-authority evidence, matches it to authoritative hierarchy nodes/propositions, and parks it for attorney review. It never scores candidates itself &mdash; POLOXI Core owns the ranking. This workspace shows the retrieved authorities, the hierarchy/proposition matches parked for review, and the exact &delta; math the channel folded into scoring.</p>
                    </div>
                </div>
                <div class="dfi-topbar-actions" style="gap:8px;">
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="Owner.LoadLegalAuthorityWorkspaceAsync" disabled="@(Owner._legalAuthorityBusy || Owner._legalAuthorityLoading)">
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
                    </button>
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="Owner.RunLegalAuthorityPassAsync" disabled="@Owner._legalAuthorityBusy" title="Match verified legal authorities to the hierarchy and park them for attorney review">
                        <i class="bi bi-play-circle" aria-hidden="true"></i> Run Authority Pass
                    </button>
                </div>
            </div>

            @if (Owner._legalAuthorityBanner is not null)
            {
                <div class="alert @(Owner._legalAuthorityBannerError ? "alert-danger" : "alert-info")"
                     style="@(Owner._legalAuthorityBannerError ? "border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" : "border-left: 4px solid #0d6efd;")">
                    @Owner._legalAuthorityBanner
                </div>
            }

            @if (Owner._legalAuthorityLoading)
            {
                <div class="dfi-panel-card"><p class="dfi-panel-sub">Loading Legal Authority workspace&hellip;</p></div>
            }
            else if (Owner._legalAuthorityError is not null)
            {
                <div class="dfi-panel-card"><div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@Owner._legalAuthorityError</div></div>
            }
            else
            {
                <div class="dfi-panel-card" style="margin-bottom:14px;">
                    <div style="display:flex; gap:18px; flex-wrap:wrap;">
                        <div><span class="dfi-panel-sub">Authorities retrieved</span><div style="font-size:1.25rem; font-weight:600;">@authorities.Count</div></div>
                        <div><span class="dfi-panel-sub">Verified</span><div style="font-size:1.25rem; font-weight:600; color:#198754;">@verifiedCount</div></div>
                        <div><span class="dfi-panel-sub">Coverage</span><div style="font-size:1.25rem; font-weight:600;">@Owner.DaAuthorityCoverage.ToString("P0")</div></div>
                        <div><span class="dfi-panel-sub">Parked for review</span><div style="font-size:1.25rem; font-weight:600; color:#fd7e14;">@reviewItems.Count</div></div>
                        <div><span class="dfi-panel-sub">Scoring contributions</span><div style="font-size:1.25rem; font-weight:600;">@contributions.Count</div></div>
                    </div>
                    @if (verifiedCount == 0)
                    {
                        <p class="la-verified-note">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            @if (authorities.Count == 0)
                            {
                                <span>No legal authorities were proposed or retrieved for this session. If citations never appear, the AI legal-authority proposal pass is disabled (config <code>Intelligence.SearchWide.EnableLegalAuthorityProposal</code>) or the decision did not run in the Legal context. Verified status additionally requires an enabled external-grounding provider &mdash; this is a retrieval/configuration state, not a finding that the authorities are bad law.</span>
                            }
                            else
                            {
                                <span>@authorities.Count authorit@(authorities.Count == 1 ? "y was" : "ies were") proposed and are shown below as &ldquo;Unverified&rdquo; leads, but none passed independent identity verification against a retrieved source. &ldquo;Verified&rdquo; reflects retrieved, identity-matched evidence &mdash; not a finding that these authorities are invalid. Recognizing a citation is never treated as verification.</span>
                            }
                        </p>
                    }
                </div>

                @if (distinctCitations.Length > 0)
                {
                    <div class="dfi-panel-card" style="margin-bottom:14px;">
                        <h5 style="margin-bottom:8px;"><i class="bi bi-quote" aria-hidden="true"></i> Citations (@distinctCitations.Length)</h5>
                        <p class="dfi-panel-sub" style="margin-bottom:10px;">Every distinct legal authority citation retrieved for this decision session. Each links to an external lookup so the citation can be independently reviewed.</p>
                        <ul class="la-citations-list">
                            @foreach (var c in distinctCitations)
                            {
                                <li class="la-citation">
                                    <a href="@CitationSearchUrl(c.Name)" target="_blank" rel="noopener noreferrer" class="la-citation-link" title="Look up this citation">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> @c.Name
                                    </a>
                                    <span class="la-citation-kind">@c.Kind</span>
                                    <span class="dfi-tag dfi-tag-@(string.Equals(c.VerificationStatus, "VERIFIED", StringComparison.OrdinalIgnoreCase) ? "ok" : "warn")">@c.VerificationStatus</span>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="dfi-panel-card" style="margin-bottom:14px;">
                    <h5 style="margin-bottom:8px;"><i class="bi bi-bank2" aria-hidden="true"></i> Retrieved legal authorities</h5>
                    @if (authorities.Count == 0)
                    {
                        <p class="dfi-panel-sub">No legal authorities have been retrieved for this matter's latest decision session yet. Run an authority pass or retrieval to surface authorities here.</p>
                    }
                    else
                    {
                        <table class="table table-sm" style="margin:0;">
                            <thead>
                                <tr><th>Authority</th><th>Kind</th><th>Citation</th><th>Relevance</th><th>Verification</th><th>Good law (Citator)</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in authorities)
                                {
                                    <tr>
                                        <td><strong>@a.Name</strong></td>
                                        <td>@a.Kind</td>
                                        <td>
                                            <a href="@CitationSearchUrl(a.Name)" target="_blank" rel="noopener noreferrer" class="la-citation-link" title="Look up this citation">
                                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> @a.Name
                                            </a>
                                        </td>
                                        <td>@a.Relevance</td>
                                        <td><span class="dfi-tag dfi-tag-@(string.Equals(a.VerificationStatus, "VERIFIED", StringComparison.OrdinalIgnoreCase) ? "ok" : "warn")">@a.VerificationStatus</span></td>
                                        <td>
                                            @{
                                                var validity = ValidityFor(a.Name);
                                            }
                                            <button type="button" class="citator-flag" style="@($"background:{validity.FlagColorHex};")"
                                                    title="@CitatorTooltip(validity)" @onclick="() => OpenCitatorPanel(a.Name)">
                                                @validity.FlagDisplayName@(validity.TreatmentCount > 0 ? $" ({validity.TreatmentCount})" : "")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                @if (_citatorPanelAuthority is not null)
                {
                    <div class="dfi-panel-card citator-panel" style="margin-bottom:14px;">
                        <div class="citator-panel-head">
                            <h5 style="margin:0;"><i class="bi bi-journal-check" aria-hidden="true"></i> Citator — @_citatorPanelAuthority</h5>
                            <div class="citator-panel-head-actions">
                                <a class="dfi-tag" href="/legal/citator" target="_blank" title="Open full citator">Full citator <i class="bi bi-box-arrow-up-right"></i></a>
                                <button type="button" class="citator-mini-btn" @onclick="CloseCitatorPanel"><i class="bi bi-x-lg"></i></button>
                            </div>
                        </div>

                        @if (_citatorPanelError is not null)
                        {
                            <p class="dfi-panel-sub citator-panel-error"><i class="bi bi-exclamation-triangle"></i> @_citatorPanelError</p>
                        }

                        @if (_citatorPanelLoading)
                        {
                            <p class="dfi-panel-sub"><span class="spinner-border spinner-border-sm"></span> Loading treatments…</p>
                        }
                        else
                        {
                            @if (_citatorPanelTreatments.Count == 0)
                            {
                                <p class="dfi-panel-sub">No treatments recorded. This authority shows as <strong>Unknown</strong> until one is added.</p>
                            }
                            else
                            {
                                <table class="table table-sm" style="margin:0 0 10px;">
                                    <thead><tr><th>Treatment</th><th>Citing authority</th><th>Date</th><th>Flag</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var t in _citatorPanelTreatments)
                                        {
                                            <tr>
                                                <td><strong>@t.TreatmentDisplayName</strong></td>
                                                <td>@t.CitingAuthorityName</td>
                                                <td>@(t.TreatmentDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                                <td>@t.FlagLevelCode</td>
                                                <td style="text-align:right;">
                                                    <button type="button" class="citator-mini-btn citator-mini-btn--danger" title="Remove (soft delete)" @onclick="() => DeleteTreatmentAsync(t.CitationTreatmentId)"><i class="bi bi-trash"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }

                            <div class="citator-record">
                                <select class="citator-record-input" @bind="_newTreatmentCode">
                                    <option value="">— treatment —</option>
                                    @foreach (var c in _citatorCodes)
                                    {
                                        <option value="@c.TreatmentCode">@c.DisplayName (@c.FlagLevelCode)</option>
                                    }
                                </select>
                                <input class="citator-record-input" placeholder="Citing authority" @bind="_newCitingAuthority" />
                                <input type="date" class="citator-record-input" @bind="_newTreatmentDate" />
                                <button type="button" class="citator-mini-btn citator-mini-btn--primary" @onclick="RecordTreatmentAsync"
                                        disabled="@(_citatorSaving || string.IsNullOrWhiteSpace(_newTreatmentCode))">
                                    <i class="bi bi-plus-lg"></i> @(_citatorSaving ? "Saving…" : "Record")
                                </button>
                            </div>
                        }
                    </div>
                }

                <div class="dfi-panel-card" style="margin-bottom:14px;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                        <h5 style="margin:0;"><i class="bi bi-inbox" aria-hidden="true"></i> Hierarchy / proposition matches parked for review</h5>
                        <span class="dfi-tag">@reviewItems.Count pending</span>
                    </div>
                    @if (Owner._legalAuthorityError is null && reviewItems.Count == 0)
                    {
                        <p class="dfi-panel-sub"><i class="bi bi-check2-circle" aria-hidden="true"></i> No authority propositions are awaiting review for this matter.</p>
                    }
                    else
                    {
                        <div class="decision-review-list">
                            @foreach (var item in reviewItems)
                            {
                                var isAccepted = string.Equals(item.StateCode, "Accepted", StringComparison.OrdinalIgnoreCase);
                                <article class="decision-review-item" @key="item.RetrievedPropositionId">
                                    <div class="decision-review-item-head">
                                        <span class="decision-review-state decision-review-state--@item.StateCode.ToLowerInvariant()">@item.StateCode</span>
                                        <span class="decision-review-assertion">@item.AssertionTypeCode</span>
                                        @if (!string.IsNullOrWhiteSpace(item.AttributedTo))
                                        {
                                            <span class="decision-review-attributed" title="Attributed to">@item.AttributedTo</span>
                                        }
                                    </div>
                                    <p class="decision-review-proposition">@item.PropositionText</p>
                                    @if (!string.IsNullOrWhiteSpace(item.SourceText))
                                    {
                                        <blockquote class="decision-review-source" title="@item.SourceLocator">&ldquo;@item.SourceText&rdquo;</blockquote>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.SourceLocator))
                                    {
                                        <div class="decision-review-locator"><i class="bi bi-geo-alt" aria-hidden="true"></i> @item.SourceLocator</div>
                                    }
                                    @if (item.Placements.Count > 0)
                                    {
                                        <ul class="decision-review-placements">
                                            @foreach (var placement in item.Placements)
                                            {
                                                <li>
                                                    <span class="decision-review-rel decision-review-rel--@placement.RelationshipCode.ToLowerInvariant()">@placement.RelationshipCode</span>
                                                    <code>@placement.TargetNodeId.ToString("N").Substring(0, 8)</code>
                                                    @if (!string.IsNullOrWhiteSpace(placement.Rationale))
                                                    {
                                                        <span class="decision-review-rationale">@placement.Rationale</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    <div class="decision-review-actions">
                                        @if (isAccepted)
                                        {
                                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => Owner.WithdrawLegalAuthorityItemAsync(item)" disabled="@Owner._legalAuthorityBusy">
                                                <i class="bi bi-x-octagon" aria-hidden="true"></i> Withdraw
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => Owner.AcceptLegalAuthorityItemAsync(item)" disabled="@Owner._legalAuthorityBusy">
                                                <i class="bi bi-check2" aria-hidden="true"></i> Accept
                                            </button>
                                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => Owner.RejectLegalAuthorityItemAsync(item)" disabled="@Owner._legalAuthorityBusy">
                                                <i class="bi bi-slash-circle" aria-hidden="true"></i> Reject
                                            </button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>

                <div class="dfi-panel-card">
                    <h5 style="margin-bottom:8px;"><i class="bi bi-calculator" aria-hidden="true"></i> Legal Authority scoring &amp; channel contributions</h5>
                    @if (model is not null)
                    {
                        <div class="la-formula-grid">
                            <div class="la-formula-chip la-formula-chip--pos">
                                <span class="la-formula-chip-label">Verified support</span>
                                <code>@model.Formula.SupportFormula</code>
                            </div>
                            <div class="la-formula-chip la-formula-chip--pos">
                                <span class="la-formula-chip-label">Qualified support</span>
                                <code>@model.Formula.QualifiedSupportFormula</code>
                            </div>
                            <div class="la-formula-chip la-formula-chip--neg">
                                <span class="la-formula-chip-label">Contradiction</span>
                                <code>@model.Formula.ContradictionFormula</code>
                            </div>
                            <div class="la-formula-chip la-formula-chip--neutral">
                                <span class="la-formula-chip-label">Placement magnitude</span>
                                <code>@model.Formula.PlacementFormula</code>
                            </div>
                        </div>
                    }
                    @if (contributions.Count == 0)
                    {
                        <p class="dfi-panel-sub">No Legal Authority channel contributions have been folded into this matter's latest decision session yet. Once a verified authority is accepted and carries authoritative lineage, its exact &delta; appears here.</p>
                    }
                    else
                    {
                        <table class="table table-sm" style="margin:0;">
                            <thead>
                                <tr>
                                    <th>Relation</th>
                                    <th>Verification</th>
                                    <th>Dimension</th>
                                    <th>Formula applied</th>
                                    <th style="text-align:right;">Applied &delta;</th>
                                    <th>Effect</th>
                                    <th>Source</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in contributions)
                                {
                                    <tr>
                                        <td>@c.Relation</td>
                                        <td>@c.VerificationState</td>
                                        <td>@c.TargetDimension</td>
                                        <td><code>@c.FormulaApplied</code></td>
                                        <td style="text-align:right; font-weight:600; color:@(c.AppliedDelta >= 0 ? "#198754" : "#dc3545")">@c.AppliedDelta.ToString("+0.###;-0.###;0")</td>
                                        <td title="@c.EffectExplanation">@c.Effect</td>
                                        <td>@c.SourceLabel</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="dfi-panel-sub" style="margin-top:6px;">These signed inputs land on the named POLOXI dimension; POLOXI Core alone decides their effect on the final candidate composite score and ranking.</p>
                    }
                </div>
            }
        </div>

@code {
    [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;

    // External lookup link for a citation when no stored reference/URL exists. Reuses the same neutral
    // web-search strategy as the Overview candidate citations so both surfaces stay consistent.
    private static string CitationSearchUrl(string authorityName)
        => LegalPersonalInjuryDecision2.OvCitationSearchUrl(authorityName);

    // Citator validity keyed by authority name (case-insensitive). Loaded on render; absence of data
    // yields the Unknown flag. Advisory only — never blocks the decision workspace.
    private readonly Dictionary<string, AuthorityValidityDto> _validity = new(StringComparer.OrdinalIgnoreCase);
    private string[] _loadedKeys = [];

    private static readonly AuthorityValidityDto UnknownValidity =
        new(string.Empty, "Unknown", "Unknown", "#6c757d", false, 0, []);

    protected override async Task OnParametersSetAsync()
    {
        var names = Owner.DaAuthorities
            .Select(a => a.Name)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToArray();

        // Skip if the authority set is unchanged since the last load.
        if (names.Length == 0 || names.SequenceEqual(_loadedKeys, StringComparer.OrdinalIgnoreCase))
            return;

        try
        {
            var results = await Api.GetCitatorValidityAsync(names);
            _validity.Clear();
            foreach (var r in results)
                _validity[r.AuthorityIdentity] = r;
            _loadedKeys = names;
        }
        catch
        {
            // Citator is advisory; on failure leave authorities as Unknown rather than disrupting the tab.
            _loadedKeys = names;
        }
    }

    private AuthorityValidityDto ValidityFor(string? name)
        => name is not null && _validity.TryGetValue(name, out var v) ? v : UnknownValidity;

    private static string CitatorTooltip(AuthorityValidityDto validity)
    {
        if (validity.TreatmentCount == 0)
            return "No citator treatment data on record for this authority.";

        var parts = validity.Treatments
            .Select(t => $"{t.TreatmentDisplayName}{(string.IsNullOrWhiteSpace(t.CitingAuthorityName) ? "" : $" — {t.CitingAuthorityName}")}");
        return string.Join("\n", parts);
    }

    // ── Inline citator management panel (opened from a validity badge) ──
    private string? _citatorPanelAuthority;
    private bool _citatorPanelLoading;
    private bool _citatorSaving;
    private string? _citatorPanelError;
    private IReadOnlyList<AuthorityTreatmentDto> _citatorPanelTreatments = [];
    private IReadOnlyList<CitationTreatmentCodeDto> _citatorCodes = [];

    private string? _newTreatmentCode;
    private string? _newCitingAuthority;
    private DateTime? _newTreatmentDate = DateTime.Today;

    private async Task OpenCitatorPanel(string authority)
    {
        _citatorPanelAuthority = authority;
        _citatorPanelError = null;
        _newTreatmentCode = null;
        _newCitingAuthority = null;
        _newTreatmentDate = DateTime.Today;
        await RefreshCitatorPanelAsync();
    }

    private void CloseCitatorPanel() => _citatorPanelAuthority = null;

    private async Task RefreshCitatorPanelAsync()
    {
        if (_citatorPanelAuthority is null)
            return;

        _citatorPanelLoading = true;
        try
        {
            if (_citatorCodes.Count == 0)
                _citatorCodes = await Api.GetCitatorTreatmentCodesAsync();

            _citatorPanelTreatments = await Api.ListCitatorTreatmentsAsync(_citatorPanelAuthority);
        }
        catch (Exception ex)
        {
            _citatorPanelError = $"Failed to load treatments: {ex.Message}";
        }
        finally
        {
            _citatorPanelLoading = false;
        }
    }

    private async Task RecordTreatmentAsync()
    {
        if (_citatorPanelAuthority is null || string.IsNullOrWhiteSpace(_newTreatmentCode))
            return;

        _citatorSaving = true;
        _citatorPanelError = null;
        try
        {
            var request = new SaveCitationTreatmentRequest(
                null,
                _citatorPanelAuthority,
                _citatorPanelAuthority,
                _newCitingAuthority,
                null,
                _newTreatmentCode!,
                _newTreatmentDate is { } d ? DateOnly.FromDateTime(d) : null,
                null,
                "Manual",
                null);

            await Api.SaveCitatorTreatmentAsync(request);
            _newTreatmentCode = null;
            _newCitingAuthority = null;
            await RefreshCitatorPanelAsync();
            await ReloadValidityAsync();
        }
        catch (Exception ex)
        {
            _citatorPanelError = $"Save failed: {ex.Message}";
        }
        finally
        {
            _citatorSaving = false;
        }
    }

    private async Task DeleteTreatmentAsync(Guid citationTreatmentId)
    {
        _citatorPanelError = null;
        try
        {
            await Api.DeleteCitatorTreatmentAsync(citationTreatmentId);
            await RefreshCitatorPanelAsync();
            await ReloadValidityAsync();
        }
        catch (Exception ex)
        {
            _citatorPanelError = $"Delete failed: {ex.Message}";
        }
    }

    // Re-pull validity badges after a write so the inline change is reflected immediately.
    private async Task ReloadValidityAsync()
    {
        if (_loadedKeys.Length == 0)
            return;

        try
        {
            var results = await Api.GetCitatorValidityAsync(_loadedKeys);
            _validity.Clear();
            foreach (var r in results)
                _validity[r.AuthorityIdentity] = r;
        }
        catch
        {
            // Advisory; ignore refresh failures.
        }
    }
}
}