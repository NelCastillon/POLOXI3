@namespace Legal.Web.Components.Pages.DecisionTabs
@using Legal.Web.Components.Pages

                                @if (Owner.SurvivingBranches.Count > 0)
                                {
                                    var hxSelected = Owner.DfiSelectedBranch;
                                    <div class="hx-workspace">
                                        @* -- Left · Decision hierarchy tree ------------------------------- *@
                                        <aside class="hx-tree">
                                            <div class="hx-tree-head">
                                                <div class="hx-tree-title">
                                                    <i class="bi bi-diagram-3"></i>
                                                    <span>Decision hierarchy</span>
                                                </div>
                                                <p class="hx-tree-sub">Structured questions to resolve the matter.</p>
                                                <div class="hx-search">
                                                    <i class="bi bi-search"></i>
                                                    <input type="text" placeholder="Search questions or factors…" @bind="Owner._hxSearch" @bind:event="oninput" />
                                                </div>
                                            </div>
                                            <div class="hx-tree-body">
                                                @foreach (var root in Owner.HxRootBranches.Where(Owner.HxRootVisible))
                                                {
                                                    var descendants = Owner.HxDescendants(root);
                                                    var collapsed = Owner._hxCollapsedGroups.Contains(root.WideBranchId);
                                                    <div class="hx-group">
                                                        <button type="button"
                                                                class="hx-group-head @(Owner._dfiSelectedBranchId == root.WideBranchId ? "hx-group-head--active" : "")"
                                                                @onclick="() => Owner.HxSelect(root)">
                                                            <i class="bi bi-chevron-@(collapsed ? "right" : "down") hx-group-caret"
                                                               @onclick:stopPropagation="true"
                                                               @onclick="() => Owner.HxToggleGroup(root.WideBranchId)"></i>
                                                            <span class="hx-node-lvl">L@(root.LevelNumber)</span>
                                                            <span class="hx-node-name">@root.DisplayName</span>
                                                            <span class="hx-node-status hx-node-status--@LegalPersonalInjuryDecision2.HxStatusTone(root)">
                                                                <i class="bi bi-@(LegalPersonalInjuryDecision2.HxComplete(root) ? "check-circle" : "exclamation-circle")"></i>
                                                                @LegalPersonalInjuryDecision2.HxStatusLabel(root)
                                                            </span>
                                                        </button>
                                                        @if (!collapsed)
                                                        {
                                                            <div class="hx-group-children">
                                                                @foreach (var d in descendants)
                                                                {
                                                                    <button type="button"
                                                                            class="hx-node hx-node--l@(Math.Min(d.LevelNumber, 6)) @(Owner._dfiSelectedBranchId == d.WideBranchId ? "hx-node--active" : "")"
                                                                            style="padding-left:@(0.75 + (d.LevelNumber - 2) * 0.9)rem"
                                                                            @onclick="() => Owner.HxSelect(d)">
                                                                        <span class="hx-node-lvl">L@(d.LevelNumber)</span>
                                                                        <span class="hx-node-name">@d.DisplayName</span>
                                                                        <i class="bi bi-chevron-right hx-node-go"></i>
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </aside>

                                        @* -- Center · Selected node detail -------------------------------- *@
                                        <section class="hx-detail">
                                            @if (hxSelected is not null)
                                            {
                                                var children = Owner.HxChildren(hxSelected);
                                                <header class="hx-detail-head">
                                                    <div class="hx-detail-title">
                                                        <span class="hx-node-lvl hx-node-lvl--lg">L@(hxSelected.LevelNumber)</span>
                                                        <div>
                                                            <h3>@hxSelected.DisplayName</h3>
                                                            <p>@hxSelected.Interpretation</p>
                                                        </div>
                                                    </div>
                                                    <span class="hx-node-status hx-node-status--@LegalPersonalInjuryDecision2.HxStatusTone(hxSelected) hx-node-status--pill">
                                                        <i class="bi bi-@(LegalPersonalInjuryDecision2.HxComplete(hxSelected) ? "check-circle" : "exclamation-circle")"></i>
                                                        @LegalPersonalInjuryDecision2.HxStatusLabel(hxSelected)
                                                    </span>
                                                </header>

                                                <nav class="hx-detail-tabs">
                                                    @foreach (var t in LegalPersonalInjuryDecision2.HxDetailTabs)
                                                    {
                                                        var label = t switch
                                                        {
                                                            "Sub-questions" => $"Sub-questions ({children.Count})",
                                                            "Dependencies" => $"Dependencies ({Owner.DfiDependencyCount})",
                                                            "Evidence" => $"Evidence ({hxSelected.EvidenceCount})",
                                                            _ => t
                                                        };
                                                        <button type="button"
                                                                class="hx-detail-tab @(Owner._hxDetailTab == t ? "hx-detail-tab--active" : "")"
                                                                @onclick="() => Owner._hxDetailTab = t">@label</button>
                                                    }
                                                </nav>

                                                <div class="hx-detail-body">
                                                    @switch (Owner._hxDetailTab)
                                                    {
                                                        case "Sub-questions":
                                                            @if (children.Count > 0)
                                                            {
                                                                <div class="hx-subq-list">
                                                                    @foreach (var c in children)
                                                                    {
                                                                        <button type="button" class="hx-subq" @onclick="() => Owner.HxSelect(c)">
                                                                            <span class="hx-node-lvl">L@(c.LevelNumber)</span>
                                                                            <span class="hx-subq-name">@c.DisplayName</span>
                                                                            <span class="hx-node-status hx-node-status--@LegalPersonalInjuryDecision2.HxStatusTone(c)">@LegalPersonalInjuryDecision2.HxStatusLabel(c)</span>
                                                                            <i class="bi bi-chevron-right"></i>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <p class="dfi-empty">No sub-questions branch from this node.</p>
                                                            }
                                                            break;
                                                        case "Dependencies":
                                                            @if (Owner._response?.DecisionInspector?.SharedDependencies.Count > 0)
                                                            {
                                                                <ul class="hx-dep-list">
                                                                    @foreach (var d in Owner._response.DecisionInspector.SharedDependencies.Take(8))
                                                                    {
                                                                        <li>
                                                                            <span class="hx-dep-type">@d.DependencyType</span>
                                                                            <span class="hx-dep-prop">@d.Proposition</span>
                                                                            <span class="dfi-pill dfi-pill-@(d.VerificationState == "VERIFIED" ? "ok" : "warn")">@d.VerificationState</span>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else
                                                            {
                                                                <p class="dfi-empty">No cross-node dependencies mapped for this run.</p>
                                                            }
                                                            break;
                                                        case "Evidence":
                                                            @if (hxSelected.EvidenceCount > 0)
                                                            {
                                                                <div class="hx-callout hx-callout--ok">
                                                                    <i class="bi bi-shield-check"></i>
                                                                    <span>@hxSelected.EvidenceCount source(s) linked to this node · grounding @hxSelected.GroundingStatusCode.</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="hx-callout hx-callout--warn">
                                                                    <i class="bi bi-exclamation-triangle"></i>
                                                                    <span>Source review required — no independently verified evidence admitted for this node.</span>
                                                                </div>
                                                            }
                                                            @if (Owner._response?.ProposedLegalAuthorities.Count > 0)
                                                            {
                                                                <ul class="hx-auth-list">
                                                                    @foreach (var a in Owner._response.ProposedLegalAuthorities.Take(5))
                                                                    {
                                                                        <li><span class="hx-node-lvl">@a.Kind</span> @a.Name <span class="dfi-pill dfi-pill-@(a.VerificationStatus == "VERIFIED" ? "ok" : "muted")">@a.VerificationStatus</span></li>
                                                                    }
                                                                </ul>
                                                            }
                                                            break;
                                                        case "Analysis":
                                                            <div class="hx-analysis">
                                                                <div class="hx-analysis-icon"><i class="bi bi-stars"></i></div>
                                                                <div>
                                                                    <h5>Latest analysis summary</h5>
                                                                    <p>@(string.IsNullOrWhiteSpace(hxSelected.Interpretation) ? "This branch requires validation before its disposition can be compared." : hxSelected.Interpretation)</p>
                                                                    <p class="hx-analysis-meta">Confidence @hxSelected.Confidence.ToString("P0")@(hxSelected.ContinueNarrowing ? " · narrowing" : $" · terminal ({hxSelected.StopReason})").</p>
                                                                </div>
                                                            </div>
                                                            break;
                                                        case "Notes":
                                                            <p class="dfi-empty">Notes for this node will appear here.</p>
                                                            break;
                                                        default:
                                                            <div class="hx-overview">
                                                                <div class="hx-card">
                                                                    <div class="hx-card-head"><i class="bi bi-bullseye"></i> Purpose</div>
                                                                    <p>@hxSelected.Interpretation</p>
                                                                </div>
                                                                <div class="hx-card">
                                                                    <div class="hx-card-head"><i class="bi bi-list-check"></i> Key considerations</div>
                                                                    <ul class="hx-check">
                                                                        <li>Grounding status · @hxSelected.GroundingStatusCode</li>
                                                                        <li>Evidence items · @hxSelected.EvidenceCount</li>
                                                                        <li>Confidence · @hxSelected.Confidence.ToString("P0")</li>
                                                                        <li>@(hxSelected.ContinueNarrowing ? "Still narrowing" : $"Terminal · {hxSelected.StopReason}")</li>
                                                                    </ul>
                                                                </div>
                                                                @if (Owner.FinalRankedCandidates.Count > 0)
                                                                {
                                                                    <div class="hx-card hx-card--wide">
                                                                        <div class="hx-card-head"><i class="bi bi-grid-3x3-gap"></i> Linked candidate outcomes</div>
                                                                        <div class="hx-cand-grid">
                                                                            @for (var ci = 0; ci < Math.Min(3, Owner.FinalRankedCandidates.Count); ci++)
                                                                            {
                                                                                var cand = Owner.FinalRankedCandidates[ci];
                                                                                <div class="hx-cand">
                                                                                    <div class="hx-cand-head"><span class="hx-cand-tag">C@(ci + 1)</span> <span class="dfi-pill dfi-pill-ok">Relevant</span></div>
                                                                                    <div class="hx-cand-name">@cand.DisplayName</div>
                                                                                    <div class="hx-cand-score">@cand.CompositeScore.ToString("P0")</div>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                                @if (children.Count > 0)
                                                                {
                                                                    <div class="hx-card hx-card--wide">
                                                                        <div class="hx-card-head"><i class="bi bi-diagram-2"></i> Related sub-questions (@children.Count)</div>
                                                                        <div class="hx-subq-list">
                                                                            @foreach (var c in children.Take(4))
                                                                            {
                                                                                <button type="button" class="hx-subq" @onclick="() => Owner.HxSelect(c)">
                                                                                    <span class="hx-node-lvl">L@(c.LevelNumber)</span>
                                                                                    <span class="hx-subq-name">@c.DisplayName</span>
                                                                                    <span class="hx-node-status hx-node-status--@LegalPersonalInjuryDecision2.HxStatusTone(c)">@LegalPersonalInjuryDecision2.HxStatusLabel(c)</span>
                                                                                    <i class="bi bi-chevron-right"></i>
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            break;
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="dfi-empty">Select a hierarchy node to inspect its proposition, grounding and linked outcomes.</p>
                                            }
                                        </section>

                                        @* -- Right · Execution status & context rail ---------------------- *@
                                        <aside class="hx-rail">
                                            <div class="hx-rail-card">
                                                <div class="hx-rail-title">Execution status <span class="hx-live"><i class="bi bi-broadcast"></i> Live</span></div>
                                                <ul class="hx-status-list">
                                                    <li><i class="bi bi-cpu"></i> Technical execution <span class="dfi-pill dfi-pill-ok">Completed</span></li>
                                                    <li><i class="bi bi-trophy"></i> Candidate competition <span class="dfi-pill dfi-pill-@(Owner.FinalRankedCandidates.Count > 0 ? "ok" : "warn")">@(Owner.FinalRankedCandidates.Count > 0 ? "Executed" : "Pending")</span></li>
                                                    <li><i class="bi bi-shield-check"></i> Evidence grounding <span class="dfi-pill dfi-pill-@(Owner.TotalEvidenceCount > 0 ? "ok" : "warn")">@Owner.DfiEvidenceCoveragePct.ToString("P0") coverage</span></li>
                                                    <li><i class="bi bi-clipboard-check"></i> Decision readiness <span class="dfi-pill dfi-pill-@Owner.DfiReadinessTone">@Owner.DfiReadinessLabel</span></li>
                                                </ul>
                                            </div>
                                            <div class="hx-rail-card">
                                                <div class="hx-rail-title">Context</div>
                                                <dl class="hx-context">
                                                    <div><dt><i class="bi bi-diagram-3"></i> Legal domain</dt><dd>Personal Injury</dd></div>
                                                    <div><dt><i class="bi bi-geo-alt"></i> Jurisdiction</dt><dd>@Owner.DfiJurisdictionTag</dd></div>
                                                    <div><dt><i class="bi bi-signpost"></i> Matter stage</dt><dd>@Owner.DfiPostureTag</dd></div>
                                                    <div><dt><i class="bi bi-cpu"></i> Model</dt><dd>@(Owner._response?.ModelCodeUsed ?? Owner._selectedModelCode)</dd></div>
                                                    <div><dt><i class="bi bi-lightning-charge"></i> POLOXI Engine</dt><dd>@(Owner._usePoloxiEngine ? "Enabled" : "Disabled")</dd></div>
                                                </dl>
                                            </div>
                                        </aside>
                                    </div>
                                }
                                else
                                {
                                    <div class="dfi-panel-card">
                                        <p class="dfi-empty">No hierarchy branches are available for this run.</p>
                                    </div>
                                }

@code {
    [Parameter] public LegalPersonalInjuryDecision2 Owner { get; set; } = default!;
}