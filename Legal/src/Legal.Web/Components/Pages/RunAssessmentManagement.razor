@page "/legal/runassessment"
@using Legal.Application.Features.Intelligence.RunManagement
@inject NavigationManager Navigation
@inject Legal.Web.Services.ApiClient Api
@rendermode RenderMode.InteractiveServer

<PageTitle>Run History &amp; Assessment Management</PageTitle>

<LegalWorkspace ExtraClass="intel-compact">
    <div class="ram-root">

        @if (_loadError is not null)
        {
            <div class="alert alert-danger ram-alert" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @_loadError
            </div>
        }

        @* ── Breadcrumb ── *@
        <nav class="ram-breadcrumb" aria-label="Breadcrumb">
            <span>@(_page?.MatterTitle ?? "Matter")</span>
            @if (!string.IsNullOrWhiteSpace(_page?.MatterReference))
            {
                <i class="bi bi-chevron-right"></i>
                <span>@_page!.MatterReference</span>
            }
            @if (!string.IsNullOrWhiteSpace(_page?.MatterStage))
            {
                <i class="bi bi-chevron-right"></i>
                <span class="ram-breadcrumb-current">@_page!.MatterStage</span>
            }
        </nav>

        @* ── Page header ── *@
        <header class="ram-header">
            <div class="ram-header-text">
                <h1>Analysis history</h1>
                <p>Every execution. Every input. One published assessment.</p>
            </div>
            <div class="ram-header-actions">
                <a class="ram-btn ram-btn-ghost" href="/legal/matters">
                    <i class="bi bi-folder2-open"></i> Matters
                </a>
                <button type="button" class="ram-btn ram-btn-primary" @onclick="StartNewAnalysis" disabled="@(_page is null)">
                    <i class="bi bi-plus-lg"></i> New analysis
                </button>
            </div>
        </header>

        @if (_loading)
        {
            <div class="ram-loading"><span class="spinner-border"></span> Loading run ledger…</div>
        }
        else if (_page is null)
        {
            <div class="ram-placeholder">
                <i class="bi bi-folder2-open"></i>
                <h2>No matter selected</h2>
                <p>Open a matter to view its run and assessment history.</p>
                <a class="ram-btn ram-btn-primary" href="/legal/matters"><i class="bi bi-folder2-open"></i> Open a matter</a>
            </div>
        }
        else
        {
            @* ── Current assessment banner ── *@
            @if (_page.CurrentAssessment is { } current)
            {
                <section class="ram-current" aria-label="Current assessment">
                    <div class="ram-current-main">
                        <span class="ram-current-label">Current assessment</span>
                        <div class="ram-current-id">@current.AssessmentLabel &middot; Run @current.RunLabel</div>
                        <div class="ram-current-meta">
                            Evaluated @current.PublishedUtc.ToLocalTime().ToString("MMM d, h:mm tt")@(string.IsNullOrWhiteSpace(current.ReviewStateText) ? null : $" · {current.ReviewStateText}")
                        </div>
                    </div>
                    <div class="ram-current-side">
                        @if (!string.IsNullOrWhiteSpace(current.FreshnessNote))
                        {
                            <span class="ram-freshness">@current.FreshnessNote</span>
                        }
                        <button type="button" class="ram-btn ram-btn-primary" @onclick="() => ViewDecision2Results(current.AnalysisRunId)">
                            <i class="bi bi-window-stack"></i> View Original Complete Run
                        </button>
                    </div>
                </section>
            }

            @* ── Primary sub-tabs ── *@
            <nav class="ram-subtabs" role="tablist" aria-label="Run and assessment views">
                @foreach (var tab in _subTabs)
                {
                    <button type="button"
                            role="tab"
                            class="ram-subtab @(tab == _activeSubTab ? "ram-subtab--active" : null)"
                            aria-selected="@(tab == _activeSubTab)"
                            @onclick="() => _activeSubTab = tab">
                        @tab
                    </button>
                }
            </nav>

            @if (_activeSubTab == "Run ledger")
            {
                <div class="ram-grid">

                    @* ── Left: run ledger ── *@
                    <aside class="ram-ledger" aria-label="Run ledger">
                        <div class="ram-ledger-head">
                            <h2>Run ledger</h2>
                            <span class="ram-count">@_page.Runs.Count runs</span>
                        </div>

                        <div class="ram-filter">
                            <label for="ram-exec-status">Execution status</label>
                            <select id="ram-exec-status" class="ram-select" @bind="_statusFilter">
                                <option value="All">All executions</option>
                                <option value="Succeeded">Succeeded</option>
                                <option value="Failed">Failed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        @if (FilteredRuns.Count == 0)
                        {
                            <div class="ram-ledger-empty">
                                <i class="bi bi-clock-history"></i>
                                <p>No runs recorded for this matter yet.</p>
                            </div>
                        }
                        else
                        {
                            <div class="ram-run-list">
                                @foreach (var run in FilteredRuns)
                                {
                                    <button type="button"
                                            class="ram-run-card @(run.AnalysisRunId == _selectedRunId ? "ram-run-card--active" : null)"
                                            @onclick="() => _selectedRunId = run.AnalysisRunId">
                                        <div class="ram-run-card-top">
                                            <span class="ram-run-id">@run.RunLabel</span>
                                            <span class="ram-status ram-status--@run.ExecutionStatusCode.ToLowerInvariant()">@run.ExecutionStatusCode</span>
                                        </div>
                                        <div class="ram-run-title">@run.Title</div>
                                        @if (run.QualityScore is { } q)
                                        {
                                            <div class="ram-run-quality" title="@QualityTooltip(q)">
                                                <span class="ram-quality-badge ram-quality-badge--@q.GradeTone">
                                                    <span class="ram-quality-grade">@q.Grade</span>
                                                    <span class="ram-quality-score">@q.Score</span>
                                                </span>
                                                @if (q.IsBestRun)
                                                {
                                                    <span class="ram-quality-best" title="Highest quality run for this matter"><i class="bi bi-trophy-fill"></i> Best run</span>
                                                }
                                                <span class="ram-quality-headline">@q.Headline</span>
                                            </div>
                                        }
                                        <div class="ram-run-sub">
                                            @run.RequestedUtc.ToLocalTime().ToString("h:mm tt")@(string.IsNullOrWhiteSpace(run.PackLabel) ? null : $" · {run.PackLabel}") &middot; @PublishStateText(run)
                                        </div>
                                    </button>
                                }
                            </div>
                        }

                        <p class="ram-ledger-foot">Execution and publication are separate.</p>
                    </aside>

                    @* ── Right: run detail ── *@
                    <section class="ram-detail" aria-label="Run detail">
                        @if (SelectedRun is { } r)
                        {
                            <div class="ram-detail-head">
                                <div>
                                    <span class="ram-detail-eyebrow">@r.RunLabel &middot; Matter analysis</span>
                                    <h2>@r.Title</h2>
                                </div>
                                <span class="ram-duration">@DurationText(r)</span>
                            </div>

                            <div class="ram-chips">
                                <span class="ram-chip ram-chip--@r.ExecutionStatusCode.ToLowerInvariant()">@r.ExecutionStatusCode</span>
                                <span class="ram-chip">@PublishStateText(r)</span>
                                @if (!string.IsNullOrWhiteSpace(r.PackLabel))
                                {
                                    <span class="ram-chip ram-chip--pack">@r.PackLabel</span>
                                }
                            </div>

                            <div class="ram-detail-meta">
                                <div>
                                    <span class="ram-meta-label">Trigger</span>
                                    <span class="ram-meta-value">@(r.TriggerText ?? r.TriggerTypeCode ?? "—")</span>
                                </div>
                                <div>
                                    <span class="ram-meta-label">Requested</span>
                                    <span class="ram-meta-value">@r.RequestedUtc.ToLocalTime().ToString("MMM d · h:mm tt")</span>
                                </div>
                                <div>
                                    <span class="ram-meta-label">Input snapshot</span>
                                    <span class="ram-meta-value">@(r.InputSnapshotLabel ?? "—")</span>
                                </div>
                            </div>

                            <nav class="ram-inner-tabs" role="tablist" aria-label="Run detail sections">
                                @foreach (var inner in _innerTabs)
                                {
                                    <button type="button"
                                            role="tab"
                                            class="ram-inner-tab @(inner == _activeInnerTab ? "ram-inner-tab--active" : null)"
                                            aria-selected="@(inner == _activeInnerTab)"
                                            @onclick="() => _activeInnerTab = inner">
                                        @inner
                                    </button>
                                }
                            </nav>

                            @if (_activeInnerTab == "Execution")
                            {
                                @if (!string.IsNullOrWhiteSpace(r.ExecutionBanner))
                                {
                                    <div class="ram-banner">@r.ExecutionBanner</div>
                                }

                                @if (r.Steps.Count == 0)
                                {
                                    <div class="ram-inner-empty">
                                        <i class="bi bi-list-check"></i>
                                        <p>No execution steps were recorded for this run.</p>
                                    </div>
                                }
                                else
                                {
                                    <ol class="ram-steps">
                                        @foreach (var step in r.Steps)
                                        {
                                            <li class="ram-step">
                                                <span class="ram-step-marker ram-step-marker--@step.StatusCode.ToLowerInvariant()">
                                                    @switch (step.StatusCode)
                                                    {
                                                        case "Completed":
                                                            <i class="bi bi-check"></i>
                                                            break;
                                                        case "Failed":
                                                            <i class="bi bi-exclamation"></i>
                                                            break;
                                                        default:
                                                            @step.Sequence
                                                            break;
                                                    }
                                                </span>
                                                <div class="ram-step-body">
                                                    <div class="ram-step-name">@step.DisplayName</div>
                                                    <div class="ram-step-desc">@step.Description</div>
                                                    @if (step.Attempts.Count > 0)
                                                    {
                                                        <div class="ram-step-attempts">
                                                            @foreach (var attempt in step.Attempts)
                                                            {
                                                                <span class="ram-attempt">@attempt.DisplayText</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                <span class="ram-step-state ram-step-state--@step.StatusCode.ToLowerInvariant()">
                                                    @(step.StatusLabel ?? step.StatusCode)
                                                </span>
                                            </li>
                                        }
                                    </ol>
                                }
                            }
                            else if (_activeInnerTab == "Input snapshot")
                            {
                                @if (r.InputSnapshot is null)
                                {
                                    <div class="ram-inner-empty">
                                        <i class="bi bi-archive"></i>
                                        <p>No input snapshot was recorded for this run.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="ram-snapshot">
                                        <div class="ram-snapshot-head">
                                            <span class="ram-snapshot-label">@r.InputSnapshot.SnapshotLabel</span>
                                            <span class="ram-snapshot-captured">Sealed @r.InputSnapshot.CapturedUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                                        </div>
                                        <dl class="ram-snapshot-grid">
                                            <dt>Query</dt>
                                            <dd>@(string.IsNullOrWhiteSpace(r.InputSnapshot.Query) ? "—" : r.InputSnapshot.Query)</dd>
                                            <dt>Context</dt>
                                            <dd>@(r.InputSnapshot.ContextCode ?? "—")</dd>
                                            <dt>Mode</dt>
                                            <dd>@(r.InputSnapshot.ModeCode ?? "—")</dd>
                                            <dt>Model</dt>
                                            <dd>@(r.InputSnapshot.ModelCode ?? "Auto")</dd>
                                            <dt>Domain Pack</dt>
                                            <dd>@(r.InputSnapshot.DomainPackCode ?? "Original")</dd>
                                            <dt>Discovery mode</dt>
                                            <dd>@(r.InputSnapshot.DiscoveryModeCode ?? "—")</dd>
                                            <dt>Jurisdiction</dt>
                                            <dd>@(r.InputSnapshot.Jurisdiction ?? "—")</dd>
                                            <dt>Governing law</dt>
                                            <dd>@(r.InputSnapshot.GoverningLaw ?? "—")</dd>
                                            <dt>Court / forum</dt>
                                            <dd>@(r.InputSnapshot.CourtOrForum ?? "—")</dd>
                                            <dt>Posture</dt>
                                            <dd>@(r.InputSnapshot.Posture ?? "—")</dd>
                                            <dt>Motion target</dt>
                                            <dd>@(r.InputSnapshot.MotionTarget ?? "—")</dd>
                                            @if (!string.IsNullOrWhiteSpace(r.InputSnapshot.CounterfactualAssumption))
                                            {
                                                <dt>Counterfactual</dt>
                                                <dd>@r.InputSnapshot.CounterfactualAssumption</dd>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.InputSnapshot.ClarificationAnswer))
                                            {
                                                <dt>Clarification answer</dt>
                                                <dd>@r.InputSnapshot.ClarificationAnswer</dd>
                                            }
                                            <dt>POLOXI engine</dt>
                                            <dd>@(r.InputSnapshot.UsedDependencyGraph == true ? "Enabled" : "Disabled")</dd>
                                        </dl>
                                        <p class="ram-snapshot-note">Reproduced verbatim from the sealed input snapshot &mdash; not recomputed from current matter configuration.</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="ram-inner-empty">
                                    <i class="bi bi-archive"></i>
                                    <p>@_activeInnerTab content is restored from the run's sealed snapshot.</p>
                                </div>
                            }

                            <footer class="ram-detail-foot">
                                <span class="ram-detail-foot-note">@(r.FooterNote ?? "Execution and publication are separate.")</span>
                                <div class="ram-detail-foot-actions">
                                    <button type="button" class="ram-btn ram-btn-ghost" @onclick="() => OpenSavedCockpit(r.AnalysisRunId)">
                                        Open saved cockpit
                                    </button>
                                    <button type="button" class="ram-btn ram-btn-outline" @onclick="() => RerunWithCurrentInputs(r.AnalysisRunId)">
                                        Rerun with current inputs
                                    </button>
                                    <button type="button" class="ram-btn ram-btn-danger" @onclick="() => RequestDeleteRun(r)">
                                        <i class="bi bi-trash"></i> Delete history
                                    </button>
                                </div>
                            </footer>
                        }
                        else
                        {
                            <div class="ram-inner-empty">
                                <i class="bi bi-clock-history"></i>
                                <p>Select a run from the ledger to inspect its execution.</p>
                            </div>
                        }
                    </section>
                </div>
            }
            else if (_activeSubTab == "Saved cockpit")
            {
                <section class="ram-tabview" aria-label="Saved cockpit">
                    <div class="ram-tabview-head">
                        <div>
                            <h2><i class="bi bi-window-stack"></i> Saved cockpit</h2>
                            <p>Reopen the retained presentation snapshot for a published run exactly as it was evaluated &mdash; reproduced from sealed records, not recomputed from current data.</p>
                        </div>
                    </div>
                    @if (_page.CurrentAssessment is { } savedCurrent)
                    {
                        <div class="ram-tabview-card">
                            <div class="ram-tabview-card-main">
                                <span class="ram-current-label">Current assessment</span>
                                <div class="ram-current-id">@savedCurrent.AssessmentLabel &middot; Run @savedCurrent.RunLabel</div>
                                <div class="ram-current-meta">Evaluated @savedCurrent.PublishedUtc.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                            </div>
                            <button type="button" class="ram-btn ram-btn-primary" @onclick="() => OpenSavedCockpit(savedCurrent.AnalysisRunId)">
                                <i class="bi bi-box-arrow-up-right"></i> Open saved cockpit
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="ram-inner-empty">
                            <i class="bi bi-window-stack"></i>
                            <p>No assessment has been published for this matter yet. Publish a run from the ledger to retain a cockpit snapshot.</p>
                        </div>
                    }
                    @if (_page.Runs.Count > 0)
                    {
                        <h3 class="ram-tabview-subhead">Published runs</h3>
                        <div class="ram-tabview-list">
                            @foreach (var run in _page.Runs.Where(r => r.PublicationStatusCode is "Published" or "Historical" or "Stale"))
                            {
                                <div class="ram-tabview-row">
                                    <div>
                                        <span class="ram-run-id">@run.RunLabel</span>
                                        <span class="ram-run-title">@run.Title</span>
                                    </div>
                                    <div class="ram-tabview-row-actions">
                                        <span class="ram-chip">@PublishStateText(run)</span>
                                        <button type="button" class="ram-btn ram-btn-ghost" @onclick="() => OpenSavedCockpit(run.AnalysisRunId)">Open</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
            else if (_activeSubTab == "Change impact")
            {
                <section class="ram-tabview" aria-label="Change impact">
                    <div class="ram-tabview-head">
                        <div>
                            <h2><i class="bi bi-shield-check"></i> Change impact</h2>
                            <p>When new evidence arrives, the historical decision is preserved while reliance today is tracked separately. Review whether a published conclusion is still supported by the matter's current evidence.</p>
                        </div>
                        <a class="ram-btn ram-btn-primary" href="@($"/legal/decision/change-review/{_page.MatterId}")">
                            <i class="bi bi-box-arrow-up-right"></i> Open change review
                        </a>
                    </div>
                    @if (_page.CurrentAssessment is { FreshnessNote: { Length: > 0 } note } ciCurrent)
                    {
                        <div class="ram-tabview-card">
                            <div class="ram-tabview-card-main">
                                <span class="ram-current-label">@ciCurrent.AssessmentLabel &middot; Run @ciCurrent.RunLabel</span>
                                <div class="ram-current-meta">@note</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ram-inner-empty">
                            <i class="bi bi-shield-check"></i>
                            <p>No change activity detected against the current assessment. Open change review for the full reliance timeline.</p>
                        </div>
                    }
                </section>
            }
            else if (_activeSubTab == "Assessment comparison")
            {
                <section class="ram-tabview" aria-label="Assessment comparison">
                    <div class="ram-tabview-head">
                        <div>
                            <h2><i class="bi bi-layout-split"></i> Assessment comparison</h2>
                            <p>Compare runs side by side to see how inputs, execution, and outcomes diverged across executions of this matter.</p>
                        </div>
                    </div>
                    @if (_page.Runs.Count < 2)
                    {
                        <div class="ram-inner-empty">
                            <i class="bi bi-layout-split"></i>
                            <p>At least two runs are required to compare. This matter has @_page.Runs.Count run@(_page.Runs.Count == 1 ? null : "s") recorded.</p>
                        </div>
                    }
                    else
                    {
                        <table class="ram-compare-table">
                            <thead>
                                <tr>
                                    <th>Run</th>
                                    <th>Quality</th>
                                    <th>Status</th>
                                    <th>Publication</th>
                                    <th>Input snapshot</th>
                                    <th>Requested</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var run in _page.Runs)
                                {
                                    <tr>
                                        <td><span class="ram-run-id">@run.RunLabel</span> @run.Title</td>
                                        <td>
                                            @if (run.QualityScore is { } q)
                                            {
                                                <span class="ram-quality-badge ram-quality-badge--@q.GradeTone" title="@QualityTooltip(q)">
                                                    <span class="ram-quality-grade">@q.Grade</span>
                                                    <span class="ram-quality-score">@q.Score</span>
                                                </span>
                                                @if (q.IsBestRun)
                                                {
                                                    <span class="ram-quality-best" title="Highest quality run for this matter"><i class="bi bi-trophy-fill"></i></span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="ram-quality-headline">Not scored</span>
                                            }
                                        </td>
                                        <td><span class="ram-chip ram-chip--@run.ExecutionStatusCode.ToLowerInvariant()">@run.ExecutionStatusCode</span></td>
                                        <td>@PublishStateText(run)</td>
                                        <td>@(run.InputSnapshotLabel ?? "—")</td>
                                        <td>@run.RequestedUtc.ToLocalTime().ToString("MMM d · h:mm tt")</td>
                                        <td>@DurationText(run)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            }
            else if (_activeSubTab == "Contract drafting")
            {
                <DecisionContractWorkspace MatterId="_page.MatterId" />
            }
            else
            {
                <div class="ram-placeholder">
                    <i class="bi bi-layers"></i>
                    <h2>@_activeSubTab</h2>
                    <p>This view reads retained snapshots for the selected matter. Historical content is reproduced from sealed records &mdash; not recomputed from current data.</p>
                </div>
            }
        }
    </div>

    @if (_pendingDeleteRun is { } del)
    {
        <div class="ram-modal-backdrop" @onclick="CancelDeleteRun">
            <div class="ram-confirm-dialog" @onclick:stopPropagation="true">
                <div class="ram-confirm-icon ram-confirm-icon--danger">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h3 class="ram-confirm-title">Delete analysis history?</h3>
                <p class="ram-confirm-text">
                    This permanently removes the run <strong>@del.RunLabel</strong>@(string.IsNullOrWhiteSpace(del.Title) ? null : $" — {del.Title}") and its saved analysis from this matter's history. This action cannot be undone.
                </p>
                @if (!string.IsNullOrWhiteSpace(_deleteError))
                {
                    <div class="alert alert-danger ram-alert" role="alert" style="border-left: 4px solid #dc3545;">
                        <i class="bi bi-exclamation-triangle"></i> @_deleteError
                    </div>
                }
                <div class="ram-confirm-footer">
                    <button type="button" class="ram-btn ram-btn-ghost" @onclick="CancelDeleteRun" disabled="@_deleting">Cancel</button>
                    <button type="button" class="ram-btn ram-btn-danger" @onclick="ConfirmDeleteRun" disabled="@_deleting">
                        @if (_deleting)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-trash"></i>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    }
</LegalWorkspace>

@code {
    [SupplyParameterFromQuery(Name = "matterId")]
    public Guid? MatterId { get; set; }

    private bool _loading = true;
    private string? _loadError;
    private RunAssessmentPageDto? _page;

    private readonly string[] _subTabs =
    {
        "Run ledger", "Saved cockpit", "Change impact", "Assessment comparison", "Contract drafting"
    };
    private string _activeSubTab = "Run ledger";

    private readonly string[] _innerTabs =
    {
        "Execution", "Input snapshot", "Assessment", "Artifacts", "Audit"
    };
    private string _activeInnerTab = "Execution";

    private string _statusFilter = "All";
    private Guid? _selectedRunId;

    private AnalysisRunDto? _pendingDeleteRun;
    private bool _deleting;
    private string? _deleteError;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var matterId = MatterId;
            if (matterId is null)
            {
                // Default to the most recently touched matter when none is supplied.
                var matters = await Api.GetLegalDecisionMattersAsync();
                matterId = matters
                    .OrderByDescending(m => m.ModifiedDateUtc ?? m.CreatedDateUtc)
                    .Select(m => (Guid?)m.DecisionMatterId)
                    .FirstOrDefault();
            }

            if (matterId is null)
            {
                _page = null;
                return;
            }

            _page = await Api.GetLegalRunAssessmentPageAsync(matterId.Value);

            if (_page is not null && _selectedRunId is null)
                _selectedRunId = _page.CurrentAssessment?.AnalysisRunId ?? _page.Runs.FirstOrDefault()?.AnalysisRunId;
        }
        catch (Exception ex)
        {
            _loadError = $"Unable to load run history: {ex.Message}";
            _page = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<AnalysisRunDto> FilteredRuns =>
        _page is null
            ? []
            : (_statusFilter == "All"
                ? _page.Runs
                : _page.Runs.Where(r => string.Equals(r.ExecutionStatusCode, _statusFilter, StringComparison.OrdinalIgnoreCase)).ToList());

    private AnalysisRunDto? SelectedRun =>
        _page?.Runs.FirstOrDefault(r => r.AnalysisRunId == _selectedRunId);

    private static string PublishStateText(AnalysisRunDto run) => run.PublicationStatusCode switch
    {
        "Published" => "Published",
        "Stale" => "Stale",
        "Historical" => "Historical",
        "NotPublished" => "Not published",
        _ => run.PublicationStatusCode
    };

    private static string QualityTooltip(RunQualityScoreDto q) =>
        $"Quality {q.Score}/100 (Grade {q.Grade})\n" +
        string.Join("\n", q.Dimensions.Select(d => $"• {d.Label}: {d.Percent}% — {d.Detail}"));

    private static string DurationText(AnalysisRunDto run)
    {
        if (run.DurationSeconds is not int seconds)
            return "—";
        if (seconds < 60)
            return $"{seconds} sec";
        var span = TimeSpan.FromSeconds(seconds);
        return span.Seconds == 0 ? $"{span.Minutes} min" : $"{span.Minutes} min {span.Seconds:00} sec";
    }

    // Open the matter's decision cockpit to configure inputs and launch a fresh analysis.
    private void StartNewAnalysis()
