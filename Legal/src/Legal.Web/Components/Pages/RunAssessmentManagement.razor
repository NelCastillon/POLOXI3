            new List<RunStep>
            {
                new("1", "Information intake", "Source versions registered and anchored.", "Completed", "Completed", new()),
                new("2", "Decision discovery", "Candidate outcomes and shared hierarchy proposed.", "Completed", "Completed", new()),
                new("3", "Evidence verification", "Sources verified and anchored.", "Completed", "Completed", new()),
                new("4", "LPI integration", "Accepted propositions integrated with lineage.", "Completed", "Completed", new()),
                new("5", "POLOXI evaluation", "Candidate competition evaluated and published.", "Completed", "Completed", new()),
            }),
