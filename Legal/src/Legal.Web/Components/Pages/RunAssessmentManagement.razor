    private IEnumerable<RunLedgerItem> FilteredRuns =>
        _statusFilter == "All" ? _runs : _runs.Where(r => r.Status == _statusFilter);

    private RunLedgerItem? SelectedRun =>
        _runs.FirstOrDefault(r => r.RunId == _selectedRunId);

    private void StartNewAnalysis() { /* Phase 1: wires to run coordinator when backend is available. */ }
    private void ViewRun(string runId) => _selectedRunId = runId;
    private void OpenSavedCockpit(string runId) { /* Opens retained presentation snapshot. */ }
    private void RerunWithCurrentInputs(string runId) { /* Creates a linked run with a fresh input snapshot. */ }

    private sealed record MatterContext(string Caption, string Reference, string Stage);

    private sealed record CurrentAssessment(
        string AssessmentId, string RunId, string EvaluatedOn, string ReviewState, string FreshnessNote);

    private sealed record RunLedgerItem(
        string RunId, string Title, string Time, string Pack, string PublishState, string Status,
        string Duration, string Trigger, string Requested, string InputSnapshot,
        string ExecutionBanner, string FooterNote, List<RunStep> Steps);

    private sealed record RunStep(
        string Order, string Name, string Description, string State, string StateLabel, List<string> Attempts);
}
