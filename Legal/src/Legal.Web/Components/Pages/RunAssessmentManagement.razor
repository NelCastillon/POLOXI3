    // Open the delete-history confirmation for the selected run.
    private void RequestDeleteRun(AnalysisRunDto run)
    {
        _deleteError = null;
        _pendingDeleteRun = run;
    }

    // Dismiss the delete-history confirmation without deleting.
    private void CancelDeleteRun()
    {
        if (_deleting)
            return;
        _pendingDeleteRun = null;
        _deleteError = null;
    }

    // Soft-delete the confirmed run and its history, then refresh the ledger.
    private async Task ConfirmDeleteRun()
    {
        if (_pendingDeleteRun is not { } run || _deleting)
            return;

        _deleting = true;
        _deleteError = null;
        try
        {
            await Api.DeleteLegalRunAsync(run.AnalysisRunId);

            if (_selectedRunId == run.AnalysisRunId)
                _selectedRunId = null;

            _pendingDeleteRun = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _deleteError = $"Delete failed: {ex.Message}";
        }
        finally
        {
            _deleting = false;
        }
    }
}
