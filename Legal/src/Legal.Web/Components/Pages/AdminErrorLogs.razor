@page "/admin/errorlogs"
@using Legal.Application.Abstractions.Services
@inject ApiClient Api

<LegalWorkspace>
<div class="intel-page">
    <header class="intel-header">
        <div>
            <span>Administration · Diagnostics</span>
            <h1>Error Logs</h1>
            <p>Detailed error messages and full stack traces captured across every module of the pipeline. Data is read-only and scoped to your organization.</p>
        </div>
        <div class="um-header-actions">
            <select class="um-input" @bind="_days" @bind:after="LoadAsync">
                <option value="1">Last 24 hours</option>
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
            </select>
            <select class="um-input" @bind="_severity" @bind:after="LoadAsync">
                <option value="">All severities</option>
                <option value="Critical">Critical</option>
                <option value="Error">Error</option>
                <option value="Warning">Warning</option>
            </select>
            <input class="um-input" placeholder="Search message / type / module…" @bind="_search" @bind:after="LoadAsync" />
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_error</div>
    }

    <section class="intel-kpis">
        <article class="intel-kpi-link @(_moduleFilter is null ? "intel-kpi-active" : null)" role="button" tabindex="0"
                 title="Show all logged errors" @onclick="() => SetModule(null)">
            <span>Total errors</span><strong>@_items.Count</strong>
        </article>
        <article class="intel-kpi-link" role="button" tabindex="0"
                 title="Critical severity only" @onclick='() => SetSeverity("Critical")'>
            <span>Critical</span><strong>@_items.Count(i => string.Equals(i.SeverityCode, "Critical", StringComparison.OrdinalIgnoreCase))</strong>
        </article>
        <article class="intel-kpi-link" role="button" tabindex="0"
                 title="Distinct modules with errors" @onclick="() => SetModule(null)">
            <span>Modules affected</span><strong>@_items.Select(i => i.Module).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong>
        </article>
    </section>

    @if (_loading)
    {
        <div class="intel-state">Loading error logs…</div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="intel-state">No errors logged in this window.</div>
    }
    else
    {
        <section class="intel-panel">
            <table class="um-table">
                <thead>
                    <tr><th>When (UTC)</th><th>Severity</th><th>Module</th><th>Operation</th><th>Type</th><th>Message</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var item in _filtered)
                    {
                        <tr @onclick="() => Select(item)" style="cursor:pointer;">
                            <td>@item.CreatedDateUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="um-badge @SeverityClass(item.SeverityCode)">@item.SeverityCode</span></td>
                            <td>@item.Module</td>
                            <td>@Display(item.Operation)</td>
                            <td>@Display(item.ExceptionType)</td>
                            <td class="um-truncate" title="@item.Message">@item.Message</td>
                            <td><button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => Select(item)" @onclick:stopPropagation="true"><i class="bi bi-eye"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
</div>

@if (_selected is not null)
{
    <div class="um-modal-backdrop" @onclick="() => _selected = null">
        <div class="um-modal um-modal-lg" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-exclamation-octagon"></i>
                <span>@_selected.Module · @Display(_selected.Operation)</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _selected = null"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body">
                <dl class="um-detail-grid">
                    <dt>When (UTC)</dt><dd>@_selected.CreatedDateUtc.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                    <dt>Severity</dt><dd><span class="um-badge @SeverityClass(_selected.SeverityCode)">@_selected.SeverityCode</span></dd>
                    <dt>Exception type</dt><dd>@Display(_selected.ExceptionType)</dd>
                    <dt>Source</dt><dd>@Display(_selected.Source)</dd>
                    <dt>Correlation id</dt><dd>@Display(_selected.CorrelationId)</dd>
                    <dt>Tenant</dt><dd>@(_selected.TenantId?.ToString() ?? "— (global)")</dd>
                </dl>
                <h4>Message</h4>
                <pre class="um-code-block">@_selected.Message</pre>
                @if (!string.IsNullOrWhiteSpace(_selected.StackTrace))
                {
                    <h4>Stack trace</h4>
                    <pre class="um-code-block">@_selected.StackTrace</pre>
                }
                @if (!string.IsNullOrWhiteSpace(_selected.ContextJson))
                {
                    <h4>Context</h4>
                    <pre class="um-code-block">@_selected.ContextJson</pre>
                }
            </div>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _selected = null">Close</button>
            </div>
        </div>
    </div>
}
</LegalWorkspace>

@code {
    private const string Dash = "—";

    private int _days = 7;
    private string _severity = string.Empty;
    private string _search = string.Empty;
    private string? _moduleFilter;
    private bool _loading;
    private string? _error;

    private IReadOnlyList<ErrorLogListItem> _items = [];
    private ErrorLogListItem? _selected;

    private List<ErrorLogListItem> _filtered =>
        _moduleFilter is null
            ? _items.ToList()
            : _items.Where(i => string.Equals(i.Module, _moduleFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Api.GetErrorLogsAsync(
                _days,
                take: 500,
                module: null,
                severity: string.IsNullOrWhiteSpace(_severity) ? null : _severity,
                search: string.IsNullOrWhiteSpace(_search) ? null : _search);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load error logs: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetModule(string? module) => _moduleFilter = module;

    private async Task SetSeverity(string severity)
    {
        _severity = severity;
        await LoadAsync();
    }

    private void Select(ErrorLogListItem item) => _selected = item;

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? Dash : value;

    private static string SeverityClass(string severity) => severity?.ToLowerInvariant() switch
    {
        "critical" => "um-badge-danger",
        "error" => "um-badge-danger",
        "warning" => "um-badge-warning",
        _ => "um-badge-neutral"
    };
}
