@page "/legal/chatjudz"
@using Legal.Application.Features.Intelligence
@using Legal.Web.Services
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode RenderMode.InteractiveServer
@implements IAsyncDisposable

<PageTitle>Chat Judz</PageTitle>

<LegalWorkspace ExtraClass="intel-compact">
    <div class="cj-root">
        <header class="cj-hero">
            <div class="cj-hero-badge" aria-hidden="true"><i class="bi bi-stars"></i></div>
            <div class="cj-hero-text">
                <span class="cj-hero-eyebrow">Enterprise assistant · Default LLM</span>
                <h1>Chat Judz</h1>
                <p>Your firm's premium AI legal copilot — ask about case strategy, drafting, research framing, or workflow. Answers are advisory and require attorney review.</p>
            </div>
            <a class="cj-hero-back" href="@BackHref">
                <i class="bi bi-arrow-left-short" aria-hidden="true"></i> Back to Decision
            </a>
        </header>

        <div class="cj-body">
            <aside class="cj-history" aria-label="Conversation history">
                <div class="cj-history-head">
                    <span><i class="bi bi-clock-history" aria-hidden="true"></i> History</span>
                    <button type="button" class="cj-history-new" @onclick="StartNewChat" disabled="@_sending" title="New chat">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="cj-history-list">
                    @if (_loadingHistory)
                    {
                        <div class="cj-history-empty"><span class="spinner-border spinner-border-sm"></span> Loading…</div>
                    }
                    else if (_conversations.Count == 0)
                    {
                        <div class="cj-history-empty">No conversations yet.</div>
                    }
                    else
                    {
                        @foreach (var convo in _conversations)
                        {
                            <button type="button"
                                    class="cj-history-item @(convo.ConversationId == _conversationId ? "cj-history-item--active" : "")"
                                    @onclick="() => OpenConversationAsync(convo.ConversationId)"
                                    disabled="@_sending">
                                <span class="cj-history-avatar" aria-hidden="true">
                                    <i class="bi bi-chat-square-text"></i>
                                </span>
                                <span class="cj-history-body">
                                    <span class="cj-history-title">@convo.Title</span>
                                    @if (!string.IsNullOrWhiteSpace(convo.Preview))
                                    {
                                        <span class="cj-history-preview"><i class="bi bi-reply-fill" aria-hidden="true"></i>@convo.Preview</span>
                                    }
                                    <span class="cj-history-meta">
                                        <span class="cj-history-chip" title="Messages in this conversation"><i class="bi bi-chat-dots" aria-hidden="true"></i>@convo.MessageCount</span>
                                        @if (convo.MatterId is not null)
                                        {
                                            <span class="cj-history-chip cj-history-chip--matter" title="Linked to a matter"><i class="bi bi-folder2-open" aria-hidden="true"></i>Matter</span>
                                        }
                                        <time class="cj-history-time" title="@convo.LastActivityUtc.ToLocalTime().ToString("f")">@RelativeTime(convo.LastActivityUtc)</time>
                                    </span>
                                </span>
                                <span class="cj-history-del" title="Delete conversation" @onclick:stopPropagation="true" @onclick="() => RequestDelete(convo.ConversationId)">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </span>
                            </button>
                        }
                    }
                </div>

                <div class="cj-history-head cj-history-head--sub">
                    <span><i class="bi bi-journal-bookmark" aria-hidden="true"></i> Citation history</span>
                    <button type="button" class="cj-history-new" @onclick="LoadCitationHistoryAsync" disabled="@_loadingCitations" title="Refresh citation history">
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="cj-history-list">
                    @if (_loadingCitations)
                    {
                        <div class="cj-history-empty"><span class="spinner-border spinner-border-sm"></span> Loading…</div>
                    }
                    else if (_citationBatches.Count == 0)
                    {
                        <div class="cj-history-empty">No citation results yet.</div>
                    }
                    else
                    {
                        @foreach (var batch in _citationBatches)
                        {
                            <button type="button"
                                    class="cj-history-item"
                                    @onclick="() => OpenCitationBatchAsync(batch.CitationBatchId)"
                                    disabled="@_loadingCitationBatch">
                                <span class="cj-history-avatar cj-history-avatar--cite" aria-hidden="true">
                                    <i class="bi bi-journal-bookmark-fill"></i>
                                </span>
                                <span class="cj-history-body">
                                    <span class="cj-history-title">@batch.Title</span>
                                    <span class="cj-history-meta">
                                        <span class="cj-history-chip" title="Verified citation passages"><i class="bi bi-quote" aria-hidden="true"></i>@batch.PassageCount cite@(batch.PassageCount == 1 ? "" : "s")</span>
                                        <span class="cj-history-chip" title="Interpretation branches"><i class="bi bi-diagram-3" aria-hidden="true"></i>@batch.BranchCount branch@(batch.BranchCount == 1 ? "" : "es")</span>
                                        <time class="cj-history-time" title="@batch.CreatedDateUtc.ToLocalTime().ToString("f")">@RelativeTime(batch.CreatedDateUtc)</time>
                                    </span>
                                </span>
                            </button>
                        }
                    }
                </div>
            </aside>

        <section class="cj-panel" aria-label="Conversation">
            <div class="cj-toolbar">
                <div class="cj-toolbar-info">
                    <span class="cj-model-badge" title="Model that answered the latest turn">
                        <i class="bi bi-cpu" aria-hidden="true"></i>
                        @(string.IsNullOrWhiteSpace(_modelCode) ? "Default LLM" : _modelCode)
                    </span>
                    @if (_messages.Count > 0)
                    {
                        <span class="cj-turn-count">@_messages.Count message@(_messages.Count == 1 ? "" : "s")</span>
                    }
                </div>
                <div class="cj-toolbar-actions">
                    <label class="cj-model-select" title="Model used for new messages">
                        <i class="bi bi-sliders" aria-hidden="true"></i>
                        <select @bind="_selectedModel" @bind:after="OnModelChangedAsync" disabled="@_sending">
                            <option value="">Default LLM</option>
                            @foreach (var model in _models)
                            {
                                <option value="@model.ModelCode">@model.DeploymentName</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="cj-tool-btn" @onclick="StartNewChat" disabled="@(_messages.Count == 0 || _sending)" title="Start a new conversation">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> New chat
                    </button>
                </div>
            </div>

            <div class="cj-thread" id="cj-thread" @ref="_threadRef">
                @if (_messages.Count == 0)
                {
                    <div class="cj-empty">
                        <div class="cj-empty-emblem" aria-hidden="true"><i class="bi bi-chat-dots"></i></div>
                        <h2>How can Judz help today?</h2>
                        <p>Start a conversation or pick a prompt to get going.</p>
                        <div class="cj-suggestions">
                            @foreach (var suggestion in _suggestions)
                            {
                                <button type="button" class="cj-chip" @onclick="() => UseSuggestion(suggestion)" disabled="@_sending">
                                    <i class="bi bi-lightning-charge" aria-hidden="true"></i> @suggestion
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var message in _messages)
                    {
                        <div class="cj-msg @(message.Role == "assistant" ? "cj-msg--bot" : "cj-msg--user")">
                            <div class="cj-msg-avatar" aria-hidden="true">
                                <i class="bi @(message.Role == "assistant" ? "bi-stars" : "bi-person")"></i>
                            </div>
                            <div class="cj-msg-bubble">
                                <div class="cj-msg-head">
                                    <span class="cj-msg-author">@(message.Role == "assistant" ? "Judz" : "You")</span>
                                    <span class="cj-msg-time">@message.TimestampUtc.ToLocalTime().ToString("t")</span>
                                </div>
                                <div class="cj-msg-body">@message.Content</div>
                                @if (message.Role == "assistant")
                                {
                                    <button type="button" class="cj-copy" title="Copy reply" @onclick="() => CopyAsync(message.Content)">
                                        <i class="bi bi-clipboard" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (_sending)
                    {
                        <div class="cj-msg cj-msg--bot">
                            <div class="cj-msg-avatar" aria-hidden="true"><i class="bi bi-stars"></i></div>
                            <div class="cj-msg-bubble">
                                <span class="cj-msg-author">Judz</span>
                                <div class="cj-typing" aria-label="Judz is typing">
                                    <span></span><span></span><span></span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="cj-error" role="alert">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <span>@_error</span>
                    @if (_canRetry)
                    {
                        <button type="button" class="cj-retry" @onclick="RetryAsync" disabled="@_sending">
                            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Retry
                        </button>
                    }
                </div>
            }

            <form class="cj-composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
                <textarea class="cj-input"
                          @ref="_inputRef"
                          @bind="_draft"
                          @bind:event="oninput"
                          @bind:after="OnDraftInput"
                          @onkeydown="OnKeyDown"
                          placeholder="Ask Judz anything about your case…"
                          rows="1"
                          disabled="@_sending"></textarea>
                <button type="submit" class="cj-send" disabled="@(_sending || string.IsNullOrWhiteSpace(_draft))" title="Send">
                    @if (_sending)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-send-fill" aria-hidden="true"></i>
                    }
                </button>
                @if (_sending)
                {
                    <button type="button" class="cj-cancel" @onclick="CancelSend" title="Stop generating">
                        <i class="bi bi-stop-fill" aria-hidden="true"></i>
                        <span>Stop</span>
                    </button>
                }
            </form>
            <p class="cj-disclaimer">Judz can make mistakes. Verify important legal information. Responses are advisory and require attorney review.</p>
        </section>
        </div>

    @if (_pendingDeleteId is not null)
    {
        <div class="cj-confirm-overlay" role="dialog" aria-modal="true" aria-label="Delete conversation">
            <div class="cj-confirm">
                <div class="cj-confirm-icon"><i class="bi bi-trash3" aria-hidden="true"></i></div>
                <h3>Delete this conversation?</h3>
                <p>This permanently removes the conversation from your history. This action cannot be undone.</p>
                <div class="cj-confirm-actions">
                    <button type="button" class="cj-tool-btn" @onclick="() => _pendingDeleteId = null">Cancel</button>
                    <button type="button" class="cj-confirm-danger" @onclick="ConfirmDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    }

    @if (_openBatch is not null)
    {
        <div class="cj-confirm-overlay" role="dialog" aria-modal="true" aria-label="Citation result">
            <div class="cj-citation-modal">
                <div class="cj-citation-head">
                    <div>
                        <span class="cj-citation-eyebrow"><i class="bi bi-journal-bookmark" aria-hidden="true"></i> Citation result</span>
                        <h3>@(string.IsNullOrWhiteSpace(_openBatch.Title) ? "Citation result" : _openBatch.Title)</h3>
                        <span class="cj-citation-when">@_openBatch.CreatedDateUtc.ToLocalTime().ToString("f")</span>
                    </div>
                    <button type="button" class="cj-tool-btn" @onclick="() => _openBatch = null" title="Close"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="cj-citation-body">
                    @foreach (var branchGroup in _openBatch.Passages.GroupBy(p => p.BranchDisplayName))
                    {
                        <div class="cj-citation-branch">
                            <div class="cj-citation-branch-head">
                                <span class="cj-citation-branch-name">@(string.IsNullOrWhiteSpace(branchGroup.Key) ? "(ungrouped)" : branchGroup.Key)</span>
                                @{
                                    var branchConf = branchGroup.First().BranchConfidence;
                                }
                                @if (branchConf is { } bc && bc > 0)
                                {
                                    <span class="cj-citation-branch-conf">@bc.ToString("P0")</span>
                                }
                            </div>
                            @{
                                var interp = branchGroup.First().BranchInterpretation;
                            }
                            @if (!string.IsNullOrWhiteSpace(interp))
                            {
                                <p class="cj-citation-interp">@interp</p>
                            }
                            @foreach (var p in branchGroup.OrderBy(x => x.RankNumber))
                            {
                                <div class="cj-citation-item">
                                    <div class="cj-citation-item-head">
                                        <span class="cj-citation-rank">@p.RankNumber.</span>
                                        <span class="cj-citation-auth">@p.AuthorityName</span>
                                        @if (p.MatchScore is { } score)
                                        {
                                            <span class="cj-citation-score">@score.ToString("P0")</span>
                                        }
                                    </div>
                                    @if (p.Facets.Count > 0)
                                    {
                                        <div class="cj-citation-facets">
                                            @foreach (var facet in p.Facets)
                                            {
                                                <span class="cj-citation-facet">@facet.Label: @facet.Value</span>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.FitDetail))
                                    {
                                        <p class="cj-citation-detail">@p.FitDetail</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    </div>
</LegalWorkspace>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "matterId")]
    public Guid? MatterId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "runId")]
    public Guid? RunId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "readonly")]
    public string? ReadOnlyFlag { get; set; }

    private readonly List<ChatMessageVm> _messages = new();

    // The two action prompts stay fixed; the remaining four are regenerated from the current matter's
    // factors (BuildMatterSuggestions) so the empty-state chips are always relevant to THIS case. When no
    // matter is linked (or it cannot be loaded) we fall back to the generic personal-injury prompts.
    private static readonly string[] ActionSuggestions =
    {
        "create a premium brief for this matter",
        "list all citations and link the passages to the matter",
        "link all evidences and the citations / statutory authorities to the matter"
    };

    private static readonly string[] GenericSuggestions =
    {
        "Summarize the strengths and weaknesses of a rear-end collision claim.",
        "Draft a professional email requesting updated medical records from a provider.",
        "What evidence strengthens a premises-liability slip-and-fall case?",
        "Outline next steps after a defendant's insurer denies liability."
    };

    private List<string> _suggestions = new(ActionSuggestions.Concat(GenericSuggestions));

    private string _draft = string.Empty;
    private string? _error;
    private bool _sending;
    private bool _canRetry;
    private string? _modelCode;
    private ElementReference _threadRef;
    private ElementReference _inputRef;
    private IJSObjectReference? _module;
    // Drives the Stop button: lets the user abort an in-flight turn (e.g. a long citation generation).
    private CancellationTokenSource? _sendCts;

    private readonly List<ChatJudzConversationSummaryDto> _conversations = new();
    private bool _loadingHistory;
    private Guid _conversationId = Guid.Empty;
    private Guid? _pendingDeleteId;

    private readonly List<ChatJudzCitationBatchSummaryDto> _citationBatches = new();
    private bool _loadingCitations;
    private bool _loadingCitationBatch;
    private ChatJudzCitationBatchDto? _openBatch;

    private readonly List<ChatJudzModelOptionDto> _models = new();
    private string _selectedModel = string.Empty;

    private sealed class ChatMessageVm
    {
        public required string Role { get; init; }
        public required string Content { get; init; }
        public DateTime TimestampUtc { get; init; } = DateTime.UtcNow;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryAsync();
        await LoadModelsAsync();
        await LoadCitationHistoryAsync();
        await LoadMatterSuggestionsAsync();
    }

    // Replaces the four generic starter prompts with matter-specific ones derived from the current
    // matter's decision factors (type/subtype, posture, requested disposition, jurisdiction). The two
    // action prompts stay pinned on top. Fail-soft: any error keeps the generic defaults.
    private async Task LoadMatterSuggestionsAsync()
    {
        if (MatterId is not { } matterId || matterId == Guid.Empty)
            return;

        try
        {
            var matter = await Api.GetLegalDecisionMatterAsync(matterId);
            if (matter is null)
                return;

            var dynamic = BuildMatterSuggestions(matter);
            if (dynamic.Count == 0)
                return;

            _suggestions = new List<string>(ActionSuggestions.Concat(dynamic));
            StateHasChanged();
        }
        catch
        {
            // Keep the generic defaults when the matter cannot be loaded.
        }
    }

    // Deterministically composes up to four case-specific starter prompts from the matter's factors.
    // No fabrication: every prompt is phrased around values actually present on the matter record.
    private static List<string> BuildMatterSuggestions(Legal.Application.Features.Intelligence.Decision.DecisionMatterDto m)
    {
        var prompts = new List<string>();

        var matterType = FirstNonEmpty(m.Subtype, m.DomainPackMatterTypeName, m.MatterTypeName, m.MatterTypeCode);
        var typeLabel = string.IsNullOrWhiteSpace(matterType) ? "this matter" : $"this {matterType} matter";

        // 1. Strengths/weaknesses tied to the actual claim target.
        var target = FirstNonEmpty(m.MotionTarget);
        prompts.Add(string.IsNullOrWhiteSpace(target)
            ? $"Summarize the strengths and weaknesses of {typeLabel}."
            : $"Summarize the strengths and weaknesses of {typeLabel} as to {target}.");

        // 2. Disposition / posture strategy anchored to the requested disposition.
        var disposition = FirstNonEmpty(m.RequestedDisposition);
        if (!string.IsNullOrWhiteSpace(disposition))
            prompts.Add($"What arguments and authorities best support {disposition} here?");
        else if (!string.IsNullOrWhiteSpace(m.Posture))
            prompts.Add($"What is the strongest strategy given this posture: {m.Posture}?");
        else
            prompts.Add($"What are the strongest arguments for the moving party in {typeLabel}?");

        // 3. Jurisdiction-specific controlling law.
        var law = FirstNonEmpty(m.GoverningLaw, m.State, m.Jurisdiction);
        prompts.Add(string.IsNullOrWhiteSpace(law)
            ? $"What controlling law and key elements govern {typeLabel}?"
            : $"What {law} law and key elements control {typeLabel}?");

        // 4. Evidence gaps / next steps using available matter context.
        var party = FirstNonEmpty(m.RespondingParty);
        prompts.Add(string.IsNullOrWhiteSpace(party)
            ? $"What evidence gaps should we close to strengthen {typeLabel}?"
            : $"What evidence do we need to overcome {party}'s likely defenses?");

        return prompts;
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var v in values)
            if (!string.IsNullOrWhiteSpace(v))
                return v.Trim();
        return string.Empty;
    }

    private async Task LoadModelsAsync()
    {
        try
        {
            var models = await Api.GetChatJudzModelsAsync();
            _models.Clear();
            _models.AddRange(models);
            _selectedModel = await Api.GetChatJudzSelectedModelAsync() ?? string.Empty;
        }
        catch (Exception ex)
        {
            _error = $"Could not load models: {ex.Message}";
        }
    }

    private async Task OnModelChangedAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedModel)) return;
        try
        {
            await Api.SaveChatJudzSelectedModelAsync(_selectedModel);
        }
        catch (Exception ex)
        {
            _error = $"Could not save model: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/ChatJudz.razor.js");
            }
            catch { /* interop unavailable during prerender — page still works */ }
        }
    }

    // Compact, human-friendly relative timestamp for the premium history cards.
    private static string RelativeTime(DateTime utc)
    {
        var delta = DateTime.UtcNow - utc;
        if (delta < TimeSpan.Zero) delta = TimeSpan.Zero;
        if (delta.TotalSeconds < 60) return "just now";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes}m ago";
        if (delta.TotalHours < 24) return $"{(int)delta.TotalHours}h ago";
        if (delta.TotalDays < 7) return $"{(int)delta.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM d");
    }

    private async Task LoadHistoryAsync()
    {        _loadingHistory = true;
        try
        {
            var list = await Api.GetChatJudzConversationsAsync(MatterId);
            _conversations.Clear();
            _conversations.AddRange(list);
        }
        catch (Exception ex)
        {
            _error = $"Could not load history: {ex.Message}";
        }
        finally
        {
            _loadingHistory = false;
        }
    }

    private async Task LoadCitationHistoryAsync()
    {
        _loadingCitations = true;
        try
        {
            var list = await Api.GetChatJudzCitationBatchesAsync(MatterId);
            _citationBatches.Clear();
            _citationBatches.AddRange(list);
        }
        catch (Exception ex)
        {
            _error = $"Could not load citation history: {ex.Message}";
        }
        finally
        {
            _loadingCitations = false;
        }
    }

    private async Task OpenCitationBatchAsync(Guid citationBatchId)
    {
        _loadingCitationBatch = true;
        try
        {
            _openBatch = await Api.GetChatJudzCitationBatchAsync(citationBatchId);
        }
        catch (Exception ex)
        {
            _error = $"Could not open citation result: {ex.Message}";
        }
        finally
        {
            _loadingCitationBatch = false;
        }
    }

    private async Task OpenConversationAsync(Guid conversationId)
    {
        if (_sending || conversationId == _conversationId) return;
        _error = null;
        _canRetry = false;
        try
        {
            var turns = await Api.GetChatJudzConversationAsync(conversationId);
            _messages.Clear();
            foreach (var t in turns)
                _messages.Add(new ChatMessageVm { Role = t.Role, Content = t.Content, TimestampUtc = t.CreatedDateUtc });
            _conversationId = conversationId;
            _modelCode = turns.LastOrDefault(t => t.Role == "assistant")?.ModelCode;
            await ScrollToLatestAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not open conversation: {ex.Message}";
        }
    }

    private void StartNewChat()
    {
        if (_sending) return;
        _messages.Clear();
        _conversationId = Guid.Empty;
        _modelCode = null;
        _error = null;
        _canRetry = false;
        _draft = string.Empty;
    }

    private void RequestDelete(Guid conversationId) => _pendingDeleteId = conversationId;

    private async Task ConfirmDeleteAsync()
    {
        var id = _pendingDeleteId;
        _pendingDeleteId = null;
        if (id is null) return;
        try
        {
            await Api.DeleteChatJudzConversationAsync(id.Value);
            if (id.Value == _conversationId) StartNewChat();
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            _error = $"Delete failed: {ex.Message}";
        }
    }

    private string BackHref
    {
        get
        {
            var query = new List<string>();
            if (MatterId is { } mid && mid != Guid.Empty) query.Add($"matterId={mid}");
            if (RunId is { } rid && rid != Guid.Empty) query.Add($"runId={rid}");
            if (!string.IsNullOrWhiteSpace(ReadOnlyFlag)) query.Add($"readonly={Uri.EscapeDataString(ReadOnlyFlag)}");
            return query.Count == 0
                ? "/legal/personalinjury_decision2"
                : $"/legal/personalinjury_decision2?{string.Join("&", query)}";
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    private void UseSuggestion(string suggestion)
    {
        _draft = suggestion;
    }

    private async Task CopyAsync(string content)
    {
        if (_module is null) return;
        try
        {
            await _module.InvokeAsync<bool>("copyText", content);
        }
        catch
        {
            // Clipboard access may be blocked; ignore silently.
        }
    }

    private async Task OnDraftInput()
    {
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("autoGrow", _inputRef, 200);
        }
        catch
        {
            // Ignore interop failures during prerender.
        }
    }

    private async Task RetryAsync()
    {
        if (_sending) return;
        // Re-send using the last user turn already present in the transcript.
        if (_messages.Count == 0 || _messages[^1].Role != "user") return;
        await SendToModelAsync();
    }

    private async Task SendAsync()
    {
        var text = _draft?.Trim();
        if (string.IsNullOrWhiteSpace(text) || _sending) return;

        _messages.Add(new ChatMessageVm { Role = "user", Content = text });
        _draft = string.Empty;
        await SendToModelAsync();
    }

    private async Task SendToModelAsync()
    {
        _error = null;
        _canRetry = false;
        _sending = true;
        _sendCts?.Dispose();
        _sendCts = new CancellationTokenSource();
        var token = _sendCts.Token;
        // Flush the render so the just-added user message is in the DOM before we scroll it up,
        // otherwise scrollToLatest runs against the pre-render layout and the prompt stays put.
        StateHasChanged();
        await Task.Yield();
        await ScrollToLatestAsync();

        try
        {
            var transcript = _messages.Select(m => new ChatJudzMessage(m.Role, m.Content)).ToList();
            var response = await Api.ChatJudzAsync(new ChatJudzRequest(transcript, MatterId, _conversationId == Guid.Empty ? null : _conversationId, string.IsNullOrWhiteSpace(_selectedModel) ? null : _selectedModel, RunId), token);
            var reply = response?.Reply;
            // The server returns a friendly Notice (not a Reply) when a turn could not be completed, e.g.
            // the request exceeded the configured AI input-length limit. Show it in the help banner with
            // its how-to-fix / contact-IT guidance instead of treating it as an empty model answer.
            if (!string.IsNullOrWhiteSpace(response?.Notice))
            {
                _error = response!.Notice;
                _canRetry = false;
            }
            else if (string.IsNullOrWhiteSpace(reply))
            {
                _error = "Judz did not return a response. Please try again.";
                _canRetry = true;
            }
            else
            {
                _modelCode = response?.ModelCode;
                if (response is not null && response.ConversationId != Guid.Empty)
                    _conversationId = response.ConversationId;
                _messages.Add(new ChatMessageVm { Role = "assistant", Content = reply });
                // Refresh the history sidebar so the new/updated conversation appears at the top.
                await LoadHistoryAsync();
                // Refresh the dedicated citation history in case this generation produced ranked authorities.
                await LoadCitationHistoryAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // User stopped the request — treat as a normal action, not a failure.
            _error = null;
            _canRetry = true;
        }
        catch (Exception ex)
        {
            _error = $"Chat failed: {ex.Message}";
            _canRetry = true;
        }
        finally
        {
            _sending = false;
            _sendCts?.Dispose();
            _sendCts = null;
            await ScrollToLatestAsync();
        }
    }

    private void CancelSend()
    {
        // Abort the in-flight turn; SendToModelAsync's cancellation handler restores the UI.
        try { _sendCts?.Cancel(); }
        catch { /* already disposed */ }
    }

    private async Task ScrollToLatestAsync()
    {
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("scrollToLatest", _threadRef);
        }
        catch
        {
            // Ignore interop failures during prerender.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch { /* circuit already torn down */ }
        }
    }
}
