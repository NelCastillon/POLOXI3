    private void ShowToast(string message, string kind) { _toast = message; _toastKind = kind; }

    private IEnumerable<DecisionContractOptionDto> OptionsFor(string field) => _options.Where(o => o.FieldCode == field).OrderBy(o => o.SortOrder);

    private RenderFragment DropdownFor(string field, string? value, Action<string?> setter) => builder =>
    {
        builder.OpenElement(0, "select");
        builder.AddAttribute(1, "disabled", ReadOnly);
        builder.AddAttribute(2, "value", value ?? "");
        builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => setter(string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())));
        builder.AddAttribute(4, "class", "dc-select");
        builder.OpenElement(5, "option"); builder.AddAttribute(6, "value", ""); builder.AddContent(7, "— Select —"); builder.CloseElement();
        foreach (var opt in OptionsFor(field))
        {
            builder.OpenElement(8, "option");
            builder.AddAttribute(9, "value", opt.Value);
            builder.AddContent(10, opt.DisplayName);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment DropdownForInline(string field, string? value, Action<string?> setter) => DropdownFor(field, value, setter);

    private RenderFragment TagEditor(List<string> tags) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "dc-tags");
        var seq = 2;
        foreach (var tag in tags.ToList())
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "dc-tag");
            builder.AddContent(seq++, tag);
            if (!ReadOnly)
            {
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "type", "button");
                builder.AddAttribute(seq++, "class", "dc-tag-x");
                builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => tags.Remove(tag)));
                builder.AddContent(seq++, "×");
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        if (!ReadOnly)
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "text");
            builder.AddAttribute(seq++, "class", "dc-tag-input");
            builder.AddAttribute(seq++, "placeholder", "Add + Enter");
            builder.AddAttribute(seq++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, e =>
            {
                // handled via onchange below for simplicity
            }));
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            {
                var val = e.Value?.ToString()?.Trim();
                if (!string.IsNullOrEmpty(val) && !tags.Contains(val)) tags.Add(val);
            }));
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment SummaryRow(string label, string? value) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "dc-summary-row");
        builder.OpenElement(2, "span"); builder.AddAttribute(3, "class", "dc-summary-label"); builder.AddContent(4, label); builder.CloseElement();
        builder.OpenElement(5, "span"); builder.AddAttribute(6, "class", "dc-summary-value"); builder.AddContent(7, string.IsNullOrWhiteSpace(value) ? "—" : value); builder.CloseElement();
        builder.CloseElement();
    };

    private static string StatusLabel(string code) => code switch
    {
        DecisionContractStatuses.Draft => "Draft",
        DecisionContractStatuses.ReadyForReview => "Ready for Review",
        DecisionContractStatuses.Approved => "Approved",
        DecisionContractStatuses.Active => "Active",
        DecisionContractStatuses.Superseded => "Superseded",
        DecisionContractStatuses.Rejected => "Rejected",
        _ => code
    };

    private static string StatusTone(string code) => code switch
    {
        DecisionContractStatuses.Active or "APPROVED" => "ok",
        DecisionContractStatuses.ReadyForReview or "SUBMITTED" => "info",
        DecisionContractStatuses.Rejected or "RETURNED" => "danger",
        DecisionContractStatuses.Superseded => "muted",
        _ => "warn"
    };

